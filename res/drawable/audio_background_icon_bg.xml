<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:gravity="center"
            android:shape="oval">
            <solid android:color="#33309a35"/>
        </shape>
    </item>
    <item
        android:top="-2dp"
        android:bottom="2dp">
        <bitmap
            android:gravity="top|center_horizontal"
            android:src="@drawable/audio_title_icon"/>
    </item>
</layer-list>
