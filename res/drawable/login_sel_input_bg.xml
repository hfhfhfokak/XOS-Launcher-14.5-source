<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mini_login_color_f7f7f7"/>
            <stroke
                android:width="@dimen/mini_dp_1"
                android:color="@color/mini_login_color_error_tv"/>
            <corners android:radius="@dimen/mini_dp_24"/>
        </shape>
    </item>
    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/mini_login_color_f7f7f7"/>
            <stroke
                android:width="@dimen/mini_dp_1"
                android:color="@color/mini_login_color_f7f7f7"/>
            <corners android:radius="@dimen/mini_dp_24"/>
        </shape>
    </item>
</selector>
