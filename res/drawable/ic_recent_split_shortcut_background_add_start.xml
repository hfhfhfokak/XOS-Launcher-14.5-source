        android:dashGap="@dimen/recent_split_shortcut_stroke_dash_gap"/>
    <solid android:color="@color/recent_split_shortcut_background_add_solid_color"/>
    <corners android:radius="@dimen/recent_split_shortcut_background_adding_radius"/>
</shape>
