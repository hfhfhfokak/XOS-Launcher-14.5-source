<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppBaseTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:progressBarStyle">@style/ThemeProgressTheme</item>
        <item name="android:splitMotionEvents">false</item>
        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:colorControlActivated">@color/purple</item>
        <item name="android:colorAccent">@color/purple</item>
        <item name="android:navigationBarColor">@color/th_navigation_background_color</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="AppTheme" parent="@style/AppBaseTheme">
        <item name="android:colorPrimaryDark">@color/theme_status_bar_color</item>
        <item name="gdprTheme">@style/ThemeGdprStyle</item>
    </style>
    <style name="Launcher.AppTheme" parent="@style/Base.Launcher.AppTheme">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:listMenuViewStyle">@style/LauListMenuViewStyle</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Launcher.Theme.AppCompat.Os.NoActionBar" parent="@style/Launcher.Theme.AppCompat.Os.NoActionBarInternal">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="MainRecTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/th_main_rec_bg_color</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="MainTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/screen_background_color</item>
        <item name="android:navigationBarColor">@color/th_navigation_background_color</item>
    </style>
    <style name="ScooperAppTheme" parent="@style/Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="android:navigationBarColor">#ffcccccc</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="ThemeProgressTheme" parent="@android:style/Widget.Material.ProgressBar">
        <item name="android:progressTint">@color/purple</item>
    </style>
    <style name="TopicDetailTheme" parent="@style/AppTheme">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="VideoShowTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="WpDetailTheme" parent="@style/AppTheme">
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="WpScrollDetailTheme" parent="@style/AppTheme">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="XNAppTheme" parent="@style/OS.Theme.Material.hios">
        <item name="android:splitMotionEvents">false</item>
        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:statusBarColor">?attr/OsBgPrimary</item>
        <item name="android:navigationBarColor">?attr/OsBgPrimary</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:isLightTheme">true</item>
        <item name="colorPrimaryDark">?attr/OsBgPrimary</item>
    </style>
    <style name="XNAppTheme_itel" parent="@style/OS.Theme.Material.itel">
        <item name="android:splitMotionEvents">false</item>
        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:statusBarColor">?attr/OsBgPrimary</item>
        <item name="android:navigationBarColor">?attr/OsBgPrimary</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:isLightTheme">true</item>
        <item name="colorPrimaryDark">?attr/OsBgPrimary</item>
    </style>
    <style name="XNAppTheme_xos" parent="@style/OS.Theme.Material.xos">
        <item name="android:splitMotionEvents">false</item>
        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:statusBarColor">?attr/OsBgPrimary</item>
        <item name="android:navigationBarColor">?attr/OsBgPrimary</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:isLightTheme">true</item>
        <item name="colorPrimaryDark">?attr/OsBgPrimary</item>
    </style>
    <style name="tpush_notification_large_title" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tpush_notification_text_title</item>
        <item name="android:ellipsize">3</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textDirection">5</item>
    </style>
</resources>
