<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="top|center_horizontal"
        android:layout_width="295.6641dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <RelativeLayout
            android:id="@+id/rl_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/head_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/htmlact_ic_default"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="@dimen/ad_content_text_size"
                android:textStyle="bold"
                android:textColor="@color/htmlact_head_text_color"
                android:id="@+id/head_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="70dp"
                android:layout_marginTop="13.33dp"
                android:text="sdfdsfdfsdfdssfdds"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/ad_content_text_size"
            android:textStyle="normal"
            android:textColor="@color/htmlact_head_text_color"
            android:id="@+id/progress_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21.67dp"
            android:text="Loading Failed"
            android:layout_below="@+id/rl_head"
            android:layout_centerHorizontal="true"/>
        <com.transsion.xlauncher.library.engine.widget.CycleLoading
            android:id="@+id/loading_progress"
            android:layout_width="80dp"
            android:layout_height="7dp"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/progress_prompt"
            android:layout_centerInParent="true"/>
        <Button
            android:id="@+id/loading_retry"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_retry"
            android:layout_below="@+id/progress_prompt"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/ad_all_content"
        android:background="@color/transparent"
        android:layout_width="295.6641dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp">
        <ImageView
            android:id="@+id/closeAd"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/htmlact_ic_cancel"
            android:layout_alignParentTop="true"/>
    </RelativeLayout>
</FrameLayout>
