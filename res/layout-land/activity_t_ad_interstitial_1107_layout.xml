<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/llRoot"
        android:layout_width="140dp"
        android:layout_height="250dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.cloud.sdk.commonutil.widget.TranCircleImageView
                android:id="@+id/iv_main_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                app:bottomLeftRadiusYL="8dp"
                app:bottomRightRadiusYL="8dp"
                app:topLeftRadiusYL="8dp"
                app:topRightRadiusYL="8dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:layout_gravity="start|bottom"
            android:id="@+id/ad_flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/include_ad_flag"/>
        <com.cloud.hisavana.sdk.api.view.StoreMarkView
            android:id="@+id/ps_mark_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="@dimen/hisavana_ad_dimen_4"/>
        <ImageView
            android:layout_gravity="start|top"
            android:id="@+id/im_volume"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/hisavana_volume_close"
            android:layout_marginStart="8dp"/>
        <include
            android:layout_gravity="end|top"
            android:id="@+id/ivCancel"
            android:layout_width="@dimen/dimens_24"
            android:layout_height="@dimen/dimens_24"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            layout="@layout/include_countdown_close_view"/>
    </FrameLayout>
</LinearLayout>
