<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/theme_title"
    android:layout_width="match_parent"
    android:layout_height="@dimen/theme_title_bar_height">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/theme_title_left_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/twenty_two_dp"
        android:layout_marginEnd="@dimen/sixteen_dp"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/eighteen_dp"
        android:textColor="@color/th_title_text_color"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/theme_title_left_tv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/theme_title_right_iv1"
            android:visibility="gone"
            android:layout_width="@dimen/forty_four_dp"
            android:layout_height="@dimen/forty_four_dp"
            android:scaleType="center"
            android:contentDescription="@string/theme_online_share"/>
        <ImageView
            android:id="@+id/theme_title_right_iv"
            android:layout_width="@dimen/forty_four_dp"
            android:layout_height="@dimen/forty_four_dp"
            android:scaleType="center"
            android:contentDescription="@string/theme_praise"
            android:layout_marginEnd="@dimen/six_dp"/>
    </LinearLayout>
</LinearLayout>
