<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/header_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/local_wp_head_item_height"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/ten_dp"
        android:layout_marginStart="@dimen/theme_common_item_half_padding"
        android:layout_marginEnd="@dimen/theme_common_item_half_padding">
        <FrameLayout
            android:id="@+id/wallpaper_gallery_layout"
            android:background="@drawable/local_wp_head_gallery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.transsion.theme.common.customview.ElegantTextView
                android:textSize="@dimen/fourteen_dp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_wallpaper"
                android:singleLine="true"
                android:drawablePadding="@dimen/five_dp"
                android:drawableStart="@drawable/ic_local_wp_head_gallery"
                android:fontFamily="sans-serif"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/wallpaper_live_layout"
            android:background="@drawable/local_wp_head_live_wallpaper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/ten_dp">
            <com.transsion.theme.common.customview.ElegantTextView
                android:textSize="@dimen/fourteen_dp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_wallpaper"
                android:singleLine="true"
                android:drawablePadding="@dimen/five_dp"
                android:drawableStart="@drawable/ic_local_wp_head_live_wallpaper"
                android:fontFamily="sans-serif"/>
        </FrameLayout>
    </LinearLayout>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/sixteen_sp"
        android:textColor="@color/th_local_wp_item_color"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/ten_dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/build_in_wallpaper"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/seven_dp"/>
</LinearLayout>
