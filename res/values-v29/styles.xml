<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppBaseTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:progressBarStyle">@style/ThemeProgressTheme</item>
        <item name="android:splitMotionEvents">false</item>
        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:colorControlActivated">@color/purple</item>
        <item name="android:colorAccent">@color/purple</item>
        <item name="android:switchStyle">@style/Theme.Widget.Switch</item>
        <item name="android:navigationBarColor">@color/th_navigation_background_color</item>
        <item name="android:windowLightStatusBar">@bool/theme_light_status_bar</item>
        <item name="android:windowLightNavigationBar">@bool/theme_light_nav_bar</item>
    </style>
    <style name="AppTheme" parent="@style/AppBaseTheme">
        <item name="android:windowBackground">@color/screen_background_color</item>
        <item name="android:colorPrimaryDark">@color/theme_status_bar_color</item>
        <item name="android:navigationBarColor">@color/screen_background_color</item>
        <item name="gdprTheme">@style/ThemeGdprStyle</item>
    </style>
    <style name="CustomerSearchTheme" parent="@style/LauncherAppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:scrollbarThumbVertical">@drawable/x_folder_scroll_bar</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="gdprTheme">@style/LauncherGdprStyle</item>
        <item name="selectableItemBackground">@drawable/item_background_borderless_material</item>
    </style>
    <style name="HideAppsActivityTheme" parent="@style/LauncherAppTheme">
        <item name="android:scrollbarThumbVertical">@drawable/x_folder_scroll_bar</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:navigationBarColor">@color/hideapp_activity_navigation_bar_color</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="selectableItemBackground">@drawable/item_background_borderless_material</item>
    </style>
    <style name="Launcher.AppTheme.WithWallpaper" parent="@style/Launcher.AppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:listMenuViewStyle">@style/LauListMenuViewStyle</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="MainRecTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/th_main_rec_bg_color</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="MainTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/screen_background_color</item>
        <item name="android:navigationBarColor">@color/theme_tab_background_color</item>
    </style>
    <style name="ProxyActivityStarterTheme" parent="@style/TransparentActivity">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="SoulDesc_Activity" parent="@style/Launcher.Theme.AppCompat.Os.NoActionBar">
        <item name="android:windowBackground">@drawable/soul_desc_activity_bg</item>
        <item name="android:colorPrimaryDark">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="Theme.Widget.Switch" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:background">@null</item>
        <item name="android:thumb">@drawable/theme_btn_switch_thumb_selector</item>
        <item name="android:track">@drawable/theme_switch_track_material_light</item>
    </style>
    <style name="ToolbarNavigationStyle.DayNight" parent="@style/ToolbarNavigationStyle">
        <item name="android:tint">@color/hideapp_toolbar_arrow_color</item>
    </style>
    <style name="TopicDetailTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/cover_bg_color</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="VideoShowTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="WhiteTheme" parent="@style/LauncherAppTheme.Light">
        <item name="android:scrollbarThumbVertical">@drawable/os_scrollbar_thumb_vertical</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">@color/launcher_account_bg_color</item>
        <item name="android:windowLightStatusBar">@bool/launcher_account_light_status_bar</item>
        <item name="colorPrimaryDark">@android:color/white</item>
    </style>
    <style name="WpScrollDetailTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/cover_bg_color</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
