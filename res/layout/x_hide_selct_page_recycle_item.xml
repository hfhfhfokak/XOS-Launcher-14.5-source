<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/hide_select_page_margin_start_end"
    android:layout_marginRight="@dimen/hide_select_page_margin_start_end">
    <ImageView
        android:id="@+id/select_item_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <Button
        android:id="@+id/select_btn"
        android:background="@drawable/ic_item_checkbox_selector"
        android:clickable="false"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textColor="@color/hide_page_select_item_text_color"
        android:ellipsize="end"
        android:id="@+id/select_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_toStartOf="@+id/select_btn"
        android:layout_toEndOf="@+id/select_item_icon"/>
</RelativeLayout>
