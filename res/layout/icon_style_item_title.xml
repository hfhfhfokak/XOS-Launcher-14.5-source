<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/icon_setting_content_margin_start"
    android:layout_marginEnd="@dimen/icon_setting_content_margin_start">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/os_text_primary_color"
        android:ellipsize="end"
        android:id="@+id/icon_setting_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/os_text_tertiary_color"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/icon_setting_item_title_des"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="149dp"
        android:maxLines="1"
        android:fontFamily="Roboto Regular"
        android:textAlignment="viewStart"
        android:layout_marginStart="10dp"/>
</LinearLayout>
