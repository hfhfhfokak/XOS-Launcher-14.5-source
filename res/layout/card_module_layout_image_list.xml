<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/card_image_list_height">
    <com.transsion.cardlibrary.element.RoundImageElement
        android:tag="@string/card_module_key_bg_image_url"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_image_list_height"
        android:src="@drawable/card_normal_shape_bg"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/RoundedStyleItem"
        app:strokeColor="@null"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/card_common_title_ll"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="@dimen/card_library_9dp"
        android:layoutDirection="locale">
        <com.transsion.cardlibrary.element.RoundImageElement
            android:tag="@string/card_module_key_logo"
            android:layout_width="@dimen/card_library_18dp"
            android:layout_height="@dimen/card_library_18dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/card_library_14dp"
            app:shapeAppearance="@style/RoundedStyleLogo"
            app:strokeColor="@null"/>
        <com.transsion.cardlibrary.element.TextElement
            android:textSize="12sp"
            android:textColor="@color/card_text_normal_color"
            android:ellipsize="end"
            android:tag="@string/card_module_key_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/card_library_5dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/card_image_list_content_ll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_container_height"
        android:layout_marginTop="@dimen/card_library_12dp"
        android:layout_below="@+id/card_common_title_ll">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/card_library_12dp">
            <com.transsion.cardlibrary.element.RoundImageElement
                android:tag="@string/card_module_key_image_url1"
                app:shapeAppearance="@style/RoundedStyleElement"
                app:strokeColor="@null"
                style="@style/ListTextImageStyle"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="14dp"
                android:textColor="@color/card_text_normal_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text1"
                android:layout_width="match_parent"
                android:layout_height="37dp"
                android:layout_marginTop="@dimen/card_library_4dp"
                android:maxLines="2"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/card_library_10dp">
            <com.transsion.cardlibrary.element.RoundImageElement
                android:tag="@string/card_module_key_image_url2"
                app:shapeAppearance="@style/RoundedStyleElement"
                app:strokeColor="@null"
                style="@style/ListTextImageStyle"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="14dp"
                android:typeface="sans"
                android:textColor="@color/card_text_normal_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text2"
                android:layout_width="match_parent"
                android:layout_height="37dp"
                android:layout_marginTop="@dimen/card_library_4dp"
                android:maxLines="2"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/card_library_10dp"
            android:layout_marginEnd="@dimen/card_library_12dp">
            <com.transsion.cardlibrary.element.RoundImageElement
                android:tag="@string/card_module_key_image_url3"
                app:shapeAppearance="@style/RoundedStyleElement"
                app:strokeColor="@null"
                style="@style/ListTextImageStyle"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="14dp"
                android:textColor="@color/card_text_normal_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text3"
                android:layout_width="match_parent"
                android:layout_height="37dp"
                android:layout_marginTop="@dimen/card_library_4dp"
                android:maxLines="2"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/card_list_space_view"
        android:background="@color/card_space_line_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_library_1dp"
        android:layout_marginTop="@dimen/card_library_16dp"
        android:layout_below="@+id/card_image_list_content_ll"
        android:layout_marginStart="@dimen/card_library_14dp"
        android:layout_marginEnd="@dimen/card_library_14dp"/>
    <com.transsion.cardlibrary.element.TextElement
        android:textSize="14sp"
        android:textColor="@color/card_text_main_color"
        android:gravity="center"
        android:tag="@string/card_module_key_text"
        android:background="@drawable/card_common_btn_selector"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:layout_below="@+id/card_list_space_view"
        android:fontFamily="sans-serif-medium"/>
</RelativeLayout>
