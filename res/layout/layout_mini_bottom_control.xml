<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/iv_control"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_play"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/mini_ic_video_center_play"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_container"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingHorizontal="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/btn_volume"
                android:layout_width="@dimen/controller_height"
                android:layout_height="@dimen/controller_height"
                android:src="@drawable/mini_ic_volume_on"/>
            <TextView
                android:textSize="@dimen/controller_time_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/curr_time"
                android:padding="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <SeekBar
                android:layout_gravity="center_vertical"
                android:id="@+id/seekBar"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:maxHeight="2dp"
                android:max="1000"
                android:progressDrawable="@drawable/mini_layer_progress_bar"
                android:thumb="@drawable/mini_seekbar_thumb"
                android:thumbOffset="0dp"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"/>
            <TextView
                android:textSize="@dimen/controller_time_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/total_time"
                android:padding="9dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/fullscreen"
                android:layout_width="@dimen/controller_height"
                android:layout_height="@dimen/controller_height"
                android:src="@drawable/mini_ic_video_full"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
