<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/search_result_card"
    android:background="@drawable/x_search_result_card_view_bg"
    android:paddingBottom="@dimen/custom_search_card_bg_corner"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/search_item_margin">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_bar"
        android:layout_width="match_parent"
        android:layout_height="38dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/search_result_itme_head_title_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/x_tv_card_title"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:drawablePadding="8dp"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/search_card_title_margin_start"
            android:paddingEnd="0dp"
            android:layout_marginEnd="50.67dp"
            style="@style/TextAppearance_Roboto_Content"/>
        <ImageView
            android:id="@+id/x_iv_gs_open_close"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/customer_search_ic_open"
            android:scaleType="centerInside"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <com.transsion.xlauncher.search.view.ExpandRecycleView
        android:id="@+id/x_gv_gs_recycle_view"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_bar"/>
</RelativeLayout>
