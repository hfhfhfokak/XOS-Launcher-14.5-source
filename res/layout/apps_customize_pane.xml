<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.allappspane.AppsCustomizePaneView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:visibility="invisible"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/apps_custom_panel_margin_start_end"
    android:layout_marginEnd="@dimen/apps_custom_panel_margin_start_end">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/all_apps_reveal"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="0dp"/>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="locale">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/workspace_icon_text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/all_apps_label"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/apps_custom_panel_title_height"
            android:text="@string/all_apps_loading_message"
            android:textAlignment="center"/>
        <com.android.launcher3.allappspane.AppsCustomizePagedView
            android:id="@+id/apps_customize_pane_content"
            android:paddingTop="@dimen/apps_custom_panel_title_height"
            android:paddingBottom="@dimen/apps_custom_panel_page_indicator_height"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            launcher:maxGap="@dimen/workspace_max_gap"
            launcher:pageIndicator="@+id/apps_customize_page_indicator"
            launcher:widgetCountX="4"
            launcher:widgetCountY="5"/>
        <com.transsion.xlauncher.pageIndicator.PageIndicatorWrapper
            android:gravity="center_horizontal"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/apps_customize_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/apps_custom_panel_page_indicator_height"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            launcher:layout_ignoreInsets="true"
            launcher:maxMarkerNum="20"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/btn_set_h"
            android:layout_width="@dimen/apps_custom_panel_title_height"
            android:layout_height="@dimen/apps_custom_panel_title_height"
            android:src="@drawable/search_bar_setting"
            android:scaleType="centerInside"
            android:layout_marginEnd="@dimen/all_apps_search_setting_btn_h_margin_start_end"/>
    </FrameLayout>
</com.android.launcher3.allappspane.AppsCustomizePaneView>
