<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/sixteen_dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/eleven_dp"
        android:layout_marginEnd="@dimen/eleven_dp">
        <TextView
            android:textSize="@dimen/twenty_sp"
            android:textColor="@color/th_res_name_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/item_weekly_num_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/th_weekly_num_gap_color"
            android:visibility="gone"
            android:layout_width="@dimen/zero_point_six_seven_dp"
            android:layout_height="@dimen/fifteen_dp"
            android:layout_marginStart="@dimen/five_dp"
            android:layout_marginEnd="@dimen/five_dp"/>
        <TextView
            android:textSize="@dimen/twelve_sp"
            android:textColor="@color/percentage_60_black"
            android:layout_gravity="center_vertical"
            android:id="@+id/item_weekly_date_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_weekly_theme_ll"
        android:background="@drawable/bg_weekly_child"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="weekly_normal_theme">
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="14sp"
            android:textColor="@color/percentage_60_black"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/forty_four_dp"
            android:text="@string/activity_tab_theme"
            android:singleLine="true"
            android:layout_marginStart="@dimen/nineteen_dp"/>
        <com.transsion.theme.common.ThemeCoverView
            android:id="@+id/item_weekly_theme_iv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/weekly_item_cover_padding"
            android:layout_marginEnd="@dimen/weekly_item_cover_padding"
            app:isNeedText="false"
            app:radios="@dimen/theme_preview_small_corner_radius"/>
        <TextView
            android:textSize="@dimen/sixteen_sp"
            android:textColor="@color/th_res_name_color"
            android:id="@+id/item_weekly_theme_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/nineteen_dp"
            android:layout_marginEnd="@dimen/nineteen_dp"/>
        <TextView
            android:textSize="@dimen/twelve_sp"
            android:textColor="@color/percentage_60_black"
            android:id="@+id/item_weekly_theme_describe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/two_dp"
            android:layout_marginBottom="@dimen/sixteen_dp"
            android:maxLines="3"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/nineteen_dp"
            android:layout_marginEnd="@dimen/nineteen_dp"/>
    </LinearLayout>
    <RelativeLayout
        android:background="@drawable/bg_weekly_child"
        android:paddingBottom="@dimen/weekly_wp_bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eight_dp"
        android:contentDescription="weekly_wallpaper"
        android:paddingStart="@dimen/weekly_item_cover_padding"
        android:paddingEnd="@dimen/weekly_item_cover_padding">
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="@dimen/fourteen_sp"
            android:textColor="@color/percentage_60_black"
            android:gravity="center"
            android:id="@+id/item_weekly_wallpaper_tv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/forty_four_dp"
            android:text="@string/activity_tab_wallpaper"
            android:singleLine="true"
            android:layout_marginStart="@dimen/weekly_item_title_padding"/>
        <com.transsion.theme.common.ThemeCoverView
            android:id="@+id/item_weekly_wallpaper_iv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/item_weekly_wallpaper_tv"
            app:isNeedText="false"
            app:radios="@dimen/theme_preview_small_corner_radius"/>
        <com.transsion.theme.common.ThemeCoverView
            android:id="@+id/item_weekly_wallpaper_iv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/item_weekly_wallpaper_tv"
            android:layout_marginStart="@dimen/weekly_wp_item_gap"
            android:layout_toEndOf="@+id/item_weekly_wallpaper_iv1"
            app:isNeedText="false"
            app:radios="@dimen/theme_preview_small_corner_radius"/>
        <com.transsion.theme.common.ThemeCoverView
            android:id="@+id/item_weekly_wallpaper_iv3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/weekly_wp_item_gap"
            android:layout_below="@+id/item_weekly_wallpaper_iv2"
            android:layout_marginStart="@dimen/weekly_wp_item_gap"
            android:layout_toEndOf="@+id/item_weekly_wallpaper_iv1"
            app:isNeedText="false"
            app:radios="@dimen/theme_preview_small_corner_radius"/>
        <com.transsion.theme.common.ThemeCoverView
            android:id="@+id/item_weekly_wallpaper_iv4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/weekly_wp_item_gap"
            android:layout_below="@+id/item_weekly_wallpaper_iv1"
            android:layout_marginStart="@dimen/weekly_wp_item_gap"
            android:layout_marginEnd="@dimen/weekly_wp_item_gap"
            android:layout_toEndOf="@+id/item_weekly_wallpaper_iv5"
            app:isNeedText="false"
            app:radios="@dimen/theme_preview_small_corner_radius"/>
        <com.transsion.theme.common.ThemeCoverView
            android:id="@+id/item_weekly_wallpaper_iv5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/weekly_wp_item_gap"
            android:layout_below="@+id/item_weekly_wallpaper_iv1"
            app:isNeedText="false"
            app:radios="@dimen/theme_preview_small_corner_radius"/>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/item_weekly_diy"
        android:background="@drawable/bg_weekly_child"
        android:paddingBottom="@dimen/twenty_two_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eight_dp"
        android:paddingStart="@dimen/weekly_item_cover_padding"
        android:paddingEnd="@dimen/weekly_item_cover_padding">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="weekly_diy_theme01">
            <com.transsion.theme.common.customview.ElegantTextView
                android:textSize="@dimen/fourteen_sp"
                android:textColor="@color/percentage_60_black"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/forty_four_dp"
                android:text="@string/diy_single_text"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingStart="@dimen/weekly_item_title_padding"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_weekly_diy1_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsion.theme.common.ThemeCoverView
                    android:id="@+id/item_weekly_diy_iv1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:isNeedText="false"
                    app:radios="@dimen/theme_preview_small_corner_radius"
                    app:typeIcon="@drawable/ic_diy_angle"/>
                <TextView
                    android:textSize="@dimen/fourteen_sp"
                    android:textColor="@color/light_black_color"
                    android:id="@+id/item_weekly_diy_name1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/six_dp"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="@dimen/twelve_sp"
                    android:textColor="@color/percentage_60_black"
                    android:id="@+id/item_weekly_diy_author1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="weekly_diy_theme02"
            android:layout_marginStart="@dimen/eight_dp">
            <com.transsion.theme.common.customview.ElegantTextView
                android:textSize="@dimen/twelve_sp"
                android:textColor="@color/percentage_60_black"
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:id="@+id/item_weekly_diy_more"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/forty_four_dp"
                android:text="@string/text_theme_description_display"
                android:drawablePadding="5dp"
                android:drawableEnd="@drawable/ic_theme_arrow"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_weekly_diy2_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.transsion.theme.common.ThemeCoverView
                    android:id="@+id/item_weekly_diy_iv2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:isNeedText="false"
                    app:radios="@dimen/theme_preview_small_corner_radius"
                    app:typeIcon="@drawable/ic_diy_angle"/>
                <TextView
                    android:textSize="@dimen/fourteen_sp"
                    android:textColor="@color/light_black_color"
                    android:id="@+id/item_weekly_diy_name2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/six_dp"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="@dimen/twelve_sp"
                    android:textColor="@color/percentage_60_black"
                    android:id="@+id/item_weekly_diy_author2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
