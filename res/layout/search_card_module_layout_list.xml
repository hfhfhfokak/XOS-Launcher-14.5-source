<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/search_card_shape_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/card_title_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_library_9dp"
        android:layoutDirection="locale">
        <com.transsion.cardlibrary.element.RoundImageElement
            android:id="@+id/search_grid_logo"
            android:tag="@string/card_module_key_logo"
            android:layout_width="@dimen/card_library_18dp"
            android:layout_height="@dimen/card_library_18dp"
            android:src="@drawable/card_img_normal"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/card_library_14dp"
            app:shapeAppearance="@style/CircleStyle"
            app:strokeColor="@null"/>
        <com.transsion.cardlibrary.element.TextElement
            android:textSize="12sp"
            android:textColor="@color/search_card_title_color"
            android:ellipsize="end"
            android:id="@+id/search_card_title"
            android:tag="@string/card_module_key_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/card_library_8dp"
            android:layout_toEndOf="@+id/search_grid_logo"/>
    </RelativeLayout>
    <com.transsion.cardlibrary.view.AbilityLinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_library_12dp"
        android:layout_below="@+id/card_title_ll">
        <RelativeLayout
            android:id="@+id/search_card_list_icon1"
            android:tag="@string/search_card_module_key_back_ground1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/card_library_20dp"
            android:paddingEnd="@dimen/card_library_20dp">
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/list_img_icon1"
                android:tag="@string/search_card_module_key_icon1"
                android:layout_width="@dimen/card_library_66dp"
                android:layout_height="@dimen/card_library_66dp"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                android:layout_marginEnd="@dimen/card_library_11dp"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="16sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:tag="@string/card_module_key_text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:layout_toEndOf="@+id/list_img_icon1"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_desc_color"
                android:ellipsize="end"
                android:id="@+id/search_list_desc1_tv"
                android:tag="@string/card_module_key_description1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_alignBottom="@+id/list_img_icon1"
                android:layout_toEndOf="@+id/list_img_icon1"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/search_card_list_icon2"
            android:tag="@string/search_card_module_key_back_ground2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_library_12dp"
            android:paddingStart="@dimen/card_library_20dp"
            android:paddingEnd="@dimen/card_library_20dp">
            <View
                android:id="@+id/list_icon2_divider"
                android:background="@color/search_card_list_divider_color"
                android:layout_width="match_parent"
                android:layout_height="0.33dp"
                android:layout_marginStart="@dimen/card_library_77dp"/>
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/list_img_icon2"
                android:tag="@string/search_card_module_key_icon2"
                android:layout_width="@dimen/card_library_66dp"
                android:layout_height="@dimen/card_library_66dp"
                android:layout_marginTop="@dimen/card_library_12dp"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                android:layout_below="@+id/list_icon2_divider"
                android:layout_marginEnd="@dimen/card_library_11dp"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="16sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:tag="@string/card_module_key_text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_library_12dp"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:layout_toEndOf="@+id/list_img_icon2"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_desc_color"
                android:ellipsize="end"
                android:id="@+id/search_list_desc2_tv"
                android:tag="@string/card_module_key_description2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_alignBottom="@+id/list_img_icon2"
                android:layout_toEndOf="@+id/list_img_icon2"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/search_card_list_icon3"
            android:tag="@string/search_card_module_key_back_ground3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_library_12dp"
            android:paddingStart="@dimen/card_library_20dp"
            android:paddingEnd="@dimen/card_library_20dp">
            <View
                android:id="@+id/list_icon3_divider"
                android:background="@color/search_card_list_divider_color"
                android:layout_width="match_parent"
                android:layout_height="0.33dp"
                android:layout_marginStart="@dimen/card_library_77dp"/>
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/list_img_icon3"
                android:tag="@string/search_card_module_key_icon3"
                android:layout_width="@dimen/card_library_66dp"
                android:layout_height="@dimen/card_library_66dp"
                android:layout_marginTop="@dimen/card_library_12dp"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                android:layout_below="@+id/list_icon3_divider"
                android:layout_marginEnd="@dimen/card_library_11dp"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="16sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:tag="@string/card_module_key_text3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_library_12dp"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:layout_toEndOf="@+id/list_img_icon3"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_desc_color"
                android:ellipsize="end"
                android:id="@+id/search_list_desc3_tv"
                android:tag="@string/card_module_key_description3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_alignBottom="@+id/list_img_icon3"
                android:layout_toEndOf="@+id/list_img_icon3"/>
        </RelativeLayout>
        <View
            android:id="@+id/search_list_divider"
            android:background="@color/search_card_list_divider_color"
            android:layout_width="match_parent"
            android:layout_height="0.33dp"
            android:layout_marginTop="@dimen/card_library_12dp"
            android:layout_below="@+id/search_list_desc3_tv"
            android:layout_marginStart="@dimen/card_library_20dp"
            android:layout_marginEnd="@dimen/card_library_20dp"/>
        <com.transsion.cardlibrary.element.NoColorTextElement
            android:textSize="14sp"
            android:textColor="@color/search_card_common_text_selector"
            android:gravity="center"
            android:tag="@string/card_module_key_more_text"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_library_42dp"/>
    </com.transsion.cardlibrary.view.AbilityLinearLayout>
</RelativeLayout>
