<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/csl_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_loading_feeds"/>
    <include layout="@layout/feeds_empty_view"/>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smart_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/feeds_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.scene.zeroscreen.view.consecutivescroller.ZsSmartRefreshFooter
            android:id="@+id/smart_refresh_footer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</FrameLayout>
