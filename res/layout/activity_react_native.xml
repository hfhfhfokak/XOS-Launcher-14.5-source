<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.react.ReactRootView
        android:id="@+id/rn_rc_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/rn_load_root_rl"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/rn_head_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="80dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/ad_content_text_size"
            android:textStyle="bold"
            android:textColor="@color/fa_head_text_color"
            android:id="@+id/head_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_below="@+id/rn_head_icon"
            android:layout_centerHorizontal="true"/>
        <com.transsion.xlauncher.library.engine.widget.CycleLoading
            android:id="@+id/rn_c_loading"
            android:layout_width="60dp"
            android:layout_height="7dp"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="@dimen/ad_content_text_size"
            android:textStyle="normal"
            android:textColor="@color/fa_head_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Loading"
            android:layout_below="@+id/rn_c_loading"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <include layout="@layout/fa_share_quit"/>
    <ViewStub
        android:id="@+id/rn_root_error"
        android:layout="@layout/fa_error_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
