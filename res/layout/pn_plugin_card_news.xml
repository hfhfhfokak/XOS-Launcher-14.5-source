<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <RelativeLayout
        android:id="@+id/plugin_news_card_rl"
        android:background="@drawable/zs_common_card_bg"
        android:paddingTop="@dimen/pn_dimen_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_news_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginBottom="@dimen/pn_dimen_10dp"
            android:src="@drawable/pn_ic_news"
            android:layout_marginStart="@dimen/pn_dimen_10dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/pn_dimen_12sp"
            android:textColor="@color/zs_common_card_title_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pn_news_title"
            android:layout_marginStart="@dimen/pn_dimen_8dp"
            android:layout_toEndOf="@+id/iv_news_icon"/>
        <FrameLayout
            android:id="@+id/plugin_news_loading_view"
            android:background="#0d000000"
            android:layout_width="match_parent"
            android:layout_height="103dp"
            android:layout_below="@+id/iv_news_icon">
            <TextView
                android:textSize="@dimen/pn_dimen_14sp"
                android:textColor="#66222222"
                android:layout_gravity="center"
                android:id="@+id/pn_news_card_error_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pn_news_fail_refresh"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/pn_news_card_progress"
                android:layout_width="@dimen/pn_dimen_24dp"
                android:layout_height="@dimen/pn_dimen_24dp"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/p_news_progress_loading"
                android:indeterminateBehavior="repeat"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/plugin_news_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/plugin_news_loading_view">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/news_card_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
