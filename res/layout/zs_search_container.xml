<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/zs_ll_gs_search_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/zs_rl_search_top"
        android:background="@drawable/zs_search_box_selector"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/zs_dimen_34dp"
        android:layout_marginBottom="@dimen/zs_zero_6dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#4d222222"
            android:gravity="center_vertical"
            android:id="@+id/zs_tv_search"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/zs_search_et_hint"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/zs_iv_scan"
            android:padding="10dp"
            android:visibility="invisible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/zs_search_scan"
            android:scaleType="fitXY"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.scene.plugin.custom.search.RecentAppsContainer
        android:id="@+id/zs_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/zs_rl_search_top"/>
</RelativeLayout>
