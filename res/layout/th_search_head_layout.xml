<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/search_head"
    android:layout_width="match_parent"
    android:layout_height="@dimen/forty_dp"
    android:layout_marginTop="@dimen/eight_dp"
    android:layout_marginBottom="@dimen/eighteen_dp"
    android:layout_marginStart="@dimen/theme_common_screen_padding"
    android:layout_marginEnd="@dimen/theme_common_screen_padding">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/slider_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/th_sidebar_switch_icon"
        android:contentDescription="slide_switch"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/search_box"
        android:background="@drawable/theme_search_box_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/sixteen_dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_main_search"
            android:layout_marginStart="@dimen/eight_dp"/>
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="@dimen/fourteen_sp"
            android:textColor="@color/th_search_hint_color"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_search"
            android:layout_marginStart="@dimen/ten_dp"/>
    </LinearLayout>
</LinearLayout>
