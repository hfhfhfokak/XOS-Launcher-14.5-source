<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/more_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ly_back"
            android:layout_width="match_parent"
            android:layout_height="@dimen/os_action_bar_height">
            <ImageView
                android:gravity="center"
                android:id="@+id/tv_back"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/os_ic_back"
                android:scaleType="centerInside"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <TextView
                android:ellipsize="end"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flashapp_recently"
                android:maxLines="1"
                style="@style/OSActionBarTitleCompat"/>
        </LinearLayout>
        <View
            android:layout_gravity="bottom"
            android:background="@color/preference_divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_more"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
