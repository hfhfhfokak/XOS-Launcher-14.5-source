<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/zs_ad_bg_color"
    android:layout_width="match_parent"
    android:layout_height="@dimen/pn_dimen_124dp">
    <com.zero.mediation.ad.view.TIconView
        android:id="@+id/ad_icon"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <com.zero.mediation.ad.view.TMediaView
        android:id="@+id/ad_image"
        android:paddingTop="@dimen/pn_dimen_14dp"
        android:paddingBottom="@dimen/pn_dimen_14dp"
        android:layout_width="@dimen/pn_dimen_184dp"
        android:layout_height="@dimen/pn_dimen_124dp"
        android:layout_marginEnd="@dimen/pn_dimen_10dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pn_dimen_96dp"
        android:layoutDirection="locale">
        <TextView
            android:textSize="@dimen/pn_dimen_15sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/ad_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="@dimen/pn_dimen_12sp"
            android:textColor="@color/zs_new_white_50"
            android:ellipsize="end"
            android:id="@+id/ad_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pn_dimen_2dp"
            android:lines="2"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:textSize="@dimen/pn_dimen_12sp"
            android:textColor="@color/pn_color1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ad_install"
            android:background="@drawable/pn_news_ads_btn_bg"
            android:paddingLeft="@dimen/pn_dimen_8dp"
            android:paddingRight="@dimen/pn_dimen_8dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pn_dimen_28dp"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
