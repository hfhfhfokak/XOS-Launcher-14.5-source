<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/fa_personalcenter_bgcolor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/fa_personalcenter_top_bgcolor"
        android:layout_width="match_parent"
        android:layout_height="178dp">
        <LinearLayout
            android:gravity="center"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/iv_back"
                android:background="@drawable/fa_ic_actionbar_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:onClick="backEvent"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ly_avatar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="76.67dp">
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="60dp"
                android:layout_height="60dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Caceklec"
                android:maxLines="1"
                android:maxEms="13"/>
        </LinearLayout>
    </FrameLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/fa_color_000000_DEDEDE"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flashapp_recently"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_0099FF"
            android:gravity="center_vertical"
            android:id="@+id/tv_more"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flashapp_more"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <include
        android:id="@+id/ly_nodata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        layout="@layout/fa_recent_play_nodata_layout"/>
    <Button
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/btn_logout"
        android:background="@drawable/fa_logout_button_style"
        android:layout_width="328dp"
        android:layout_height="48dp"
        android:layout_marginBottom="30dp"
        android:text="@string/flashapp_logout"/>
</LinearLayout>
