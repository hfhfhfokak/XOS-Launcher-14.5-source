<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/wp_detail_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/walldetail_reload"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_theme_reload"
        android:layout_centerInParent="true"/>
    <ProgressBar
        android:id="@+id/walldetail_progress"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <Button
        android:textSize="@dimen/fourteen_sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:id="@+id/walldetail_btn"
        android:background="@drawable/th_fullscreen_download_btn_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty_six_dp"
        android:layout_marginBottom="@dimen/thirty_dp"
        android:text="@string/text_wallpaper_download"
        android:singleLine="true"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_marginStart="@dimen/wp_detail_activity_button_padding"
        android:layout_marginEnd="@dimen/wp_detail_activity_button_padding"/>
    <RelativeLayout
        android:id="@+id/rl_gaussian_blur"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/twenty_dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/twenty_night_dp">
        <ImageView
            android:id="@+id/iv_blur"
            android:clickable="false"
            android:layout_width="@dimen/thirty_two_dp"
            android:layout_height="@dimen/thirty_two_dp"
            android:src="@drawable/blur_button_selector_normal"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/ten_dp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/fifty_eight_dp"
            android:text="@string/btn_gaussian_blur"
            android:singleLine="true"
            android:shadowColor="#59000000"
            android:shadowDx="0"
            android:shadowDy="0.7"
            android:shadowRadius="1.2"
            android:layout_below="@+id/iv_blur"
            android:layout_centerHorizontal="true"
            android:textAllCaps="false"
            android:textFontWeight="500"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_seekbar_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/forty_eight_dp"
        android:layout_marginBottom="@dimen/twenty_five_dp"
        android:layout_above="@+id/walldetail_btn"
        android:layout_marginStart="@dimen/twenty_four_dp"
        android:layout_marginEnd="@dimen/twenty_four_dp">
        <com.transsion.widgetslib.widget.seekbar.OSSeekbar
            android:id="@+id/seek_bar_blur"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/twelve_dp"
            android:layout_marginEnd="@dimen/twelve_dp"
            android:splitTrack="false"
            app:osSeekbarMax="150"
            app:osSeekbarMin="0"
            app:osSeekbarProgress="30"/>
    </RelativeLayout>
</RelativeLayout>
