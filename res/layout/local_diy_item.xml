<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/sixteen_dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/theme_common_item_half_padding"
    android:paddingEnd="@dimen/theme_common_item_half_padding">
    <com.transsion.theme.common.ThemeCoverView
        android:id="@+id/local_diy_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:radios="@dimen/theme_preview_corner_radius"/>
    <CheckBox
        android:id="@+id/local_diy_choose"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_alignTop="@+id/local_diy_image"
        android:layout_alignEnd="@+id/local_diy_image"/>
    <com.transsion.theme.common.customview.RoundCornerImageView
        android:id="@+id/local_diy_using"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_using"
        android:layout_alignRight="@+id/local_diy_image"
        android:layout_alignBottom="@+id/local_diy_image"
        app:riv_corner_radius_bottom_right="@dimen/theme_preview_corner_radius"/>
</RelativeLayout>
