<?xml version="1.0" encoding="utf-8"?>
<com.android.quickstep.src.com.android.quickstep.views.TaskMenuView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/task_menu_view"
    android:background="@drawable/task_menu_bg"
    android:paddingTop="@dimen/recent_press_task_scroll_menu_pading_top"
    android:visibility="invisible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <com.android.quickstep.src.com.android.quickstep.views.IconView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/task_icon"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="@dimen/task_thumbnail_icon_size"
        android:layout_height="@dimen/task_thumbnail_icon_size"
        android:layout_marginBottom="@dimen/deep_shortcut_drawable_padding"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="15sp"
        android:gravity="center_horizontal"
        android:id="@+id/task_name"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>
    <com.transsion.widgetslib.view.OverBoundNestedScrollView
        android:id="@+id/menu_option_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/recent_press_task_scroll_menu_margin_top"
        android:layout_marginBottom="@dimen/recent_press_task_scroll_menu_margin_bottom">
        <LinearLayout
            android:id="@+id/menu_option_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/recent_task_menu_margin"
            android:layout_marginBottom="@dimen/recent_task_menu_margin"
            android:divider="@drawable/all_apps_divider"
            android:minWidth="@dimen/recent_task_menu_min_width"
            android:showDividers="beginning"
            android:paddingStart="@dimen/task_card_menu_horizontal_padding"
            android:paddingEnd="@dimen/task_card_menu_horizontal_padding"
            style="@style/TaskMenu"/>
    </com.transsion.widgetslib.view.OverBoundNestedScrollView>
</com.android.quickstep.src.com.android.quickstep.views.TaskMenuView>
