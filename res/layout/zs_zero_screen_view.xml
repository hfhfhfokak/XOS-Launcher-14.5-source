<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <FrameLayout
        android:id="@+id/fl_hint_temp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_hint_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/zs_sideslipe_hint"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <com.scene.zeroscreen.view.consecutivescroller.ZsSmartRefreshLayout
        android:id="@+id/smart_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/zs_main_status_bar_placeholder"
        app:srlDisableContentWhenRefresh="false"
        app:srlHeaderHeight="@dimen/dp_68">
        <com.scene.zeroscreen.view.consecutivescroller.StickyNavLayout
            android:id="@+id/sick_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.scene.zeroscreen.view.consecutivescroller.NestedScrollingChild2Rv
                android:id="@+id/nc_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.scene.zeroscreen.view.consecutivescroller.MaxHeightRecyclerView
                    android:id="@+id/zs_rv_main_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.scene.zeroscreen.view.consecutivescroller.NestedScrollingChild2Rv>
            <com.scene.zeroscreen.view.consecutivescroller.NestScrollingParent2
                android:id="@+id/np_in_iv"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="true">
                <View
                    android:id="@+id/placeholder_view"
                    android:background="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:alpha="0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/gradient_view"
                    android:background="@drawable/shape_view_mask"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:alpha="0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/placeholder_view"/>
                <View
                    android:id="@+id/space_margin"
                    android:background="@color/zs_news_bg_color"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:alpha="0"
                    app:layout_constraintBottom_toBottomOf="@+id/gradient_view"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_viewpager"
                    android:background="@drawable/zs_news_card_bg_first_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@+id/space_margin">
                    <com.scene.zeroscreen.view.consecutivescroller.FixedViewPager
                        android:id="@+id/feeds_viewpager"
                        android:descendantFocusability="afterDescendants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_feeds_next"
                    android:paddingTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/zs_ic_feeds_next"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/cl_viewpager"/>
            </com.scene.zeroscreen.view.consecutivescroller.NestScrollingParent2>
        </com.scene.zeroscreen.view.consecutivescroller.StickyNavLayout>
    </com.scene.zeroscreen.view.consecutivescroller.ZsSmartRefreshLayout>
    <RelativeLayout
        android:id="@+id/rl_news_guide"
        android:background="@drawable/news_top_guide_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/zeroscreen_guide">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_12"
            android:text="@string/new_content_below"
            android:layout_above="@+id/lottie_view"
            android:layout_centerHorizontal="true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_view"
            android:layout_width="@dimen/dp_84"
            android:layout_height="@dimen/dp_84"
            android:layout_marginBottom="@dimen/zs_dimen_52dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            app:lottie_autoPlay="false"
            app:lottie_fileName="news_guide.json"
            app:lottie_imageAssetsFolder="images/"
            app:lottie_loop="false"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/zs_main_status_bar_placeholder"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/zs_main_status_bar_placeholder_cover"
        android:background="@color/zs_feeds_color"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0"/>
    <FrameLayout
        android:id="@+id/fl_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/zs_main_status_bar_placeholder">
        <RelativeLayout
            android:id="@+id/rl_zs_news_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_54">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/os_text_primary_color"
                android:gravity="center_vertical"
                android:id="@+id/zs_news_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/sharpnews"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"/>
            <ImageView
                android:gravity="center_vertical"
                android:id="@+id/iv_zs_back_top"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/zs_feeds_quit_icon"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_zs_news_tab"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_54">
            <com.scene.zeroscreen.view.consecutivescroller.ZsTabLayout
                android:theme="@style/Launcher.AppTheme"
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_54"
                android:overScrollMode="never"
                android:layout_toStartOf="@+id/iv_zs_back_top_tab"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/transparent"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="@dimen/dp_200"
                app:tabMode="scrollable"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/os_text_primary_color"
                app:tabTextAppearance="@style/TabText"
                app:tabTextColor="@color/os_text_tertiary_color"/>
            <ImageView
                android:id="@+id/iv_tab_shape_start"
                android:background="@drawable/feeds_tab_gradient_start_shape"
                android:layout_width="@dimen/dp_16"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"/>
            <ImageView
                android:id="@+id/iv_tab_shape_end"
                android:background="@drawable/feeds_tab_gradient_end_shape"
                android:layout_width="@dimen/dp_30"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:gravity="center_vertical"
                android:id="@+id/iv_zs_back_top_tab"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/zs_feeds_quit_icon"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/rl_open_network"
        android:background="@color/zs_open_network_bg_90"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fl_title">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/tv_open_network"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_10"
            android:text="@string/open_network"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_16"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/no_network_settings"
            android:textAllCaps="true"
            android:drawableEnd="@drawable/ic_arrow"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dimen_16"
            android:layout_marginEnd="@dimen/dimen_16"/>
    </LinearLayout>
    <View
        android:id="@+id/x_ll_gs_navigation"
        android:background="@drawable/bg_x_search_navigation"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/zs_gs_navigation_height"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/x_news_action_ll"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_20"
        android:layout_above="@+id/x_ll_gs_navigation"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/x_gs_news_back"
            android:background="@drawable/fab_news_go_top"
            android:visibility="gone"
            android:layout_width="@dimen/zs_dimen_56dp"
            android:layout_height="@dimen/zs_dimen_56dp"
            android:contentDescription="@string/zeroscreen_action_top"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/fl_gs_news_refresh"
            android:background="@drawable/fab_news_refresh"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/x_gs_news_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/zs_ic_refresh"
                android:contentDescription="@string/zeroscreen_action_refresh"/>
        </FrameLayout>
    </LinearLayout>
    <com.scene.zeroscreen.firstLoadingAnim.ZsFirstLoadingView
        android:orientation="vertical"
        android:id="@+id/first_loading_root"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/zs_main_status_bar_placeholder"/>
</merge>
