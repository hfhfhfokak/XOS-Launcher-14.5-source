<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/wp_detail_preview_image_height">
                    <ImageView
                        android:id="@+id/preview_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ProgressBar
                        android:id="@+id/download_progress"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/wp_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/theme_common_screen_padding_with_item_padding"
                    android:paddingEnd="@dimen/theme_common_screen_padding_with_item_padding"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:background="@drawable/shape_walldetail_mask"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one_hundred_dp"/>
        <RelativeLayout
            android:id="@+id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/theme_title_bar_height"
            android:paddingStart="@dimen/four_dp"
            android:paddingEnd="@dimen/four_dp">
            <ImageView
                android:id="@+id/backIv"
                android:layout_width="@dimen/forty_eight_dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_theme_actionbar_back"
                android:scaleType="center"
                android:tint="@android:color/white"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/zoomIv"
                android:layout_width="@dimen/forty_eight_dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_wp_zoom_out"
                android:scaleType="center"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/theme_download_action"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sixty_eight_dp">
        <Button
            android:textSize="@dimen/fifteen_sp"
            android:textColor="@color/th_detail_btn_text_color"
            android:ellipsize="end"
            android:id="@+id/btn_download_wallpaper"
            android:background="@drawable/theme_download_btn_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_six_dp"
            android:layout_marginTop="@dimen/twelve_dp"
            android:text="@string/text_wallpaper_download"
            android:singleLine="true"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/wp_detail_activity_button_padding"
            android:layout_marginEnd="@dimen/wp_detail_activity_button_padding"
            style="?android:attr/borderlessButtonStyle"/>
    </RelativeLayout>
    <include layout="@layout/theme_button_gap_layout"/>
</LinearLayout>
