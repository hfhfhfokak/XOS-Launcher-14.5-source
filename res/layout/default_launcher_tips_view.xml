<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/default_launcher_tips_view_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/default_launcher_tips_view_padding"
    android:paddingEnd="@dimen/default_launcher_tips_view_padding">
    <TextView
        android:textSize="@dimen/default_launcher_tips_view_choose_text_size"
        android:textColor="@color/default_launcher_background_white"
        android:gravity="center_vertical"
        android:id="@+id/default_launcher_tips_view_choose"
        android:paddingTop="@dimen/default_launcher_tips_view_choose_padding_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/default_launcher_tips_chose"
        android:drawablePadding="@dimen/default_launcher_tips_view_choose_drawable_padding"
        app:drawableStartCompat="@drawable/default_launcher_tips_view_step_1"/>
    <ImageView
        android:id="@+id/default_launcher_tips_view_logo"
        android:paddingTop="@dimen/default_launcher_tips_view_logo_padding_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/default_launcher_app_icon"
        android:layout_marginStart="@dimen/default_launcher_tips_view_logo_margin_start"
        android:layout_toEndOf="@+id/default_launcher_tips_view_choose"/>
    <TextView
        android:textSize="@dimen/default_launcher_tips_view_name_text_size"
        android:textColor="@color/default_launcher_tips_view_name_color"
        android:gravity="center_vertical"
        android:id="@+id/default_launcher_tips_view_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/default_launcher_tips_view_choose_drawable_padding"
        android:layout_alignBottom="@+id/default_launcher_tips_view_choose"
        android:layout_marginStart="@dimen/default_launcher_tips_view_name_margin_start"
        android:layout_toEndOf="@+id/default_launcher_tips_view_logo"/>
    <TextView
        android:textSize="@dimen/default_launcher_tips_view_always_text_size"
        android:textColor="@color/default_launcher_tips_view_name_color"
        android:gravity="center_vertical"
        android:id="@+id/default_launcher_tips_view_always"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_launcher_tips_view_always_marigin_top"
        android:text="@string/default_launcher_tips_click_always"
        android:drawablePadding="@dimen/default_launcher_tips_view_choose_drawable_padding"
        android:layout_below="@+id/default_launcher_tips_view_choose"
        app:drawableStartCompat="@drawable/default_launcher_tips_view_step_2"/>
</RelativeLayout>
