<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/theme_title"
    android:layout_width="match_parent"
    android:layout_height="@dimen/theme_title_bar_height">
    <ImageView
        android:id="@+id/theme_title_left_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:contentDescription="@string/mine_botton_description"
        android:paddingStart="@dimen/theme_common_screen_padding"
        android:paddingEnd="@dimen/sixteen_dp"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/eighteen_dp"
        android:textColor="@color/th_title_text_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/theme_title_left_tv"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:lines="1"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="viewStart"
        android:layout_toStartOf="@+id/theme_title_right_tv"
        android:layout_toEndOf="@+id/theme_title_left_iv"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/fourteen_dp"
        android:textColor="@color/theme_title_btn_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/theme_title_right_tv"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/one_hundred_dp"
        android:lines="1"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/twelve_dp"
        android:layout_marginEnd="@dimen/twenty_four_dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
