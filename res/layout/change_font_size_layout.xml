<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/change_font_size_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <SeekBar
        android:id="@+id/change_font_size_progress"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:max="80"
        android:progressDrawable="@drawable/change_font_size_progress_bg"
        android:thumb="@drawable/change_font_size_seek_bar_thumb_shape"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toEndOf="@+id/large_size_dot_cl"
        app:layout_constraintStart_toStartOf="@+id/small_size_dot_cl"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img"/>
    <ImageView
        android:id="@+id/size_minus_img"
        android:layout_width="40dp"
        android:layout_height="59.34dp"
        android:src="@drawable/font_size_minus_icon"
        android:scaleType="center"
        android:paddingStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/small_size_dot_cl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/small_size_dot_cl"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toStartOf="@+id/small_big_line"
        app:layout_constraintStart_toEndOf="@+id/size_minus_img"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img">
        <ImageView
            android:id="@+id/small_size_dot"
            android:background="@drawable/change_font_size_dot_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/small_big_line"
        android:background="#c9c9c9"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toStartOf="@+id/medium_size_dot_cl"
        app:layout_constraintStart_toEndOf="@+id/small_size_dot_cl"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/medium_size_dot_cl"
        android:layout_width="10dp"
        android:layout_height="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toStartOf="@+id/medium_big_line"
        app:layout_constraintStart_toEndOf="@+id/small_big_line"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img">
        <ImageView
            android:id="@+id/medium_size_dot"
            android:background="@drawable/change_font_size_dot_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/medium_big_line"
        android:background="#c9c9c9"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toStartOf="@+id/normal_size_dot_cl"
        app:layout_constraintStart_toEndOf="@+id/medium_size_dot_cl"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#aaaaaa"
        android:id="@+id/normal_size_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:text="@string/normal_font_size_reminder"
        app:layout_constraintBottom_toTopOf="@+id/normal_size_dot_cl"
        app:layout_constraintEnd_toEndOf="@+id/normal_size_dot_cl"
        app:layout_constraintStart_toStartOf="@+id/normal_size_dot_cl"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/normal_size_dot_cl"
        android:layout_width="10dp"
        android:layout_height="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toStartOf="@+id/normal_big_line"
        app:layout_constraintStart_toEndOf="@+id/medium_big_line"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img">
        <ImageView
            android:id="@+id/normal_size_dot"
            android:background="@drawable/change_font_size_dot_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/normal_big_line"
        android:background="#c9c9c9"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toStartOf="@+id/big_size_dot_cl"
        app:layout_constraintStart_toEndOf="@+id/normal_size_dot_cl"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/big_size_dot_cl"
        android:layout_width="10dp"
        android:layout_height="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toStartOf="@+id/big_large_line"
        app:layout_constraintStart_toEndOf="@+id/normal_big_line"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img">
        <ImageView
            android:id="@+id/big_size_dot"
            android:background="@drawable/change_font_size_dot_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/big_large_line"
        android:background="#c9c9c9"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toStartOf="@+id/large_size_dot_cl"
        app:layout_constraintStart_toEndOf="@+id/big_size_dot_cl"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/large_size_dot_cl"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toStartOf="@+id/size_plus_img"
        app:layout_constraintStart_toEndOf="@+id/big_large_line"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img">
        <ImageView
            android:id="@+id/large_size_dot"
            android:background="@drawable/change_font_size_dot_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/size_plus_img"
        android:layout_width="40dp"
        android:layout_height="59.34dp"
        android:src="@drawable/font_size_plus_icon"
        android:scaleType="center"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/size_minus_img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/large_size_dot_cl"
        app:layout_constraintTop_toTopOf="@+id/size_minus_img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
