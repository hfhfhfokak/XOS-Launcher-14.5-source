<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/theme_common_item_half_padding"
    android:paddingEnd="@dimen/theme_common_item_half_padding">
    <com.transsion.theme.common.customview.RoundCornerImageView
        android:id="@+id/setting_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/local_theme_preview"
        app:roundCornerRadius="@dimen/theme_preview_corner_radius"/>
    <ImageView
        android:id="@+id/theme_type_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_diy_angle"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <CheckBox
        android:id="@+id/setting_choose"
        android:background="@android:color/transparent"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_alignTop="@+id/setting_image"
        android:layout_alignEnd="@+id/setting_image"/>
    <com.transsion.theme.common.customview.RoundCornerImageView
        android:id="@+id/setting_using"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_using"
        android:layout_alignRight="@+id/setting_image"
        android:layout_alignBottom="@+id/setting_image"
        app:riv_corner_radius_bottom_right="@dimen/theme_preview_corner_radius"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/twelve_sp"
        android:textColor="@color/th_local_theme_name_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/setting_name"
        android:paddingTop="@dimen/five_dp"
        android:paddingBottom="@dimen/fifteen_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_below="@+id/setting_image"
        android:fontFamily="sans-serif"
        android:textAlignment="viewStart"/>
</RelativeLayout>
