<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sdk_koluncard_title_area"
    android:layout_width="match_parent"
    android:layout_height="@dimen/sdk_koluncard_title_area_height"
    android:layout_marginBottom="@dimen/sdk_koluncard_title_area_margin_bottom"
    android:minHeight="@dimen/sdk_koluncard_title_area_height">
    <com.transsion.kolun.cardtemplate.customwidget.CustomCardImageView
        android:id="@+id/sdk_koluncard_title_icon"
        android:layout_width="@dimen/dp_18"
        android:layout_height="@dimen/dp_18"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_6"
        android:layout_alignParentStart="true"
        app:sdk_koluncard_corner_radius="@dimen/dp_4"/>
    <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
        android:id="@+id/sdk_koluncard_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/sdk_koluncard_title_menu_more"
        android:layout_toEndOf="@+id/sdk_koluncard_title_icon"
        android:elegantTextHeight="true"
        style="@style/SdkKolunCardCardTitleTextStyle"/>
    <ImageView
        android:id="@+id/sdk_koluncard_title_menu_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
