<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp12"
    android:layout_marginBottom="@dimen/dp40">
    <TextView
        android:textAppearance="@style/FgsManagerAppTitle"
        android:id="@+id/tv_fgs_manager_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp40"
        android:text="@string/fgs_manager_dialog_title"
        android:layout_marginStart="@dimen/dp20"
        android:layout_marginEnd="@dimen/dp20"/>
    <TextView
        android:textColor="@color/resident_detail_category_color"
        android:id="@+id/tv_fgs_manager_dialog_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fgs_manager_dialog_message"
        android:layout_marginStart="@dimen/dp20"
        android:layout_marginEnd="@dimen/dp20"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="3dp"
            android:scrollbarTrackVertical="@color/scrollbar_bg_color"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:id="@+id/rv_fgs_manager_dialog"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp24"
            android:fadeScrollbars="false"
            android:paddingEnd="@dimen/dp20"
            android:layout_marginStart="@dimen/dp20"/>
    </LinearLayout>
</LinearLayout>
