<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.popup.PopupWidgetContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popup_widget_view"
    android:background="@drawable/bg_white_round_rect"
    android:paddingBottom="@dimen/popup_widget_rect_radius"
    android:layout_width="match_parent"
    android:layout_height="@dimen/popup_container_widget_Height"
    android:minWidth="@dimen/popup_container_widget_width"
    android:elevation="@dimen/deep_shortcuts_elevation">
    <RelativeLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/notification_header_height"
            android:layout_marginTop="10dp"
            android:layoutDirection="ltr"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:elevation="@dimen/notification_elevation">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/popup_container_text_color"
                android:gravity="center_vertical"
                android:layout_gravity="start"
                android:id="@+id/widget_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Widget"/>
            <TextView
                android:textSize="@dimen/notification_header_text_size"
                android:textColor="@color/popup_container_text_color"
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:id="@+id/pinWidget_text"
                android:background="@drawable/ic_pin_add_widget"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:background="@drawable/popup_widget_snapshot_bg"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="42dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/widget_detail_preview"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/place_widget_guide"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/header"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_alignEnd="@+id/header"/>
    </RelativeLayout>
</com.transsion.xlauncher.popup.PopupWidgetContainer>
