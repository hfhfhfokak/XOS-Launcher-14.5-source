<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/reminder_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_no_network"/>
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="@dimen/fourteen_sp"
            android:textColor="@color/percentage_60_black"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"/>
    </LinearLayout>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/fifteen_sp"
        android:textColor="@color/refresh_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/btn_refresh"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/forty_two_dp"
        android:layout_marginTop="9.33dp"
        android:maxWidth="264dp"
        android:minWidth="160dp"
        android:text="@string/text_refresh"
        android:lines="1"
        android:layout_below="@+id/reminder_ll"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"/>
</RelativeLayout>
