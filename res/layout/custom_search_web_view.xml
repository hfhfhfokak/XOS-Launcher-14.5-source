<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/full_video"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include layout="@layout/include_web_error"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/rl_progressbar"
        android:layout_width="match_parent"
        android:layout_height="2dp">
        <View
            android:background="@drawable/custom_search_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:id="@+id/progressbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/CustomSearchProgressBar"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/custom_search_menu_size">
        <ImageView
            android:id="@+id/back"
            android:layout_width="@dimen/custom_search_menu_size"
            android:layout_height="@dimen/custom_search_menu_size"
            android:src="@drawable/ic_launcher_back"
            android:scaleType="center"
            android:layout_marginStart="@dimen/custom_search_menu_margin"
            android:stateListAnimator="@anim/overview_button_anim"/>
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="@dimen/custom_search_menu_size"
            android:layout_height="@dimen/custom_search_menu_size"
            android:src="@drawable/ic_refresh"
            android:scaleType="center"
            android:layout_marginEnd="@dimen/custom_search_refresh_margin_end"
            android:layout_alignParentEnd="true"
            android:stateListAnimator="@anim/overview_button_anim"/>
        <ImageView
            android:id="@+id/share"
            android:layout_width="@dimen/custom_search_menu_size"
            android:layout_height="@dimen/custom_search_menu_size"
            android:src="@drawable/ic_share"
            android:scaleType="center"
            android:layout_marginEnd="@dimen/custom_search_share_margin_end"
            android:layout_toStartOf="@+id/refresh"
            android:stateListAnimator="@anim/overview_button_anim"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/customsearch_webview_titleview_textcolor"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/custom_search_title_margin"
            android:layout_marginEnd="@dimen/custom_search_title_margin"
            android:layout_toStartOf="@+id/share"
            android:layout_toEndOf="@+id/back"/>
    </RelativeLayout>
</LinearLayout>
