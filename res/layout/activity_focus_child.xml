<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/logo_iv"
        android:layout_width="@dimen/seventy_two_dp"
        android:layout_height="@dimen/seventy_two_dp"
        android:layout_marginTop="208dp"
        android:scaleType="fitXY"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="34dp"
        android:textColor="@color/th_splash_app_name_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:text="@string/theme_app_name"
        android:fontFamily="sans-serif"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="14dp"
        android:textColor="@color/th_splash_summary_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="15dp"
        android:text="@string/launcher_info"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</LinearLayout>
