<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.widget.SearchWidgetView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/search_widget_height"
    android:contentDescription="@string/home_screen_search"
    app:swv_contentLongBitmap="@drawable/ic_google_icon_colorful"
    app:swv_contentMarginLeft="@dimen/search_widget_start_bitmap_margin_left"
