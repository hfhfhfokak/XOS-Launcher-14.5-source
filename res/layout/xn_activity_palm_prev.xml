<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/xn_palm_prev_background"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/os_text_primary_color"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/xn_app_name"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="27dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/btnClose"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/xn_palm_prev_close"
            android:scaleType="centerInside"
            android:layout_marginEnd="18dp"
            android:layout_alignParentEnd="true"/>
        <com.transsion.xuanniao.account.comm.widget.RoundImageView
            android:id="@+id/portrait"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/xn_palm_portrait_default"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textAppearance="@style/font_black_24_medium"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/nickName"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxLines="1"
            android:layout_below="@+id/portrait"
            android:layout_centerHorizontal="true"
            android:elegantTextHeight="true"/>
        <Button
            android:id="@+id/btnLoginNow"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="24dp"
            android:text="@string/xn_login"
            android:layout_below="@+id/nickName"
            android:layout_marginStart="72dp"
            android:layout_marginEnd="72dp"
            style="@style/OS.Widget.Button.Contained.Big.Single"/>
        <TextView
            android:textAppearance="@style/font_primary_12"
            android:id="@+id/tvSwitchAcc"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="@string/xn_switch_account"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:elegantTextHeight="true"/>
    </RelativeLayout>
</RelativeLayout>
