<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:view="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="start|center_vertical"
        android:id="@+id/search"
        android:background="@drawable/widget_main_search_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/widget_dialog_left_right_margin"
        android:layout_marginEnd="@dimen/widget_dialog_left_right_margin">
        <ImageView
            android:id="@+id/main_search_icon"
            android:layout_width="@dimen/widget_search_icon_size"
            android:layout_height="@dimen/widget_search_icon_size"
            android:src="@drawable/search_gray"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/widget_hint_text_color"
            android:gravity="center_vertical"
            android:id="@+id/main_search_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/search_widget"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/header_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/smart_scene"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">
                <com.transsion.xlauncher.base.SpringShapeableImageView
                    android:id="@+id/smart_scene_btn"
                    android:background="@drawable/bg_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:src="@drawable/pic_suggestions"
                    android:scaleType="center"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_color"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/smart_advice"
                    android:maxLines="2"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/system_tools"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">
                <com.transsion.xlauncher.base.SpringShapeableImageView
                    android:id="@+id/system_tools_btn"
                    android:background="@drawable/bg_systermtools"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:src="@drawable/pic_systermtools"
                    android:scaleType="center"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_color"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/system_tool"
                    android:maxLines="2"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/widget_gray_text_color"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:text="@string/all_widgets"
            android:layout_marginStart="24dp"/>
    </LinearLayout>
</LinearLayout>
