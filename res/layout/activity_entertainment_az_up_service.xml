<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsion.xlauncher.zeroscroll.AZUPNestedScrollView
        android:id="@+id/scoll_view_az"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_100">
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="top"
                android:id="@+id/rl_top"
                android:background="@color/transparent"
                android:paddingLeft="@dimen/zs_zero_16dp"
                android:paddingRight="@dimen/zs_zero_16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/rl_top_today_recommend"
                    android:background="@drawable/discover_az_up_iv_bg"
                    android:layout_width="@dimen/az_up_today_recommend_width"
                    android:layout_height="@dimen/az_up_today_recommend_height"/>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/rl_top_today_hot_rl"
                    android:visibility="gone"
                    android:layout_width="@dimen/az_up_rl_top_today_hot_bac_len"
                    android:layout_height="@dimen/az_up_rl_top_today_hot_bac_len"
                    android:layout_marginLeft="@dimen/zs_zero_9dp"
                    android:layout_toRightOf="@+id/rl_top_today_recommend"
                    android:layout_alignTop="@+id/rl_top_today_recommend"
                    android:layout_alignParentRight="true">
                    <ImageView
                        android:id="@+id/rl_top_today_hot"
                        android:background="@drawable/discover_az_up_hot_iv_bg"
                        android:layout_width="@dimen/az_up_rl_top_today_hot_len"
                        android:layout_height="@dimen/az_up_rl_top_today_hot_len"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <ImageView
                    android:id="@+id/rl_top_today_hot_iv_bak"
                    android:background="@drawable/discover_az_up_hot_iv_bg"
                    android:layout_width="@dimen/az_up_rl_top_today_hot_bac_len"
                    android:layout_height="@dimen/az_up_rl_top_today_hot_bac_len"
                    android:layout_marginLeft="@dimen/zs_zero_9dp"
                    android:src="@drawable/game_recommend_hot_back"
                    android:layout_toRightOf="@+id/rl_top_today_recommend"
                    android:layout_alignTop="@+id/rl_top_today_recommend"
                    android:layout_alignParentRight="true"/>
                <ImageView
                    android:id="@+id/rl_top_today_hot_back"
                    android:background="@drawable/discover_az_up_iv_bg"
                    android:layout_width="@dimen/az_up_rl_top_today_hot_bac_len"
                    android:layout_height="@dimen/az_up_rl_top_today_hot_bac_len"
                    android:layout_marginLeft="@dimen/zs_zero_9dp"
                    android:layout_toRightOf="@+id/rl_top_today_recommend"
                    android:layout_alignTop="@+id/rl_top_today_recommend"
                    android:layout_alignParentRight="true"/>
                <ImageView
                    android:id="@+id/rl_top_today_special"
                    android:background="@drawable/discover_az_up_iv_bg"
                    android:layout_width="@dimen/az_up_rl_top_today_hot_bac_len"
                    android:layout_height="@dimen/az_up_rl_top_today_hot_bac_len"
                    android:layout_marginLeft="@dimen/zs_zero_9dp"
                    android:layout_toRightOf="@+id/rl_top_today_recommend"
                    android:layout_alignRight="@+id/rl_top_today_hot_rl"
                    android:layout_alignBottom="@+id/rl_top_today_recommend"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/zs_zero_16sp"
                android:textStyle="bold"
                android:textColor="@color/os_btn_text_dark"
                android:id="@+id/tv_recommend_for_you"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/az_up_zero_az_up_recommend_for_you_margintop"
                android:text="@string/zero_az_up_recommend_for_you"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recomment_for_you"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_19"
                android:overScrollMode="never"/>
            <TextView
                android:textSize="@dimen/zs_zero_16sp"
                android:textStyle="bold"
                android:textColor="@color/os_btn_text_dark"
                android:id="@+id/tv_may_u_like_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_11"
                android:text="Recent played"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_may_you_like"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_7"
                android:overScrollMode="never"/>
        </LinearLayout>
    </com.transsion.xlauncher.zeroscroll.AZUPNestedScrollView>
    <RelativeLayout
        android:id="@+id/rl_touch"
        android:background="@drawable/discover_az_up_botton_up_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_touch_up"
            android:background="@drawable/myesc_ic_pull_up"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_marginBottom="@dimen/zs_zero_13dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
