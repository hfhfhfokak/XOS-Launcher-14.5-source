<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/follow_start_you_may_like_bg_color"
    android:paddingTop="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/custom_share_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="9"
        android:layout_alignParentTop="true">
        <RelativeLayout
            android:id="@+id/rv_whatsapp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2">
            <FrameLayout
                android:id="@+id/whatsapp_share_icon_fl"
                android:background="@drawable/share_icon_background"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/whatsapp_share_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/app_icon_whatsapp_24dp"/>
            </FrameLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/follow_init_title_color"
                android:id="@+id/whatsapp_share_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/whats_app"
                android:layout_below="@+id/whatsapp_share_icon_fl"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rv_facebook"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2">
            <FrameLayout
                android:id="@+id/facebook_share_icon_fl"
                android:background="@drawable/share_icon_background"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/facebook_share_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/app_icon_facebook_24dp"/>
            </FrameLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/follow_init_title_color"
                android:id="@+id/facebook_share_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/facebook"
                android:layout_below="@+id/facebook_share_icon_fl"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rv_twitter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2">
            <FrameLayout
                android:id="@+id/twitter_share_icon_fl"
                android:background="@drawable/share_icon_background"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/twitter_share_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/app_icon_twitter_24dp"/>
            </FrameLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/follow_init_title_color"
                android:id="@+id/twitter_share_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/twitter"
                android:layout_below="@+id/twitter_share_icon_fl"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:id="@+id/line0"
        android:background="@color/detail_related_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/custom_share_ll"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/system_share_list"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line0"/>
    <View
        android:id="@+id/line1"
        android:background="@color/detail_related_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/system_share_list"/>
    <TextView
        android:textColor="@color/follow_init_title_color"
        android:gravity="center"
        android:id="@+id/custom_share_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@android:string/cancel"
        android:layout_below="@+id/line1"
        style="@style/FontStyle.Regular.Bold"/>
</RelativeLayout>
