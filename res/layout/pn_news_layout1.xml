<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/zs_common_color4"
    android:paddingTop="@dimen/pn_dimen_10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/pn_dimen_16sp"
                android:textColor="@color/zs_setting_title_text_color"
                android:ellipsize="end"
                android:id="@+id/tv_news1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pn_dimen_24dp">
                <TextView
                    android:textSize="@dimen/pn_dimen_12sp"
                    android:textColor="@color/zs_text_alpha_60"
                    android:id="@+id/tv_news1_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/pn_dimen_80dp"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="@dimen/pn_dimen_12sp"
                    android:textColor="@color/zs_text_alpha_60"
                    android:id="@+id/tv_news1_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pn_dimen_10dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_eye"
                    android:layout_width="@dimen/pn_dimen_12dp"
                    android:layout_height="@dimen/pn_dimen_12dp"
                    android:src="@drawable/pn_eye_icon"
                    android:layout_marginStart="@dimen/pn_dimen_8dp"
                    android:layout_marginEnd="@dimen/pn_dimen_2dp"/>
                <TextView
                    android:textSize="@dimen/pn_dimen_12sp"
                    android:textColor="@color/zs_text_alpha_60"
                    android:id="@+id/tv_news1_view_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_news1"
            android:layout_width="106dp"
            android:layout_height="@dimen/pn_dimen_80dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/pn_dimen_24dp"/>
    </LinearLayout>
    <View
        android:background="@color/zs_divide_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/pn_dimen_8dp"/>
</LinearLayout>
