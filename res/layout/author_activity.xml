<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/zs_author_layer_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:background="@color/zs_author_layer_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="?attr/colorPrimary"
            app:scrimAnimationDuration="0">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/author_info_container"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/author_info_bg"
                    android:background="@drawable/personal_center_bg_icon"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/author_info_bg_shade"
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.scene.zeroscreen.view.pgc.PgcShapedImageView
                    android:layout_gravity="center"
                    android:id="@+id/author_image"
                    android:layout_width="@dimen/account_personal_center_head_size"
                    android:layout_height="@dimen/account_personal_center_head_size"
                    android:layout_marginTop="84dp"
                    android:src="@drawable/user_icon_default"
                    android:scaleType="fitXY"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/author_info_bg"
                    app:pgc_label_height="24dp"
                    app:pgc_label_padding="2dp"
                    app:pgc_label_width="24dp"
                    app:pgc_stroke_color="@color/white"
                    app:pgc_stroke_width="1dp"
                    app:shape_mode="circle"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/os_text_primary_color"
                    android:id="@+id/author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="44dp"
                    android:includeFontPadding="false"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/author_info_bg"
                    style="@style/FontStyle.Medium"/>
                <ImageView
                    android:id="@+id/pgc_label_iv"
                    android:visibility="invisible"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/icon_pgc_default_scooper"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/author_name"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#abaeb4"
                    android:id="@+id/pgc_label_tv"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verified account:Media"
                    android:layout_marginStart="30dp"
                    app:layout_constraintBottom_toBottomOf="@+id/pgc_label_iv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/pgc_label_iv"
                    style="@style/FontStyle"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/os_text_tertiary_color"
                    android:id="@+id/author_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/pgc_label_iv"/>
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/author_tag_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/author_desc"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/author_tag_container">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#5b6c7d"
                        android:id="@+id/follow_number_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/follow_number_text"
                        android:includeFontPadding="false"
                        android:layout_centerVertical="true"
                        style="@style/FontStyle.Regular.Bold"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#090d11"
                        android:id="@+id/follow_number"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="3dp"
                        android:layout_toEndOf="@+id/follow_number_text"
                        style="@style/FontStyle.Regular.Bold"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/follow_ways_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/base_title_bar_height"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                app:titleTextAppearance="@style/Toolbar.TitleText">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:id="@+id/status_bar"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/toolbar_custom_container"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/base_title_bar_height">
                        <ImageView
                            android:id="@+id/toolbar_back"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_back_white"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="20dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.scene.zeroscreen.view.pgc.PgcShapedImageView
                            android:id="@+id/toolbar_author_image"
                            android:visibility="gone"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:scaleType="fitXY"
                            android:layout_marginStart="20dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/toolbar_back"
                            app:layout_constraintTop_toTopOf="parent"
                            app:pgc_label_height="12dp"
                            app:pgc_label_width="12dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ffffffff"
                            android:ellipsize="end"
                            android:id="@+id/toolbar_author_name"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/toolbar_author_image"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/FontStyle.Medium"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/toolbar_follow_button_ll"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="20dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/toolbar_share"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/toolbar_share"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/common_share_ic_white"
                            android:layout_marginEnd="20dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <include
        android:id="@+id/author_feed_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        layout="@layout/author_feeds_layout"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
