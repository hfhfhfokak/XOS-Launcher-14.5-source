<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#fdfdfd"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/load_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="@dimen/load_error_img_width"
                android:layout_height="@dimen/load_error_img_height"
                android:src="@drawable/ic_img_none_wifi_hios_light"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="@color/os_text_tertiary_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_network"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:elegantTextHeight="true"/>
            <Button
                android:textSize="@dimen/sp_16"
                android:gravity="center"
                android:id="@+id/reload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/load_error_reload_margin_top"
                android:text="@string/reload"
                android:onClick="onReloadClick"
                style="@style/OS.Widget.Button.Text"/>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:minHeight="@dimen/dp_5"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"/>
</FrameLayout>
