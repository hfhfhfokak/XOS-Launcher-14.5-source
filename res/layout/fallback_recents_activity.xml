<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.LauncherRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.quickstep.src.com.android.quickstep.views.SplitPlaceholderView
        android:id="@+id/split_placeholder"
        android:background="@android:color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/split_placeholder_size"
        android:alpha="0.8"/>
    <com.android.quickstep.src.com.android.quickstep.fallback.RecentsDragLayer
        android:id="@+id/drag_layer"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/split_short_container"
            layout="@layout/split_shortcut_list"/>
        <com.android.launcher3.views.ScrimView
            android:id="@+id/scrim_view"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.android.quickstep.src.com.android.quickstep.fallback.FallbackRecentsView
            android:id="@+id/overview_panel"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:outlineProvider="none"/>
        <include
            android:id="@+id/recents_memory_container"
            layout="@layout/tran_clear_all"/>
        <include
            android:id="@+id/overview_actions_view"
            layout="@layout/overview_actions_container"/>
        <include
            android:id="@+id/recents_small_window_container"
            android:visibility="gone"
            layout="@layout/tran_small_window_folding"/>
        <include
            android:id="@+id/recents_fg_container"
            layout="@layout/tran_fgs"/>
    </com.android.quickstep.src.com.android.quickstep.fallback.RecentsDragLayer>
</com.android.launcher3.LauncherRootView>
