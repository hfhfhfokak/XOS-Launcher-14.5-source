<?xml version="1.0" encoding="utf-8"?>
<com.android.quickstep.src.com.android.quickstep.views.GroupedTaskView xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">
    <com.android.quickstep.src.com.android.quickstep.views.TaskThumbnailView
        android:id="@+id/snapshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.android.quickstep.src.com.android.quickstep.views.TaskThumbnailView
        android:id="@+id/bottomRight_snapshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:id="@+id/task_menu_layout"
        android:paddingBottom="@dimen/recent_task_title_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/task_arrow"
            android:background="@null"
            android:layout_width="@dimen/recent_task_thumbnail_icon_size"
            android:layout_height="@dimen/recent_task_thumbnail_icon_size"
            android:src="@drawable/recent_ic_task_menu_arrow"/>
        <TextView
            android:theme="@style/recent_WidgetContainerTheme"
            android:textSize="14sp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/task_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/recent_task_title_max_width_grouped"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:paddingStart="6dp"/>
        <com.android.quickstep.src.com.android.quickstep.views.IconView
            android:id="@+id/icon"
            android:focusable="false"
            android:layout_width="@dimen/recent_task_thumbnail_icon_size"
            android:layout_height="@dimen/recent_task_thumbnail_icon_size"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:orientation="horizontal"
        android:id="@+id/bottomRight_task_menu_layout"
        android:paddingBottom="@dimen/recent_task_title_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/bottomRight_task_arrow"
            android:background="@null"
            android:layout_width="@dimen/recent_task_thumbnail_icon_size"
            android:layout_height="@dimen/recent_task_thumbnail_icon_size"
            android:src="@drawable/recent_ic_task_menu_arrow"/>
        <TextView
            android:theme="@style/recent_WidgetContainerTheme"
            android:textSize="14sp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/bottomRight_task_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/recent_task_title_max_width_grouped"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:paddingStart="6dp"/>
        <com.android.quickstep.src.com.android.quickstep.views.IconView
            android:id="@+id/bottomRight_icon"
            android:focusable="false"
            android:layout_width="@dimen/recent_task_thumbnail_icon_size"
            android:layout_height="@dimen/recent_task_thumbnail_icon_size"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/task_icon_locker"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="@dimen/recent_task_icon_padding"
        android:src="@drawable/recent_ic_h_task_icon_locker"
        android:layout_marginStart="@dimen/recent_task_thumbnail_icon_size"
        android:layout_marginEnd="@dimen/recent_task_thumbnail_icon_size"/>
</com.android.quickstep.src.com.android.quickstep.views.GroupedTaskView>
