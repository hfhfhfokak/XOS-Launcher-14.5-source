<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.cloud.tmc.zxinglib.CenterCropSurfaceView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.cloud.tmc.zxinglib.ViewfinderView
        android:id="@+id/viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/view_mask"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/view_gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_gallery"
        app:layout_constraintEnd_toEndOf="@+id/iv_gallery_right"
        app:layout_constraintStart_toStartOf="@+id/iv_gallery_left"
        app:layout_constraintTop_toTopOf="@+id/tv_gallery"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_qrcode_x"
        android:layout_width="@dimen/mini_dp_24"
        android:layout_height="@dimen/mini_dp_24"
        android:layout_marginTop="@dimen/mini_dp_56"
        android:layout_marginStart="@dimen/mini_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/qr_scan_x"/>
    <TextView
        android:textSize="@dimen/mini_dp_18"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mini_dp_50"
        android:layout_marginRight="@dimen/mini_dp_50"
        android:text="@string/qr_title"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/mini_dp_50"
        app:layout_constraintBottom_toBottomOf="@+id/iv_qrcode_x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_qrcode_x"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_gallery_left"
        android:layout_width="@dimen/mini_dp_31_5"
        android:layout_height="@dimen/mini_dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/tv_gallery"
        app:layout_constraintEnd_toStartOf="@+id/tv_gallery"
        app:layout_constraintTop_toTopOf="@+id/tv_gallery"
        app:srcCompat="@drawable/qr_select_img"/>
    <TextView
        android:textSize="@dimen/mini_dp_16"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mini_dp_35"
        android:maxWidth="@dimen/mini_dp_184"
        android:text="@string/qr_upload_from_gallery"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_qr_light"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_qr_light,tv_qr_light_tips"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_qr_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mini_dp_121"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/sel_qr_light"/>
    <TextView
        android:textSize="@dimen/mini_dp_16"
        android:textColor="@color/white"
        android:id="@+id/tv_qr_light_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/qr_light_flash_on"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_qr_light"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_gallery,iv_gallery_left,iv_gallery_right,view_gallery"/>
    <TextView
        android:textSize="@dimen/mini_dp_16"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_scan_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mini_dp_16"
        android:layout_marginRight="@dimen/mini_dp_16"
        android:layout_marginBottom="@dimen/mini_dp_103"
        android:text="@string/qr_open_mini"
        android:layout_marginHorizontal="@dimen/mini_dp_16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_gallery"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_gallery_right"
        android:layout_width="@dimen/mini_dp_20"
        android:layout_height="@dimen/mini_dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_gallery"
        app:layout_constraintStart_toEndOf="@+id/tv_gallery"
        app:layout_constraintTop_toTopOf="@+id/tv_gallery"
        app:srcCompat="@drawable/qr_select_right"/>
</androidx.constraintlayout.widget.ConstraintLayout>
