<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/zs_app_row0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/row0_ll0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/zeroscreen_recent_app"
        android:paddingStart="@dimen/zs_dimen_4dp"
        android:paddingEnd="@dimen/zs_dimen_4dp">
        <ImageView
            android:id="@+id/row0_iv0"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/zs_sa_blank"
            android:scaleType="centerInside"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/row0_ad0"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_ad_hot_icon"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/row0_tv0"
            android:paddingTop="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_below="@+id/row0_iv0"
            android:paddingStart="@dimen/zs_recent_app_item_padding"
            android:paddingEnd="@dimen/zs_recent_app_item_padding"/>
    </RelativeLayout>
