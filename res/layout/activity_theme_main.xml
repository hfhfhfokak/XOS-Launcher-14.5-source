<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/main_content_fl"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:id="@+id/bottom_gap"
            android:layout_width="match_parent"
            android:layout_height="@dimen/theme_main_tab_height"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/main_rg"
        android:background="@drawable/theme_tab_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/theme_main_tab_height"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/theme_tab_padding"
        android:paddingEnd="@dimen/theme_tab_padding">
        <com.transsion.theme.common.customview.ThemeTabView
            android:id="@+id/menu_weekly"
            android:background="@drawable/os_press_primary_bg"
            android:contentDescription="@string/theme_main_weekly"
            app:th_tab_dr="@drawable/th_weekly_background"
            app:th_tab_name="@string/weekly_download_ranking"
            style="@style/RadioButton_Style"/>
        <com.transsion.theme.common.customview.ThemeTabView
            android:id="@+id/menu_wallpaper"
            android:background="@drawable/os_press_primary_bg"
            android:contentDescription="@string/theme_main_wp"
            android:paddingStart="@dimen/theme_tab_gap"
            app:th_tab_dr="@drawable/th_wallpaper_background"
            app:th_tab_name="@string/activity_tab_wallpaper"
            style="@style/RadioButton_Style"/>
        <com.transsion.theme.common.customview.ThemeTabView
            android:id="@+id/menu_theme"
            android:background="@drawable/os_press_primary_bg"
            android:contentDescription="@string/theme_main_theme"
            android:paddingStart="@dimen/theme_tab_gap"
            app:th_tab_dr="@drawable/th_theme_background"
            app:th_tab_name="@string/activity_tab_theme"
            style="@style/RadioButton_Style"/>
        <com.transsion.theme.common.customview.ThemeTabView
            android:id="@+id/menu_font"
            android:background="@drawable/os_press_primary_bg"
            android:contentDescription="@string/theme_main_font"
            android:paddingStart="@dimen/theme_tab_gap"
            app:th_tab_dr="@drawable/th_font_background"
            app:th_tab_name="@string/activity_tab_font"
            style="@style/RadioButton_Style"/>
        <com.transsion.theme.common.customview.ThemeTabView
            android:id="@+id/menu_discovery"
            android:background="@drawable/os_press_primary_bg"
            android:contentDescription="@string/theme_main_discovery"
            android:paddingStart="@dimen/theme_tab_gap"
            app:th_tab_dr="@drawable/th_discovery_background"
            app:th_tab_name="@string/activity_tab_discovery"
            style="@style/RadioButton_Style"/>
    </LinearLayout>
</RelativeLayout>
