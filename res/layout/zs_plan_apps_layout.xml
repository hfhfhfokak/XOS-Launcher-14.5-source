<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/zs_card_view_shape_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/blur_layer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/blur_target"
                android:paddingBottom="@dimen/zs_card_blur_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_one"
                    android:layout_width="@dimen/zs_dimen_44dp"
                    android:layout_height="@dimen/zs_dimen_44dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_two"
                    android:layout_width="@dimen/zs_dimen_44dp"
                    android:layout_height="@dimen/zs_dimen_44dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_three"
                    android:layout_width="@dimen/zs_dimen_44dp"
                    android:layout_height="@dimen/zs_dimen_44dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_four"
                    android:layout_width="@dimen/zs_dimen_44dp"
                    android:layout_height="@dimen/zs_dimen_44dp"
                    android:layout_weight="1"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.scene.zeroscreen.view.PlanItemView
                android:id="@+id/plan_item_one"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.scene.zeroscreen.view.PlanItemView
                android:id="@+id/plan_item_two"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.scene.zeroscreen.view.PlanItemView
                android:id="@+id/plan_item_three"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.scene.zeroscreen.view.PlanItemView
                android:id="@+id/plan_item_four"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
