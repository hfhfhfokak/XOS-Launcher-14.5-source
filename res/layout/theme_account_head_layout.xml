<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/user_info"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/one_hundred_and_eighty_dp">
    <com.transsion.theme.common.customview.RoundCornerImageView
        android:id="@+id/user_icon"
        android:background="@drawable/th_sidebar_account_bg"
        android:layout_width="@dimen/sixty_six_dp"
        android:layout_height="@dimen/sixty_six_dp"
        android:layout_marginTop="@dimen/forty_dp"
        android:layout_centerHorizontal="true"
        app:roundCornerRadius="@dimen/thirty_six_dp"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="16sp"
        android:textColor="@color/th_slider_account_info_color"
        android:ellipsize="end"
        android:id="@+id/account_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/twelve_dp"
        android:text="@string/text_log_in"
        android:singleLine="true"
        android:layout_below="@+id/user_icon"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif"
        android:layout_marginStart="@dimen/ten_dp"
        android:layout_marginEnd="@dimen/ten_dp"/>
</RelativeLayout>
