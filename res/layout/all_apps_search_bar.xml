<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/all_apps_search_bar_height"
    android:layoutDirection="locale">
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="@dimen/all_apps_search_bar_height"
        android:layout_centerInParent="true"
        android:layoutDirection="locale"
        android:layout_toStartOf="@+id/btn_set_v"
        android:layout_alignParentStart="true">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/search_btns"
            android:background="@drawable/all_apps_search_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/search_bar_margin_start"
            android:layout_marginEnd="@dimen/search_bar_margin_end">
            <com.android.launcher3.ExtendedEditText
                android:textSize="14sp"
                android:textColor="@color/all_apps_search_input_text_color"
                android:textColorHint="@color/all_apps_search_input_text_color_hint"
                android:gravity="center_vertical"
                android:id="@+id/search_box_input"
                android:background="@android:color/transparent"
                android:focusableInTouchMode="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/all_apps_search_bar_hint"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:maxLength="99"
                android:drawablePadding="10dp"
                android:layout_weight="1"
                android:inputType="textNoSuggestions"
                android:imeOptions="flagNoExtractUi|actionSearch"
                android:textCursorDrawable="@drawable/os_edit_text_cursor"
                android:drawableStart="@drawable/ic_app_search"
                android:fontFamily="sans-serif"
                android:paddingStart="10dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/del_btn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_search_delete"
                android:contentDescription="@string/desc_content_az_del_btn"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/all_apps_search_input_text_color"
            android:textColorHint="@color/all_apps_search_input_text_color_hint"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/search_btn_preview"
            android:background="@drawable/all_apps_search_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/all_apps_search_bar_hint"
            android:maxLines="1"
            android:singleLine="true"
            android:drawablePadding="10dp"
            android:layout_centerVertical="true"
            android:contentDescription="@string/desc_a_z_search_btn_preview"
            android:fontFamily="sans-serif"
            android:paddingStart="10dp"
            android:layout_marginStart="@dimen/search_bar_preview_margin_start"
            android:layout_marginEnd="@dimen/search_bar_preview_margin_end"
            app:drawableStartCompat="@drawable/ic_app_search"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/btn_set_v"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/search_bar_setting"
        android:scaleType="centerInside"
        android:layout_centerInParent="true"
        android:layout_marginEnd="22dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
