<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_width="@dimen/update_dialog_width"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/update_dialog_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/update_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/update_dialog_cover"
        android:layout_marginStart="@dimen/update_dialog_content_margin"
        android:layout_marginEnd="@dimen/update_dialog_content_margin">
        <TextView
            android:textSize="@dimen/update_dialog_title_size"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:id="@+id/update_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/update_dialog_title_max_width"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/update_dialog_version_size"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:id="@+id/update_dialog_version_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <com.transsion.xlauncher.library.springview.SpringRecyclerView
            android:scrollbarThumbVertical="@drawable/update_dialog_desc_scroll_bar"
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/update_dialog_desc_recycler_view"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="@dimen/update_dialog_desc_list_padding_start"
            android:paddingEnd="@dimen/update_dialog_desc_list_padding_end"
            android:layout_marginStart="@dimen/update_dialog_desc_list_margin_start"
            android:layout_marginEnd="@dimen/update_dialog_desc_list_margin_end"/>
        <Button
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/update_dialog_ok_btn"
            android:layout_width="@dimen/update_dialog_button_width"
            android:layout_height="@dimen/update_dialog_button_height"
            android:layout_marginTop="@dimen/update_dialog_button_margin_top"
            android:layout_marginBottom="@dimen/update_dialog_button_margin_bottom"
            android:text="@string/update_now"
            style="@style/OS.Widget.Button.Contained.Big.Single"/>
    </LinearLayout>
</RelativeLayout>
