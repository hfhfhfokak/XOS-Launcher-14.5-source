<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_tiktok"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/custom_play"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/mini_ic_video_center_play"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/custom_loading"
        android:visibility="gone"
        android:layout_width="@dimen/play_btn_size"
        android:layout_height="@dimen/play_btn_size"
        android:indeterminateDrawable="@drawable/mini_progress_loading"
        android:indeterminateDuration="2000"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="@drawable/mini_shape_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="bottom|right"
            android:layout_gravity="right"
            android:orientation="vertical"
            android:id="@+id/right_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="7dp">
            <ImageView
                android:id="@+id/avatar"
                android:background="@drawable/mini_backgroud_oval"
                android:padding="1dp"
                android:visibility="gone"
                android:layout_width="50dp"
                android:layout_height="50dp"/>
            <ImageView
                android:id="@+id/avatar_subscribe"
                android:padding="11dp"
                android:visibility="invisible"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="-24dp"
                android:src="@drawable/mini_author_unlike"/>
            <ImageView
                android:id="@+id/btn_like"
                android:layout_width="@dimen/controller_custom"
                android:layout_height="@dimen/controller_custom"
                android:layout_marginTop="6dp"
                android:src="@drawable/mini_ic_video_like_off"/>
            <TextView
                android:textSize="@dimen/controller_time_text_size"
                android:layout_gravity="center"
                android:id="@+id/btn_like_cnt"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-7dp"/>
            <ImageView
                android:id="@+id/btn_share"
                android:padding="7dp"
                android:layout_width="@dimen/controller_custom"
                android:layout_height="@dimen/controller_custom"
                android:layout_marginTop="13dp"
                android:src="@drawable/mini_ic_video_share"/>
            <ImageView
                android:id="@+id/btn_volume"
                android:padding="7dp"
                android:layout_width="@dimen/controller_custom"
                android:layout_height="@dimen/controller_custom"
                android:layout_marginTop="6dp"
                android:src="@drawable/mini_ic_volume_on"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/right_container_bottomView"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="25dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom|left"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp">
            <LinearLayout
                android:gravity="bottom|left"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="@dimen/controller_nick_text_size"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"/>
                <ImageView
                    android:id="@+id/author_vip"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/mini_author_v"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="64dp"
                android:layout_marginBottom="14dp"
                android:maxLines="2"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/time_progress"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <TextView
                    android:textSize="24sp"
                    android:textColor="#ffffffff"
                    android:gravity="center_horizontal"
                    android:id="@+id/time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="#80ffffff"
                    android:gravity="center_horizontal"
                    android:id="@+id/time_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.cloud.tmc.miniplayer.ui.component.TikTokSeekBar
                android:layout_gravity="bottom"
                android:id="@+id/bottom_progress"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginRight="12dp"
                android:max="1000"
                android:progressDrawable="@drawable/mini_seekbar_tiktok_progress_bar"
                android:minHeight="2dp"
                android:thumb="@null"
                android:thumbOffset="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:splitTrack="false"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/bottom_View"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="26dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
