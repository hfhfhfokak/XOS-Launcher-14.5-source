<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    android:elevation="@dimen/dp_10"
    app:cardBackgroundColor="@color/zs_popup_bg_color"
    app:cardCornerRadius="@dimen/dp_12"
    app:cardElevation="@dimen/dp_10"
    app:contentPadding="@dimen/dp_16">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/dp_160"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/pn_dimen_14sp"
            android:textColor="@color/zs_split_line_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/news_dialog_news_tv1"
            android:layout_width="160dp"
            android:layout_height="@dimen/zs_dimen_44dp"
            android:layout_marginTop="@dimen/dp_7"
            android:text="@string/zs_pin"
            android:maxLines="2"
            android:paddingStart="@dimen/dp_15"
            android:paddingEnd="@dimen/dp_15"/>
        <TextView
            android:textSize="@dimen/pn_dimen_14sp"
            android:textColor="@color/zs_split_line_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/news_dialog_news_tv2"
            android:visibility="gone"
            android:layout_width="160dp"
            android:layout_height="@dimen/zs_dimen_44dp"
            android:text="@string/zs_setting_title"
            android:maxLines="2"
            android:paddingStart="@dimen/dp_15"
            android:paddingEnd="@dimen/dp_15"/>
        <TextView
            android:textSize="@dimen/pn_dimen_14sp"
            android:textColor="@color/zs_split_line_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/news_dialog_news_tv3"
            android:layout_width="160dp"
            android:layout_height="@dimen/zs_dimen_44dp"
            android:layout_marginBottom="@dimen/dp_7"
            android:text="@string/zs_ignore"
            android:maxLines="2"
            android:paddingStart="@dimen/dp_15"
            android:paddingEnd="@dimen/dp_15"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
