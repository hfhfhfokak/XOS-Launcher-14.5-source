<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.defaultlauncher.widget.DLBackKeyListenerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/default_launcher_retain_view_height">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/default_launcher_retain_view_content_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_launcher_retain_view_content_height">
            <TextView
                android:textSize="@dimen/default_launcher_retain_view_later_text_size"
                android:textColor="@color/default_launcher_retain_view_later_text_color"
                android:ellipsize="end"
                android:id="@+id/default_launcher_retain_view_later"
                android:layout_width="@dimen/default_launcher_retain_view_later_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_launcher_retain_view_later_margin_top"
                android:text="@string/default_launcher_retain_later"
                android:singleLine="true"
                android:layout_marginStart="@dimen/default_launcher_retain_view_later_margin_start"/>
            <TextView
                android:textSize="@dimen/default_launcher_retain_view_slogen_text_size"
                android:textColor="@color/default_launcher_retain_view_slogen_text_color"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/default_launcher_retain_view_slogen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_launcher_retain_view_slogen_margin_top"
                android:text="@string/default_launcher_retain_slogen"
                android:layout_marginStart="@dimen/default_launcher_retain_view_slogen_margin_start"
                android:layout_marginEnd="@dimen/default_launcher_retain_view_slogen_margin_start"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/default_launcher_retain_view_layout_ok"
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_launcher_retain_view_layout_ok_height">
            <com.transsion.xlauncher.defaultlauncher.widget.RipperView
                android:background="@color/default_launcher_background_white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:rv_color="@color/os_color_accent"/>
            <TextView
                android:textSize="@dimen/default_launcher_retain_view_layout_ok_text_size"
                android:textColor="@color/os_color_accent"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@android:string/ok"/>
        </FrameLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/default_launcher_retain_view_logo"/>
</com.transsion.xlauncher.defaultlauncher.widget.DLBackKeyListenerView>
