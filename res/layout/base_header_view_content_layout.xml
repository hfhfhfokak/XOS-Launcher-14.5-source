<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/six_dp"
    android:clipChildren="@bool/clip_list_child"
    android:clipToPadding="@bool/clip_list_child"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/topic_viewpager"/>
    <LinearLayout
        android:id="@+id/base_bt_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sixteen_dp"
        android:layout_marginBottom="@dimen/twenty_dp"
        android:layout_marginStart="@dimen/topic_banner_icon_layout_padding"
        android:layout_marginEnd="@dimen/topic_banner_icon_layout_padding">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/base_ranking_bt"
            android:background="@drawable/os_press_primary_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/six_dp"
            android:paddingEnd="@dimen/six_dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_ranking"
                android:layout_width="@dimen/forty_two_dp"
                android:layout_height="@dimen/forty_two_dp"
                android:src="@drawable/ic_ranking"/>
            <com.transsion.theme.common.customview.ElegantTextView
                android:text="@string/theme_tab_ranking"
                style="@style/base_header_view_button_style"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/base_category_bt"
            android:background="@drawable/os_press_primary_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/six_dp"
            android:paddingEnd="@dimen/six_dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_category"
                android:layout_width="@dimen/forty_two_dp"
                android:layout_height="@dimen/forty_two_dp"
                android:src="@drawable/ic_category"/>
            <com.transsion.theme.common.customview.ElegantTextView
                android:text="@string/theme_tab_sort"
                style="@style/base_header_view_button_style"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/base_diy_bt"
            android:background="@drawable/os_press_primary_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/six_dp"
            android:paddingEnd="@dimen/six_dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_diy"
                android:layout_width="@dimen/forty_two_dp"
                android:layout_height="@dimen/forty_two_dp"
                android:src="@drawable/ic_main_diy"/>
            <com.transsion.theme.common.customview.ElegantTextView
                android:text="@string/diy_single_text"
                style="@style/base_header_view_button_style"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/base_local_bt"
            android:background="@drawable/os_press_primary_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/six_dp"
            android:paddingEnd="@dimen/six_dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_local"
                android:layout_width="@dimen/forty_two_dp"
                android:layout_height="@dimen/forty_two_dp"
                android:src="@drawable/ic_local"/>
            <com.transsion.theme.common.customview.ElegantTextView
                android:text="@string/local_src_text"
                style="@style/base_header_view_button_style"/>
        </LinearLayout>
    </LinearLayout>
</merge>
