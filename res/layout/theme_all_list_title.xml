<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/sixteen_sp"
        android:textColor="@color/th_res_name_color"
        android:id="@+id/theme_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/seven_dp"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/twelve_sp"
        android:textColor="@color/percentage_60_black"
        android:id="@+id/more_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_theme_description_display"
        android:drawablePadding="@dimen/five_dp"
        android:layout_centerVertical="true"
        android:drawableEnd="@drawable/ic_theme_arrow"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/five_dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
