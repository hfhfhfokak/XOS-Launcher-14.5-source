<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/pn_dimen_10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/pn_dimen_122dp">
        <TextView
            android:textSize="@dimen/pn_dimen_16sp"
            android:textColor="@color/pn_color3"
            android:id="@+id/pn_news_ad1_tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/pn_dimen_12sp"
            android:textColor="@color/pn_color4"
            android:ellipsize="end"
            android:id="@+id/pn_news_ad1_tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pn_dimen_1dp"
            android:maxLines="2"
            android:layout_below="@+id/pn_news_ad1_tv1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/pn_news_ad1_iv"
        android:layout_width="@dimen/pn_dimen_100dp"
        android:layout_height="@dimen/pn_dimen_60dp"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="@color/pn_detail_divider_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pn_dimen_1px"
        android:layout_marginTop="@dimen/pn_dimen_10dp"
        android:layout_below="@+id/pn_news_ad1_iv"/>
</RelativeLayout>
