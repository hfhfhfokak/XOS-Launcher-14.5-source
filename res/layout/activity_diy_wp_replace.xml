<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/theme_title_lr6_layout"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/theme_zip_wp_select_tab_padding"
                android:layout_marginEnd="@dimen/theme_zip_wp_select_tab_padding">
                <com.transsion.theme.common.customview.ElegantTextView
                    android:textSize="@dimen/sixteen_sp"
                    android:textColor="@color/main_tab_color"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/diy_wp_btn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/activity_tab_wallpaper"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:textAllCaps="false"/>
                <com.transsion.theme.common.customview.ElegantTextView
                    android:textSize="@dimen/sixteen_sp"
                    android:textColor="@color/main_tab_color"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/diy_lock_wp_btn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/lockscreen_text"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:textAllCaps="false"/>
            </LinearLayout>
            <com.transsion.theme.common.customview.RoundCornerImageView
                android:layout_gravity="center"
                android:id="@+id/diy_wp_replace_iv"
                android:layout_width="@dimen/one_hundred_and_eighty_dp"
                android:layout_height="@dimen/three_hundred_and_twenty_dp"
                android:layout_marginTop="@dimen/twelve_dp"
                android:scaleType="centerCrop"
                app:roundCornerRadius="@dimen/theme_preview_corner_radius"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/twelve_dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/diy_wp_replace_gallery_ll"
                    android:background="@drawable/diy_gallery_bg"
                    android:layout_width="@dimen/theme_zip_wp_select_item_size"
                    android:layout_height="@dimen/theme_zip_wp_select_item_size">
                    <ImageView
                        android:layout_width="@dimen/thirty_two_dp"
                        android:layout_height="@dimen/thirty_two_dp"
                        android:src="@drawable/ic_diy_wallpaper_gallery"/>
                    <com.transsion.theme.common.customview.ElegantTextView
                        android:textSize="@dimen/fourteen_sp"
                        android:textColor="@android:color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/two_dp"
                        android:text="@string/gallery_wallpaper"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/diy_wp_replace_online_ll"
                    android:background="@drawable/diy_online_wp_bg"
                    android:layout_width="@dimen/theme_zip_wp_select_item_size"
                    android:layout_height="@dimen/theme_zip_wp_select_item_size"
                    android:layout_marginStart="@dimen/theme_common_item_padding">
                    <ImageView
                        android:layout_width="@dimen/thirty_two_dp"
                        android:layout_height="@dimen/thirty_two_dp"
                        android:src="@drawable/ic_diy_wallpaper_online"/>
                    <com.transsion.theme.common.customview.ElegantTextView
                        android:textSize="@dimen/fourteen_sp"
                        android:textColor="@android:color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/two_dp"
                        android:text="@string/online_resource"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
