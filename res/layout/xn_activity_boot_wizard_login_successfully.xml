<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dimen_16"
    android:paddingEnd="@dimen/dimen_16">
    <ImageView
        android:id="@+id/questionIcon"
        android:layout_width="@dimen/dimen_24"
        android:layout_height="@dimen/dimen_24"
        android:layout_marginTop="@dimen/dimen_48"
        android:src="@drawable/xn_icon_question"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/loginLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/dimen_38"
        android:src="@mipmap/xn_launcher"
        android:layout_below="@+id/questionIcon"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="@style/font_black_24"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:text="@string/xn_app_name"
        android:layout_below="@+id/loginLogo"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="@style/font_black_14"
        android:id="@+id/subTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_below="@+id/title"/>
    <TextView
        android:textAppearance="@style/font_black_14_t65"
        android:id="@+id/note"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxHeight="@dimen/dimen_180"
        android:text="@string/xn_boot_success"
        android:layout_below="@+id/subTitle"/>
    <TextView
        android:textAppearance="@style/font_black_14_t65"
        android:id="@+id/tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:text="@string/xn_boot_success_tips"
        android:layout_below="@+id/note"/>
    <Button
        android:id="@+id/setCloudServices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_16"
        android:layout_marginTop="@dimen/dimen_24"
        android:layout_marginRight="@dimen/dimen_16"
        android:text="@string/xn_set_cloud_services"
        android:layout_below="@+id/tips"
        style="@style/OS.Widget.Button.Contained.Big.Single"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bootWizardL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16">
        <Button
            android:id="@+id/bootBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xn_back"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dimen_8"
            style="@style/OS.Widget.Button.Contained.Big.Single.Gray"/>
        <Button
            android:id="@+id/bootSkip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xn_next"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_8"
            style="@style/OS.Widget.Button.Contained.Big.Single"/>
    </LinearLayout>
</RelativeLayout>
