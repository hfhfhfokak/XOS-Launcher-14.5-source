<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/font_black_12_t65"
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/xn_safe_msg"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16"
        android:elegantTextHeight="true"/>
    <View
        android:id="@+id/line"
        android:background="@color/os_gray_tertiary_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_below="@+id/note"/>
    <TextView
        android:textAppearance="@style/font_primary_15"
        android:gravity="center"
        android:id="@+id/bindingPhone"
        android:background="@drawable/os_press_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_45"
        android:text="@string/xn_bind_phone"
        android:layout_below="@+id/line"
        android:paddingStart="@dimen/dimen_16"
        android:paddingEnd="@dimen/dimen_16"
        android:elegantTextHeight="true"/>
    <TextView
        android:textAppearance="@style/font_primary_15"
        android:gravity="center"
        android:id="@+id/bindingEmail"
        android:background="@drawable/os_press_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_45"
        android:text="@string/xn_bind_email"
        android:layout_below="@+id/bindingPhone"
        android:paddingStart="@dimen/dimen_16"
        android:paddingEnd="@dimen/dimen_16"
        android:elegantTextHeight="true"/>
    <TextView
        android:textAppearance="@style/font_primary_15"
        android:gravity="center"
        android:id="@+id/unboundNow"
        android:background="@drawable/os_press_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_45"
        android:text="@string/xn_unbound_now"
        android:layout_below="@+id/bindingEmail"
        android:paddingStart="@dimen/dimen_16"
        android:paddingEnd="@dimen/dimen_16"
        android:elegantTextHeight="true"/>
</RelativeLayout>
