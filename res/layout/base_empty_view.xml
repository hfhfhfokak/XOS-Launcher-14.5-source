<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/base_empty_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/network_unavailable"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/flash_add_more_note_text_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/base_empty_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="@string/flash_add_more_note_tip"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/flash_add_more_btn_border"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/base_empty_btn"
        android:background="@drawable/flash_add_more_btn_bg"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:layout_marginBottom="20dp"
        android:text="@string/flash_add_more_btn"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/flash_add_more_btn_border"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/network_setting_btn"
        android:background="@drawable/flash_add_more_btn_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:text="@string/network_setting_reminder"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
</LinearLayout>
