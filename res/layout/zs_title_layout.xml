<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <RelativeLayout
        android:id="@+id/rl_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/zs_title_top_height">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/iv_search"
            android:layout_width="@dimen/dp_48"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/iv_setting">
            <ImageView
                android:id="@+id/iv_search_icon"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_search_new"
                android:contentDescription="@string/zeroscreen_action_search"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/iv_setting"
            android:layout_width="@dimen/dp_48"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/iv_setting_icon"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_search_settings"
                android:layout_centerInParent="true"
                android:contentDescription="@string/zeroscreen_action_settings"/>
            <ImageView
                android:id="@+id/iv_setting_red_dot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/zs_ic_point_red"
                android:layout_alignTop="@+id/iv_setting_icon"
                android:layout_alignEnd="@+id/iv_setting_icon"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_scan"
            android:layout_width="@dimen/dp_24"
            android:layout_height="match_parent"
            android:src="@drawable/zs_ic_scan"
            android:contentDescription="@string/zeroscreen_action_scanning"
            android:layout_marginEnd="@dimen/dp_10"
            android:layout_toStartOf="@+id/iv_search"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_below="@+id/rl_top">
        <com.scene.zeroscreen.cards.WeatherCardView
            android:id="@+id/weather_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/title_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/zs_headline_soul1"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_20"/>
    </LinearLayout>
</RelativeLayout>
