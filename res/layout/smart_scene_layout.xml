<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/smart_scene_top_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/zs_smart_title_text_color"
            android:gravity="center_vertical"
            android:id="@+id/tv_recent_app"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/zs_scenes"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dimen_14"
            style="@style/ZsTitleTextShadowStyle"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/smart_scene_next"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/smart_scene_notify_1"
                android:visibility="gone"
                android:layout_width="@dimen/dimen_16"
                android:layout_height="@dimen/dimen_16"/>
            <ImageView
                android:id="@+id/smart_scene_notify_2"
                android:visibility="gone"
                android:layout_width="@dimen/dimen_16"
                android:layout_height="@dimen/dimen_16"
                android:layout_marginStart="@dimen/dp_4"/>
            <ImageView
                android:layout_width="@dimen/dimen_16"
                android:layout_height="@dimen/dimen_16"
                android:src="@drawable/ic_more"
                android:layout_marginStart="@dimen/dimen_5"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/smart_scene_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/smart_scene_default"
        android:background="@drawable/zs_card_view_shape_bg"
        android:paddingTop="@dimen/dimen_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_14"
        android:paddingEnd="@dimen/dimen_14">
        <TextView
            android:textSize="@dimen/zs_zero_14sp"
            android:textColor="@color/zs_text_black_60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scene_setting_enjoy_now"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/os_platform_basic_color_os"
            android:layout_gravity="end"
            android:id="@+id/smart_scene_go"
            android:background="@drawable/zs_selectable_item_with_bg_color"
            android:padding="@dimen/dimen_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10"
            android:layout_marginBottom="@dimen/dp_2"
            android:text="@string/scene_setting_to_enjoy"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
