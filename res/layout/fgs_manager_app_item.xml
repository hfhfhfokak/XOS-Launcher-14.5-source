<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="30dp">
    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/dp22"
        android:layout_height="@dimen/dp22"
        android:layout_marginEnd="@dimen/dp12"
        app:cardBackgroundColor="@color/transparent"
        app:cardCornerRadius="@dimen/dp6"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/fgs_manager_app_item_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingEnd="@dimen/dp12">
        <TextView
            android:textColor="@color/tr_resident_detail_tile_color"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/fgs_manager_app_item_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxEms="5"
            android:singleLine="true"
            style="@style/FgsManagerAppLabel"/>
        <TextView
            android:textColor="@color/resident_detail_category_color"
            android:gravity="start"
            android:id="@+id/fgs_manager_app_item_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/FgsManagerAppDuration"/>
    </LinearLayout>
    <Button
        android:textSize="@dimen/dp12"
        android:textColor="@color/os_platform_basic_color_selector"
        android:id="@+id/fgs_manager_app_item_stop_button"
        android:background="@drawable/os_btn_big_gray"
        android:layout_width="@dimen/dp70"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp28"
        android:text="@string/fgs_manager_app_item_stop_button_label"
        android:textAllCaps="false"
        style="?android:attr/buttonBarNeutralButtonStyle"/>
</LinearLayout>
