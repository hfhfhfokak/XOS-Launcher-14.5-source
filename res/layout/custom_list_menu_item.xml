<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/picture_menu_item_padding"
    android:paddingEnd="@dimen/picture_menu_item_padding">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/menu_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/picture_menu_text_size"
        android:textColor="@color/picture_menu_text_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/menu_text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/picture_menu_item_height"
        android:maxLines="1"
        android:layout_marginStart="@dimen/picture_menu_drawable_padding"/>
</LinearLayout>
