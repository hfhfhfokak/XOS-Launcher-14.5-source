<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.cloud.tmc.minicamera.CameraView
        android:id="@+id/camera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:cameraAudio="off"
        app:cameraAutoFocusMarker="@string/cameraview_default_autofocus_marker"
        app:cameraEngine="camera2"
        app:cameraExperimental="true"
        app:cameraFacing="back"
        app:cameraFlash="off"
        app:cameraGestureLongTap="none"
        app:cameraGesturePinch="zoom"
        app:cameraGestureScrollHorizontal="none"
        app:cameraGestureScrollVertical="none"
        app:cameraGestureTap="autoFocus"
        app:cameraGrid="off"
        app:cameraMode="picture"
        app:cameraPlaySounds="true"
        app:cameraPreview="glSurface"/>
    <View
        android:id="@+id/view_flash_bg"
        android:background="@drawable/shape_mini_camera_click_bg"
        android:clickable="true"
        android:layout_width="@dimen/mini_dp_36"
        android:layout_height="@dimen/mini_dp_36"
        android:layout_marginTop="@dimen/mini_dp_34"
        android:layout_marginEnd="@dimen/mini_dp_68"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_flash_btn"
        android:layout_width="@dimen/mini_dp_24"
        android:layout_height="@dimen/mini_dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/view_flash_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_flash_bg"
        app:layout_constraintStart_toStartOf="@+id/view_flash_bg"
        app:layout_constraintTop_toTopOf="@+id/view_flash_bg"
        app:srcCompat="@drawable/mini_sel_camera_flash"/>
    <View
        android:id="@+id/view_switch_bg"
        android:background="@drawable/shape_mini_camera_click_bg"
        android:clickable="true"
        android:layout_width="@dimen/mini_dp_36"
        android:layout_height="@dimen/mini_dp_36"
        android:layout_marginTop="@dimen/mini_dp_34"
        android:layout_marginEnd="@dimen/mini_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_camera_switch_btn"
        android:layout_width="@dimen/mini_dp_24"
        android:layout_height="@dimen/mini_dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/view_switch_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_switch_bg"
        app:layout_constraintStart_toStartOf="@+id/view_switch_bg"
        app:layout_constraintTop_toTopOf="@+id/view_switch_bg"
        app:srcCompat="@drawable/mini_camera_switch_icon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_take_photo_btn"
        android:layout_width="@dimen/mini_dp_78"
        android:layout_height="@dimen/mini_dp_78"
        android:layout_marginBottom="@dimen/mini_dp_46"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/mini_camera_sel_takephoto"/>
    <View
        android:id="@+id/view_camera_loading_bg"
        android:background="@color/mini_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_camera_x"
        android:layout_width="@dimen/mini_dp_24"
        android:layout_height="@dimen/mini_dp_24"
        android:layout_marginTop="@dimen/mini_dp_40"
        android:layout_marginStart="@dimen/mini_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/mini_ic_camera_x"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_camera_center_logo"
        android:layout_width="@dimen/mini_dp_64"
        android:layout_height="@dimen/mini_dp_64"
        app:layout_constraintBottom_toTopOf="@+id/tv_camera_center_loading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/mini_ic_camera_center_logo"/>
    <TextView
        android:textSize="@dimen/mini_sp_14"
        android:textColor="@color/mini_color_bg_01"
        android:id="@+id/tv_camera_center_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mini_dp_8"
        android:text="Preparing camera…"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_camera_center_logo"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_camera_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_camera_center_loading,iv_camera_center_logo,view_camera_loading_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
