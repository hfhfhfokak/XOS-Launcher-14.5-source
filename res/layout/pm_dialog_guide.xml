<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/rl_main_layout"
    android:background="#2d2bd1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/ll_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp">
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/pm_logo"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pm_app_name"
            android:layout_toRightOf="@+id/iv_logo"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"/>
        <ImageView
            android:id="@+id/iv_skip"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/pm_guide_close"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_main_pic"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/pm_img_boost_guide"
        android:layout_below="@+id/ll_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iv_main_pic">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_rmd_desc_a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="7dp"
            android:text="@string/pm_gp_guide_title"
            android:layout_below="@+id/iv_main_pic"
            android:fontFamily="Roboto Bold"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#b3ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_rmd_desc_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pm_gp_guide_des"
            android:fontFamily="Roboto Regular"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
    </LinearLayout>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btn_start"
        android:background="@drawable/pm_btn_guide_go_gp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:text="@string/pm_gp_guide_button"
        android:shadowColor="#ffd68700"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="3"
        android:layout_below="@+id/ll_info"
        android:textAllCaps="true"
        android:fontFamily="Roboto Bold"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
</RelativeLayout>
