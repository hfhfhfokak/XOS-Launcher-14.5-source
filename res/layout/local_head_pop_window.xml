<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/theme_popup_background"
    android:paddingTop="@dimen/eight_dp"
    android:paddingBottom="@dimen/eight_dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/sixteen_sp"
        android:textColor="@color/theme_popup_menu_text_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/select_all"
        android:background="@drawable/os_press_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/text_local_select_all"
        android:singleLine="true"
        android:fontFamily="sans-serif"
        android:textAlignment="viewStart"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/sixteen_sp"
        android:textColor="@color/theme_popup_menu_text_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/unselect_all"
        android:background="@drawable/os_press_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/text_local_unselect_all"
        android:singleLine="true"
        android:fontFamily="sans-serif"
        android:textAlignment="viewStart"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</LinearLayout>
