<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_privacy"
    android:background="@drawable/bg_gdpr_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="28dp">
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/cloud_dialog_desc_color"
        android:id="@+id/tv_privacy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_above="@+id/btn_agree"
        android:layout_alignParentTop="true"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/cloud_dialog_bg_color"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:background="@drawable/bg_cloud_folder_button_cancel"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        android:text="@string/text_cloud_dialog_cancel"
        android:layout_alignParentBottom="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_agree"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_privacy"/>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/file_folder_confirm"
        android:gravity="center"
        android:id="@+id/btn_agree"
        android:background="@drawable/os_btn_shape_primary_light_primary_selector"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        android:text="@string/text_cloud_dialog_agree"
        android:layout_above="@+id/btn_cancel"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_cancel"
        app:layout_constraintTop_toBottomOf="@+id/tv_privacy"/>
</androidx.constraintlayout.widget.ConstraintLayout>
