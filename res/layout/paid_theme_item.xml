<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/six_dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/six_dp">
    <com.transsion.theme.common.ThemeCoverView
        android:id="@+id/paid_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/local_theme_preview"
        app:isNeedText="false"
        app:radios="@dimen/theme_preview_corner_radius"/>
    <CheckBox
        android:id="@+id/paid_choose"
        android:background="@android:color/transparent"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_alignTop="@+id/paid_preview"
        android:layout_alignEnd="@+id/paid_preview"/>
    <com.transsion.theme.common.customview.RoundCornerImageView
        android:id="@+id/paid_using"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_using"
        android:layout_alignRight="@+id/paid_preview"
        android:layout_alignBottom="@+id/paid_preview"
        app:riv_corner_radius_bottom_right="@dimen/theme_preview_corner_radius"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/twelve_sp"
        android:textColor="@color/th_res_name_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/paid_name"
        android:paddingBottom="@dimen/four_dp"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:lines="1"
        android:layout_below="@+id/paid_preview"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/four_dp"
        android:layout_marginEnd="@dimen/four_dp"/>
</RelativeLayout>
