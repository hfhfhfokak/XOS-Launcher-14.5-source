<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_profile_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.cloud.tmc.miniapp.widget.NativeTitleBar
        android:id="@+id/layout_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_dp_56"
        app:bar_line="false"
        app:bar_title="@string/mini_create_profile"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_profile_img"
        android:layout_width="@dimen/mini_dp_80"
        android:layout_height="@dimen/mini_dp_80"
        android:layout_marginTop="@dimen/mini_dp_56"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_title"
        app:srcCompat="@drawable/mini_ic_head_default"/>
    <TextView
        android:textColor="@color/mini_color_login_main"
        android:layout_gravity="center"
        android:id="@+id/tv_change_profile_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mini_dp_8"
        android:text="@string/mini_change_profile_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_profile_img"/>
    <View
        android:id="@+id/view_username_bg"
        android:background="@drawable/login_sel_input_bg"
        android:layout_width="@dimen/mini_dp_312"
        android:layout_height="@dimen/mini_dp_48"
        android:layout_marginTop="@dimen/mini_dp_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_change_profile_img"/>
    <com.cloud.tmc.miniapp.widget.RegexEditText
        android:id="@+id/edit_username_input"
        android:hint="@string/mini_username_input_hint"
        android:layout_marginStart="@dimen/mini_dp_14"
        android:layout_marginEnd="@dimen/mini_dp_5"
        app:layout_constraintBottom_toBottomOf="@+id/view_username_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_input_clear"
        app:layout_constraintStart_toStartOf="@+id/view_username_bg"
        app:layout_constraintTop_toTopOf="@+id/view_username_bg"
        app:mini_regexType="name"
        style="@style/mini_username_input"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_input_clear"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/view_username_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_username_bg"
        app:layout_constraintTop_toTopOf="@+id/view_username_bg"
        style="@style/mini_style_input_clear"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:enabled="false"
        android:textSize="@dimen/mini_sp_18"
        android:textColor="@color/mini_color_bg_01"
        android:gravity="center"
        android:id="@+id/btn_save"
        android:background="@drawable/login_sel_save_btn_bg"
        android:layout_width="@dimen/mini_dp_312"
        android:layout_height="@dimen/mini_dp_48"
        android:layout_marginTop="@dimen/mini_dp_24"
        android:text="@string/mini_profile_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_username_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
