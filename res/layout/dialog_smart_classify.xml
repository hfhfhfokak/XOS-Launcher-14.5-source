<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsion.xlauncher.smartclassify.SmartClassifyArrowHolder
        android:id="@+id/dialog_smart_classify_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dimen_30dp"
        android:layout_marginEnd="@dimen/dimen_30dp"/>
    <TextView
        android:id="@+id/dialog_smart_classify_app"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_toStartOf="@+id/dialog_smart_classify_arrow"
        style="@style/Icon.SmartClassify"/>
    <TextView
        android:id="@+id/dialog_smart_classify_folder"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_toEndOf="@+id/dialog_smart_classify_arrow"
        style="@style/Icon.SmartClassify"/>
</RelativeLayout>
