<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/custom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ly_back"
            android:layout_width="match_parent"
            android:layout_height="@dimen/os_action_bar_height">
            <ImageView
                android:gravity="center"
                android:id="@+id/tv_back"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/os_ic_back"
                android:scaleType="centerInside"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <TextView
                android:ellipsize="end"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flashapp_appname"
                android:maxLines="1"
                style="@style/OSActionBarTitleCompat"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.transsion.flashapp.lobby.widget.slidetab.PagerSlidingTabStrip
            android:textSize="15sp"
            android:textColor="@color/fa_color_A6000000_B3DEDEDE"
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:pstsDividerColor="@android:color/transparent"
            app:pstsIndicatorColor="@color/color_317BDD"
            app:pstsIndicatorHeight="4dp"
            app:pstsScaleZoomMax="0.2"
            app:pstsShouldExpand="true"
            app:pstsTabPaddingLeftRight="12dp"
            app:pstsTextAllCaps="false"
            app:pstsTextSelectedColor="@color/os_platform_basic_color_os"
            app:pstsUnderlineColor="@color/preference_divider_color"/>
    </LinearLayout>
    <View
        android:background="@color/preference_divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.67dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <com.transsion.flashapp.lobby.widget.rtlviewpager.RtlViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
