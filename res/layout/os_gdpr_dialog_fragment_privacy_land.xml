<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/os_gdpr_dialog_background_land"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="3dp">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="@dimen/os_gdpr_dialog_title_size"
            android:textColor="@color/os_gdpr_text_primary_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/mtvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="29dp"
            android:maxLines="2"
            android:layout_alignParentLeft="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="29dp"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="@drawable/os_gdpr_scrollbar"
            android:scrollbarStyle="outsideInset"
            android:textSize="@dimen/os_gdpr_message_text_size"
            android:textColor="@color/os_gdpr_text_secondary_color"
            android:id="@+id/mWebview"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/os_gdpr_content_announce_margin"
            android:text="@string/os_gdpr_privacy_content"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:lineHeight="@dimen/os_gdpr_message_text_line_height"/>
        <TextView
            android:textSize="@dimen/os_gdpr_message_text_size"
            android:textColor="@color/os_gdpr_text_secondary_color"
            android:id="@+id/tv_announcement"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:lineHeight="@dimen/os_gdpr_message_text_line_height"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:id="@+id/ll_spilt_line"
            android:background="#26a1a1a1"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/rl_button"
        android:paddingLeft="@dimen/os_gdpr_btn_layout_padding_hor"
        android:paddingTop="@dimen/os_dimen_rl_button_padding_top"
        android:paddingRight="@dimen/os_gdpr_btn_layout_padding_hor"
        android:paddingBottom="@dimen/os_dimen_rl_button_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/os_gdpr_btn_layout_padding_hor">
        <Button
            android:id="@+id/mbtnCancel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:text="@string/os_gdpr_cancel_btn"
            android:layout_weight="1"
            style="@style/os_gdpr_cancel_btn_style"/>
        <View
            android:layout_width="10dp"
            android:layout_height="1dp"/>
        <Button
            android:id="@+id/mbtnOk"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:text="@string/os_gdpr_accept_btn"
            android:layout_weight="1"
            android:layout_alignParentEnd="true"
            style="@style/os_gdpr_positive_btn_style"/>
    </LinearLayout>
</LinearLayout>
