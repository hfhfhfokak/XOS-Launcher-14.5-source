<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/zs_card_title_color"
        android:ellipsize="end"
        android:id="@+id/ad_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pn_dimen_12dp"
        android:text="@string/zs_recommedation"
        android:lines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/pn_dimen_14dp"
        android:layout_marginEnd="@dimen/pn_dimen_14dp"/>
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pn_dimen_11dp"
        android:layout_marginStart="@dimen/pn_dimen_14dp"
        android:layout_marginEnd="@dimen/pn_dimen_14dp"
        app:cardCornerRadius="@dimen/dp_10"
        app:cardElevation="@dimen/dp_0">
        <ImageView
            android:id="@+id/ad_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_127"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_9"
        android:layout_marginBottom="@dimen/dp_14"
        android:layout_marginStart="@dimen/pn_dimen_13dp"
        android:layout_marginEnd="@dimen/pn_dimen_13dp">
        <TextView
            android:textSize="15sp"
            android:textColor="#66000000"
            android:ellipsize="end"
            android:id="@+id/ad_name"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zs_recommedation"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
