<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/news_list_divider_fat"
        android:background="@color/list_item_divider_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_item_divider"/>
    <View
        android:id="@+id/news_list_divider_thin"
        android:background="@color/list_item_divider_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="@dimen/news_list_item_margin"
        android:layout_marginEnd="@dimen/news_list_item_margin"/>
</LinearLayout>
