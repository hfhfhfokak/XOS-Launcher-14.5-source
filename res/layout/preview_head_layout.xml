<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/header_height">
    <include layout="@layout/theme_title_lr6_layout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fifty_six_dp"
        android:layout_marginStart="@dimen/theme_icon_diy_tab_padding"
        android:layout_marginEnd="@dimen/theme_icon_diy_tab_padding">
        <com.transsion.theme.common.customview.ElegantTextView
            android:id="@+id/tab_tv_1"
            android:text="@string/lock_screen_tab"
            style="@style/EasyDiyTabTextStyle"/>
        <com.transsion.theme.common.customview.ElegantTextView
            android:id="@+id/tab_tv_2"
            android:text="@string/wallpaper_tab"
            style="@style/EasyDiyTabTextStyle"/>
        <com.transsion.theme.common.customview.ElegantTextView
            android:id="@+id/tab_tv_3"
            android:text="@string/icon_tab"
            style="@style/EasyDiyTabTextStyle"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="@dimen/one_hundred_and_eighty_dp"
        android:layout_height="@dimen/easy_diy_preview_height"
        android:layout_marginTop="@dimen/eight_dp">
        <com.transsion.theme.common.customview.RoundCornerImageView
            android:layout_gravity="center"
            android:id="@+id/preview_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:roundCornerRadius="@dimen/theme_preview_corner_radius"/>
        <FrameLayout
            android:id="@+id/progress_view"
            android:background="@color/percentage_50_gray"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.spinkit.SpinKitView
                android:layout_gravity="center"
                android:layout_width="@dimen/forty_eight_dp"
                android:layout_height="@dimen/forty_eight_dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/progress_view_lock"
            android:background="@drawable/lock_preview_loading_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.spinkit.SpinKitView
                android:layout_gravity="center"
                android:layout_width="@dimen/forty_eight_dp"
                android:layout_height="@dimen/forty_eight_dp"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
