<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="#f7f7f7"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_toolbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dimen_16"
                android:layout_marginRight="@dimen/dp_16">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/os_list_item_view_bg_corners"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_60"
                    android:paddingStart="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_16">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_centerVertical="true">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:id="@+id/temp_hide"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/taskbar_temp_hide_title"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#66000000"
                            android:id="@+id/temp_hide_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/taskbar_temp_hide_title_hint"/>
                    </LinearLayout>
                    <Switch
                        android:gravity="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/taskbar_temp_hide_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        style="@style/OS.Widget.Switch"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_bottom"
                android:background="@drawable/taskbar_settings_main_bg"
                android:paddingLeft="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="10dp"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginBottom="20dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="279dp">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/large_lt_gift"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:layout_centerInParent="true"
                        android:layout_centerHorizontal="true"
                        app:lottie_autoPlay="true"
                        app:lottie_fileName="setting_guide/guide_hide/data.json"
                        app:lottie_imageAssetsFolder="setting_guide/guide_hide/images/"
                        app:lottie_loop="true"
                        app:lottie_repeatMode="restart"/>
                </RelativeLayout>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/guide_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/taskbar_guide_title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99000000"
                    android:id="@+id/guide_title2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/taskbar_guide_title1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99000000"
                    android:id="@+id/guide_title3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="@dimen/dimen_16"
                    android:text="@string/taskbar_guide_title2"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
