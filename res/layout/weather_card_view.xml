<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/rl_weather_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="27dp"
            android:textColor="@color/white"
            android:gravity="bottom"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="01/01"
            android:fontFamily="sans-serif"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/zs_view_weather_line"
            android:background="@color/title_weather_line_color_light"
            android:layout_width="1dp"
            android:layout_height="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_11"
            android:layout_marginStart="@dimen/dp_16"/>
        <ImageView
            android:layout_gravity="bottom"
            android:id="@+id/iv_current_weather"
            android:background="@drawable/ic_wth_unkonw_light"
            android:layout_width="@dimen/dp_21"
            android:layout_height="@dimen/dp_21"
            android:layout_marginBottom="@dimen/dimen_6"
            android:layout_marginStart="17.6dp"/>
        <TextView
            android:textSize="28dp"
            android:textColor="@color/white"
            android:gravity="bottom"
            android:id="@+id/tv_weather"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/zs_weather_default"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dp_6"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_21">
        <ImageView
            android:id="@+id/iv_location"
            android:background="@drawable/zs_ic_weather_location"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_10"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/title_weather_line_color_light"
            android:id="@+id/tv_current_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dp_5"/>
    </LinearLayout>
</LinearLayout>
