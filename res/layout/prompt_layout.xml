<?xml version="1.0" encoding="utf-8"?>
<com.transsion.launcher.PromptWrapper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/prompt_bg"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    launcher:layout_ignoreInsets="true">
    <include layout="@layout/include_prompt_app_locate"/>
    <include layout="@layout/include_prompt_a_to_z"/>
    <include layout="@layout/include_prompt_enter_hide_apps"/>
    <com.transsion.launcher.PromptLinearLayout
        android:id="@+id/freezer_layout"
        android:paddingLeft="@dimen/prompt_text_padding_left_or_right"
        android:paddingTop="@dimen/prompt_text_padding_top"
        android:paddingRight="@dimen/prompt_text_padding_left_or_right"
        android:paddingBottom="@dimen/prompt_text_padding_bottom"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/prompt_text_size"
            android:textColor="@color/prompt_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/prompt_text_max_width"
            android:text="@string/hide_prompt"
            android:layout_centerVertical="true"/>
    </com.transsion.launcher.PromptLinearLayout>
    <com.transsion.launcher.PromptLinearLayout
        android:layout_gravity="bottom|right"
        android:id="@+id/prompt_menu_layout"
        android:paddingLeft="@dimen/prompt_text_padding_left_or_right"
        android:paddingTop="@dimen/prompt_text_padding_top"
        android:paddingRight="@dimen/prompt_text_padding_left_or_right"
        android:paddingBottom="@dimen/prompt_text_padding_bottom"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/prompt_margin_left_or_right">
        <TextView
            android:textSize="@dimen/prompt_text_size"
            android:textColor="@color/prompt_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/prompt_text_max_width"
            android:text="@string/menu_text_prompt"
            android:layout_centerVertical="true"/>
    </com.transsion.launcher.PromptLinearLayout>
    <com.transsion.launcher.PromptLinearLayout
        android:layout_gravity="top|right"
        android:id="@+id/prompt_sort_layout"
        android:paddingLeft="@dimen/prompt_text_padding_left_or_right"
        android:paddingTop="@dimen/prompt_text_padding_top"
        android:paddingRight="@dimen/prompt_text_padding_left_or_right"
        android:paddingBottom="@dimen/prompt_text_padding_bottom"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/prompt_margin_left_or_right">
        <TextView
            android:textSize="@dimen/prompt_text_size"
            android:textColor="@color/prompt_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/prompt_text_max_width"
            android:text="@string/sort_text_prompt"
            android:layout_centerVertical="true"/>
    </com.transsion.launcher.PromptLinearLayout>
    <com.transsion.launcher.PromptLinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/prompt_restore_apps_layout"
        android:paddingLeft="@dimen/prompt_text_padding_left_or_right"
        android:paddingTop="@dimen/prompt_text_padding_top"
        android:paddingRight="@dimen/prompt_text_padding_left_or_right"
        android:paddingBottom="@dimen/prompt_text_padding_bottom"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/prompt_text_size"
            android:textColor="@color/prompt_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/prompt_text_max_width"
            android:text="@string/restore_apps_text_prompt"
            android:layout_centerVertical="true"/>
    </com.transsion.launcher.PromptLinearLayout>
    <com.transsion.launcher.PromptLinearLayout
        android:orientation="vertical"
        android:id="@+id/prompt_freezer_click_layout"
        android:paddingTop="@dimen/prompt_text_padding_top"
        android:paddingBottom="@dimen/prompt_text_padding_bottom"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layoutDirection="locale"
        android:paddingStart="@dimen/prompt_text_padding_left_or_right"
        android:paddingEnd="@dimen/prompt_text_padding_left_or_right"
        android:layout_marginStart="@dimen/prompt_margin_left_or_right">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="locale">
            <TextView
                android:textSize="@dimen/prompt_text_size_start"
                android:textColor="@color/prompt_text_color"
                android:layout_gravity="top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/prompt_text_start_margin_top"
                android:text="@string/freezer_click_text_prompt_line_start"
                android:layout_marginStart="0dp"/>
            <TextView
                android:textSize="@dimen/prompt_text_size"
                android:textColor="@color/prompt_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/prompt_text_max_width"
                android:text="@string/freezer_click_text_prompt_line_one"
                android:layout_marginStart="@dimen/prompt_freezer_click_text_margin_point"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="locale">
            <TextView
                android:textSize="@dimen/prompt_text_size_start"
                android:textColor="@color/prompt_text_color"
                android:layout_gravity="top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/prompt_text_start_margin_top"
                android:text="@string/freezer_click_text_prompt_line_start"
                android:layout_marginStart="0dp"/>
            <TextView
                android:textSize="@dimen/prompt_text_size"
                android:textColor="@color/prompt_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/prompt_text_max_width"
                android:text="@string/freezer_click_text_prompt_line_two"
                android:layout_marginStart="@dimen/prompt_freezer_click_text_margin_point"/>
        </LinearLayout>
    </com.transsion.launcher.PromptLinearLayout>
</com.transsion.launcher.PromptWrapper>
