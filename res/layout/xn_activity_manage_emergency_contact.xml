<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/xn_full_margin_start"
    android:layout_marginEnd="@dimen/xn_full_margin_end">
    <View
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <Button
        android:textSize="16sp"
        android:id="@+id/bindBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/xn_add_to_account"
        android:layout_above="@+id/placeholder"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="72dp"
        style="@style/OS.Widget.Button.Contained.Big.Single"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="12dp"
        android:layout_above="@+id/bindBtn">
        <com.transsion.widgetslib.view.OverBoundNestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end">
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/addLabel"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_24"
                    android:text="@string/xn_add_label"
                    android:elegantTextHeight="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/nameL"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_12"
                    android:layout_below="@+id/addLabel">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/nameLogo"
                        android:visibility="gone"
                        android:layout_width="@dimen/dimen_32"
                        android:layout_height="@dimen/dimen_32"
                        android:src="@drawable/xn_emergency_contact"
                        android:tint="@color/xn_logo_toggle_color"/>
                    <TextView
                        android:textAppearance="@style/font_black_18_medium"
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elegantTextHeight="true"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/phoneL"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_12"
                    android:layout_below="@+id/nameL">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/phoneLogo"
                        android:layout_width="@dimen/dimen_24"
                        android:layout_height="@dimen/dimen_24"
                        android:src="@drawable/xn_phone"
                        android:tint="@color/xn_primary_logo_color"/>
                    <TextView
                        android:textAppearance="@style/font_black_15_t65"
                        android:id="@+id/phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_12"
                        android:elegantTextHeight="true"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/emailL"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_12"
                    android:layout_below="@+id/phoneL">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/emailLogo"
                        android:layout_width="@dimen/dimen_24"
                        android:layout_height="@dimen/dimen_24"
                        android:src="@drawable/xn_icon_email"
                        android:tint="@color/xn_primary_logo_color"/>
                    <TextView
                        android:textAppearance="@style/font_black_15_t65"
                        android:id="@+id/email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_12"
                        android:elegantTextHeight="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/attentionL"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_24"
                    android:layout_below="@+id/emailL">
                    <View
                        android:background="@color/os_gray_quaternary_color"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_12">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/dimen_15"
                            android:layout_height="@dimen/dimen_15"
                            android:src="@drawable/xn_icon_attention"
                            android:layout_marginStart="@dimen/dimen_3"/>
                        <TextView
                            android:textAppearance="@style/font_black_14_t40"
                            android:id="@+id/title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/xn_bind_contact_tips"
                            android:layout_marginStart="@dimen/dimen_10"
                            android:elegantTextHeight="true"/>
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/emptyL"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:id="@+id/emptyLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/xn_emergency_contact_empty"
                        android:layout_centerHorizontal="true"/>
                    <TextView
                        android:textAppearance="@style/font_black_15_t40"
                        android:gravity="center"
                        android:id="@+id/unboundTips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xn_unbind_contact_tips"
                        android:layout_below="@+id/emptyLogo"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:elegantTextHeight="true"/>
                </RelativeLayout>
            </RelativeLayout>
        </com.transsion.widgetslib.view.OverBoundNestedScrollView>
    </RelativeLayout>
</RelativeLayout>
