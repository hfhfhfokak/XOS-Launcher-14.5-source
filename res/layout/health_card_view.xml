<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/zs_card_view_shape_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/zs_card_padding_start_end"
    android:paddingEnd="@dimen/zs_card_padding_start_end">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/health_card_goal_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_alignBottom="@+id/health_card_steps"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/zs_step_goal_text_color_day_night"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zs_goal"
            android:fontFamily="Roboto Regular"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/zs_step_num_color_day_night"
            android:gravity="center"
            android:id="@+id/health_card_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="Roboto Regular"
            android:layout_marginStart="3dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp_10"
        android:textColor="@color/zs_step_bt_text_color_day_night"
        android:gravity="center"
        android:id="@+id/bt_set_goal"
        android:background="@drawable/zs_card_bt_round_selector"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:minWidth="85dp"
        android:text="@string/zs_card_step_setgoal"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@color/zs_step_num_color_day_night"
        android:gravity="center_vertical"
        android:id="@+id/health_card_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_centerVertical="true"
        android:fontFamily="Roboto Regular"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="6dp"
        android:layout_toStartOf="@+id/health_card_goal_text"
        android:layout_toEndOf="@+id/progressbar_health"/>
    <com.scene.zeroscreen.view.HealthProgressView
        android:id="@+id/progressbar_health"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
