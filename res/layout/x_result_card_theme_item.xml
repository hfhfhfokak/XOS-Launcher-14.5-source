<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/x_search_theme_item_container"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/search_result_theme"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsion.theme.common.customview.RoundCornerImageView
                android:id="@+id/x_search_theme_item_preview"
                android:layout_width="74dp"
                android:layout_height="131dp"
                android:scaleType="center"
                app:roundCornerRadius="@dimen/theme_preview_corner_radius"/>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/search_result_item_big_title_color"
                    android:id="@+id/x_search_theme_item_name"
                    android:singleLine="true"
                    android:layout_marginEnd="4dp"
                    style="@style/search_theme_tv_style"/>
                <TextView
                    android:id="@+id/x_search_theme_item_desc"
                    android:layout_marginTop="10dp"
                    android:maxLines="2"
                    android:layout_below="@+id/x_search_theme_item_name"
                    android:textAlignment="viewStart"
                    android:layout_marginEnd="4dp"
                    style="@style/search_theme_info_style"/>
                <TextView
                    android:id="@+id/x_search_theme_item_dlnumber"
                    android:layout_marginTop="26dp"
                    android:singleLine="true"
                    android:drawablePadding="4dp"
                    android:layout_below="@+id/x_search_theme_item_desc"
                    app:drawableStartCompat="@drawable/ic_search_theme_dlnumber"
                    style="@style/search_theme_info_style"/>
                <TextView
                    android:id="@+id/x_search_theme_item_author"
                    android:layout_marginTop="26dp"
                    android:singleLine="true"
                    android:drawablePadding="4dp"
                    android:layout_below="@+id/x_search_theme_item_desc"
                    android:layout_alignBottom="@+id/x_search_theme_item_dlnumber"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="4dp"
                    android:layout_toEndOf="@+id/x_search_theme_item_dlnumber"
                    app:drawableStartCompat="@drawable/ic_search_theme_author"
                    style="@style/search_theme_info_style"/>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/x_search_theme_item_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:background="#33a1a1a1"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/theme_more_color_selector"
            android:gravity="center"
            android:id="@+id/x_search_theme_item_more"
            android:layout_width="match_parent"
            android:layout_height="47.67dp"
            android:text="@string/search_more_theme"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
</FrameLayout>
