<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/x_ll_gs_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_interaction_view_top_height"
        android:layout_marginBottom="@dimen/search_item_top_bottom_margin"
        android:layout_marginStart="@dimen/search_interaction_view_top_start"
        android:layout_marginEnd="@dimen/search_interaction_view_top_start">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/x_search_bar_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/x_search_net"
                android:layout_width="@dimen/search_keyword_net_width_height"
                android:layout_height="@dimen/search_keyword_net_width_height"
                android:src="@drawable/x_search_net"
                android:layout_marginStart="8dp"/>
            <com.transsion.xlauncher.search.view.SaEditText
                android:textSize="14sp"
                android:textColor="@color/customer_search_search_bar_textcolor"
                android:textColorHint="@color/customer_search_search_bar_hinttextcolor"
                android:id="@+id/et_search"
                android:background="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/abandoned_search"
                android:maxLength="99"
                android:layout_weight="1"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionSearch"
                android:contentDescription="@string/custom_search_sa_edit"
                android:textCursorDrawable="@drawable/os_edit_text_cursor"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                style="@style/TextAppearance_Roboto_Content"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/x_iv_gs_clear"
                android:visibility="gone"
                android:layout_width="@dimen/search_keyword_clear_width_height"
                android:layout_height="@dimen/search_keyword_clear_width_height"
                android:src="@drawable/x_search_clear"
                android:layout_marginEnd="@dimen/search_keyword_clear_margin_end"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/x_iv_gs_setting"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/search_bar_setting"
            android:scaleType="centerInside"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
</merge>
