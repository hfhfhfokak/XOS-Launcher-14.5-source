<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/x_rl_search_item"
    android:background="@drawable/x_search_card_item_selector"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="16sp"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/TextAppearance_Roboto_Content"/>
        <TextView
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            style="@style/TextAppearance_Roboto_Content"/>
    </LinearLayout>
    <com.transsion.xlauncher.search.view.SaFreezeImageView
        android:id="@+id/x_iv_search_img"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"/>
    <LinearLayout
        android:id="@+id/x_ll_gs_button_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingStart="3dp"
        android:paddingEnd="0dp"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/x_ll_search_hotkey"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/x_iv_search_whatsapp"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"/>
            <ImageView
                android:id="@+id/x_iv_search_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/zs_ic_sms"
                android:scaleType="centerInside"
                android:layout_marginEnd="12dp"/>
            <ImageView
                android:id="@+id/x_iv_search_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/zs_ic_phone"
                android:scaleType="centerInside"
                android:layout_marginEnd="16dp"/>
            <ImageView
                android:id="@+id/x_iv_search_location"
                android:visibility="gone"
                android:layout_width="52dp"
                android:layout_height="58dp"
                android:src="@drawable/ic_search_location"
                android:scaleType="center"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/zs_globalsearch_textcolor_subtitle"
            android:id="@+id/x_tv_search_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textAlignment="viewStart"
            android:layout_marginEnd="17.67dp"
            style="@style/TextAppearance_Roboto_Content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/zs_globalsearch_textcolor_subtitle"
            android:ellipsize="end"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/x_tv_search_folder"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="65dp"
            android:maxLines="1"
            style="@style/TextAppearance_Roboto_Content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/search_widget_text_open"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/x_tv_search_open"
            android:background="@drawable/button_bg_stroke_20dp_radius"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/x_search_instant_app_open"
            android:maxLength="8"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dimen_16"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/x_ll_gs_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="14dp"
        android:layout_toStartOf="@+id/x_ll_gs_button_hint"
        android:layout_toEndOf="@+id/x_iv_search_img">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/search_result_item_text_color"
            android:ellipsize="end"
            android:id="@+id/x_tv_search_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/TextAppearance_Roboto_Content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/search_result_item_contact_tv_color"
            android:ellipsize="end"
            android:id="@+id/x_tv_search_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/TextAppearance_Roboto_Content"/>
    </LinearLayout>
</RelativeLayout>
