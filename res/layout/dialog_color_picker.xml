<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">
        <com.transsion.xlauncher.library.colorpicker.ColorPickerView
            android:id="@+id/color_picker_view"
            android:tag="portrait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layerType="software"/>
        <RelativeLayout
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="90dp">
            <LinearLayout
                android:gravity="top"
                android:id="@+id/text_hex_wrapper"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true">
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/os_text_color_primary_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#"/>
                <EditText
                    android:textSize="13dp"
                    android:textColor="@color/os_text_color_primary_selector"
                    android:textColorHint="@color/os_text_hint_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/hex_val"
                    android:background="@null"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="HEX"
                    android:singleLine="true"
                    android:maxLength="8"
                    android:digits="0123456789abcdefABCDEF"
                    android:layout_weight="1"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionDone"
                    android:textAlignment="textStart"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:id="@+id/colorPanel"
                android:padding="0dp"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:layout_below="@+id/text_hex_wrapper"
                android:layout_alignParentRight="true">
                <com.transsion.xlauncher.library.colorpicker.ColorPickerPanelView
                    android:id="@+id/old_color_panel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/ic_right_arrow"/>
                <com.transsion.xlauncher.library.colorpicker.ColorPickerPanelView
                    android:id="@+id/new_color_panel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@+id/text_hex_wrapper"
                android:overScrollMode="never"/>
        </RelativeLayout>
    </LinearLayout>
    <include
        android:id="@+id/layout_dialog_buttons"
        layout="@layout/lau_prompt_dialog_buttons_horizontal"/>
</LinearLayout>
