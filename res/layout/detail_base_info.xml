<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/theme_common_text_screen_padding"
    android:layout_marginEnd="@dimen/theme_common_text_screen_padding">
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/twelve_dp"
        android:textColor="@color/percentage_60_gray"
        android:id="@+id/src_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"/>
    <View
        android:id="@+id/line"
        android:background="#979797"
        android:layout_width="0.67dp"
        android:layout_height="10.67dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/seven_dp"
        android:layout_marginEnd="@dimen/seven_dp"
        android:layout_toEndOf="@+id/src_size"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/twelve_dp"
        android:textColor="@color/percentage_60_gray"
        android:ellipsize="end"
        android:id="@+id/download_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/fifty_dp"
        android:maxLines="1"
        android:layout_toEndOf="@+id/line"/>
    <View
        android:id="@+id/praise_line"
        android:background="#979797"
        android:layout_width="0.67dp"
        android:layout_height="10.67dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/seven_dp"
        android:layout_marginEnd="@dimen/seven_dp"
        android:layout_toEndOf="@+id/download_number"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/twelve_dp"
        android:textColor="@color/percentage_60_gray"
        android:ellipsize="end"
        android:id="@+id/praise_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:maxLength="20"/>
</RelativeLayout>
