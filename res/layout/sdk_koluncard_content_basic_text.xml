<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/basic_text_layout"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
        android:id="@+id/sdk_koluncard_text_main_info_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_6"
        android:layout_alignParentTop="true"
        style="@style/SdkKolunCardMainInfoTextStyle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/sdk_koluncard_main_info_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_4"
        android:layout_alignParentTop="true">
        <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
            android:id="@+id/sdk_koluncard_digital_main_info_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/SdkKolunCardMianInfoDigitalTextStyle"/>
        <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
            android:id="@+id/sdk_koluncard_main_info_unit_view"
            android:paddingBottom="@dimen/sdk_koluncard_main_info_unit_padding_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sdk_koluncard_main_info_unit_margin_left"
            style="@style/SdkKolunCardMainInfoUnitTextStyle"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/sdk_koluncard_primary_info_text_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_2"
        android:layout_below="@+id/sdk_koluncard_text_main_info_view">
        <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
            android:id="@+id/sdk_koluncard_primary_info_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_6"
            style="@style/SdkKolunCardPrimaryInfoTextStyle"/>
        <com.transsion.kolun.cardtemplate.customwidget.CustomLabelView
            android:id="@+id/sdk_koluncard_primary_info_text_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SdkKolunCardTextLabelStyle"/>
        <com.transsion.kolun.cardtemplate.customwidget.CustomCardImageView
            android:id="@+id/sdk_koluncard_primary_info_image_label"
            android:layout_width="@dimen/dp_19"
            android:layout_height="@dimen/dp_19"/>
    </LinearLayout>
    <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
        android:id="@+id/sdk_koluncard_secondary_info_text_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/sdk_koluncard_primary_info_text_layout"
        style="@style/SdkKolunCardSecondaryInfoTextStyle"/>
</RelativeLayout>
