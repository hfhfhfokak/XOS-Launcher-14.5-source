<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/os_gdpr_dialog_background_old"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="3dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/os_gdpr_dialog_title_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/mtvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="29dp"
            android:maxLines="2"
            android:layout_alignParentLeft="true"
            android:layout_marginEnd="29dp"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="@drawable/os_gdpr_scrollbar_old"
            android:scrollbarStyle="insideInset"
            android:textSize="@dimen/os_gdpr_message_text_size"
            android:textColor="@color/os_gdpr_text_secondary_color"
            android:id="@+id/mWebview"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="164dp"
            android:layout_marginBottom="10dp"
            android:text="@string/os_gdpr_privacy_content"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:lineHeight="@dimen/os_gdpr_message_text_line_height"/>
        <TextView
            android:textSize="@dimen/os_gdpr_message_text_size"
            android:textColor="@color/os_gdpr_text_secondary_color"
            android:id="@+id/tv_announcement"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:lineHeight="@dimen/os_gdpr_message_text_line_height"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:background="#26a1a1a1"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="16dp">
        <Button
            android:textSize="14sp"
            android:textColor="@color/os_gdpr_dialog_message_text_color"
            android:id="@+id/mbtnCancel"
            android:background="@drawable/os_gdpr_cancel_btn_old"
            android:layout_width="104dp"
            android:layout_height="36dp"
            android:text="@string/os_gdpr_cancel_btn"
            style="?android:attr/borderlessButtonStyle"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/os_gdpr_white"
            android:id="@+id/mbtnOk"
            android:background="@drawable/os_gdpr_accept_btn_old"
            android:layout_width="104dp"
            android:layout_height="36dp"
            android:text="@string/os_gdpr_accept_btn"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</LinearLayout>
