<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/shape_mini_select_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_dp_244">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/mini_dp_24"
        android:layout_height="@dimen/mini_dp_24"
        android:layout_marginTop="@dimen/mini_dp_24"
        android:layout_marginStart="@dimen/mini_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/mini_sp_16"
        android:textColor="@color/mini_color_element_02"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/mini_dp_8"
        android:layout_marginEnd="@dimen/mini_dp_16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_logo"
        app:layout_constraintTop_toTopOf="@+id/iv_logo"/>
    <TextView
        android:textSize="@dimen/mini_sp_16"
        android:textColor="@color/mini_color_191f2b"
        android:gravity="start"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mini_dp_16"
        android:layout_marginTop="@dimen/mini_dp_16"
        android:layout_marginRight="@dimen/mini_dp_16"
        android:layout_marginHorizontal="@dimen/mini_dp_16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/mini_sp_16"
        android:textStyle="bold"
        android:textColor="@color/mini_color_black_white"
        android:gravity="center"
        android:id="@+id/tv_deny"
        android:background="@drawable/mini_login_permission_btn_deny_bg"
        android:clickable="true"
        android:layout_width="@dimen/mini_dp_158"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mini_dp_40"
        android:minHeight="@dimen/mini_dp_40"
        android:text="@string/mini_userinfo_deny"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_allow"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/mini_sp_16"
        android:textStyle="bold"
        android:textColor="@color/mini_color_element_regular"
        android:gravity="center"
        android:id="@+id/tv_allow"
        android:background="@drawable/mini_sel_login_btn_allow_bg"
        android:clickable="true"
        android:layout_width="@dimen/mini_dp_158"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mini_dp_40"
        android:minHeight="@dimen/mini_dp_40"
        android:text="@string/mini_userinfo_allow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_deny"/>
</androidx.constraintlayout.widget.ConstraintLayout>
