<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="98dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/addressContentL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <tech.palm.lib.widget.TagTextView
            android:textAppearance="@style/font_black_16_medium"
            android:id="@+id/fullName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"/>
        <LinearLayout
            android:gravity="end"
            android:id="@+id/edit"
            android:layout_width="@dimen/dimen_58"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="@dimen/dimen_24"
                android:layout_height="@dimen/dimen_24"
                android:src="@drawable/xn_edit_bg"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/font_black_12_t65"
        android:id="@+id/phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/addressContentL"
        android:elegantTextHeight="true"/>
    <TextView
        android:textAppearance="@style/font_black_14_t65"
        android:id="@+id/address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6"
        android:layout_below="@+id/phone"
        android:elegantTextHeight="true"/>
    <View
        android:background="@color/os_gray_tertiary_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/address"/>
</RelativeLayout>
