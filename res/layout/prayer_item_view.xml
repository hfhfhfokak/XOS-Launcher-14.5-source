<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_7"
    android:paddingBottom="@dimen/dp_7"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_4"
    android:paddingEnd="@dimen/dp_4">
    <TextView
        android:textSize="@dimen/zs_dimen_14sp"
        android:textColor="@color/team_text_color"
        android:gravity="center"
        android:id="@+id/prayer_item_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_4"/>
    <ImageView
        android:id="@+id/prayer_item_icon"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dimen_5"
        android:src="@drawable/ic_pray_1_fajr"/>
    <TextView
        android:textSize="@dimen/zs_dimen_12sp"
        android:textColor="@color/team_text_color"
        android:gravity="center"
        android:id="@+id/prayer_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6"
        android:text="N/A"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_4"/>
</LinearLayout>
