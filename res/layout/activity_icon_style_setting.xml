<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_toolbar"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="165.33dp">
        <com.android.launcher3.CellLayout
            android:layout_gravity="center"
            android:id="@+id/preview_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:display="icon_size_preview"/>
    </FrameLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:background="@drawable/icon_style_panel_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_above="@+id/ll_btn_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">
            <com.transsion.xlauncher.library.springview.SpringScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.transsion.xlauncher.iconstyle.views.IconStyleView
                        android:id="@+id/icon_style_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="152dp"/>
                    <com.transsion.xlauncher.iconstyle.views.IconColorView
                        android:id="@+id/icon_color_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="30dp"/>
                    <com.transsion.xlauncher.iconstyle.views.IconShapeView
                        android:id="@+id/icon_shape_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.transsion.xlauncher.iconstyle.views.IconSizeView
                        android:id="@+id/icon_size_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"/>
                </LinearLayout>
            </com.transsion.xlauncher.library.springview.SpringScrollView>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_btn_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <Button
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_apply"
                android:layout_width="@dimen/apply_button_width"
                android:layout_height="wrap_content"
                android:text="@string/setting_desktop_mode_btn_apply"
                style="@style/OS.Widget.Button.Contained.Big.Single"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
