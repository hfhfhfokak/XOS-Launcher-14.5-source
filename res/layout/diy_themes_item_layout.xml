<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/sixteen_dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/diy_themes_cell01"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/theme_common_screen_padding">
        <RelativeLayout
            android:id="@+id/diy_themes_icon01"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsion.theme.common.ThemeCoverView
                android:id="@+id/diy_themes_iv01"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:isNeedText="false"
                app:radios="@dimen/theme_preview_corner_radius"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_diy_angle"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
            <com.transsion.theme.common.customview.RoundCornerImageView
                android:id="@+id/diy_themes_dl01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_downloaded_square"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                app:roundCornerRadius="@dimen/theme_preview_corner_radius"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/fourteen_sp"
            android:textColor="@color/th_res_name_color"
            android:id="@+id/diy_themes_name01"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/six_dp"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/six_dp"/>
        <TextView
            android:textSize="@dimen/twelve_sp"
            android:textColor="@color/percentage_100_gray"
            android:id="@+id/diy_themes_author01"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/six_dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/diy_themes_cell02"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/theme_common_item_padding"
        android:layout_marginEnd="@dimen/theme_common_screen_padding">
        <RelativeLayout
            android:id="@+id/diy_themes_icon02"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsion.theme.common.ThemeCoverView
                android:id="@+id/diy_themes_iv02"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:isNeedText="false"
                app:radios="@dimen/theme_preview_corner_radius"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_diy_angle"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
            <com.transsion.theme.common.customview.RoundCornerImageView
                android:id="@+id/diy_themes_dl02"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_downloaded_square"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                app:roundCornerRadius="@dimen/theme_preview_corner_radius"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/fourteen_sp"
            android:textColor="@color/th_res_name_color"
            android:id="@+id/diy_themes_name02"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/six_dp"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/six_dp"/>
        <TextView
            android:textSize="@dimen/twelve_sp"
            android:textColor="@color/percentage_100_gray"
            android:id="@+id/diy_themes_author02"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/six_dp"/>
    </LinearLayout>
</LinearLayout>
