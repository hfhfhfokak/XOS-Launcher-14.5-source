<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/mini_color_bg_01"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/mini_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/tv_privacy_go"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/fl_privacy_top_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll_privacy_miniappcenter_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/iv_privacy_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/mini_privacy_bg"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/mini_sp_18"
                        android:textColor="@color/mini_color_element_01"
                        android:id="@+id/tv_privacy_appName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mini_dp_7"
                        android:text="@string/mini_miniapp_center"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintBottom_toTopOf="@+id/iv_privacy_icon"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_privacy_bg"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_privacy_other_bg"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mini_dp_120"
                    app:layout_constraintBottom_toTopOf="@+id/iv_privacy_icon"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent">
                    <com.cloud.tmc.miniapp.widget.RoundedCornerImageView
                        android:id="@+id/iv_privacy_miniapp_icon"
                        android:layout_width="@dimen/mini_dp_100"
                        android:layout_height="@dimen/mini_dp_100"/>
                    <TextView
                        android:textSize="@dimen/mini_sp_18"
                        android:textColor="@color/mini_color_element_01"
                        android:id="@+id/tv_privacy_appName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mini_dp_10"
                        android:text=""
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="@dimen/mini_sp_12"
                        android:textColor="@color/mini_color_element_03"
                        android:gravity="center"
                        android:id="@+id/tv_privacy_des"
                        android:background="@drawable/mini_privacy_des_bg"
                        android:layout_width="@dimen/mini_dp_61"
                        android:layout_height="@dimen/mini_dp_22"
                        android:layout_marginTop="@dimen/mini_dp_8"
                        android:text="@string/mini_miniapp"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>
            </FrameLayout>
            <ImageView
                android:id="@+id/iv_privacy_icon"
                android:layout_width="@dimen/mini_dp_19"
                android:layout_height="@dimen/mini_dp_20"
                android:layout_marginTop="@dimen/mini_dp_12"
                android:src="@drawable/mini_privacy_icon"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fl_privacy_top_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_privacy_content"
                android:background="@drawable/mini_privacy_content_bg"
                android:paddingLeft="@dimen/mini_dp_23"
                android:paddingTop="@dimen/mini_dp_16"
                android:paddingRight="@dimen/mini_dp_23"
                android:paddingBottom="@dimen/mini_dp_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/mini_dp_220"
                android:paddingHorizontal="@dimen/mini_dp_23"
                android:paddingVertical="@dimen/mini_dp_16"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_privacy_icon">
                <TextView
                    android:textSize="@dimen/mini_sp_15"
                    android:textColor="@color/mini_color_privacy_hint"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/mini_dp_272"
                    android:text="@string/mini_what_is_miniapp"
                    android:maxLines="2"
                    android:fontFamily="sans-serif"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mini_dp_12"
                    android:maxWidth="@dimen/mini_dp_266">
                    <View
                        android:background="@drawable/mini_dot"
                        android:layout_width="@dimen/mini_dp_4"
                        android:layout_height="@dimen/mini_dp_4"
                        android:layout_marginTop="@dimen/mini_dp_9"/>
                    <TextView
                        android:textSize="@dimen/mini_sp_15"
                        android:textColor="@color/mini_color_privacy_hint"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/mini_dp_272"
                        android:text="@string/mini_no_installation_required"
                        android:maxLines="2"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="@dimen/mini_dp_6"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mini_dp_6">
                    <View
                        android:background="@drawable/mini_dot"
                        android:layout_width="@dimen/mini_dp_4"
                        android:layout_height="@dimen/mini_dp_4"
                        android:layout_marginTop="@dimen/mini_dp_9"/>
                    <TextView
                        android:textSize="@dimen/mini_sp_15"
                        android:textColor="@color/mini_color_privacy_hint"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/mini_dp_272"
                        android:text="@string/mini_less_storage_and_data"
                        android:maxLines="2"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="@dimen/mini_dp_6"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mini_dp_6">
                    <View
                        android:background="@drawable/mini_dot"
                        android:layout_width="@dimen/mini_dp_4"
                        android:layout_height="@dimen/mini_dp_4"
                        android:layout_marginTop="@dimen/mini_dp_9"/>
                    <TextView
                        android:textSize="@dimen/mini_sp_15"
                        android:textColor="@color/mini_color_privacy_hint"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/mini_dp_272"
                        android:text="@string/mini_faster_loading_speeds"
                        android:maxLines="2"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="@dimen/mini_dp_6"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="@dimen/mini_sp_16"
        android:textColor="@color/mini_color_element_regular"
        android:gravity="center"
        android:id="@+id/tv_privacy_go"
        android:background="@drawable/mini_privacy_button_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_dp_48"
        android:layout_marginLeft="@dimen/mini_dp_28"
        android:layout_marginRight="@dimen/mini_dp_28"
        android:layout_marginBottom="@dimen/mini_dp_16"
        android:text="@string/mini_get_started"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/mini_dp_28"
        app:layout_constraintBottom_toTopOf="@+id/tv_privacy_agreement_please_read"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="@dimen/mini_sp_12"
        android:textColor="@color/mini_color_666666"
        android:id="@+id/tv_privacy_agreement_please_read"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mini_dp_28"
        android:layout_marginRight="@dimen/mini_dp_28"
        android:layout_marginBottom="@dimen/mini_dp_20"
        android:text="@string/mini_by_continuing"
        android:layout_marginHorizontal="@dimen/mini_dp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
