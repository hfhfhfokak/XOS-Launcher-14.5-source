<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.toolbar.TopDropBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="top"
    android:orientation="horizontal"
    android:id="@+id/top_drop_bar"
    android:layout_width="match_parent"
    android:layout_height="41dp"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/create_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <com.transsion.xlauncher.toolbar.CreateDropTarget
            android:id="@+id/create_drop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</com.transsion.xlauncher.toolbar.TopDropBar>
