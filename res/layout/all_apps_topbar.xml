<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.picture.PictureTopBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_layout"
    android:paddingBottom="@dimen/all_apps_topbar_bottom_padding"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <FrameLayout
        android:id="@+id/search_box_container"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/menu_btn"
        android:visibility="gone"
        android:layout_width="@dimen/picture_top_btn_size"
        android:layout_height="@dimen/picture_top_btn_size"
        android:src="@drawable/h5_menu_selector"
        android:scaleType="center"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/desc_a_z_btn_menu"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/picture_blur_shadow_height"
        android:layout_marginBottom="-1dp"
        android:src="@drawable/picture_blur_shadow"
        android:scaleType="fitXY"
        android:layout_alignParentBottom="true"/>
</com.transsion.xlauncher.picture.PictureTopBar>
