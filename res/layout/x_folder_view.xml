<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.folder.FolderViewContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folder_view_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsion.xlauncher.folder.FolderPage
        android:id="@+id/folder_view"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <ImageView
        android:id="@+id/folder_page_shade"
        android:background="#7f000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        launcher:layout_ignoreInsets="true"/>
    <com.transsion.xlauncher.folder.FolderTitleContainer
        android:id="@+id/folder_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        launcher:layout_ignoreInsets="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/folder_titles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsion.xlauncher.folder.ExtendedEditText
            android:textSize="@dimen/folder_title_text_size"
            android:textColor="@color/workspace_icon_text_color"
            android:textColorHighlight="@color/folder_title_text_highlight_color"
            android:textColorHint="@color/workspace_icon_text_color"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/folder_edit"
            android:background="@drawable/folder_title_edit_bg"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="@string/folder_hint_text"
            android:singleLine="true"
            android:maxLength="64"
            android:imeOptions="flagNoExtractUi"
            android:textCursorDrawable="@null"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </com.transsion.xlauncher.folder.FolderTitleContainer>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="@dimen/folder_bottom_button_height">
        <FrameLayout
            android:id="@+id/sort_btn"
            android:background="@drawable/bg_folder_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="71dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sort_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_folder_sort"
                android:scaleType="center"
                android:contentDescription="@string/desc_content_folder_sort_button"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/add_btn"
            android:background="@drawable/bg_folder_btn_with_red_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_folder_add"
                android:contentDescription="@string/desc_content_folder_add_btn"
                android:stateListAnimator="@anim/overview_button_anim"/>
        </FrameLayout>
    </LinearLayout>
</com.transsion.xlauncher.folder.FolderViewContainer>
