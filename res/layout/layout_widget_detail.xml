<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/detail_back"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/widget_title_height"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/widget_dialog_left_right_margin"
        android:layout_marginEnd="@dimen/widget_dialog_left_right_margin">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/widget_edit_back_arrow"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_dialog_name_margin_title"
        android:layout_below="@+id/detail_back"
        android:layout_marginStart="@dimen/widget_dialog_left_right_margin"
        android:layout_marginEnd="@dimen/widget_dialog_left_right_margin">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/widget_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/detail_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:fontFamily="Roboto Regular"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/description_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_detail_description_height">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/widget_gray_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/detail_description"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:fontFamily="Roboto Regular"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/detail_img_layout"
        android:layout_width="match_parent"
        android:layout_height="276dp"
        android:layout_marginTop="@dimen/widget_detail_img_margin_top"
        android:layout_below="@+id/title_layout"
        android:layout_centerHorizontal="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detail_image"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="always"/>
    </LinearLayout>
    <com.transsion.xlauncher.widget.BaseCircleIndicator
        android:id="@+id/indicator"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="@dimen/widget_detail_indicator_margin_top"
        android:layout_below="@+id/detail_img_layout"
        android:layout_centerHorizontal="true"
        app:ci_height="6dp"
        app:ci_width="6dp"/>
    <Button
        android:id="@+id/add_to_home"
        android:layout_width="@dimen/lau_bottom_sheet_button_width"
        android:layout_height="wrap_content"
        android:text="@string/add_to_workspace"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:paddingStart="@dimen/lau_bottom_sheet_button_start_end_margin"
        android:paddingEnd="@dimen/lau_bottom_sheet_button_start_end_margin"
        style="@style/ThemeWidgetDetailButton"/>
</RelativeLayout>
