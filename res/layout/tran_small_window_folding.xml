<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recents_small_window_folding"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:gravity="center"
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ts_recents_left_small_window_container_folding"
        android:layout_width="@dimen/recent_folding_small_window_width_folding"
        android:layout_height="@dimen/recent_folding_small_window_height_folding"
        android:layout_marginRight="@dimen/recent_folding_small_window_width_folding"
        android:src="@drawable/ic_bigleft"
        android:alpha="0.3"
        android:layout_marginStart="-24dp"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ts_recents_left_small_window_icon_folding"
        android:layout_width="@dimen/recent_task_small_window_size"
        android:layout_height="@dimen/recent_task_small_window_size"
        android:src="@drawable/ic_recent_mini_left"
        android:layout_marginStart="@dimen/recent_folding_small_window_icon_margin"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ts_recents_right_small_window_icon_folding"
        android:layout_width="@dimen/recent_task_small_window_size"
        android:layout_height="@dimen/recent_task_small_window_size"
        android:src="@drawable/ic_recent_mini_right"
        android:layout_marginEnd="@dimen/recent_folding_small_window_icon_margin"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ts_recents_right_small_window_container_folding"
        android:layout_width="@dimen/recent_folding_small_window_width_folding"
        android:layout_height="@dimen/recent_folding_small_window_height_folding"
        android:layout_marginLeft="@dimen/recent_folding_small_window_width_folding"
        android:src="@drawable/ic_bigright"
        android:alpha="0.3"
        android:layout_marginEnd="-24dp"/>
</FrameLayout>
