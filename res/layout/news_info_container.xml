<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_8"
    android:paddingEnd="@dimen/dp_12">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/author_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/item_following_head"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#bdbdbd"
            android:ellipsize="end"
            android:id="@+id/item_following_author_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_following_head"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/item_following_status_img"
            android:visibility="visible"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/pgc_followed_icon"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_following_author_name"
            app:layout_constraintTop_toTopOf="parent"/>
        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_4"
            android:indeterminateTint="@color/colorGreen1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_following_status_img"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/ll_offline"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_ll"
        app:layout_constraintStart_toEndOf="@+id/author_info_container"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="10sp"
            android:textColor="#bdbdbd"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_offline"
            android:background="@drawable/news_feed_offline_bg"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/news_feed_offline_hint"
            android:maxLines="1"
            android:paddingStart="@dimen/dp_3"
            android:paddingEnd="@dimen/dp_3"
            style="@style/FontStyle.Regular"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/right_ll"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_is_hot"
            android:visibility="gone"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_hot_news_icon"
            android:layout_marginStart="@dimen/dp_8"/>
        <ImageView
            android:id="@+id/tv_news_date_img"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/news_list_date_icon"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/dp_8"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#bdbdbd"
            android:gravity="center_vertical"
            android:id="@+id/tv_news_date"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_2"/>
        <ImageView
            android:id="@+id/view_num_img"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/news_comment_icon"
            android:layout_marginStart="@dimen/dp_8"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#bdbdbd"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_news_view_num"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_2"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/top_close_btn"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/notification_static_news_report_icon"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/dp_8"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_share_icon"
            android:visibility="gone"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_share_gray"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/news_info_container_audio_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/news_info_container_audio_listener_img"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/audio_listens_number"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ff8e8e8e"
            android:id="@+id/news_info_container_audio_listens_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/news_info_container_audio_listener_img"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
