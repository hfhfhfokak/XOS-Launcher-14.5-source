<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.widget.WidgetRootLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widget_dialog"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_dialog_height">
    <ViewStub
        android:id="@+id/search_screen"
        android:layout="@layout/layout_widget_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_dialog_search_margin_top"
        android:layout_marginBottom="@dimen/widget_dialog_search_margin_bottom"
        android:layout_marginStart="@dimen/widget_dialog_left_right_margin"
        android:layout_marginEnd="@dimen/widget_dialog_left_right_margin"/>
    <com.transsion.xlauncher.library.search.EmptySearchResult
        android:id="@+id/search_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lau_bottom_sheet_widget_empty_top_margin"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/main_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/title_main"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/widget_title_height"
            android:text="@string/add_widget"
            android:layout_marginStart="@dimen/widget_dialog_left_right_margin"
            style="@style/ThemeWpWidgetTitleText"/>
        <FrameLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/widget_dialog_search_margin_top">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_main"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="always"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_search"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="always"/>
        </FrameLayout>
    </LinearLayout>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/detail_screen"
        android:layout="@layout/layout_widget_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.transsion.xlauncher.widget.WidgetRootLinearLayout>
