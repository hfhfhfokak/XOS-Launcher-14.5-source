<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.android.launcher3.widget.WidgetImageView
        android:id="@+id/widget_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <RelativeLayout
        android:gravity="center"
        android:paddingLeft="@dimen/widget_preview_label_horizontal_padding"
        android:paddingRight="@dimen/widget_preview_label_horizontal_padding"
        android:paddingBottom="@dimen/widget_preview_label_vertical_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.transsion.xlauncher.library.widget.ElegantTextView
            android:textSize="14sp"
            android:textColor="@color/widget_preview_label"
            android:id="@+id/widget_dims"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginStart="5dp"
            android:layout_alignParentEnd="true"/>
        <com.transsion.xlauncher.library.widget.ElegantTextView
            android:textSize="14sp"
            android:textColor="@color/widget_preview_label"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/widget_name"
            android:fadingEdge="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="sans-serif-condensed"
            android:layout_toStartOf="@+id/widget_dims"/>
    </RelativeLayout>
</merge>
