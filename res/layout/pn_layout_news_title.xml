<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/pn_dimen_8dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimen_48">
    <ImageView
        android:id="@+id/news_title_left_iv"
        android:layout_width="@dimen/pn_dimen_24dp"
        android:layout_height="@dimen/pn_dimen_24dp"
        android:src="@drawable/pn_news_ic_back"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/pn_dimen_16dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/zs_setting_title_text_color"
        android:id="@+id/news_title_left_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pn_news_title"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/pn_dimen_10dp"
        android:layout_toEndOf="@+id/news_title_left_iv"/>
    <ImageView
        android:id="@+id/news_title_right_iv"
        android:visibility="gone"
        android:layout_width="@dimen/pn_dimen_24dp"
        android:layout_height="@dimen/pn_dimen_24dp"
        android:src="@drawable/pn_ic_actionbar_menu_path"
        android:layout_marginEnd="@dimen/pn_dimen_16dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="0.67dp"
        android:layout_marginTop="@dimen/pn_dimen_8dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
