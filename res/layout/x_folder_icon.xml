<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.folder.FolderIcon xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/preview_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/x_portal_ring_inner"
        android:antialias="true"
        android:scaleType="fitXY"/>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/folder_icon_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.android.launcher3.BubbleTextView
            android:id="@+id/folder_icon_t_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Icon"/>
        <com.android.launcher3.BubbleTextView
            android:id="@+id/folder_icon_t_c"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Icon"/>
        <com.android.launcher3.BubbleTextView
            android:id="@+id/folder_icon_t_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Icon"/>
        <com.android.launcher3.BubbleTextView
            android:id="@+id/folder_icon_c_l"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Icon"/>
        <com.android.launcher3.BubbleTextView
            android:id="@+id/folder_icon_c_c"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Icon"/>
        <com.android.launcher3.BubbleTextView
            android:id="@+id/folder_icon_c_r"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Icon"/>
        <com.android.launcher3.BubbleTextView
            android:id="@+id/folder_icon_b_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Icon"/>
        <com.android.launcher3.BubbleTextView
            android:id="@+id/folder_icon_b_c"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Icon"/>
        <RelativeLayout
            android:id="@+id/folder_icon_b_r_parent"
            android:padding="@dimen/big_folder_cell_icon_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/folder_icon_b_r_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.android.launcher3.BubbleTextView
                android:id="@+id/folder_icon_b_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Icon"/>
        </RelativeLayout>
    </RelativeLayout>
    <com.android.launcher3.BubbleTextView
        android:layout_gravity="top"
        android:id="@+id/folder_icon_name"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/Icon"/>
</com.transsion.xlauncher.folder.FolderIcon>
