<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <include
        android:id="@+id/sdk_koluncard_image_grid_one"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        layout="@layout/sdk_koluncard_image_grid_item"/>
    <View
        android:id="@+id/sdk_koluncard_image_grid_space_one"
        android:layout_width="@dimen/sdk_koluncard_image_grid_spacing"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/sdk_koluncard_image_grid_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        layout="@layout/sdk_koluncard_image_grid_item"/>
    <View
        android:id="@+id/sdk_koluncard_image_grid_space_two"
        android:layout_width="@dimen/sdk_koluncard_image_grid_spacing"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/sdk_koluncard_image_grid_three"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        layout="@layout/sdk_koluncard_image_grid_item"/>
</LinearLayout>
