<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.folder.Folder xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/freezer_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/workspace_icon_text_color"
            android:textColorHighlight="#ffffffff"
            android:textColorHint="@color/workspace_icon_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/freezer_title"
            android:background="#00000000"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="@string/freezer_title"
            android:singleLine="true"
            android:fontFamily="sans-serif"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/unfreezer_btn"
            android:visibility="invisible"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_abc_menu_overflow"
            android:scaleType="center"
            android:contentDescription="@string/desc_content_freezer_menu"/>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/folder_description_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/folder_description"
        android:background="#00000000"
        android:paddingBottom="@dimen/freezer_folder_title_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.transsion.xlauncher.folder.FolderScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            style="@style/folder_scroll_bar_style">
            <com.android.launcher3.CellLayout
                android:id="@+id/folder_content"
                android:background="#00000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cacheColorHint="#ff333333"
                android:hapticFeedbackEnabled="false"
                launcher:display="freezer"/>
        </com.transsion.xlauncher.folder.FolderScrollView>
    </LinearLayout>
</com.transsion.xlauncher.folder.Folder>
