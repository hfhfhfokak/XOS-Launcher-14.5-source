<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/dialog_layout"
        android:background="@drawable/shape_mini_layout_white_12"
        android:paddingTop="@dimen/mini_dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mini_dp_16"
        android:layout_marginRight="@dimen/mini_dp_16"
        android:minHeight="@dimen/mini_dp_148"
        android:layout_marginHorizontal="@dimen/mini_dp_16">
        <TextView
            android:textSize="@dimen/mini_sp_16"
            android:textColor="@color/mini_color_remove_confirm_title"
            android:ellipsize="end"
            android:id="@+id/txt_common_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/mini_dp_16"
            android:layout_marginRight="@dimen/mini_dp_16"
            android:maxLines="1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/mini_dp_16"/>
        <TextView
            android:textSize="@dimen/mini_sp_14"
            android:textColor="@color/mini_color_remove_confirm_content"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/txt_common_dialog_describe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/mini_dp_16"
            android:layout_marginTop="@dimen/mini_dp_18"
            android:layout_marginRight="@dimen/mini_dp_16"
            android:textAllCaps="false"
            android:fontFamily="sans-serif"
            android:layout_marginHorizontal="@dimen/mini_dp_16"/>
        <View
            android:background="@color/mini_color_remove_confirm_halving_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mini_dp_1"
            android:layout_marginTop="@dimen/mini_dp_16"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/mini_dp_52">
            <TextView
                android:textSize="@dimen/mini_sp_15"
                android:textColor="@color/mini_color_remove_confirm_cancel"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_common_dialog_left"
                android:background="@drawable/shape_mini_common_tip_confirm_dialog_left_click"
                android:paddingLeft="@dimen/mini_dp_16"
                android:paddingTop="@dimen/mini_dp_16"
                android:paddingRight="@dimen/mini_dp_16"
                android:paddingBottom="@dimen/mini_dp_16"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="@dimen/mini_dp_16"
                android:paddingVertical="@dimen/mini_dp_16"/>
            <TextView
                android:textSize="@dimen/mini_sp_15"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_common_dialog_right"
                android:background="@drawable/shape_mini_common_tip_confirm_dialog_right_click"
                android:paddingLeft="@dimen/mini_dp_16"
                android:paddingTop="@dimen/mini_dp_16"
                android:paddingRight="@dimen/mini_dp_16"
                android:paddingBottom="@dimen/mini_dp_16"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="@dimen/mini_dp_16"
                android:paddingVertical="@dimen/mini_dp_16"/>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/dialog_view_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_dp_8"/>
    <View
        android:id="@+id/view_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_dp_48"/>
</androidx.appcompat.widget.LinearLayoutCompat>
