<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/sdk_koluncard_button_area_separator"
        android:background="@color/sdk_koluncard_area_separator_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sdk_koluncard_area_separator_height"
        android:layout_marginTop="@dimen/dp_10"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/sdk_koluncard_button_container"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
            android:id="@+id/sdk_koluncard_negative_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:sdk_koluncard_text_style="medium"
            style="@style/SdkKolunCardButtonStyle"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/sdk_koluncard_neutral_button_lyt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/sdk_koluncard_button_separator1"
                android:background="@color/sdk_koluncard_button_separator_color"
                android:layout_width="@dimen/sdk_koluncard_button_separator_width"
                android:layout_height="@dimen/sdk_koluncard_button_separator_height"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
                android:id="@+id/sdk_koluncard_neutral_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sdk_koluncard_text_style="medium"
                style="@style/SdkKolunCardButtonStyle"/>
            <View
                android:id="@+id/sdk_koluncard_button_separator2"
                android:background="@color/sdk_koluncard_button_separator_color"
                android:layout_width="@dimen/sdk_koluncard_button_separator_width"
                android:layout_height="@dimen/sdk_koluncard_button_separator_height"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
            android:id="@+id/sdk_koluncard_positive_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:sdk_koluncard_text_style="medium"
            style="@style/SdkKolunCardButtonStyle"/>
    </LinearLayout>
</merge>
