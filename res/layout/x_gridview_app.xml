<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.search.view.SaExpandView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/recent_apps_card"
    android:background="@drawable/x_sa_used_app_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/x_rl_gs_title"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_card_title_height"
        android:paddingStart="@dimen/search_card_title_margin_start">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/recent_apps_title_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/x_tv_recent_app"
            android:paddingTop="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/launcher_search_title_grid_apps"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:paddingEnd="11dp"/>
        <ImageView
            android:id="@+id/x_iv_gs_open_close"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="10.67dp"
            android:src="@drawable/customer_search_ic_open"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <com.transsion.xlauncher.search.view.SaGridView
        android:id="@+id/x_gv_gs_apps"
        android:paddingBottom="18dp"
        android:visibility="visible"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@android:color/transparent"
        android:cacheColorHint="@android:color/transparent"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="16.67dp"
        android:numColumns="@integer/search_item_display_columns"/>
</com.transsion.xlauncher.search.view.SaExpandView>
