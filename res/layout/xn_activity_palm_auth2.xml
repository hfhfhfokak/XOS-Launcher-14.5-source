<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rlAppInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="@dimen/xn_item_padding_start"/>
        <TextView
            android:textAppearance="@style/font_black_16"
            android:ellipsize="end"
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/ivAppIcon"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rlAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/rlAppInfo"
        android:layout_centerHorizontal="true">
        <com.transsion.xuanniao.account.comm.widget.RoundImageView
            android:id="@+id/portrait"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/xn_portrait_default"
            android:layout_marginStart="@dimen/xn_item_padding_start"/>
        <TextView
            android:textAppearance="@style/font_black_24"
            android:ellipsize="end"
            android:id="@+id/nickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dimen_16"
            android:layout_toEndOf="@+id/portrait"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rlUserAuth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        android:layout_below="@+id/rlAccount">
        <RelativeLayout
            android:id="@+id/rlScopeView"
            android:layout_width="match_parent"
            android:layout_height="300dp">
            <ListView
                android:id="@+id/listView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"/>
        </RelativeLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/os_text_tertiary_color"
            android:id="@+id/tvDeclare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sdk_text_declare"
            android:layout_below="@+id/rlScopeView"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end"/>
        <Button
            android:id="@+id/btn_agree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="72dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="72dp"
            android:text="@string/sdk_text_agree"
            android:layout_below="@+id/tvDeclare"
            style="@style/OS.Widget.Button.Contained.Big.Single"/>
        <Button
            android:id="@+id/btn_reject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="72dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="72dp"
            android:text="@string/sdk_text_reject"
            android:layout_below="@+id/btn_agree"
            style="@style/OS.Widget.Button.Contained.Big.Single.Gray"/>
    </RelativeLayout>
</RelativeLayout>
