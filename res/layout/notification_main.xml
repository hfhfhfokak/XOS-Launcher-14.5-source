<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.popup.NotificationContentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="@dimen/notification_elevation">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/text_and_background"
        android:background="@drawable/bg_white_round_rect_lower"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/popup_padding_start"
        android:paddingEnd="@dimen/notification_content_padding_end">
        <TextView
            android:textSize="@dimen/notification_main_text_size"
            android:textColor="?android:attr/textColorPrimary"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="sans-serif"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="@dimen/notification_main_text_size"
            android:textColor="?android:attr/textColorSecondary"
            android:ellipsize="end"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <View
        android:layout_gravity="end|center_vertical"
        android:id="@+id/popup_item_icon"
        android:layout_width="@dimen/notification_icon_size"
        android:layout_height="@dimen/notification_icon_size"
        android:layout_marginEnd="@dimen/launcher_notification_padding_end"/>
</com.transsion.xlauncher.popup.NotificationContentView>
