<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/hidden_apps_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hidden_page_title_margin_top">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/hide_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hide_apps_title"
            android:singleLine="true"
            android:fontFamily="sans-serif"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/hide_setting_btn"
            android:background="?attr/selectableItemBackground"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/hide_apps_setting_icon"
            android:scaleType="center"
            android:contentDescription="@string/hide_app_settings_title"
            android:layout_marginEnd="25dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/hide_apps_recycle_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="34dp"
        android:layout_weight="1">
        <com.transsion.xlauncher.library.springview.SpringRecyclerView
            android:id="@+id/hide_recycler_view"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            style="@style/folder_scroll_bar_style"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/hide_apps_empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/hide_apps_empty"/>
    </FrameLayout>
    <Button
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/add_or_remove"
        android:background="@drawable/hide_add_remove_btn_selector"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="@string/hide_apps_add_or_remove"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/add_or_remove_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/hide_apps_add_or_remove"/>
</LinearLayout>
