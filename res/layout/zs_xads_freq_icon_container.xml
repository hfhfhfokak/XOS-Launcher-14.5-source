<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/zs_ad_bg_color"
    android:paddingTop="@dimen/zs_dimen_16dp"
    android:paddingBottom="@dimen/zs_dimen_18dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/zs_dimen_76dp"
    android:layoutDirection="locale">
    <com.zero.mediation.ad.view.TIconView
        android:id="@+id/ad_icon"
        android:layout_width="@dimen/zs_dimen_42dp"
        android:layout_height="@dimen/zs_dimen_42dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="10dp"
        android:layout_alignParentStart="true"/>
    <com.zero.mediation.ad.view.TMediaView
        android:id="@+id/ad_image"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="@dimen/zs_dimen_42dp"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/zs_dimen_10dp">
        <TextView
            android:textSize="@dimen/zs_dimen_16sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/ad_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/zs_ads_body_color"
            android:ellipsize="end"
            android:id="@+id/ad_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/zs_dimen_42dp">
        <Button
            android:textSize="@dimen/zs_dimen_14sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/ad_install"
            android:background="@drawable/zs_xads_btn_bg"
            android:paddingLeft="@dimen/zs_dimen_8dp"
            android:paddingRight="@dimen/zs_dimen_8dp"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:maxWidth="105dp"
            android:minWidth="82dp"
            android:maxLines="1"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</LinearLayout>
