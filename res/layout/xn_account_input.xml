<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/accountLeftL"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_8">
        <TextView
            android:textAppearance="@style/font_black_14_t40"
            android:gravity="center"
            android:id="@+id/cc"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_38"
            android:minWidth="@dimen/dimen_24"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/dimen_10"
            android:paddingEnd="@dimen/dimen_8"
            android:elegantTextHeight="true"/>
        <View
            android:id="@+id/line1"
            android:background="@color/xn_line"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_below="@+id/cc"
            android:layout_alignStart="@+id/cc"
            android:layout_alignEnd="@+id/cc"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/inputL"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_38"
        android:paddingEnd="@dimen/dimen_12"
        android:layout_toEndOf="@+id/accountLeftL">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/dimen_24"
            android:layout_height="@dimen/dimen_24"
            android:src="@drawable/xn_icon_account"
            android:tint="@color/xn_input_logo_color"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dimen_12"
            android:layout_marginEnd="@dimen/dimen_16"/>
        <EditText
            android:textSize="15sp"
            android:textColor="@color/os_text_primary_color"
            android:textColorHint="@color/os_text_quaternary_color"
            android:ellipsize="end"
            android:id="@+id/edit"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_38"
            android:hint="@string/xn_email_phone_hint"
            android:singleLine="true"
            android:maxLength="100"
            android:digits="@string/xn_email_digits"
            android:layout_centerVertical="true"
            android:inputType="textNoSuggestions"
            android:textDirection="anyRtl"
            android:textAlignment="viewStart"
            android:layout_toEndOf="@+id/logo"
            android:importantForAutofill="no"/>
    </RelativeLayout>
    <View
        android:id="@+id/line"
        android:background="@color/xn_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/inputL"
        android:layout_alignStart="@+id/inputL"/>
</RelativeLayout>
