<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/xn_item_padding_start"
    android:paddingEnd="@dimen/xn_item_padding_end"
    android:layout_marginStart="@dimen/xn_full_margin_start"
    android:layout_marginEnd="@dimen/xn_full_margin_end">
    <com.transsion.widgetslib.view.OverBoundNestedScrollView
        android:id="@+id/scrollView"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_20">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/font_black_14_t65"
                android:id="@+id/contactLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:text="@string/xn_contact"/>
            <TextView
                android:textAppearance="@style/font_error_10"
                android:gravity="center_vertical"
                android:id="@+id/contactStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xn_star"
                android:layout_alignTop="@+id/contactLabel"
                android:layout_alignBottom="@+id/contactLabel"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/contactLabel"/>
            <com.transsion.xuanniao.account.comm.widget.ContactInput
                android:id="@+id/contactInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_3"
                android:layout_below="@+id/contactLabel"/>
            <com.transsion.xuanniao.account.comm.widget.ErrorView
                android:id="@+id/contactError"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dimen_25"
                android:layout_below="@+id/contactInput"/>
            <TextView
                android:textAppearance="@style/font_black_14_t65"
                android:id="@+id/phoneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2"
                android:text="@string/xn_phone_num"
                android:layout_below="@+id/contactError"/>
            <TextView
                android:textAppearance="@style/font_error_10"
                android:gravity="center_vertical"
                android:id="@+id/phoneStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xn_star"
                android:layout_alignTop="@+id/phoneLabel"
                android:layout_alignBottom="@+id/phoneLabel"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/phoneLabel"/>
            <com.transsion.xuanniao.account.comm.widget.PhoneInput
                android:id="@+id/phoneInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_3"
                android:layout_below="@+id/phoneLabel"/>
            <com.transsion.xuanniao.account.comm.widget.ErrorView
                android:id="@+id/phoneError"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dimen_25"
                android:layout_below="@+id/phoneInput"/>
            <TextView
                android:textAppearance="@style/font_black_14_t65"
                android:id="@+id/regionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2"
                android:text="@string/xn_region"
                android:layout_below="@+id/phoneError"/>
            <TextView
                android:textAppearance="@style/font_error_10"
                android:gravity="center_vertical"
                android:id="@+id/regionStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xn_star"
                android:layout_alignTop="@+id/regionLabel"
                android:layout_alignBottom="@+id/regionLabel"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/regionLabel"/>
            <RelativeLayout
                android:id="@+id/regionL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_3"
                android:minHeight="@dimen/dimen_38"
                android:layout_below="@+id/regionLabel">
                <ImageView
                    android:id="@+id/regionArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_15"
                    android:textColorHint="@color/os_text_quaternary_color"
                    android:id="@+id/region"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/xn_please_select"
                    android:layout_centerVertical="true"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/regionArrow"/>
                <View
                    android:id="@+id/line"
                    android:background="@color/xn_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <com.transsion.xuanniao.account.comm.widget.ErrorView
                android:id="@+id/regionError"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dimen_25"
                android:layout_below="@+id/regionL"/>
            <TextView
                android:textAppearance="@style/font_black_14_t65"
                android:id="@+id/addressDetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2"
                android:text="@string/xn_address_detail"
                android:layout_below="@+id/regionError"/>
            <com.transsion.xuanniao.account.comm.widget.NormalInput
                android:id="@+id/addressDetailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_3"
                android:layout_below="@+id/addressDetailLabel"
                app:hint_resource="@string/xn_address_detail"
                app:max_length="50"/>
            <TextView
                android:textAppearance="@style/font_black_14_t65"
                android:id="@+id/provinceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_25"
                android:text="@string/xn_province"
                android:layout_below="@+id/addressDetailInput"/>
            <com.transsion.xuanniao.account.comm.widget.NormalInput
                android:id="@+id/provinceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_3"
                android:layout_below="@+id/provinceLabel"
                app:hint_resource="@string/xn_province"
                app:max_length="50"/>
            <TextView
                android:textAppearance="@style/font_black_14_t65"
                android:id="@+id/districtLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_25"
                android:text="@string/xn_district"
                android:layout_below="@+id/provinceInput"/>
            <com.transsion.xuanniao.account.comm.widget.NormalInput
                android:id="@+id/districtInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_3"
                android:layout_below="@+id/districtLabel"
                app:hint_resource="@string/xn_district"
                app:max_length="50"/>
            <TextView
                android:textAppearance="@style/font_black_14_t65"
                android:id="@+id/postcodeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_25"
                android:text="@string/xn_postcode"
                android:layout_below="@+id/districtInput"/>
            <com.transsion.xuanniao.account.comm.widget.NormalInput
                android:id="@+id/postcodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/postcodeLabel"
                app:hint_resource="@string/xn_postcode"
                app:max_length="50"/>
            <TextView
                android:textAppearance="@style/font_black_14_t65"
                android:id="@+id/labelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_25"
                android:text="@string/xn_label"
                android:layout_below="@+id/postcodeInput"/>
            <RelativeLayout
                android:id="@+id/labelL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_3"
                android:layout_below="@+id/labelLabel">
                <ImageView
                    android:id="@+id/downArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_15_t25"
                    android:id="@+id/label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_please_select"
                    android:layout_centerVertical="true"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/downArrow"/>
                <ImageView
                    android:id="@+id/down_arrow"
                    android:layout_width="@dimen/dimen_10"
                    android:layout_height="@dimen/dimen_4"
                    android:src="@drawable/down_arrow_drawable"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <View
                    android:id="@+id/labelLine"
                    android:background="@color/xn_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dimen_16"
                    android:layout_below="@+id/label"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rlSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_25"
                android:layout_marginBottom="@dimen/dimen_32"
                android:layout_below="@+id/labelL">
                <Switch
                    android:enabled="true"
                    android:id="@+id/defaultSwitch"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:textOn=" "
                    android:textOff=" "
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_address_default"
                    android:layout_toStartOf="@+id/defaultSwitch"/>
            </RelativeLayout>
            <View
                android:id="@+id/blankL"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_140"
                android:layout_below="@+id/rlSwitch"/>
        </RelativeLayout>
    </com.transsion.widgetslib.view.OverBoundNestedScrollView>
</RelativeLayout>
