<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <ImageView
        android:id="@+id/notification_icon"
        android:layout_width="97dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/twelve_dp"
        android:paddingEnd="@dimen/twelve_dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_logo"
                android:layout_width="@dimen/fourteen_dp"
                android:layout_height="@dimen/fourteen_dp"
                android:src="@drawable/launcher_notification"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="@dimen/twelve_sp"
                android:textColor="@color/theme_fcm_title_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_logo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launcher_notice_name"
                android:singleLine="true"
                android:layout_marginStart="@dimen/six_dp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/twelve_sp"
            android:textColor="@color/theme_fcm_des_color"
            android:ellipsize="end"
            android:id="@+id/tv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
