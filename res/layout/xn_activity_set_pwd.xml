<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/xn_full_margin_start"
    android:layout_marginEnd="@dimen/xn_full_margin_end">
    <com.transsion.widgetslib.view.OverBoundNestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/os_text_primary_color"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_alignParentStart="true"/>
            <com.transsion.xuanniao.account.comm.widget.FormatView
                android:id="@+id/formatView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:layout_below="@+id/title"/>
            <com.transsion.xuanniao.account.comm.widget.PasswordInput
                android:id="@+id/oldPwdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:layout_below="@+id/formatView"
                app:hint_resource="@string/xn_pwd"/>
            <com.transsion.xuanniao.account.comm.widget.PasswordInput
                android:id="@+id/newPwdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:layout_below="@+id/oldPwdInput"
                app:hint_resource="@string/xn_set_pwd"/>
            <com.transsion.xuanniao.account.comm.widget.PasswordInput
                android:id="@+id/confirmPwdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:layout_below="@+id/newPwdInput"
                app:hint_resource="@string/xn_pwd_confirm"/>
            <com.transsion.xuanniao.account.comm.widget.ErrorView
                android:id="@+id/errorView"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/confirmPwdInput"/>
            <Button
                android:id="@+id/forgetPwd"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/xn_forget_pwd"
                android:layout_below="@+id/errorView"
                android:layout_centerHorizontal="true"
                style="@style/OS.Widget.Button.Text"/>
            <Button
                android:enabled="false"
                android:id="@+id/savePwdBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/xn_save_pwd"
                android:layout_below="@+id/forgetPwd"
                android:layout_centerHorizontal="true"
                style="@style/OS.Widget.Button.Contained.Big.Single"/>
        </RelativeLayout>
    </com.transsion.widgetslib.view.OverBoundNestedScrollView>
</RelativeLayout>
