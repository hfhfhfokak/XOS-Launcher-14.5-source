<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/theme_title"
    android:layout_width="match_parent"
    android:layout_height="@dimen/theme_title_bar_height"
    android:paddingStart="@dimen/twenty_two_dp"
    android:paddingEnd="@dimen/six_dp">
    <ImageView
        android:id="@+id/theme_title_left_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/sixteen_dp"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/theme_title_right_iv1"
        android:visibility="gone"
        android:layout_width="@dimen/forty_four_dp"
        android:layout_height="@dimen/forty_four_dp"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:contentDescription="@string/theme_online_share"
        android:layout_toStartOf="@+id/theme_title_right_iv"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/eighteen_dp"
        android:textColor="@color/th_title_text_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/theme_title_left_tv"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"
        android:layout_toStartOf="@+id/theme_title_right_iv1"
        android:layout_toEndOf="@+id/theme_title_left_iv"/>
    <ImageView
        android:id="@+id/theme_title_right_iv"
        android:layout_width="@dimen/forty_four_dp"
        android:layout_height="@dimen/forty_four_dp"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:contentDescription="@string/theme_praise"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
