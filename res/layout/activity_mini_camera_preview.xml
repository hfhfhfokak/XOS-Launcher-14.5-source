<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.cloud.tmc.miniapp.widget.photoview.PhotoView
        android:id="@+id/iv_camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_bottom"
        android:background="@color/mini_black80"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_dp_56"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/view_bottom_mid_line"
        android:background="@color/mini_color_bg_01"
        android:layout_width="@dimen/mini_dp_1"
        android:layout_height="@dimen/mini_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/view_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_bottom"/>
    <TextView
        android:textSize="@dimen/mini_sp_16"
        android:textColor="@color/mini_color_bg_01"
        android:gravity="center"
        android:id="@+id/tv_camera_retake"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_dp_56"
        android:text="Retake"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/view_bottom_mid_line"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/mini_sp_16"
        android:textColor="@color/mini_color_primary"
        android:gravity="center"
        android:id="@+id/tv_camera_use_photo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_dp_56"
        android:text="Use Photo"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view_bottom_mid_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
