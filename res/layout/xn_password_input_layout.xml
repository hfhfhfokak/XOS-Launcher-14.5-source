<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/inputL"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_38"
        android:paddingStart="@dimen/dimen_12"
        android:paddingEnd="@dimen/dimen_12">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pwdLogo"
            android:layout_width="@dimen/dimen_24"
            android:layout_height="@dimen/dimen_24"
            android:src="@drawable/xn_icon_password"
            android:tint="@color/xn_input_logo_color"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dimen_16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/eyeView"
            android:layout_width="@dimen/dimen_24"
            android:layout_height="@dimen/dimen_24"
            android:src="@drawable/xn_password_invisible"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dimen_12"
            android:layout_alignParentEnd="true"/>
        <EditText
            android:textSize="15sp"
            android:textColor="@color/os_text_primary_color"
            android:textColorHint="@color/os_text_quaternary_color"
            android:id="@+id/password_view"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_38"
            android:hint="@string/xn_pwd"
            android:singleLine="true"
            android:maxLength="16"
            android:layout_centerVertical="true"
            android:inputType="textNoSuggestions"
            android:textDirection="anyRtl"
            android:textAlignment="viewStart"
            android:layout_toStartOf="@+id/eyeView"
            android:layout_toEndOf="@+id/pwdLogo"
            android:importantForAutofill="no"/>
    </RelativeLayout>
    <View
        android:id="@+id/line"
        android:background="@color/xn_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/inputL"/>
</RelativeLayout>
