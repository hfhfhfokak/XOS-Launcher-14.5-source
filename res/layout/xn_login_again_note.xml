<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/font_black_12_t65"
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16"/>
    <View
        android:id="@+id/line"
        android:background="@color/os_gray_tertiary_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dimen_16"
        android:layout_below="@+id/note"/>
    <TextView
        android:textAppearance="@style/font_primary_15"
        android:gravity="center"
        android:id="@+id/loginAgain"
        android:background="@drawable/os_press_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_45"
        android:text="@string/xn_login_again"
        android:layout_below="@+id/line"
        android:paddingStart="@dimen/dimen_16"
        android:paddingEnd="@dimen/dimen_16"/>
    <TextView
        android:textAppearance="@style/font_primary_15"
        android:gravity="center"
        android:id="@+id/notLoginNow"
        android:background="@drawable/os_press_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_45"
        android:text="@string/xn_not_login_now"
        android:layout_below="@+id/loginAgain"
        android:paddingStart="@dimen/dimen_16"
        android:paddingEnd="@dimen/dimen_16"/>
    <TextView
        android:textAppearance="@style/font_primary_15"
        android:gravity="center"
        android:id="@+id/deleteData"
        android:background="@drawable/os_press_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_45"
        android:text="@string/xn_delete_data"
        android:layout_below="@+id/notLoginNow"
        android:paddingStart="@dimen/dimen_16"
        android:paddingEnd="@dimen/dimen_16"/>
</RelativeLayout>
