<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.library.settingbase.LauRoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/preference_item_bg_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/preference_item_padding_start"
    android:paddingEnd="@dimen/preference_item_padding_end"
    android:layout_marginStart="@dimen/preference_item_margin_start_end"
    android:layout_marginEnd="@dimen/preference_item_margin_start_end">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_marginStart="@dimen/preference_item_text_margin_start">
        <ImageView
            android:id="@+id/menu"
            android:layout_width="@dimen/preference_item_start_icon_wh"
            android:layout_height="@dimen/preference_item_start_icon_wh"
            android:src="@drawable/zs_ic_settings_subscribe_menu"
            android:layout_centerVertical="true"
            android:layout_marginEnd="13dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_list_next"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/preference_item_end_icon_margin_start"
            android:layout_marginEnd="@dimen/preference_item_end_icon_margin_end"
            android:layout_alignParentEnd="true"/>
        <RelativeLayout
            android:id="@+id/icon_container"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/menu">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/red_dot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/zs_ic_point_red"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:textDirection="locale"
            android:layout_marginStart="13dp"
            android:layout_toStartOf="@+id/arrow"
            android:layout_toEndOf="@+id/icon_container"
            style="@style/PreferenceText.Title"/>
    </RelativeLayout>
</com.transsion.xlauncher.library.settingbase.LauRoundLinearLayout>
