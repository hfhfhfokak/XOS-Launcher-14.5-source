<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/theme_title"
    android:layout_width="match_parent"
    android:layout_height="@dimen/theme_title_bar_height"
    android:importantForAccessibility="no"
    android:paddingStart="@dimen/theme_common_screen_padding">
    <FrameLayout
        android:id="@+id/local_header_back"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_theme_actionbar_back"
            android:contentDescription="@string/back"/>
    </FrameLayout>
    <com.transsion.theme.common.customview.ElegantTextView
        android:id="@+id/local_header_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/sixteen_dp"
        android:layout_toStartOf="@+id/jump_tv"
        android:layout_toEndOf="@+id/local_header_back"
        style="@style/actionbar_text_style"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/delete_head"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/sixteen_dp"
        android:layout_toStartOf="@+id/local_header_delete"
        android:layout_toEndOf="@+id/local_header_back">
        <com.transsion.theme.common.customview.ElegantTextView
            android:id="@+id/delete_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:drawableEnd="@drawable/local_more"
            style="@style/actionbar_text_style"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/local_header_delete"
        android:visibility="gone"
        android:layout_width="@dimen/theme_title_bar_height"
        android:layout_height="match_parent"
        android:contentDescription="@string/theme_del_file"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_del"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/theme_btn_del_selector"/>
    </FrameLayout>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/fourteen_sp"
        android:textColor="@color/th_title_text_color"
        android:gravity="center_vertical"
        android:id="@+id/paid_theme"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/text_payment"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/twelve_dp"
        android:layout_alignParentEnd="true"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/fourteen_dp"
        android:textColor="@color/theme_title_btn_color"
        android:gravity="center_vertical"
        android:id="@+id/jump_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="@dimen/sixteen_dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
