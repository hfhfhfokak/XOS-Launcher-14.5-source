<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/ten_dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/theme_common_text_screen_padding"
    android:paddingEnd="@dimen/theme_common_text_screen_padding">
    <RelativeLayout
        android:id="@+id/search_history_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sixteen_dp">
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="@dimen/fourteen_sp"
            android:textColor="@color/th_search_tag_text_color"
            android:gravity="center_vertical"
            android:id="@+id/search_history_text"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginBottom="@dimen/sixteen_dp"
            android:text="@string/text_search_history"/>
        <com.transsion.theme.common.FlowLayout
            android:id="@+id/search_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/search_history_text"
            app:vertical_padding="@dimen/twelve_dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/search_hot_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="@dimen/fourteen_sp"
            android:textColor="@color/th_search_tag_text_color"
            android:gravity="center_vertical"
            android:id="@+id/search_hot_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sixteen_dp"
            android:text="@string/text_search_hot"/>
        <com.transsion.theme.common.FlowLayout
            android:id="@+id/search_hot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/search_hot_text"
            app:vertical_padding="@dimen/twelve_dp"/>
    </RelativeLayout>
</LinearLayout>
