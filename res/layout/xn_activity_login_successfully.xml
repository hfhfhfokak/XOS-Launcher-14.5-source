<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/loginLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/dimen_38"
        android:src="@drawable/xn_launcher"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="@style/font_black_24"
        android:id="@+id/noteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:text="@string/xn_login_success"
        android:layout_below="@+id/loginLogo"
        android:layout_centerHorizontal="true"
        android:elegantTextHeight="true"/>
    <TextView
        android:textAppearance="@style/font_black_14"
        android:id="@+id/oldAccountNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_38"
        android:text="@string/xn_old_account_note"
        android:layout_below="@+id/noteTitle"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16"
        android:elegantTextHeight="true"/>
    <TextView
        android:textAppearance="@style/font_black_14_t65"
        android:id="@+id/oldAccounts"
        android:scrollbars="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxHeight="@dimen/dimen_180"
        android:layout_below="@+id/oldAccountNote"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16"
        android:elegantTextHeight="true"/>
    <TextView
        android:textAppearance="@style/font_black_14"
        android:id="@+id/mergeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:layout_below="@+id/oldAccounts"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16"
        android:elegantTextHeight="true"/>
    <TextView
        android:textAppearance="@style/font_black_14_t65"
        android:id="@+id/mergeTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/mergeTitle"
        android:layout_marginStart="@dimen/dimen_16"
        android:layout_marginEnd="@dimen/dimen_16"
        android:elegantTextHeight="true"/>
    <Button
        android:id="@+id/okButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_58"
        android:text="@string/xn_enter_user_center"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dimen_32"
        android:layout_marginEnd="@dimen/dimen_32"
        style="@style/OS.Widget.Button.Contained.Big.Single"/>
</RelativeLayout>
