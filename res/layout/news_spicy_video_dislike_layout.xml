<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dislike_view"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/video_dislike_cover"
        android:background="#e6000000"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/video_dislike_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/news_spicy_video_reminder"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/video_continue_cs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dislike_cs"
        android:background="@drawable/news_spicy_video_bg"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintBottom_toTopOf="@+id/ask_spicy_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_continue_cs">
        <ImageView
            android:id="@+id/dislike_img"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/dislike_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/dislike_reminder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/dislike_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prefer_dislike"
            android:layout_marginStart="4.67dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/dislike_img"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/video_continue_cs"
        android:background="@drawable/news_spicy_video_bg"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintBottom_toTopOf="@+id/dislike_cs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_dislike_title">
        <ImageView
            android:id="@+id/continue_img"
            android:layout_width="15.33dp"
            android:layout_height="15.33dp"
            android:src="@drawable/news_video_spicy_continue_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/continue_reminder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/continue_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/news_video_continue"
            android:layout_marginStart="4.67dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/continue_img"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <CheckBox
        android:id="@+id/ask_spicy_status"
        android:background="@drawable/spicy_ask_select"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:button="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ask_reminder"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dislike_cs"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/ask_reminder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/country_switch_reminder"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ask_spicy_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ask_spicy_status"
        app:layout_constraintTop_toTopOf="@+id/ask_spicy_status"/>
</androidx.constraintlayout.widget.ConstraintLayout>
