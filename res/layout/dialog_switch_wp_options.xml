<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/switch_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="66dp">
    <FrameLayout
        android:id="@+id/cancel_tv"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/switch_tv_padding_side">
        <TextView
            android:ellipsize="end"
            android:id="@+id/cancel_tv_text"
            android:background="@drawable/switch_ripple_bg_selector"
            android:clickable="false"
            android:text="@string/reset"
            android:lines="1"
            app:drawableTopCompat="@drawable/switch_dialog_cancel"
            style="@style/switch_tv_style"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/more_tv"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/switch_tv_padding_side"
        android:layout_alignParentEnd="true">
        <TextView
            android:ellipsize="end"
            android:id="@+id/more_tv_text"
            android:background="@drawable/switch_ripple_bg_selector"
            android:clickable="false"
            android:text="@string/text_theme_description_display"
            android:lines="1"
            app:drawableTopCompat="@drawable/switch_dialog_more"
            style="@style/switch_tv_style"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/switch_note"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/switch_note"
        android:lines="2"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/switch_text_padding_side"
        android:layout_toStartOf="@+id/more_tv"/>
</RelativeLayout>
