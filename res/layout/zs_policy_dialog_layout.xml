<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/ll_policy"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/os_medium_fontweight"
        android:textSize="@dimen/os_h1_font"
        android:textColor="@color/os_text_primary_color"
        android:id="@+id/policyTitle"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/os_dialog_padding_left_right"
        android:paddingEnd="@dimen/os_dialog_padding_left_right"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/os_text_secondary_color"
        android:ellipsize="end"
        android:id="@+id/policyDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/zs_dimen_8dp"
        android:maxLines="2"
        android:fontFamily="sans-serif"
        android:paddingStart="@dimen/os_dialog_padding_left_right"
        android:paddingEnd="@dimen/os_dialog_padding_left_right"/>
    <TextView
        android:scrollbarSize="3dp"
        android:scrollbarThumbVertical="@null"
        android:scrollbarStyle="insideInset"
        android:textSize="14sp"
        android:textColor="@color/lau_os_text_secondary_color_day_night"
        android:id="@+id/policyContent"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:maxHeight="@dimen/zs_dimen_164dp"
        android:paddingStart="@dimen/os_dialog_padding_left_right"
        android:paddingEnd="@dimen/os_dialog_padding_left_right"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/lau_os_text_secondary_color_day_night"
        android:id="@+id/policyAnnouncement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/zs_dimen_14dp"
        android:paddingStart="@dimen/os_dialog_padding_left_right"
        android:paddingEnd="@dimen/os_dialog_padding_left_right"/>
    <include layout="@layout/overlay_prompt_dialog_buttons_horizontal"/>
</LinearLayout>
