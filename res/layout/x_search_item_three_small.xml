<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#d6ffffff"
    android:paddingTop="11dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <TextView
        android:textSize="15sp"
        android:textColor="#222222"
        android:ellipsize="end"
        android:id="@+id/x_search_three_small_content_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="sans-serif-medium"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <ImageView
            android:id="@+id/x_search_three_small_iv1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/x_search_three_small_iv2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/x_search_three_small_iv3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="#80222222"
        android:id="@+id/x_search_three_small_come_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:background="#1f000000"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"
        android:layout_marginTop="12dp"/>
</LinearLayout>
