<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/system_share_icon_fl"
        android:background="@drawable/share_icon_background"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/system_share_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/app_icon_whatsapp_24dp"/>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/follow_init_title_color"
        android:id="@+id/syatem_share_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/whats_app"
        android:layout_below="@+id/system_share_icon_fl"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
