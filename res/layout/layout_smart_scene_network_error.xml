<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true">
    <ImageView
        android:layout_width="@dimen/zs_smart_scene_net_error_img_width"
        android:layout_height="@dimen/zs_smart_scene_net_error_img_height"
        android:src="@drawable/zs_smart_scene_net_error_img"/>
    <TextView
        android:textSize="@dimen/pn_dimen_14sp"
        android:textColor="@color/os_text_tertiary_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/zs_no_network"/>
    <TextView
        android:textSize="@dimen/pn_dimen_15sp"
        android:textColor="@color/os_platform_basic_color_os"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_no_network"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/network_settings"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
