<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:id="@+id/fl_top"
        android:background="@drawable/video_grident_bg_shape_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_54">
        <ImageView
            android:id="@+id/iv_back"
            android:background="@drawable/os_control_background_40dp"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_16"
            android:src="@drawable/zs_ic_back_white"
            android:layout_marginStart="@dimen/dp_16"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/play_btn"
        android:background="@drawable/dkplayer_shape_play_bg"
        android:padding="@dimen/dp_10"
        android:visibility="gone"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_50"
        android:src="@drawable/dkplayer_selector_play_button"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/video_grident_bg_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:id="@+id/tv_title"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:lineSpacingExtra="4dp"
            android:elevation="5dp"
            app:layout_constraintBottom_toTopOf="@+id/header"/>
        <com.scene.zeroscreen.activity.player.view.CircleImageView
            android:id="@+id/header"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginBottom="40dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/dkplayer_author_name_color"
            android:id="@+id/author_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/header"
            app:layout_constraintStart_toEndOf="@+id/header"
            app:layout_constraintTop_toTopOf="@+id/header"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.scene.zeroscreen.player.videoplayer.player.TiktokLoadingBarView
        android:layout_gravity="bottom"
        android:id="@+id/tk_loading"
        android:layout_width="match_parent"
        android:layout_height="5dp"/>
</FrameLayout>
