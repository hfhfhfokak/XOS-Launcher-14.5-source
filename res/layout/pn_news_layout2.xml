<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#d6ffffff"
    android:paddingTop="@dimen/pn_dimen_10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/pn_dimen_16sp"
        android:textColor="@color/zs_setting_title_text_color"
        android:ellipsize="end"
        android:id="@+id/tv_news2_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pn_dimen_8dp"
        android:maxLines="2"/>
    <com.scene.plugin.custom.news.view.NewsScaleImage
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_news2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pn_dimen_8dp"
        android:scaleType="centerCrop"
        app:newsRoundHeight="160.67dp"
        app:newsRoundWidth="328dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pn_dimen_8dp">
        <TextView
            android:textSize="@dimen/pn_dimen_12sp"
            android:textColor="@color/zs_text_alpha_60"
            android:id="@+id/tv_news2_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/pn_dimen_180dp"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/pn_dimen_12sp"
            android:textColor="@color/zs_text_alpha_60"
            android:id="@+id/tv_news2_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="@dimen/pn_dimen_10dp"/>
        <ImageView
            android:id="@+id/iv_eye"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pn_eye_icon"
            android:layout_marginStart="@dimen/pn_dimen_8dp"
            android:layout_marginEnd="@dimen/pn_dimen_2dp"/>
        <TextView
            android:textSize="@dimen/pn_dimen_12sp"
            android:textColor="@color/zs_text_alpha_60"
            android:layout_gravity="center"
            android:id="@+id/tv_news2_view_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:background="@color/zs_divide_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/pn_dimen_8dp"/>
</LinearLayout>
