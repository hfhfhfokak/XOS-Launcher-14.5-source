<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="@dimen/pn_dimen_30dp"
    android:paddingBottom="@dimen/pn_dimen_30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_like_news"
        android:background="@drawable/pn_like_bg"
        android:layout_width="@dimen/pn_dimen_90dp"
        android:layout_height="@dimen/pn_dimen_40dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_is_like_news"
            android:layout_width="@dimen/pn_dimen_24dp"
            android:layout_height="@dimen/pn_dimen_24dp"
            android:src="@drawable/pn_detail_like_sel_icon"
            android:layout_marginStart="@dimen/pn_dimen_12dp"/>
        <TextView
            android:textSize="@dimen/pn_dimen_14dp"
            android:textColor="@color/pn_country_text_color"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_like_news_count"
            android:layout_width="@dimen/pn_dimen_34dp"
            android:layout_height="wrap_content"
            android:text="@string/pn_like"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/pn_dimen_2dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_dislike_news"
        android:background="@drawable/pn_like_bg"
        android:layout_width="@dimen/pn_dimen_90dp"
        android:layout_height="@dimen/pn_dimen_40dp"
        android:layout_marginStart="@dimen/pn_dimen_32dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_is_dislike_news"
            android:layout_width="@dimen/pn_dimen_24dp"
            android:layout_height="@dimen/pn_dimen_24dp"
            android:src="@drawable/pn_detail_dislike_icon"
            android:layout_marginStart="@dimen/pn_dimen_12dp"/>
        <TextView
            android:textSize="@dimen/pn_dimen_11dp"
            android:textColor="@color/pn_news_comment_content_color"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_dislike_news_count"
            android:layout_width="@dimen/pn_dimen_34dp"
            android:layout_height="wrap_content"
            android:text="@string/pn_dislike"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/pn_dimen_2dp"/>
    </LinearLayout>
</LinearLayout>
