<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/theme_title_lr4_layout"/>
    <View style="@style/HorizontalLine"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="80dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/import_zip"
            android:layout_marginTop="25dp"
            style="@style/ThDiyBtnStyle">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_import_diy"/>
            <com.transsion.theme.common.customview.ElegantTextView
                android:text="@string/diy_import"
                style="@style/ThDiyTextStyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/icon_diy"
            android:layout_marginTop="12dp"
            style="@style/ThDiyBtnStyle">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_edit_diy"
                android:layout_marginStart="11dp"/>
            <com.transsion.theme.common.customview.ElegantTextView
                android:text="@string/diy_icon"
                style="@style/ThDiyTextStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
