<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/icon_color_title_container"
        layout="@layout/icon_style_item_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/colors_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.67dp">
        <com.transsion.xlauncher.iconstyle.views.IconOutLineView
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/default_icon_color_container"
            android:layout_width="@dimen/icon_color_item_out_line_width_height"
            android:layout_height="@dimen/icon_color_item_out_line_width_height"
            android:layout_marginStart="@dimen/icon_color_default_icon_margin_start"
            app:outline_style="circle">
            <ImageView
                android:id="@+id/default_icon_color"
                android:layout_width="@dimen/icon_color_list_item_width_height"
                android:layout_height="@dimen/icon_color_list_item_width_height"
                android:src="@drawable/icon_color_btn_default"/>
        </com.transsion.xlauncher.iconstyle.views.IconOutLineView>
        <View
            android:id="@+id/color_divider"
            android:background="#33a1a1a1"
            android:layout_width="0.67dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/icon_color_list"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/follow_system_container"
        android:background="@drawable/icon_style_color_follow_system_bg_selector"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="86dp"
        android:layoutDirection="locale"
        android:paddingStart="@dimen/icon_follow_system_color_padding"
        android:paddingEnd="@dimen/icon_follow_system_color_padding"
        android:layout_marginStart="@dimen/icon_follow_system_color"
        android:layout_marginEnd="@dimen/icon_follow_system_color">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layoutDirection="locale"
            android:layout_toStartOf="@+id/follow_system_switch_button"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/os_text_primary_color"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/icon_color_view_follow_system_title"
                android:fontFamily="PingFang SC"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/os_text_secondary_color"
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/icon_color_view_follow_system_title_des"
                android:textAlignment="viewStart"/>
        </LinearLayout>
        <Switch
            android:id="@+id/follow_system_switch_button"
            android:clickable="false"
            android:layout_width="40dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_alignParentEnd="true"
            style="@style/OS.Widget.Switch"/>
    </RelativeLayout>
</LinearLayout>
