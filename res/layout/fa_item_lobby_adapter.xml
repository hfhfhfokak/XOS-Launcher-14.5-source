<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="6dp">
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="250dp"
        android:layout_height="116dp"
        android:scaleType="centerCrop"
        android:contentDescription="flashapp_image_bg"/>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/iv_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="41dp"
        android:scaleType="centerCrop"
        android:contentDescription="flashapp_image_icon"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/item_home_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:singleLine="true"/>
</androidx.cardview.widget.CardView>
