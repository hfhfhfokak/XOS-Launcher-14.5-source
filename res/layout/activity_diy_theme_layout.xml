<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ListView
        android:id="@+id/listview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/theme_common_item_padding"
        android:layout_above="@+id/apply_layout"
        android:layout_marginStart="@dimen/theme_common_screen_padding"
        android:layout_marginEnd="@dimen/theme_common_screen_padding"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/header_height">
        <com.spinkit.SpinKitView
            android:layout_gravity="center"
            android:id="@+id/icon_loading_progress"
            android:visibility="gone"
            android:layout_width="@dimen/forty_eight_dp"
            android:layout_height="@dimen/forty_eight_dp"
            app:SpinKit_Color="@color/loading_progress_color"/>
    </FrameLayout>
    <com.transsion.theme.easydiy.view.PreviewHeadView
        android:id="@+id/header_picture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/apply_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:id="@+id/apply_rl"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sixty_eight_dp">
            <com.transsion.theme.common.customview.ElegantTextView
                android:textSize="@dimen/fifteen_sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/step_tv"
                android:background="@drawable/theme_download_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/thirty_six_dp"
                android:layout_marginTop="@dimen/twelve_dp"
                android:text="@string/theme_next"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/theme_detail_download_btn_margin_total"
                android:layout_marginEnd="@dimen/theme_detail_download_btn_margin_total"/>
        </RelativeLayout>
        <include layout="@layout/theme_button_gap_layout"/>
    </LinearLayout>
</RelativeLayout>
