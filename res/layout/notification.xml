<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.popup.NotificationContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_view"
    android:background="@drawable/bg_white_round_rect"
    android:paddingBottom="@dimen/popup_rect_radius"
    android:layout_width="@dimen/popup_container_width"
    android:layout_height="wrap_content"
    android:elevation="@dimen/deep_shortcuts_elevation">
    <RelativeLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/header"
            android:background="@drawable/bg_white_round_rect_upper"
            android:layout_width="match_parent"
            android:layout_height="@dimen/notification_header_height"
            android:paddingStart="@dimen/popup_padding_start"
            android:paddingEnd="@dimen/launcher_notification_padding_end"
            android:elevation="@dimen/notification_elevation">
            <TextView
                android:textSize="@dimen/notification_header_text_size"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center_vertical"
                android:layout_gravity="start"
                android:id="@+id/notification_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/notifications_header"/>
            <TextView
                android:textSize="@dimen/notification_header_count_text_size"
                android:textColor="?android:attr/textColorPrimary"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/notification_count"
                android:layout_width="@dimen/notification_icon_size"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"/>
        </FrameLayout>
        <include
            android:id="@+id/main_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/notification_content_height"
            android:layout_below="@+id/header"
            layout="@layout/notification_main"/>
        <View
            android:id="@+id/divider"
            android:background="?android:attr/listDivider"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/popup_item_divider_height"
            android:layout_below="@+id/main_view"/>
        <include
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/notification_footer_height"
            android:layout_below="@+id/divider"
            layout="@layout/notification_footer"/>
    </RelativeLayout>
</com.transsion.xlauncher.popup.NotificationContainer>
