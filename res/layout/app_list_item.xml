<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/os_list_item_view_bg_corners"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_50">
    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_18"
        android:layout_marginBottom="@dimen/dp_18"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/mutil_task_ninety_degree_conner_card_app_name_color"
        android:ellipsize="end"
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_90"
        android:layout_toEndOf="@+id/appIcon"/>
    <Switch
        android:id="@+id/appSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textOn=""
        android:textOff=""
        android:layout_centerVertical="true"
        android:switchMinWidth="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_alignParentEnd="true"
        style="@style/OS.Widget.Switch"/>
</RelativeLayout>
