<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/mini_dp_232"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/mini_shape_share_dialog_bg"
        android:layout_width="@dimen/mini_dp_232"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/mini_dp_32"
            android:layout_height="@dimen/mini_dp_32"
            android:layout_marginTop="@dimen/mini_dp_16"
            android:layout_marginStart="@dimen/mini_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mini_dp_8"
            android:layout_marginEnd="@dimen/mini_dp_16"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_logo"
            app:layout_constraintTop_toTopOf="@+id/iv_logo">
            <TextView
                android:textSize="@dimen/mini_sp_14"
                android:textColor="@color/mini_color_title_text"
                android:ellipsize="end"
                android:id="@+id/tv_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="@dimen/mini_sp_10"
                android:textColor="@color/mini_color_element_03"
                android:ellipsize="end"
                android:id="@+id/tv_company_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mini_dp_2"
                android:maxLines="1"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/fl_qrcode"
            android:background="@drawable/drawable_share_qr_bg"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mini_dp_12"
            android:layout_marginStart="@dimen/mini_dp_16"
            android:layout_marginEnd="@dimen/mini_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_logo">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_qrcode"
                android:layout_width="@dimen/mini_dp_200"
                android:layout_height="@dimen/mini_dp_200"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/mini_sp_10"
            android:textColor="@color/mini_color_element_02"
            android:id="@+id/tv_share_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mini_dp_12"
            android:text="@string/mini_dialog_qrcode_notice"
            android:lineSpacingExtra="@dimen/mini_dp_4"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/fl_qrcode"
            app:layout_constraintStart_toStartOf="@+id/fl_qrcode"
            app:layout_constraintTop_toBottomOf="@+id/fl_qrcode"/>
        <TextView
            android:textSize="@dimen/mini_sp_14"
            android:textStyle="bold"
            android:textColor="@color/mini_color_title_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_save_btn"
            android:background="@drawable/sel_share_dialog_btn_bg"
            android:clickable="true"
            android:layout_width="@dimen/mini_dp_200"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mini_dp_16"
            android:minHeight="@dimen/mini_dp_36"
            android:text="@string/mini_dialog_qrcode_save"
            android:maxLines="1"
            android:paddingStart="@dimen/mini_dp_16"
            android:paddingEnd="@dimen/mini_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_share_notice"/>
        <View
            android:layout_width="@dimen/mini_dp_1"
            android:layout_height="@dimen/mini_dp_16"
            app:layout_constraintTop_toBottomOf="@+id/tv_save_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/iv_close"
        android:layout_width="@dimen/mini_dp_32"
        android:layout_height="@dimen/mini_dp_32"
        android:layout_marginTop="@dimen/mini_dp_24"
        app:srcCompat="@drawable/sel_share_dialog_close_img"/>
</LinearLayout>
