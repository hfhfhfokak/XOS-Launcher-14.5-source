<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/head_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/htmlact_ic_default"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/ad_content_text_size"
            android:textStyle="bold"
            android:textColor="@color/htmlact_head_text_color"
            android:id="@+id/head_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_below="@+id/head_icon"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_below="@+id/head">
        <Button
            android:id="@+id/loading_retry"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_retry"
            android:layout_below="@+id/progress_prompt"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="@dimen/ad_content_text_size"
            android:textStyle="normal"
            android:textColor="@color/htmlact_head_text_color"
            android:id="@+id/progress_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Loading Failed"
            android:layout_below="@+id/loading_progress"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true"/>
        <com.transsion.xlauncher.library.engine.widget.CycleLoading
            android:id="@+id/loading_progress"
            android:layout_width="60dp"
            android:layout_height="7dp"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/ad_all_content"
        android:background="@color/transparent"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/loading">
        <ImageView
            android:id="@+id/closeAd"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/htmlact_ic_cancel"
            android:layout_alignParentTop="true"
            android:layout_alignEnd="@+id/native_layout"/>
        <com.zero.mediation.ad.view.TAdNativeView
            android:id="@+id/native_layout"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/closeAd"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
