<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.transsion.xlauncher.base.SpringRelativeLayout
        android:id="@+id/layout_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/layout_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsion.theme.common.customview.RoundCornerImageView
                android:id="@+id/item_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:roundCornerRadius="14dp"/>
        </FrameLayout>
        <com.transsion.theme.common.customview.RoundCornerImageView
            android:id="@+id/item_using"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_theme_using"
            android:scaleType="centerCrop"
            android:layout_alignRight="@+id/layout_preview"
            android:layout_alignBottom="@+id/layout_preview"
            app:riv_corner_radius_bottom_right="14dp"/>
    </com.transsion.xlauncher.base.SpringRelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/lau_os_text_primary_color_day_night"
        android:gravity="center"
        android:id="@+id/item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/layout_image"/>
</RelativeLayout>
