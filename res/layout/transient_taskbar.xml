<?xml version="1.0" encoding="utf-8"?>
<com.android.quickstep.src.com.android.launcher3.taskbar.TaskbarDragLayer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskbar_container"
    android:focusable="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.android.quickstep.src.com.android.launcher3.taskbar.TaskbarSplitBackgroundView
        android:layout_gravity="bottom"
        android:id="@+id/taskbar_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.android.quickstep.src.com.android.launcher3.taskbar.TaskbarView
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/taskbar_view"
        android:focusable="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:forceHasOverlappingRendering="false"/>
    <com.android.quickstep.src.com.android.launcher3.taskbar.TaskbarScrimView
        android:id="@+id/taskbar_scrim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.android.quickstep.src.com.android.launcher3.taskbar.bubbles.BubbleBarView
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:id="@+id/taskbar_bubbles"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/bubblebar_size"
        android:layout_marginBottom="@dimen/transient_taskbar_bottom_margin"
        android:paddingStart="@dimen/taskbar_icon_spacing"
        android:paddingEnd="@dimen/taskbar_icon_spacing"
        android:layout_marginEnd="@dimen/transient_taskbar_bottom_margin"/>
    <FrameLayout
        android:layout_gravity="bottom|right"
        android:id="@+id/navbuttons_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/start_contextual_buttons"
            android:paddingTop="@dimen/taskbar_contextual_padding_top"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/taskbar_contextual_button_padding"
            android:paddingEnd="@dimen/taskbar_contextual_button_padding"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:id="@+id/end_nav_buttons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layoutDirection="ltr"/>
        <FrameLayout
            android:gravity="center_vertical"
            android:layout_gravity="right"
            android:id="@+id/end_contextual_buttons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom|left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="left"
            android:id="@+id/all_app_button"
            android:layout_width="@dimen/taskbar_nav_buttons_size_height"
            android:layout_height="@dimen/taskbar_nav_buttons_size_height"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:src="@drawable/taskbar_all_apps"
            android:scaleType="center"
            android:tint="@color/taskbar_nav_icon_light_color"
            android:alpha="0"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/hide_icon_container"
            android:layout_width="@dimen/taskbar_nav_buttons_size_height"
            android:layout_height="@dimen/taskbar_nav_buttons_size_height">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/hide_icon_anim"
                android:background="@drawable/taskbar_temp_hide_anim_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/hide_icon"
                android:layout_width="@dimen/taskbar_nav_buttons_size_height"
                android:layout_height="@dimen/taskbar_nav_buttons_size_height"
                android:src="@drawable/taskbar_hide_taskbar_btn"
                android:scaleType="center"
                android:tint="@color/taskbar_nav_icon_light_color"/>
        </FrameLayout>
    </FrameLayout>
    <com.android.quickstep.src.com.android.launcher3.taskbar.StashedHandleView
        android:layout_gravity="bottom"
        android:id="@+id/stashed_handle"
        android:background="@color/taskbar_stashed_handle_dark_color"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipToOutline="true"/>
    <com.android.quickstep.src.com.android.launcher3.taskbar.StashedHandleView
        android:layout_gravity="bottom"
        android:id="@+id/stashed_bubble_handle"
        android:background="@color/taskbar_stashed_handle_dark_color"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.android.quickstep.src.com.android.launcher3.taskbar.TaskbarDragLayer>
