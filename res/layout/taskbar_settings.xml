<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="#f7f7f7"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_toolbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/setting_guide_fragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_items"
                android:background="@drawable/taskbar_settings_main_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginBottom="20dp">
                <RelativeLayout
                    android:id="@+id/task_bar_item"
                    android:background="@drawable/os_list_item_view_bg_corners"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_60"
                    android:paddingStart="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_16">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:id="@+id/taskbar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/taskbar"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:layout_toStartOf="@+id/taskbar_check"
                        android:layout_alignParentStart="true"/>
                    <Switch
                        android:id="@+id/taskbar_check"
                        android:layout_width="@dimen/dimen_40"
                        android:layout_height="22dp"
                        android:checked="true"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        style="@style/OS.Widget.Switch"/>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_60"
                    android:paddingEnd="@dimen/dp_16">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/temp_hide_item"
                        android:background="@drawable/os_list_item_view_bg_corners"
                        android:paddingTop="@dimen/dp_6"
                        android:paddingBottom="@dimen/dp_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_centerVertical="true"
                        android:paddingStart="@dimen/dp_16">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:id="@+id/temp_hide"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/taskbar_temp_hide_title"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#66000000"
                            android:id="@+id/temp_hide_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/taskbar_temp_hide_title_hint"/>
                    </LinearLayout>
                    <View
                        android:background="@drawable/bg_hide_taskbar_divider"
                        android:layout_width="1dp"
                        android:layout_height="16dp"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:layout_toStartOf="@+id/taskbar_temp_hide_check"/>
                    <Switch
                        android:id="@+id/taskbar_temp_hide_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        style="@style/OS.Widget.Switch"/>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/ll_nav_settings"
                    android:background="@drawable/os_list_item_view_bg_corners"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_60"
                    android:paddingStart="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_16">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:layout_toStartOf="@+id/ll_nav_switch"
                        android:layout_alignParentStart="true">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:ellipsize="end"
                            android:id="@+id/nav_pos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/taskbar_nav_position"
                            android:maxLines="2"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#66000000"
                            android:id="@+id/nav_pos_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/taskbar_nav_position_hint"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_nav_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#66000000"
                            android:id="@+id/tv_nav_dir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nav_right"/>
                        <ImageView
                            android:id="@+id/iv_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/taskbar_nav_arrow_down_right"/>
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/recent_hide_item"
                    android:background="@drawable/os_list_item_view_bg_corners"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_60"
                    android:paddingStart="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_16">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_centerVertical="true">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:id="@+id/recent_hide"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/taskbar_recent"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#66000000"
                            android:id="@+id/recent_hide_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/taskbar_recent_hint"/>
                    </LinearLayout>
                    <Switch
                        android:gravity="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/recent_hide_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        style="@style/OS.Widget.Switch"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
