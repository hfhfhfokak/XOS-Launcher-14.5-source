<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/detail_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/os_action_bar_height">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ly_back"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_toStartOf="@+id/ly_share"
                android:layout_alignParentStart="true">
                <ImageView
                    android:gravity="center"
                    android:id="@+id/tv_back"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/os_ic_back"
                    android:scaleType="centerInside"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
                <TextView
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/flashapp_appname"
                    android:maxLines="1"
                    style="@style/OSActionBarTitleCompat"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ly_share"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/tv_share"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/fa_ic_share"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/fa_color_000000_DEDEDE"
            android:layout_gravity="center"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jedi survival: exciting battlefields"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/fa_color_222222_99DEDEDE"
        android:gravity="start"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tv_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Genuine Chicken Hand Tour Stimulating the Battlefield a new summer version of the passion of a summer shock! New map - rain forest map, San no, 4*4 mode, make fighting more intense!"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <RelativeLayout
        android:id="@+id/rl_button_play"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <Button
            android:id="@+id/btn_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text="@string/flashapp_play"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:contentDescription="flashapp_play_button"
            style="@style/OS.Widget.Button.Contained.Big.Single"/>
    </RelativeLayout>
</LinearLayout>
