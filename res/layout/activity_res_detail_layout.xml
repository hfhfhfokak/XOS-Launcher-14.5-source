<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextureView
        android:id="@+id/preview_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/preview_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:background="@drawable/shape_walldetail_mask"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_hundred_dp"/>
    <View
        android:background="@drawable/shape_walldetail_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_hundred_dp"
        android:layout_alignParentBottom="true"/>
    <RelativeLayout
        android:id="@+id/video_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/resource_download_action">
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="@dimen/thirty_sp"
            android:textColor="@android:color/white"
            android:id="@+id/head_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/one_hundred_thirty_dp"
            android:text="@string/video_show_preview_name"
            android:shadowColor="#7c000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-medium"/>
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="@dimen/twenty_four_sp"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nine_dp"
            android:text="@string/video_show_preview_num"
            android:shadowColor="#7c000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:layout_below="@+id/head_name"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-medium"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/forty_eight_dp"
            android:layout_alignParentBottom="true"
            android:layoutDirection="ltr"
            android:layout_marginStart="@dimen/fifty_one_dp"
            android:layout_marginEnd="@dimen/fifty_one_dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_call_reject"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_call_answer"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:fitsSystemWindows="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/resdetail_back_iv"
            android:padding="@dimen/twelve_dp"
            android:layout_width="@dimen/forty_eight_dp"
            android:layout_height="@dimen/forty_eight_dp"
            android:layout_marginLeft="@dimen/four_dp"
            android:src="@drawable/ic_theme_actionbar_back"
            android:tint="@android:color/white"
            android:minWidth="@dimen/twenty_eight_dp"/>
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="@dimen/fourteen_sp"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:id="@+id/resource_size"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/forty_eight_dp"
            android:fontFamily="sans-serif"
            android:layout_marginEnd="@dimen/sixteen_dp"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/resdetail_reload"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_theme_reload"
            android:layout_centerInParent="true"/>
        <ProgressBar
            android:id="@+id/loading_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/resource_download_action"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fifty_six_dp"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/theme_detail_download_btn_margin_total"
            android:layout_marginEnd="@dimen/theme_detail_download_btn_margin_end">
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/downing_state"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="@dimen/thirty_six_dp"
                android:layout_weight="1">
                <ProgressBar
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/downing_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ProgressBar_Mini_Vs"/>
                <com.transsion.theme.common.customview.ElegantTextView
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:id="@+id/downing_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <FrameLayout
                android:layout_width="@dimen/forty_eight_dp"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/downing_stop"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_vs_download_stop"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/downing_going"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_vs_download_going"/>
            </FrameLayout>
        </LinearLayout>
        <Button
            android:textColor="#ffffffff"
            android:id="@+id/btn_download_resource"
            android:background="@drawable/th_fullscreen_download_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_six_dp"
            android:text="@string/text_theme_download"
            android:layout_centerVertical="true"
            android:textAllCaps="true"
            android:layout_marginStart="@dimen/theme_detail_download_btn_margin_total"
            android:layout_marginEnd="@dimen/theme_detail_download_btn_margin_total"
            style="?android:attr/borderlessButtonStyle"/>
    </RelativeLayout>
</RelativeLayout>
