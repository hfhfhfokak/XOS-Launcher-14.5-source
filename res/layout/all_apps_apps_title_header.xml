<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="@dimen/ten_dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/all_app_gap"
        android:layout_width="match_parent"
        android:layout_height="@dimen/all_apps_title_top_margin"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_all_app_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_az_all_app_title"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="@dimen/recent_all_title_header_padding"/>
</LinearLayout>
