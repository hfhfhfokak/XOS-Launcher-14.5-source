<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/mini_round_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/mini_color_element_01"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:text=""
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/mini_gray_92969e"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:text=""
        android:fontFamily="sans-serif"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_dont_ask_again"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content">
        <ImageView
            android:id="@+id/btn_dont_ask_agagin"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/mini_checkbox_bg"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/mini_color_element_01"
            android:id="@+id/tv_dont_ask_again"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <View
        android:id="@+id/line_h"
        android:background="@color/mini_color_divider_01"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_dont_ask_again"/>
    <View
        android:id="@+id/line_v"
        android:background="@color/mini_color_divider_01"
        android:layout_width="0.5dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line_h"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/mini_gray_92969e"
        android:gravity="center"
        android:id="@+id/btn_negative"
        android:background="@drawable/mini_dialog_pressed_left_bg"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text=""
        android:fontFamily="sans-serif"
        app:layout_constraintEnd_toStartOf="@+id/line_v"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line_h"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/mini_color_element_01"
        android:gravity="center"
        android:id="@+id/btn_positive"
        android:background="@drawable/mini_dialog_pressed_right_bg"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text=""
        android:fontFamily="sans-serif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/line_v"
        app:layout_constraintTop_toBottomOf="@+id/line_h"/>
</androidx.constraintlayout.widget.ConstraintLayout>
