<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/popup_bg"
        android:background="@color/comfirm_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/popup_content"
        android:background="@drawable/fa_comfirm_dialog_style"
        android:layout_width="328dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/fa_color_000000_DEDEDE"
            android:gravity="center"
            android:layout_gravity="left"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="@string/flashapp_is_quit_app"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/fa_comfirm_dialog_style"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="12dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/fa_comfirm_cancel_textcolor"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_left"
                android:background="@drawable/fa_comfirm_background_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="148dp"
                android:minWidth="72dp"
                android:text="@string/flashapp_cancel"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/fa_comfirm_quit_textcolor"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_right"
                android:background="@drawable/fa_comfirm_background_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="148dp"
                android:minWidth="72dp"
                android:text="@string/flashapp_quit"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
