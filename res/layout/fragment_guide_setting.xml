<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/fragmentRelativeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="312dp">
        <androidx.viewpager2.widget.ViewPager2
            android:layout_gravity="center_horizontal"
            android:id="@+id/vp_guide"
            android:layout_width="match_parent"
            android:layout_height="280dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/progress_point"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true">
                <View
                    android:id="@+id/page_indicator1"
                    android:background="@color/widget_indicator_color"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"/>
                <View
                    android:id="@+id/page_indicator2"
                    android:background="@color/widget_indicator_color"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#66000000"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:minHeight="@dimen/dimen_48"/>
</LinearLayout>
