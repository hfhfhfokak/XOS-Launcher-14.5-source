<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsion.widgetslib.view.OverBoundNestedScrollView
        android:id="@+id/scrollView"
        android:background="@color/mutil_task_bg_color"
        android:paddingBottom="@dimen/dp_50"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/mutil_task_ninety_degree_conner_card_title_color"
                android:gravity="center_vertical"
                android:id="@+id/lockTextView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/pn_dimen_34dp"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/recent_task_option_locked_title"
                android:paddingStart="@dimen/dp_26"
                android:layout_marginStart="0dp"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/lockedCardView"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"
                app:cardBackgroundColor="#f7f7f7"
                app:cardCornerRadius="@dimen/dp_15"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/lockedViewGroup"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.cardview.widget.CardView>
            <View
                android:id="@+id/dividerLine"
                android:background="@color/mutil_task_divider_line_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/pn_dimen_12dp"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/mutil_task_ninety_degree_conner_card_title_color"
                android:gravity="center_vertical"
                android:id="@+id/unLockTextView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/pn_dimen_34dp"
                android:layout_marginTop="@dimen/pn_dimen_16dp"
                android:text="@string/recent_task_option_unlocked_title"
                android:paddingStart="@dimen/dp_26"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/unLockedCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"
                app:cardCornerRadius="@dimen/dp_15"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/unLockedViewGroup"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </com.transsion.widgetslib.view.OverBoundNestedScrollView>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/navigation_toolbar_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/ToolbarTitle"
            android:paddingBottom="@dimen/dimen_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/recent_task_option_lock_manage"/>
    </androidx.appcompat.widget.Toolbar>
</RelativeLayout>
