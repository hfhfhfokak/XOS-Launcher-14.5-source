<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/theme_title_lr4_layout"/>
    <View style="@style/HorizontalLine"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.wuxiaolong.pullloadmorerecyclerview.PullLoadMoreRecyclerView
            android:id="@+id/resource_list"
            android:paddingTop="@dimen/ten_dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/theme_common_screen_padding_with_item_padding"
            android:layout_marginEnd="@dimen/theme_common_screen_padding_with_item_padding"/>
        <com.transsion.theme.common.customview.RefreshView
            android:id="@+id/refresh_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
