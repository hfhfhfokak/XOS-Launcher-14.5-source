<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:view="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/x_search_card_item_selector"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_dialog_item_height"
    android:paddingStart="@dimen/widget_dialog_left_right_margin"
    android:paddingEnd="@dimen/widget_dialog_left_right_margin">
    <ImageView
        android:id="@+id/widget_cell_preview"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/widget_text_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/widget_cell_title"
        android:fadingEdge="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:fontFamily="sans-serif"
        android:textDirection="locale"
        android:layout_marginStart="16dp"
        android:layout_toStartOf="@+id/summary"
        android:layout_toEndOf="@+id/widget_cell_preview"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:maxLength="25"
        android:layout_centerVertical="true"
        android:drawableEnd="@drawable/ic_list_next"
        android:textAlignment="viewStart"
        android:layout_alignParentEnd="true"
        style="@style/PreferenceText.Summary"/>
</RelativeLayout>
