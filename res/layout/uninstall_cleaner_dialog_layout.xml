<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="@dimen/uninstall_cleaner_dialog_width"
    android:layout_height="@dimen/uninstall_cleaner_dialog_height">
    <TextView
        android:textSize="18dp"
        android:textColor="@color/clean_reminder_text_color"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/uninstall_cleaner_dialog_title"
        android:layout_width="224dp"
        android:layout_height="22dp"
        android:layout_marginTop="16dp"
        android:text="@string/uninstall_reminder_dialog_title"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"/>
    <Button
        android:textSize="16dp"
        android:textColor="#fafafa"
        android:id="@+id/uninstall_cleaner_dialog_ok_btn"
        android:background="@drawable/bg_emoji_dialog_ok_btn"
        android:layout_width="236dp"
        android:layout_height="36dp"
        android:layout_marginBottom="20dp"
        android:text="@string/uninstall_reminder_dialog_clean_btn"
        android:maxLines="1"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        android:layout_above="@+id/uninstall_cleaner_dialog_ok_btn"
        android:layout_below="@+id/uninstall_cleaner_dialog_title"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp">
        <ImageView
            android:id="@+id/uninstall_cleaner_dialog_icon"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/clean_reminder_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/uninstall_reminder_dialog_msg"
            android:maxLines="2"
            android:fontFamily="sans-serif"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/uninstall_cleaner_dialog_close_btn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/ic_uninstall_dialog_close"
        android:layout_marginEnd="2dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
