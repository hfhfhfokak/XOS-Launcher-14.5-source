<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.defaultlauncher.widget.DLBackKeyListenerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_launcher_home_setting_empty_space_height"/>
        <RelativeLayout
            android:layout_gravity="bottom"
            android:background="@color/default_launcher_background_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/default_launcher_home_setting_circle_1"/>
            <ImageView
                android:layout_gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/default_launcher_home_setting_circle_2"
                android:layout_marginEnd="@dimen/default_launcher_home_setting_circle2_margin_end"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="@dimen/default_launcher_home_setting_title_text_size"
                android:textColor="@color/default_launcher_home_setting_title_color"
                android:ellipsize="end"
                android:id="@+id/default_launcher_home_setting_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_launcher_home_setting_title_marigin_top"
                android:text="@string/default_launcher_home_setting_title"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/default_launcher_home_setting_view_padding"
                android:layout_marginEnd="@dimen/default_launcher_home_setting_view_padding"/>
            <TextView
                android:textSize="@dimen/default_launcher_home_setting_summary_text_size"
                android:textColor="@color/default_launcher_home_setting_title_color"
                android:id="@+id/default_launcher_home_setting_summary_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_launcher_home_setting_summary_marigin_top"
                android:layout_marginBottom="@dimen/default_launcher_home_setting_summary_marigin_bottom"
                android:layout_below="@+id/default_launcher_home_setting_title_tv"
                android:layout_marginStart="@dimen/default_launcher_home_setting_view_padding"
                android:layout_marginEnd="@dimen/default_launcher_home_setting_view_padding"/>
            <Button
                android:textSize="@dimen/default_launcher_home_setting_ok_btn_text_size"
                android:textColor="@color/default_launcher_background_white"
                android:id="@+id/default_launcher_home_setting_ok_btn"
                android:background="@drawable/default_launcher_home_setting_ok_btn_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/default_launcher_home_setting_ok_btn_height"
                android:layout_marginBottom="@dimen/default_launcher_home_setting_ok_btn_margin_bottom"
                android:text="@android:string/ok"
                android:layout_below="@+id/default_launcher_home_setting_summary_tv"
                android:layout_marginStart="@dimen/default_launcher_home_setting_view_padding"
                android:layout_marginEnd="@dimen/default_launcher_home_setting_view_padding"/>
        </RelativeLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/default_launcher_home_setting_icon"
        android:layout_width="@dimen/default_launcher_home_setting_icon_width"
        android:layout_height="@dimen/default_launcher_home_setting_icon_width"/>
</com.transsion.xlauncher.defaultlauncher.widget.DLBackKeyListenerView>
