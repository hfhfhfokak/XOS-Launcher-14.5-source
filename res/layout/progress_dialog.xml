<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/progress_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    launcher:layout_ignoreInsets="true">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/sort_progressBar"
        android:background="@drawable/x_sort_progress_bg"
        android:clickable="false"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:indeterminateDrawable="@drawable/x_sort_progress"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
