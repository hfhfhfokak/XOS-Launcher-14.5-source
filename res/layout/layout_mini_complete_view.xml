<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#44444444"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/stop_fullscreen"
        android:visibility="gone"
        android:layout_width="@dimen/btn_back"
        android:layout_height="@dimen/btn_back"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="9dp"
        android:src="@drawable/mini_ic_video_back"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_replay"
            android:layout_width="@dimen/play_btn_size"
            android:layout_height="@dimen/play_btn_size"
            android:src="@drawable/mini_ic_video_replay"/>
    </LinearLayout>
</FrameLayout>
