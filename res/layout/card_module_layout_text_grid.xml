<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsion.cardlibrary.element.RoundImageElement
        android:tag="@string/card_module_key_bg_image_url"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/card_normal_shape_bg"
        android:scaleType="centerCrop"
        android:layout_alignBottom="@+id/card_space_view"
        android:layout_alignParentTop="true"
        app:shapeAppearance="@style/RoundedStyleItem"
        app:strokeColor="@null"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/card_title_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_library_9dp"
        android:layoutDirection="locale">
        <com.transsion.cardlibrary.element.RoundImageElement
            android:tag="@string/card_module_key_logo"
            android:layout_width="@dimen/card_library_18dp"
            android:layout_height="@dimen/card_library_18dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/card_library_14dp"
            app:shapeAppearance="@style/RoundedStyleLogo"
            app:strokeColor="@null"/>
        <com.transsion.cardlibrary.element.TextElement
            android:textSize="12sp"
            android:textColor="@color/card_text_normal_color"
            android:ellipsize="end"
            android:tag="@string/card_module_key_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/card_library_5dp"/>
    </LinearLayout>
    <com.transsion.cardlibrary.view.AbilityLinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_module_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_library_14dp"
        android:layout_below="@+id/card_title_ll"
        android:layout_marginStart="@dimen/card_library_14dp"
        android:layout_marginEnd="@dimen/card_library_14dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1">
                <com.transsion.cardlibrary.element.RoundImageElement
                    android:tag="@string/card_module_key_bg_image_url1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/card_grid_item_bg"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/RoundedStyleElement"
                    app:strokeColor="@null"/>
                <com.transsion.cardlibrary.element.RoundImageElement
                    android:id="@+id/card_more_button_icon_left"
                    android:tag="@string/card_module_key_logo1"
                    android:layout_width="@dimen/card_library_28dp"
                    android:layout_height="@dimen/card_library_28dp"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/card_library_14dp"
                    app:shapeAppearance="@style/RoundedStyleElement"
                    app:strokeColor="@null"/>
                <com.transsion.cardlibrary.element.TextElement
                    android:textSize="12sp"
                    android:textColor="@color/card_text_normal_color"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:tag="@string/card_module_key_title1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/card_library_11dp"
                    android:layout_toEndOf="@+id/card_more_button_icon_left"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/card_library_10dp">
                <com.transsion.cardlibrary.element.RoundImageElement
                    android:tag="@string/card_module_key_bg_image_url2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/card_grid_item_bg"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/RoundedStyleElement"
                    app:strokeColor="@null"/>
                <com.transsion.cardlibrary.element.RoundImageElement
                    android:id="@+id/card_more_button_icon_right"
                    android:tag="@string/card_module_key_logo2"
                    android:layout_width="@dimen/card_library_28dp"
                    android:layout_height="@dimen/card_library_28dp"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/card_library_14dp"
                    app:shapeAppearance="@style/RoundedStyleElement"
                    app:strokeColor="@null"/>
                <com.transsion.cardlibrary.element.TextElement
                    android:textSize="12sp"
                    android:textColor="@color/card_text_normal_color"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:tag="@string/card_module_key_title2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/card_library_11dp"
                    android:layout_toEndOf="@+id/card_more_button_icon_right"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/card_logo_left"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/card_library_10dp"
                android:layout_weight="1">
                <com.transsion.cardlibrary.element.RoundImageElement
                    android:tag="@string/card_module_key_bg_image_url3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/card_grid_item_bg"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/RoundedStyleElement"
                    app:strokeColor="@null"/>
                <com.transsion.cardlibrary.element.RoundImageElement
                    android:id="@+id/card_more_button_logo_left"
                    android:tag="@string/card_module_key_logo3"
                    android:layout_width="@dimen/card_library_28dp"
                    android:layout_height="@dimen/card_library_28dp"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/card_library_14dp"
                    app:shapeAppearance="@style/RoundedStyleElement"
                    app:strokeColor="@null"/>
                <com.transsion.cardlibrary.element.TextElement
                    android:textSize="12sp"
                    android:textColor="@color/card_text_normal_color"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:tag="@string/card_module_key_title3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/card_library_11dp"
                    android:layout_toEndOf="@+id/card_more_button_logo_left"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/card_logo_right"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/card_library_10dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/card_library_10dp">
                <com.transsion.cardlibrary.element.RoundImageElement
                    android:tag="@string/card_module_key_bg_image_url4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/card_grid_item_bg"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/RoundedStyleElement"
                    app:strokeColor="@null"/>
                <com.transsion.cardlibrary.element.RoundImageElement
                    android:id="@+id/card_more_button_logo_right"
                    android:tag="@string/card_module_key_logo4"
                    android:layout_width="@dimen/card_library_28dp"
                    android:layout_height="@dimen/card_library_28dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/card_library_14dp"
                    app:shapeAppearance="@style/RoundedStyleElement"
                    app:strokeColor="@null"/>
                <com.transsion.cardlibrary.element.TextElement
                    android:textSize="12sp"
                    android:textColor="@color/card_text_normal_color"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:tag="@string/card_module_key_title4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/card_library_11dp"
                    android:layout_toEndOf="@+id/card_more_button_logo_right"/>
            </RelativeLayout>
        </LinearLayout>
    </com.transsion.cardlibrary.view.AbilityLinearLayout>
    <View
        android:id="@+id/card_space_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_library_14dp"
        android:layout_below="@+id/ll_module_more"/>
</RelativeLayout>
