<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/subscribe_dialog"
    android:layout_width="match_parent"
    android:layout_height="@dimen/setting_subscribe_dialog_height">
    <ImageView
        android:id="@+id/card_preview"
        android:layout_width="316dp"
        android:layout_height="161dp"
        android:layout_marginTop="50dp"
        android:layout_below="@+id/card_summary"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp">
        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/os_text_primary_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/card_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="28dp"
            android:lines="1"
            android:layout_marginStart="16dp"
            android:lineHeight="22sp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/os_text_tertiary_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/card_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="40dp"
        android:lines="2"
        android:layout_below="@+id/title_container"
        android:layout_centerHorizontal="true"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:lineHeight="19sp"/>
    <Button
        android:id="@+id/card_button"
        android:layout_width="@dimen/lau_bottom_sheet_button_width"
        android:layout_height="36dp"
        android:text="订阅"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/OS.Widget.Button.Contained.Big.Single"/>
</RelativeLayout>
