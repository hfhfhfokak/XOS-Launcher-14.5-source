<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.zero.mediation.ad.view.TMediaView
        android:id="@+id/coverview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="170dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.zero.mediation.ad.view.TIconView
            android:id="@+id/native_ad_icon"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentStart="true"/>
        <Button
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/call_to_action"
            android:background="@drawable/htmlact_ad_btn_default"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"
            style="?android:attr/borderlessButtonStyle"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/call_to_action"
            android:layout_toEndOf="@+id/native_ad_icon">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/htmlact_ad_title_text_color"
                android:ellipsize="end"
                android:id="@+id/native_ad_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/htmlact_ad_body_text_color"
                android:ellipsize="end"
                android:id="@+id/native_ad_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
