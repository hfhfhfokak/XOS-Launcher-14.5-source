<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/guide_page_guide_policy"
    android:background="@color/os_background_material_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="17dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/guide_privacy_policy_title_color"
                android:id="@+id/guide_privacy_policy_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/guide_privacy_policy_title"
                android:layout_centerHorizontal="true"
                android:fontFamily="sans-serif"
                android:layout_marginStart="@dimen/guide_privacy_policy_text_margin_start_end"
                android:layout_marginEnd="@dimen/guide_privacy_policy_text_margin_start_end"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/guide_privacy_policy_paragraph_color"
                android:id="@+id/guide_privacy_policy_paragraph_one"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/guide_privacy_policy_paragraph_one"
                android:layout_below="@+id/guide_privacy_policy_title"
                android:layout_centerHorizontal="true"
                android:fontFamily="sans-serif"
                android:layout_marginStart="@dimen/guide_privacy_policy_text_margin_start_end"
                android:layout_marginEnd="@dimen/guide_privacy_policy_text_margin_start_end"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/guide_privacy_policy_paragraph_color"
                android:id="@+id/guide_privacy_policy_paragraph_two"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/guide_privacy_policy_paragraph_two"
                android:layout_below="@+id/guide_privacy_policy_paragraph_one"
                android:layout_centerHorizontal="true"
                android:fontFamily="sans-serif"
                android:layout_marginStart="@dimen/guide_privacy_policy_text_margin_start_end"
                android:layout_marginEnd="@dimen/guide_privacy_policy_text_margin_start_end"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/guide_privacy_policy_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="@dimen/x_guide_bottom_button_margin_bottom">
        <Button
            android:textSize="@dimen/guide_button_text_size"
            android:textColor="@color/guide_privacy_policy_disagree_button_text_color"
            android:id="@+id/guide_disagree_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/guide_privacy_policy_button_height"
            android:text="@string/disagree"
            android:layout_weight="1"
            android:textAllCaps="true"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/guide_privacy_policy_button_margin_start_end"
            android:layout_marginEnd="@dimen/guide_privacy_policy_button_margin_start_end"
            style="@style/PrivacyPolicyDisAgreeButtonTheme"/>
        <Button
            android:textSize="@dimen/guide_button_text_size"
            android:textColor="@color/white"
            android:id="@+id/guide_agree_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/guide_privacy_policy_button_height"
            android:text="@string/agree"
            android:layout_weight="1"
            android:contentDescription="@string/desc_guide_policy_btn"
            android:textAllCaps="true"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/guide_privacy_policy_button_margin_start_end"
            android:layout_marginEnd="@dimen/guide_privacy_policy_button_margin_start_end"
            style="@style/PrivacyPolicyAgreeButtonTheme"/>
    </LinearLayout>
</LinearLayout>
