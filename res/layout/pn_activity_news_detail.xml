<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/pn_comment_tv_num"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/pn_layout_news_title_white"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="#efffffff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/webview_progress"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:max="100"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/pn_news_detail_content_fl"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/layout_wait_or_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pn_dimen_30dp"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/iv_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pn_dimen_20dp_f"
                    android:indeterminateDrawable="@drawable/pn_progress_bar"
                    android:contentDescription="@string/pn_iv_loading_desc"
                    style="@android:style/Widget.ProgressBar"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_news_detail_error_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_32"
                    android:layout_marginEnd="@dimen/dp_32">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/iv_news_detail_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/no_network_icon"/>
                    <TextView
                        android:textSize="@dimen/pn_dimen_14sp"
                        android:textColor="@color/black_60"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_news_detail_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:text="@string/open_network"/>
                    <TextView
                        android:textSize="@dimen/pn_dimen_14sp"
                        android:textColor="@color/zs_open_network_bg"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tv_network_setting"
                        android:background="@drawable/bg_retry_selector"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:text="@string/network_settings"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/news_details_bottom_ll"
            android:background="#ffffff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:elevation="2dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#222222"
                android:id="@+id/news_details_bottom_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/news_details_bottom_iv1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pn_ic_whatsapp"
                android:layout_marginStart="23.4dp"/>
            <ImageView
                android:id="@+id/news_details_bottom_iv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pn_ic_facebook"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"/>
            <ImageView
                android:id="@+id/news_details_bottom_iv3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pn_ic_share"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/news_details_menu_fl"
        android:paddingTop="40.67dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="end"
            android:orientation="vertical"
            android:background="@drawable/pn_shape_news_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:elevation="2.67dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#222222"
                android:gravity="center_vertical"
                android:id="@+id/news_details_menu_tv1"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/pn_copyright"
                android:singleLine="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#222222"
                android:gravity="center_vertical"
                android:id="@+id/news_details_menu_tv2"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/pn_open_with_browsers"
                android:singleLine="true"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
