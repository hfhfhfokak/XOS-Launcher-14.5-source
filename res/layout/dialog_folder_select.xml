<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/lau_dialog_panel_padding_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsion.xlauncher.library.widget.ElegantTextView
        android:ellipsize="middle"
        android:gravity="start|center_vertical"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/lau_dialog_title_margin_bottom"
        android:singleLine="true"
        android:layout_marginStart="@dimen/os_dialog_padding_left_right"
        android:layout_marginEnd="@dimen/os_dialog_padding_left_right"
        style="@style/os_dialog_title"/>
    <FrameLayout
        android:id="@+id/dialog_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="160dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp">
        <com.transsion.xlauncher.library.springview.SpringRecyclerView
            android:scrollbarThumbVertical="@drawable/os_scrollbar_thumb_vertical"
            android:id="@+id/recycler_view"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/os_dialog_divider_margin"
        layout="@layout/lau_prompt_dialog_buttons_horizontal_with_state_change"/>
</LinearLayout>
