<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/close_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ad_close_16dp"
        android:scaleType="center"/>
    <com.transsion.xlauncher.admedia.widget.ArrowView
        android:layout_gravity="top"
        android:id="@+id/arrow_view"
        android:layout_width="@dimen/folder_ad_arrow_width"
        android:layout_height="@dimen/folder_ad_arrow_height"/>
    <FrameLayout
        android:id="@+id/container_layout"
        android:background="@drawable/clean_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
