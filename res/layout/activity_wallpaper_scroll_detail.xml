<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wp_image_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@drawable/shape_walldetail_mask"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_hundred_dp"/>
    <View
        android:background="@drawable/shape_walldetail_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_hundred_dp"
        android:layout_alignParentBottom="true"/>
    <RelativeLayout
        android:fitsSystemWindows="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/walldetail_back_iv"
            android:padding="@dimen/twelve_dp"
            android:layout_width="@dimen/forty_eight_dp"
            android:layout_height="@dimen/theme_title_bar_height"
            android:src="@drawable/ic_theme_actionbar_back"
            android:tint="@android:color/white"
            android:minWidth="@dimen/twenty_eight_dp"
            android:layout_marginStart="@dimen/four_dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/zoom_btn"
            android:padding="@dimen/twelve_dp"
            android:layout_width="@dimen/forty_eight_dp"
            android:layout_height="@dimen/theme_title_bar_height"
            android:src="@drawable/ic_wp_zoom_in"
            android:minWidth="@dimen/twenty_eight_dp"
            android:layout_marginEnd="@dimen/four_dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
