<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/search_box"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="@dimen/theme_common_screen_padding"
        android:paddingEnd="15dp">
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="@dimen/twelve_sp"
            android:textColor="@color/th_all_list_name_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/search_go"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/forty_dp"
            android:maxWidth="@dimen/seventy_dp"
            android:text="@android:string/cancel"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/theme_search_box_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/forty_dp"
            android:layout_centerVertical="true"
            android:paddingEnd="@dimen/four_dp"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/search_go">
            <Button
                android:textSize="@dimen/twelve_sp"
                android:textColor="@color/percentage_100_gray"
                android:ellipsize="end"
                android:id="@+id/search_type"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="@dimen/one_hundred_dp"
                android:minWidth="@dimen/seventy_two_dp"
                android:text="@string/activity_tab_theme"
                android:maxLines="1"
                android:singleLine="true"
                android:textAllCaps="false"
                android:drawableEnd="@drawable/selection"
                android:paddingStart="@dimen/eight_dp"/>
            <View
                android:id="@+id/search_gap"
                android:background="@color/focus_cover_background"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="6dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_main_search"
                android:layout_marginStart="@dimen/eight_dp"/>
            <EditText
                android:textSize="@dimen/fourteen_sp"
                android:textColor="@color/percentage_100_gray"
                android:textColorHint="@color/support_text_color"
                android:gravity="center_vertical"
                android:id="@+id/search_text"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/text_search"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/th_edittext_cursor_bg"
                android:layout_marginStart="@dimen/ten_dp"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/search_clear"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_th_search_del"
                android:scaleType="center"
                android:layout_marginEnd="@dimen/eight_dp"/>
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/search_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
