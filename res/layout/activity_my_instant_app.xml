<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootview"
    android:background="#2a2b46"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestscrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="130dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="112dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ly_recently"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="23dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_FFFFFF"
                        android:id="@+id/tv_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_centerVertical="true"
                        android:drawableStart="@drawable/fa_white_dot"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_FFFFFF"
                        android:id="@+id/tv_title_recent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flashapp_recently"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/tv_dot"/>
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <View
                    android:background="#19ffffff"
                    android:layout_width="match_parent"
                    android:layout_height="0.67dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="23dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_FFFFFF"
                        android:id="@+id/tv_dot1"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_centerVertical="true"
                        android:drawableStart="@drawable/fa_white_dot"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_FFFFFF"
                        android:id="@+id/tv_title_mine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flashapp_favorites"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@+id/tv_dot1"/>
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_mine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="60dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="@mipmap/fa_my_instant_app_top_bg"
        android:layout_width="match_parent"
        android:layout_height="86dp">
        <TextView
            android:textSize="22sp"
            android:textColor="@color/color_FFFFFF"
            android:gravity="center_horizontal"
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/flashapp_my_instant_app"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#7fffffff"
        android:gravity="center_horizontal"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/tv_nofavorite_tip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="314dp"
        android:text="@string/flashapp_no_favorite_tips"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#7fffffff"
        android:gravity="center_horizontal"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/tv_no_favorite_recently_tip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="172dp"
        android:text="@string/flashapp_no_favorite_recently_tips"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/rl_touch"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <ImageView
            android:background="@mipmap/fa_ic_pull_up"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/v_gradient"
        android:background="@drawable/fa_share_linear_gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="130dp"/>
</FrameLayout>
