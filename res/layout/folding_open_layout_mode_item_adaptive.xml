<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/folding_open_layout_mode_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/folding_open_layout_mode_item_title"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/adaptive_mode_preview"
        android:layout_width="match_parent"
        android:layout_height="174dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/adaptive_layout_mode_preview"
        android:scaleType="centerInside"/>
</LinearLayout>
