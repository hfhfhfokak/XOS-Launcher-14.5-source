<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/pn_color10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pn_dimen_2dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_news_detail_comment_top"
        android:paddingTop="@dimen/pn_dimen_18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/pn_dimen_16dp"
        android:paddingEnd="@dimen/pn_dimen_16dp">
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/pn_detail_divider_color"
            android:layout_width="@dimen/pn_dimen_80dp"
            android:layout_height="@dimen/pn_dimen_1px"/>
        <TextView
            android:textSize="@dimen/pn_dimen_14dp"
            android:textColor="@color/pn_hot_comment_title_tv_color"
            android:gravity="center"
            android:paddingBottom="@dimen/pn_dimen_8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/pn_comments"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/pn_detail_divider_color"
            android:layout_width="@dimen/pn_dimen_80dp"
            android:layout_height="@dimen/pn_dimen_1px"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_no_comment"
        android:layout_width="@dimen/pn_dimen_80dp"
        android:layout_height="@dimen/pn_dimen_80dp"
        android:layout_marginTop="@dimen/pn_dimen_11dp"
        android:src="@drawable/pn_no_comment_icon"/>
</LinearLayout>
