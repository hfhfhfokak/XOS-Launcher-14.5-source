<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-7dp"
        android:layout_marginStart="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextClock
            android:textStyle="normal"
            android:gravity="center_horizontal"
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:shadowColor="#1a000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:fontFamily="@font/tos_241205_medium"
            android:layout_marginStart="0dp"
            android:format12Hour="@string/horizontal_clock_time_format_12_hour"
            android:format24Hour="@string/horizontal_clock_time_format_24_hour"
            android:textFontWeight="300"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_weather"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="14dp">
                <TextView
                    android:textSize="26dp"
                    android:id="@+id/tv_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#1a000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:fontFamily="@font/tos_241205_medium"/>
                <ImageView
                    android:id="@+id/iv_weather"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:src="@mipmap/ic_weather_cloudy"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <TextClock
                android:textSize="17.33dp"
                android:gravity="center_horizontal"
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:maxLines="1"
                android:shadowColor="#1a000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:fontFamily="@font/tos_241205_medium"
                android:layout_marginEnd="17dp"
                android:format12Hour="@string/vertical_clock_data_format_24"
                android:format24Hour="@string/vertical_clock_data_format_24"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
