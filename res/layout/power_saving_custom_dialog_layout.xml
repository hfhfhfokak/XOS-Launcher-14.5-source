<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/os_body_font"
        android:textColor="@color/os_text_secondary_color"
        android:gravity="start"
        android:id="@+id/custom_dialog_content"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_margin"
        android:layout_marginBottom="@dimen/dialog_title_content_margin_left_right"
        android:fontFamily="sans-serif"
        android:layout_marginStart="@dimen/dialog_title_content_margin_left_right"
        android:layout_marginEnd="@dimen/dialog_title_content_margin_left_right"/>
    <View
        android:id="@+id/btn_divider_line"
        android:background="@color/os_gray_tertiary_color"
        android:layout_width="match_parent"
        android:layout_height="0.67dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/os_dialog_button_height">
        <Button
            android:id="@+id/left_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textAllCaps="true"
            style="@style/DialogButtonStyle_Negative"/>
        <Button
            android:id="@+id/right_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            style="@style/DialogButtonStyle_Positive"/>
    </LinearLayout>
</LinearLayout>
