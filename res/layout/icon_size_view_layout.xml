<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/icon_style_title_container"
        layout="@layout/icon_style_item_title"/>
    <com.transsion.widgetslib.widget.seekbar.OSSectionSeekbar
        android:layout_gravity="center"
        android:id="@+id/seekBar"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/icon_setting_content_img_margin_start"
        android:layout_marginEnd="@dimen/icon_setting_content_img_margin_start"/>
</LinearLayout>
