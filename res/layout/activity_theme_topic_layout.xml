<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/topic_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <View
            android:background="@color/theme_topic_detail_cover_color"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/back_layout"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/theme_title_bar_height"
                android:src="@drawable/ic_theme_actionbar_back"
                android:tint="@android:color/white"
                android:paddingStart="@dimen/theme_common_screen_padding"/>
            <include layout="@layout/theme_topic_cover"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/theme_topic_viewPager"
            android:paddingTop="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/theme_common_screen_padding_with_item_padding"
            android:paddingEnd="@dimen/theme_common_screen_padding_with_item_padding"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/loading_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
</RelativeLayout>
