<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.library.bottomsheet.LauBottomSheetContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/touch_outside"
        android:background="#000000"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:soundEffectsEnabled="false"
        android:alpha="0"
        android:importantForAccessibility="no"/>
    <com.transsion.xlauncher.library.bottomsheet.LauBottomSheetPanel
        android:gravity="top"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/drag_panel"
        android:background="@drawable/lau_bottom_sheet_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/lau_bottom_sheet_panel_bottom_margin"
        android:layout_marginStart="@dimen/lau_bottom_sheet_panel_margin"
        android:layout_marginEnd="@dimen/lau_bottom_sheet_panel_margin">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">
            <FrameLayout
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/panel_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/lau_bottom_sheet_content_min_height"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/pull_rect"
                android:background="@color/os_altitude_secondary_color"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lau_bottom_sheet_pull_rect"
                android:soundEffectsEnabled="false"
                android:importantForAccessibility="no"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/drag_rect"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="24dp">
            <ImageView
                android:layout_gravity="center"
                android:background="@drawable/lau_bottom_sheet_drag_bar"
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:scaleType="centerInside"/>
        </FrameLayout>
    </com.transsion.xlauncher.library.bottomsheet.LauBottomSheetPanel>
</com.transsion.xlauncher.library.bottomsheet.LauBottomSheetContainer>
