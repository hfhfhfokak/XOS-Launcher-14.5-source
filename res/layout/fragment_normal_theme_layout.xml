<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsion.xlauncher.library.springview.SpringRecyclerView
        android:id="@+id/theme_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/theme_common_screen_padding_with_item_padding"
        android:paddingEnd="@dimen/theme_common_screen_padding_with_item_padding"/>
    <ProgressBar
        android:layout_gravity="center_horizontal"
        android:id="@+id/loading_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/sixty_dp"
        android:indeterminate="true"
        style="@style/mProgress_circle"/>
</FrameLayout>
