<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.scene.zeroscreen.firstLoadingAnim.ZsFirstLoading2x2CardViewItem
            android:id="@+id/fl_2x2_card_view_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/zs_card_default_size"
            android:src="@drawable/zs_first_loading_2x2_card_view_content_1"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/zs_card_blur_margin"/>
        <com.scene.zeroscreen.firstLoadingAnim.ZsFirstLoading2x2CardViewItem
            android:id="@+id/fl_2x2_card_view_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/zs_card_default_size"
            android:src="@drawable/zs_first_loading_2x2_card_view_content_2"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/zs_card_blur_margin"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/zs_recyclerview_item_decoration">
        <com.scene.zeroscreen.firstLoadingAnim.ZsFirstLoading2x2CardViewItem
            android:id="@+id/fl_2x2_card_view_3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/zs_card_default_size"
            android:src="@drawable/zs_first_loading_2x2_card_view_content_3"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/zs_card_blur_margin"/>
        <com.scene.zeroscreen.firstLoadingAnim.ZsFirstLoading2x2CardViewItem
            android:id="@+id/fl_2x2_card_view_4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/zs_card_default_size"
            android:src="@drawable/zs_first_loading_2x2_card_view_content_1"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/zs_card_blur_margin"/>
    </LinearLayout>
</merge>
