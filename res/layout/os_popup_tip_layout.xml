<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/os_popup_tip_arrow"
        android:background="@drawable/os_popup_tip_arrow"
        android:layout_width="@dimen/os_popup_tip_arrow_width"
        android:layout_height="@dimen/os_popup_tip_arrow_height"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/os_candwhile_primary_color"
        android:id="@+id/os_popup_tip_text"
        android:background="?attr/os_platform_basic_color"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</RelativeLayout>
