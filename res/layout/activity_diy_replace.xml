<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/theme_title_lr4_layout"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/header_diy"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_below="@+id/theme_title"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/image_preview"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="24dp"/>
        <com.transsion.theme.common.customview.ElegantTextView
            android:id="@+id/text_preview"
            android:layout_marginTop="6dp"
            style="@style/ThemeIconDiyTextStyle"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/diy_arrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header_diy">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_diy_arrow"/>
    </LinearLayout>
    <TableLayout
        android:gravity="center_horizontal"
        android:background="@color/th_diy_editor_bg_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:layout_below="@+id/diy_arrow"
        android:paddingStart="@dimen/diy_icon_replace_grid_padding"
        android:paddingEnd="@dimen/diy_icon_replace_grid_padding">
        <TableRow
            android:gravity="center"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="34dp"
            android:paddingHorizontal="5dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/image_cur"
                    android:layout_width="@dimen/forty_five_dp"
                    android:layout_height="@dimen/forty_five_dp"/>
                <com.transsion.theme.common.customview.ElegantTextView
                    android:layout_marginTop="6dp"
                    android:text="@string/diy_current_icon"
                    style="@style/ThemeIconDiyTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/image_app"
                    android:layout_width="@dimen/forty_five_dp"
                    android:layout_height="@dimen/forty_five_dp"/>
                <com.transsion.theme.common.customview.ElegantTextView
                    android:layout_marginTop="6dp"
                    android:text="@string/diy_original_icon"
                    style="@style/ThemeIconDiyTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/image_camera"
                    android:layout_width="@dimen/forty_five_dp"
                    android:layout_height="@dimen/forty_five_dp"/>
                <com.transsion.theme.common.customview.ElegantTextView
                    android:layout_marginTop="6dp"
                    android:text="@string/diy_icon"
                    style="@style/ThemeIconDiyTextStyle"/>
            </LinearLayout>
        </TableRow>
        <View
            android:background="@color/th_diy_editor_line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one_dp"/>
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="62dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/mask_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="59dp"
                    android:layout_height="59dp">
                    <ImageView
                        android:id="@+id/image_mask"
                        android:layout_width="@dimen/forty_five_dp"
                        android:layout_height="@dimen/forty_five_dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                    <ImageView
                        android:id="@+id/image_mask_select"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_selected"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <com.transsion.theme.common.customview.ElegantTextView
                    android:layout_marginTop="6dp"
                    android:text="@string/diy_mask"
                    style="@style/ThemeIconDiyTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/bg_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="59dp"
                    android:layout_height="59dp">
                    <ImageView
                        android:id="@+id/image_bg"
                        android:layout_width="@dimen/forty_five_dp"
                        android:layout_height="@dimen/forty_five_dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                    <ImageView
                        android:id="@+id/image_bg_select"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_selected"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <com.transsion.theme.common.customview.ElegantTextView
                    android:layout_marginTop="6dp"
                    android:text="@string/diy_background"
                    style="@style/ThemeIconDiyTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/top_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="59dp"
                    android:layout_height="59dp">
                    <ImageView
                        android:id="@+id/image_fr"
                        android:layout_width="@dimen/forty_five_dp"
                        android:layout_height="@dimen/forty_five_dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                    <ImageView
                        android:id="@+id/image_fr_select"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_selected"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <com.transsion.theme.common.customview.ElegantTextView
                    android:layout_marginTop="6dp"
                    android:text="@string/diy_front"
                    style="@style/ThemeIconDiyTextStyle"/>
            </LinearLayout>
        </TableRow>
    </TableLayout>
    <Button
        android:textColor="@android:color/white"
        android:layout_gravity="center"
        android:id="@+id/save_zip"
        android:background="@drawable/theme_download_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:text="@string/diy_save"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/diy_icon_button_padding"
        android:layout_marginEnd="@dimen/diy_icon_button_padding"
        style="?android:attr/borderlessButtonStyle"/>
</RelativeLayout>
