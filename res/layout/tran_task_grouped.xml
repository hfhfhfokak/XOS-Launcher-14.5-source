<?xml version="1.0" encoding="utf-8"?>
<com.android.quickstep.src.com.android.quickstep.views.GroupedTaskView xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="4dp">
    <FrameLayout
        android:id="@+id/snapshotContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.android.quickstep.src.com.android.quickstep.views.TaskThumbnailView
            android:id="@+id/snapshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/blurTaskIcon"
            android:visibility="gone"
            android:layout_width="@dimen/recent_task_center_app_lock_icon_size"
            android:layout_height="@dimen/recent_task_center_app_lock_icon_size"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="@dimen/recent_task_blur_reason_text_size"
            android:textColor="@color/recent_task_blur_reason_text_color"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/blurTaskText"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/recent_task_blur_reason_text_height_default"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/bottomRight_snapshotContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.android.quickstep.src.com.android.quickstep.views.TaskThumbnailView
            android:id="@+id/bottomRight_snapshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/bottomRight_blurTaskIcon"
            android:visibility="gone"
            android:layout_width="@dimen/recent_task_center_app_lock_icon_size"
            android:layout_height="@dimen/recent_task_center_app_lock_icon_size"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="@dimen/recent_task_blur_reason_text_size"
            android:textColor="@color/recent_task_blur_reason_text_color"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/bottomRight_blurTaskText"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/recent_task_blur_reason_text_height_default"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/taskLockIconTop"
        android:visibility="gone"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_margin="@dimen/recent_task_lock_icon_margin"
        android:src="@drawable/lock"/>
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/taskLockIconBottom"
        android:visibility="gone"
        android:layout_width="@dimen/dp20"
        android:layout_height="@dimen/dp20"
        android:layout_margin="@dimen/recent_task_lock_icon_margin"
        android:src="@drawable/lock"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:id="@+id/task_menu_layout"
        android:paddingBottom="@dimen/recent_task_title_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/recent_task_menu_layout_padding_end"
        android:paddingEnd="@dimen/dp_10">
        <ImageView
            android:id="@+id/task_arrow"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="@dimen/recent_task_thumbnail_icon_size"
            android:layout_height="@dimen/recent_task_thumbnail_icon_size"
            android:src="@drawable/recent_ic_task_menu_arrow"/>
        <TextView
            android:theme="@style/recent_WidgetContainerTheme"
            android:textSize="14sp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/task_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/dp_100"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:paddingStart="6dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/spilit_shortcut_layout"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24">
            <FrameLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/task_icon_top"
                android:background="@drawable/ic_recent_split_shortcut_background_icon_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.android.quickstep.src.com.android.quickstep.views.IconView
                    android:layout_gravity="center"
                    android:id="@+id/icon"
                    android:focusable="false"
                    android:layout_width="@dimen/dimen_10"
                    android:layout_height="@dimen/dimen_10"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="12dp"/>
            </FrameLayout>
            <FrameLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/task_icon_bottom"
                android:background="@drawable/ic_recent_split_shortcut_background_icon_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.android.quickstep.src.com.android.quickstep.views.IconView
                    android:layout_gravity="center"
                    android:id="@+id/bottomRight_icon"
                    android:focusable="false"
                    android:layout_width="@dimen/dp_10"
                    android:layout_height="@dimen/dp_10"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:orientation="horizontal"
        android:id="@+id/bottomRight_task_menu_layout"
        android:paddingBottom="@dimen/recent_task_title_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/recent_task_menu_layout_padding_end"
        android:paddingEnd="@dimen/recent_task_menu_layout_padding_end">
        <ImageView
            android:id="@+id/bottomRight_task_arrow"
            android:background="@null"
            android:visibility="invisible"
            android:layout_width="@dimen/recent_task_thumbnail_icon_size"
            android:layout_height="@dimen/recent_task_thumbnail_icon_size"
            android:src="@drawable/recent_ic_task_menu_arrow"/>
        <TextView
            android:theme="@style/recent_WidgetContainerTheme"
            android:textSize="14sp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/bottomRight_task_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/recent_task_title_max_width_grouped"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textAlignment="viewStart"
            android:paddingStart="6dp"/>
    </LinearLayout>
</com.android.quickstep.src.com.android.quickstep.views.GroupedTaskView>
