<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guide_page_wallpaper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_launcher_guide_bg_two"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textSize="14sp"
        android:textColor="#ff9d9d9e"
        android:id="@+id/theme_select_skip"
        android:background="@drawable/guide_theme_select_skip_bg"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="@string/launcher_skip_theme_select"
        android:textAllCaps="true"
        android:fontFamily="sans-serif"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0635"
        style="?android:attr/buttonStyleSmall"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@android:color/white"
        android:id="@+id/guide_wallpager_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="@string/launcher_theme_select_title"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="46dp"
        android:layout_marginEnd="46dp"
        app:layout_constraintBottom_toTopOf="@+id/preview_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"/>
    <com.transsion.theme.common.customview.RoundCornerImageView
        android:id="@+id/preview_iv"
        android:background="@drawable/guide_theme_selected_bg"
        android:padding="9dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.53"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4715"
        app:roundCornerRadius="9dp"/>
    <Button
        android:textSize="@dimen/guide_button_text_size"
        android:textColor="@color/white"
        android:id="@+id/guide_wallpaper_button"
        android:background="@drawable/guide_button_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/guide_button_height"
        android:text="@string/launcher_theme_select_next_step"
        android:layout_below="@+id/preview_iv"
        android:contentDescription="@string/desc_guide_theme_btn"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"
        android:layout_marginStart="46dp"
        android:layout_marginEnd="46dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.86"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
