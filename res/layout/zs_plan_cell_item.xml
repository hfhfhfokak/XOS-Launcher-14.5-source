<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/plan_item_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/plan_title_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/plan_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/plan_title_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:background="@drawable/zs_promotion_app_btn_bg"
        android:layout_width="50dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/search_palm_item_btn_text"
        android:maxLines="1"
        android:layout_below="@+id/plan_item_title"
        android:layout_centerHorizontal="true"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"/>
</RelativeLayout>
