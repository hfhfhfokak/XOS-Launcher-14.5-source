<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/x_item_iv"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/zs_sa_blank"
        android:scaleType="centerInside"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/recent_apps_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/x_item_tv"
        android:paddingTop="4.33dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/custome_search_recent_apps_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/x_item_button_tv"
        android:background="@drawable/ic_search_promotion_app_btn"
        android:layout_width="50dp"
        android:layout_height="16dp"
        android:layout_marginTop="10dp"
        android:text="@string/search_palm_item_btn_text"
        android:maxLines="1"
        android:paddingStart="@dimen/dp_6"
        android:paddingEnd="@dimen/dp_6"/>
</LinearLayout>
