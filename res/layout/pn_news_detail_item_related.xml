<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_news_detail_related"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/pn_color10"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pn_dimen_4dp"/>
        <LinearLayout
            android:paddingTop="@dimen/pn_dimen_10dp"
            android:paddingBottom="@dimen/pn_dimen_8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/pn_dimen_16dp"
            android:paddingEnd="@dimen/pn_dimen_16dp">
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/pn_detail_divider_color"
                android:layout_width="@dimen/pn_dimen_80dp"
                android:layout_height="@dimen/pn_dimen_1px"/>
            <TextView
                android:textSize="@dimen/pn_dimen_14sp"
                android:textColor="@color/pn_color4"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/pn_related_news"
                android:layout_weight="1"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/pn_detail_divider_color"
                android:layout_width="@dimen/pn_dimen_80dp"
                android:layout_height="@dimen/pn_dimen_1px"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pn_dimen_8dp"
        android:layout_marginBottom="@dimen/pn_dimen_8dp"
        android:paddingStart="@dimen/pn_dimen_16dp"
        android:paddingEnd="@dimen/pn_dimen_16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/pn_dimen_16sp"
                android:textColor="@color/pn_color7"
                android:ellipsize="end"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_news_detail_related_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/pn_dimen_4dp"
                android:maxLines="2"/>
            <TextView
                android:textSize="@dimen/pn_dimen_8sp"
                android:textStyle="bold"
                android:textColor="@color/pn_color8"
                android:gravity="center"
                android:id="@+id/tv_app_icon"
                android:background="@drawable/pn_news_app_bg"
                android:layout_width="@dimen/pn_dimen_24dp"
                android:layout_height="@dimen/pn_dimen_12dp"
                android:text="@string/pn_news_app"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_news_detail_related"
            android:layout_width="@dimen/pn_dimen_100dp"
            android:layout_height="@dimen/pn_dimen_60dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/pn_dimen_18dp"/>
    </LinearLayout>
    <View
        android:id="@+id/iv_recommend_divider"
        android:background="@color/pn_detail_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginStart="@dimen/pn_dimen_16dp"
        android:layout_marginEnd="@dimen/pn_dimen_16dp"/>
</LinearLayout>
