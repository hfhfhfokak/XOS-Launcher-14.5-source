<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.library.springview.SpringScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsion.xlauncher.search.view.TouchFinishLinearLayout
        android:orientation="vertical"
        android:id="@+id/touch_finish_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/search_interaction_view_top_start"
        android:paddingEnd="@dimen/search_interaction_view_top_start">
        <com.transsion.xlauncher.search.view.SaUsedAppView
            android:id="@+id/use_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/search_item_margin"/>
        <com.transsion.xlauncher.search.view.SaAppPromotionView
            android:id="@+id/x_hot_apps"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/search_item_margin"/>
        <com.transsion.xlauncher.search.view.BytePromotionView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.transsion.xlauncher.search.view.SaPalmSearchView
            android:id="@+id/x_search_palm"
            android:background="@drawable/x_sa_used_app_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.transsion.xlauncher.search.view.TouchFinishLinearLayout>
</com.transsion.xlauncher.library.springview.SpringScrollView>
