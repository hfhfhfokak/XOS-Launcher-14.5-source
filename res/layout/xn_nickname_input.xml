<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_10">
        <ImageView
            android:id="@+id/xn_delete_all"
            android:background="@drawable/os_control_background_32dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/os_ic_cancel"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <EditText
            android:textSize="15sp"
            android:textColor="@color/os_text_primary_color"
            android:textColorHint="@color/os_text_quaternary_color"
            android:id="@+id/edit"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_38"
            android:hint="@string/xn_nickname_label"
            android:singleLine="true"
            android:maxLength="50"
            android:textDirection="anyRtl"
            android:textAlignment="viewStart"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/xn_delete_all"
            android:importantForAutofill="no"/>
    </RelativeLayout>
    <View
        android:id="@+id/line"
        android:background="@color/xn_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/input"/>
    <TextView
        android:textAppearance="@style/font_black_10_t40"
        android:id="@+id/num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/line"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="@style/font_black_10_t40"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/xn_nickname_empty"
        android:layout_below="@+id/line"
        android:layout_alignTop="@+id/num"
        android:layout_marginEnd="@dimen/dimen_16"
        android:layout_toStartOf="@+id/num"/>
</RelativeLayout>
