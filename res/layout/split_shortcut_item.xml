<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@null"
    android:layout_width="@dimen/dp_50"
    android:layout_height="@dimen/dp_50"
    android:layoutDirection="ltr">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/spilit_shortcut_layout"
        android:background="@drawable/ic_recent_split_shortcut_background"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/topBackground"
            android:background="@drawable/ic_recent_split_shortcut_background_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/task_icon_left"
                android:focusable="false"
                android:layout_width="@dimen/dp_15"
                android:layout_height="@dimen/dp_15"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/bottomBackground"
            android:background="@drawable/ic_recent_split_shortcut_background_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/task_icon_right"
                android:focusable="false"
                android:layout_width="@dimen/dp_15"
                android:layout_height="@dimen/dp_15"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/task_icon_remove"
        android:visibility="gone"
        android:layout_width="@dimen/recent_split_shortcut_delete_icon_size"
        android:layout_height="@dimen/recent_split_shortcut_delete_icon_size"
        android:src="@drawable/ic_recent_split_shortcut_delete"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
