<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_search"
    android:background="@drawable/taskbar_all_apps_search_bg"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layoutDirection="locale">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_btns"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp">
        <com.android.launcher3.ExtendedEditText
            android:textSize="14sp"
            android:textColor="@color/all_apps_search_input_text_color"
            android:textColorHint="@color/taskbar_all_apps_hint_color"
            android:gravity="center_vertical"
            android:id="@+id/search_box_input"
            android:background="@android:color/transparent"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/all_apps_search_bar_hint"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:maxLength="99"
            android:drawablePadding="8dp"
            android:layout_weight="1"
            android:inputType="textNoSuggestions"
            android:imeOptions="flagNoExtractUi|actionSearch"
            android:textCursorDrawable="@drawable/os_edit_text_cursor"
            android:drawableStart="@drawable/ic_taskbar_search_dock"
            android:paddingStart="10dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/del_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_search_delete"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/taskbar_all_apps_hint_color"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/search_btn_preview"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/all_apps_search_bar_hint"
        android:maxLines="1"
        android:singleLine="true"
        android:drawablePadding="8dp"
        android:layout_centerVertical="true"
        android:paddingStart="10dp"
        android:layout_marginEnd="@dimen/task_bar_search_bar_preview_margin_end"
        app:drawableStartCompat="@drawable/ic_taskbar_search_dock"/>
</RelativeLayout>
