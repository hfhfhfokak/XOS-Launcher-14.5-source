<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rl_news_detail_comment"
    android:paddingTop="@dimen/pn_dimen_8dp"
    android:paddingBottom="@dimen/pn_dimen_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/pn_dimen_16dp"
    android:paddingEnd="@dimen/pn_dimen_16dp">
    <com.scene.plugin.custom.news.view.NewsCircleImageView
        android:id="@+id/comment_user_icon"
        android:layout_width="@dimen/pn_dimen_30dp"
        android:layout_height="@dimen/pn_dimen_30dp"
        android:layout_alignParentStart="true"
        app:news_border_color="#ffffff"
        app:news_border_width="@dimen/pn_dimen_1dp"/>
    <TextView
        android:textSize="@dimen/pn_dimen_16dp"
        android:textColor="@color/pn_text_color"
        android:id="@+id/comment_user_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pn_fb_nickname"
        android:paddingStart="@dimen/pn_dimen_16dp"
        android:layout_toEndOf="@+id/comment_user_icon"/>
    <TextView
        android:textSize="@dimen/pn_dimen_12dp"
        android:textColor="@color/pn_news_app_color"
        android:id="@+id/comment_user_publishTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10.23.2.1"
        android:layout_below="@+id/comment_user_nickname"
        android:paddingStart="@dimen/pn_dimen_16dp"
        android:layout_toEndOf="@+id/comment_user_icon"/>
    <TextView
        android:textSize="@dimen/pn_dimen_12dp"
        android:textColor="@color/pn_news_app_color"
        android:id="@+id/comment_user_country"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10.23.2.1"
        android:layout_below="@+id/comment_user_nickname"
        android:paddingStart="@dimen/pn_dimen_16dp"
        android:layout_toEndOf="@+id/comment_user_publishTime"/>
    <TextView
        android:textSize="@dimen/pn_dimen_12sp"
        android:textColor="@color/pn_news_comment_content_color"
        android:id="@+id/comment_user_content"
        android:paddingTop="@dimen/pn_dimen_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pn_tips_content"
        android:layout_below="@+id/comment_user_publishTime"
        android:paddingStart="@dimen/pn_dimen_16dp"
        android:layout_toEndOf="@+id/comment_user_icon"/>
</RelativeLayout>
