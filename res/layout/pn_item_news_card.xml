<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="7dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pn_dimen_10dp">
        <com.scene.plugin.custom.news.view.NewsCircleImageView
            android:id="@+id/news_card_item_iv1"
            android:layout_width="@dimen/pn_dimen_18dp"
            android:layout_height="@dimen/pn_dimen_18dp"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="@dimen/pn_dimen_12sp"
            android:textColor="#99222222"
            android:id="@+id/news_card_item_tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="144dp"
            android:singleLine="true"
            android:layout_marginStart="@dimen/pn_dimen_8dp"/>
        <TextView
            android:textSize="@dimen/pn_dimen_12sp"
            android:textColor="#99222222"
            android:gravity="start"
            android:id="@+id/news_card_item_tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pn_dimen_10dp"/>
        <androidx.legacy.widget.Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/news_card_item_iv2"
            android:layout_width="@dimen/pn_dimen_18dp"
            android:layout_height="@dimen/pn_dimen_18dp"
            android:src="@drawable/pn_ic_news_cancel"
            android:layout_marginEnd="@dimen/pn_dimen_12dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/pn_dimen_16sp"
        android:textColor="#222222"
        android:ellipsize="end"
        android:id="@+id/news_card_item_tv3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pn_dimen_7dp"
        android:layout_marginBottom="@dimen/pn_dimen_8dp"
        android:maxLines="2"
        android:layout_marginStart="@dimen/pn_dimen_14dp"
        android:layout_marginEnd="@dimen/pn_dimen_14dp"/>
    <com.scene.plugin.custom.news.view.ScaleRoundImage
        android:id="@+id/news_card_item_si"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        app:newsRoundHeight="164dp"
        app:newsRoundWidth="344dp"/>
</LinearLayout>
