<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/xn_full_margin_start"
    android:layout_marginEnd="@dimen/xn_full_margin_end">
    <View
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <com.transsion.widgetslib.view.OverBoundNestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/placeholder">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsion.xuanniao.account.comm.widget.RoundImageView
                android:id="@+id/portrait"
                android:layout_width="@dimen/dimen_70"
                android:layout_height="@dimen/dimen_70"
                android:layout_marginTop="@dimen/dimen_24"
                android:src="@drawable/xn_portrait_default"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textAppearance="@style/font_black_24_medium"
                android:ellipsize="end"
                android:id="@+id/nickName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:maxLines="1"
                android:layout_below="@+id/portrait"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/dimen_16"
                android:layout_marginEnd="@dimen/dimen_16"
                android:elegantTextHeight="true"/>
            <TextView
                android:textAppearance="@style/font_black_12_t40"
                android:id="@+id/accountId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/nickName"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/dimen_16"
                android:layout_marginEnd="@dimen/dimen_16"
                android:elegantTextHeight="true"/>
            <RelativeLayout
                android:id="@+id/quickUnderstandL"
                android:background="@drawable/xn_banner_bg"
                android:paddingBottom="@dimen/dimen_12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:minHeight="78dp"
                android:layout_below="@+id/accountId"
                android:layout_marginStart="@dimen/dimen_16"
                android:layout_marginEnd="@dimen/dimen_16">
                <ImageView
                    android:id="@+id/bannerLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_3"
                    android:layout_marginBottom="@dimen/dp_3"
                    android:src="@mipmap/banner_logo"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:id="@+id/quickUnderstand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16"
                    android:text="@string/xn_quick_understand_app"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="@dimen/dimen_16"
                    android:layout_marginEnd="@dimen/dimen_4"
                    android:layout_toStartOf="@+id/bannerLogo"
                    android:elegantTextHeight="true"/>
                <Button
                    android:id="@+id/viewQuickUnderstand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_10"
                    android:text="@string/xn_see_more"
                    android:layout_below="@+id/quickUnderstand"
                    android:layout_alignStart="@+id/quickUnderstand"
                    style="@style/OS.Widget.Button.Contained.Small.Single"/>
                <ImageView
                    android:id="@+id/close"
                    android:layout_width="@dimen/dimen_20"
                    android:layout_height="@dimen/dimen_20"
                    android:layout_marginTop="@dimen/dimen_6"
                    android:src="@drawable/xn_cancel_new"
                    android:layout_marginEnd="@dimen/dimen_6"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <View
                android:id="@+id/item_top"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_16"
                android:layout_below="@+id/quickUnderstandL"/>
            <RelativeLayout
                android:id="@+id/infoL"
                android:background="@drawable/xn_ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:minHeight="@dimen/dimen_58"
                android:layout_below="@+id/item_top">
                <ImageView
                    android:id="@+id/arrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/xn_item_margin_end"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/infoLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/xn_personal_info"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/xn_item_margin_start"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dimen_16"
                    android:layout_toStartOf="@+id/arrow"
                    android:layout_toEndOf="@+id/infoLogo">
                    <TextView
                        android:textAppearance="@style/font_black_16"
                        android:id="@+id/infoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xn_person_info"
                        android:elegantTextHeight="true"/>
                    <TextView
                        android:textAppearance="@style/font_black_10_t40"
                        android:id="@+id/perfectInfo"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xn_perfect_info"
                        android:layout_below="@+id/infoLabel"
                        android:elegantTextHeight="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/safeCenterL"
                android:background="@drawable/xn_ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dimen_58"
                android:layout_below="@+id/infoL">
                <ImageView
                    android:id="@+id/safeCenterArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/xn_item_margin_end"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/safeLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/xn_security_center"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/xn_item_margin_start"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dimen_16"
                    android:layout_toStartOf="@+id/safeCenterArrow"
                    android:layout_toEndOf="@+id/safeLogo">
                    <TextView
                        android:textAppearance="@style/font_black_16"
                        android:id="@+id/safeCenter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xn_safe_center"
                        android:elegantTextHeight="true"/>
                    <TextView
                        android:textAppearance="@style/font_black_10_t40"
                        android:id="@+id/perfectSafe"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/safeCenter"
                        android:elegantTextHeight="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/privacyCenterL"
                android:background="@drawable/xn_ripple_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dimen_58"
                android:layout_below="@+id/safeCenterL">
                <ImageView
                    android:id="@+id/privacyCenterArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/xn_item_margin_end"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/privacyLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/xn_privacy_center"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/xn_item_margin_start"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dimen_16"
                    android:layout_toStartOf="@+id/privacyCenterArrow"
                    android:layout_toEndOf="@+id/privacyLogo">
                    <TextView
                        android:textAppearance="@style/font_black_16"
                        android:id="@+id/privacyCenter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xn_help_and_private"
                        android:elegantTextHeight="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/helpCenterL"
                android:background="@drawable/xn_ripple_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dimen_58"
                android:layout_below="@+id/privacyCenterL">
                <ImageView
                    android:id="@+id/helpCenterArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/dimen_16"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/helpLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/xn_help_center"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dimen_16"/>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:id="@+id/helpCenter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_help_center"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dimen_16"
                    android:layout_marginEnd="@dimen/dimen_16"
                    android:layout_toStartOf="@+id/helpCenterArrow"
                    android:layout_toEndOf="@+id/helpLogo"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </com.transsion.widgetslib.view.OverBoundNestedScrollView>
</RelativeLayout>
