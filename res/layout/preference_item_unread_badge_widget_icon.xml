<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start|center_vertical"
    android:id="@+id/icon_frame"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:visibility="gone"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/preference_item_start_icon_margin_start"
    android:paddingEnd="6dp">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/preference_item_start_icon_big_wh"
        android:layout_height="@dimen/preference_item_start_icon_big_wh"/>
    <ImageView
        android:id="@+id/unread_badge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="-3dp"
        android:src="@drawable/ic_unread_badge"
        android:layout_marginEnd="-6dp"
        android:layout_alignEnd="@+id/icon"/>
</RelativeLayout>
