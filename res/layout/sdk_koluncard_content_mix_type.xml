<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/mix_label_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_12"
        layout="@layout/sdk_koluncard_label_image"/>
    <com.transsion.kolun.cardtemplate.customwidget.CustomCardImageView
        android:id="@+id/sdk_koluncard_mix_type_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_12"/>
    <include
        android:id="@+id/sdk_koluncard_basic_text_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        layout="@layout/sdk_koluncard_content_basic_text"/>
    <ImageView
        android:id="@+id/sdk_koluncard_image_button_one"
        android:background="@android:color/transparent"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_14"
        android:layout_toStartOf="@+id/sdk_koluncard_image_button_two"/>
    <ImageView
        android:id="@+id/sdk_koluncard_image_button_two"
        android:background="@android:color/transparent"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <Switch
        android:id="@+id/sdk_koluncard_content_switch"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_20"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/sdk_koluncard_reminder_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
            android:textStyle="bold"
            android:id="@+id/sdk_koluncard_reminder_info_text_one"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SdkKolunCardSingleLineTextStyle"/>
        <com.transsion.kolun.cardtemplate.customwidget.BasicTextView
            android:id="@+id/sdk_koluncard_reminder_info_text_two"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SdkKolunCardSingleLineTextStyle"/>
    </LinearLayout>
</RelativeLayout>
