<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:id="@+id/snackbar_layout"
    android:background="@drawable/ossnackbar_shape_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxWidth="400dp"
    android:minHeight="48dp"
    android:layout_alignParentBottom="true"
    android:layout_centerHorizontal="true"
    android:paddingStart="16dp"
    android:paddingEnd="0dp"
    style="@style/OSSnackBarStyle">
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:ellipsize="end"
        android:gravity="start"
        android:layout_gravity="center_vertical"
        android:id="@+id/mbMessage"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="176dp"
        android:maxLines="2"
        android:paddingStart="0dp"
        android:paddingEnd="16dp"/>
    <Button
        android:textColor="@color/os_dialog_positive_btn_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/btn"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="96dp"
        android:minWidth="0dp"
        android:maxLines="2"
        android:paddingStart="0dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        style="@style/DialogButtonStyle_Positive"/>
</LinearLayout>
