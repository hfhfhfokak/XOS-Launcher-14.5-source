<?xml version="1.0" encoding="utf-8"?>
<com.transsion.widgetslib.view.OverBoundNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/xn_full_margin_start"
    android:layout_marginEnd="@dimen/xn_full_margin_end">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/facebookL"
            android:background="@drawable/xn_ripple_bg"
            android:paddingTop="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end">
            <ImageView
                android:id="@+id/facebookArrow"
                android:layout_width="@dimen/dimen_24"
                android:layout_height="@dimen/dimen_24"
                android:src="@drawable/xn_next"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textAppearance="@style/font_black_15"
                android:id="@+id/facebookLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xn_facebook_title"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@+id/facebookArrow"
                android:elegantTextHeight="true"/>
            <TextView
                android:textAppearance="@style/font_black_12_t40"
                android:id="@+id/facebookStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/facebookLabel"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/googleL"
            android:background="@drawable/xn_ripple_bg"
            android:paddingTop="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end">
            <ImageView
                android:id="@+id/googleArrow"
                android:layout_width="@dimen/dimen_24"
                android:layout_height="@dimen/dimen_24"
                android:src="@drawable/xn_next"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textAppearance="@style/font_black_15"
                android:id="@+id/googleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xn_google_title"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@+id/googleArrow"
                android:elegantTextHeight="true"/>
            <TextView
                android:textAppearance="@style/font_black_12_t40"
                android:id="@+id/googleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/googleLabel"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/lineL"
            android:background="@drawable/xn_ripple_bg"
            android:paddingTop="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end">
            <ImageView
                android:id="@+id/lineArrow"
                android:layout_width="@dimen/dimen_24"
                android:layout_height="@dimen/dimen_24"
                android:src="@drawable/xn_next"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textAppearance="@style/font_black_15"
                android:id="@+id/lineLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xn_line_app_title"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@+id/lineArrow"
                android:elegantTextHeight="true"/>
            <TextView
                android:textAppearance="@style/font_black_12_t40"
                android:id="@+id/lineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/lineLabel"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/vkL"
            android:background="@drawable/xn_ripple_bg"
            android:paddingTop="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end">
            <ImageView
                android:id="@+id/vkArrow"
                android:layout_width="@dimen/dimen_24"
                android:layout_height="@dimen/dimen_24"
                android:src="@drawable/xn_next"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textAppearance="@style/font_black_15"
                android:id="@+id/vkLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xn_vk_app_title"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@+id/vkArrow"
                android:elegantTextHeight="true"/>
            <TextView
                android:textAppearance="@style/font_black_12_t40"
                android:id="@+id/vkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/vkLabel"/>
        </RelativeLayout>
    </LinearLayout>
</com.transsion.widgetslib.view.OverBoundNestedScrollView>
