<?xml version="1.0" encoding="utf-8"?>
<com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/viewRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout
        android:id="@+id/leftContainer"
        android:background="#f6eda3"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
    </com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout>
    <com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout
        android:id="@+id/rightContainer"
        android:background="#ffffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_layer"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:src="@drawable/diy_preview_camera"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
    </com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout>
</com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout>
