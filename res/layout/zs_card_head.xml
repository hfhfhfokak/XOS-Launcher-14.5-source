<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/zs_dimen_48dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/zs_dimen_36dp"
        android:layout_marginStart="@dimen/zs_dimen_8dp"
        android:layout_marginEnd="@dimen/zs_dimen_8dp">
        <FrameLayout
            android:id="@+id/zs_head_account_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/zs_head_coin_icon"
                android:visibility="gone"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/head_coin_icon"
                android:layout_marginStart="@dimen/dp_15"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/zs_rl_search_top"
            android:background="@drawable/zs_search_box_selector"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dp_2"
            android:layout_centerVertical="true"
            android:contentDescription="@string/zeroscreen_search"
            android:layout_toStartOf="@+id/zs_head_account_container">
            <TextView
                android:textSize="16sp"
                android:textColor="#4dffffff"
                android:id="@+id/zs_tv_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zs_search_et_hint"
                android:layout_centerVertical="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/zs_iv_scan"
                android:visibility="invisible"
                android:layout_width="@dimen/zs_zero_18dp"
                android:layout_height="@dimen/zs_zero_18sp"
                android:src="@drawable/zs_search_scan"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_11"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
