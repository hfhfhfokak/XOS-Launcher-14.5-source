<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/theme_title_lr4_layout"/>
    <View style="@style/HorizontalLine"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/eighteen_sp"
        android:textColor="@color/th_res_name_color"
        android:ellipsize="end"
        android:id="@+id/name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/twelve_dp"
        android:lines="1"
        android:layout_marginStart="@dimen/theme_common_text_screen_padding"
        android:layout_marginEnd="@dimen/theme_common_text_screen_padding"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/local_theme_detail_preview_top_margin"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/preview_view_pager"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/theme_common_screen_padding"
            android:paddingEnd="@dimen/twelve_dp"/>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/apply_rl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sixty_eight_dp">
        <Button
            android:textSize="@dimen/fifteen_sp"
            android:textColor="#ffffffff"
            android:id="@+id/apply_btn"
            android:background="@drawable/theme_download_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_six_dp"
            android:layout_marginTop="@dimen/twelve_dp"
            android:text="@string/text_apply_theme"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/theme_detail_download_btn_margin_total"
            android:layout_marginEnd="@dimen/theme_detail_download_btn_margin_total"
            style="?android:attr/borderlessButtonStyle"/>
    </RelativeLayout>
    <include layout="@layout/theme_button_gap_layout"/>
</LinearLayout>
