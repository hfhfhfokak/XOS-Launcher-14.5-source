<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/rl_loading_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/loading_error_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/fa_loading_error"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/fa_error_layout_textcolor"
            android:gravity="center"
            android:id="@+id/loading_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/failed_description"
            android:layout_below="@+id/loading_error_icon"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif"/>
    </RelativeLayout>
    <Button
        android:textSize="15sp"
        android:textColor="@color/os_platform_basic_color_os"
        android:id="@+id/loading_error_retry"
        android:background="@drawable/preference_item_bg_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9.3dp"
        android:maxHeight="43dp"
        android:minWidth="78dp"
        android:text="@string/loading_retry"
        android:layout_below="@+id/rl_loading_error"
        android:layout_centerInParent="true"
        android:onClick="retryShow"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        style="?android:attr/borderlessButtonStyle"/>
</RelativeLayout>
