<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/clean_result_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tt_clean_percent"
            android:layout_width="150dp"
            android:layout_height="44dp"
            android:layout_marginTop="155dp"
            style="@style/CleanResultPercentText"/>
        <TextView
            android:layout_width="150dp"
            android:layout_height="22dp"
            android:layout_marginTop="2dp"
            android:text="@string/clean_widget_title"
            style="@style/CleanResultSpeedUpText"/>
        <TextView
            android:id="@+id/clean_desc"
            android:layout_width="wrap_content"
            android:layout_height="63dp"
            android:text="@string/clean_submsg_freed"
            style="@style/CleanResultDesText"/>
        <Button
            android:textSize="@dimen/emoji_rating_dialog_ok_button_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/bn_clean_ok"
            android:background="@drawable/bg_emoji_dialog_ok_btn"
            android:layout_width="264dp"
            android:layout_height="40dp"
            android:text="@android:string/ok"
            android:layout_centerHorizontal="true"/>
    </LinearLayout>
</FrameLayout>
