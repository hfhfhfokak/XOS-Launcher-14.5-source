<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/enter_hide_apps_layout"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/prompt_hide_apps_margin_bottom">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/prompt_two_finger_tail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/prompt_hide_apps_image_view_margin_top"
            android:src="@drawable/guide_enter_hide_apps_tail"/>
        <ImageView
            android:id="@+id/prompt_two_finger_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/prompt_hide_apps_image_view_margin_top"
            android:src="@drawable/guide_enter_hide_apps_hand"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/prompt_text_size"
        android:textColor="@color/prompt_text_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/prompt_hide_apps_text_margin_top"
        android:text="@string/hide_apps_guide_title"
        android:contentDescription="@string/enter_hide_apps_prompt"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
</LinearLayout>
