<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/zs_ad_bg_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zero.mediation.ad.view.TMediaView
        android:id="@+id/ad_image"
        android:layout_width="@dimen/zs_dimen_144dp"
        android:layout_height="@dimen/zs_dimen_75dp"
        android:layout_marginTop="@dimen/zs_dimen_10dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="@dimen/zs_dimen_85dp"
        android:layout_weight="1"
        android:layoutDirection="locale"
        android:layout_marginStart="@dimen/zs_dimen_12dp">
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/zs_dimen_16sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ad_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/zs_dimen_11dp"
            android:maxLines="1"/>
        <Button
            android:textSize="@dimen/zs_dimen_14sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ad_install"
            android:background="@drawable/zs_xads_btn_bg"
            android:paddingLeft="@dimen/zs_dimen_8dp"
            android:paddingRight="@dimen/zs_dimen_8dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/zs_dimen_30dp"
            android:layout_marginBottom="@dimen/zs_dimen_3dp"
            android:maxWidth="@dimen/zs_dimen_126dp"
            android:minWidth="@dimen/zs_dimen_95dp"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
