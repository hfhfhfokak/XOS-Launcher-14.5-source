<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/zeroscreen_news_item"
    android:paddingStart="@dimen/dp_14"
    android:paddingEnd="@dimen/dp_14">
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/os_text_primary_color"
        android:ellipsize="end"
        android:id="@+id/x_search_three_small_content_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_9"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="sans-serif"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_8">
        <ImageView
            android:id="@+id/x_search_three_small_iv1"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_67"
            android:scaleType="centerCrop"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/x_search_three_small_iv2"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_67"
            android:scaleType="centerCrop"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/x_search_three_small_iv3"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_67"
            android:scaleType="centerCrop"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/os_text_tertiary_color"
        android:id="@+id/x_search_three_small_come_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:background="@color/os_gray_tertiary_color"
        android:layout_width="match_parent"
        android:layout_height="0.33dp"
        android:layout_marginTop="@dimen/dp_12"/>
</LinearLayout>
