<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.transsion.theme.common.customview.RoundCornerImageView
        android:id="@+id/iv_icon"
        android:background="@drawable/discover_az_up_second_iv_bg"
        android:visibility="gone"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/dp_100"
        android:scaleType="centerCrop"
        app:riv_corner_radius_top_left="@dimen/discover_iv_corners_radius"
        app:riv_corner_radius_top_right="@dimen/discover_iv_corners_radius"/>
    <ImageView
        android:id="@+id/iv_icon_play"
        android:background="@drawable/game_recommed_can_play"
        android:visibility="gone"
        android:layout_width="@dimen/dp_15"
        android:layout_height="@dimen/dp_15"
        android:layout_marginLeft="@dimen/dp_7"
        android:layout_marginBottom="@dimen/dp_7"
        android:scaleType="centerCrop"
        android:layout_alignBottom="@+id/iv_icon"/>
    <TextView
        android:textSize="@dimen/zs_zero_12sp"
        android:textColor="@color/os_btn_text_dark"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:background="@drawable/discover_az_up_second_tv_bg"
        android:paddingLeft="@dimen/dp_3"
        android:paddingRight="@dimen/dp_3"
        android:paddingBottom="@dimen/zs_zero_4dp"
        android:visibility="gone"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/dp_30"
        android:text=" "
        android:maxLines="1"
        android:layout_below="@+id/iv_icon"/>
    <ImageView
        android:id="@+id/iv_icon_size"
        android:background="@drawable/discover_az_up_iv_bg"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/zs_zero_133dp"
        android:scaleType="centerCrop"/>
</RelativeLayout>
