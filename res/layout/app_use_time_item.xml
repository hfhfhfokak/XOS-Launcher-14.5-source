<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_13"
    android:layout_weight="1"
    android:layout_marginEnd="@dimen/dp_8">
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/fl_app_use"
        android:layout_width="wrap_content"
        android:layout_height="18dp">
        <com.scene.zeroscreen.view.AppUseIndicatorView
            android:id="@+id/app_use_first_icon"
            android:layout_width="@dimen/dp_3"
            android:layout_height="@dimen/dp_10"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/dp_5"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/zs_app_use_name_color_day_night"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="18sp"
        android:layout_marginBottom="@dimen/dp_2"
        android:maxWidth="@dimen/dp_88"
        android:maxLines="1"
        android:layout_toEndOf="@+id/fl_app_use"/>
    <TextView
        android:textSize="@dimen/sp_9"
        android:textColor="@color/zs_app_use_time_color_day_night"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_app_use_time"
        android:layout_width="wrap_content"
        android:layout_height="14sp"
        android:layout_marginBottom="@dimen/dp_20"
        android:maxWidth="@dimen/dp_88"
        android:maxLines="1"
        android:layout_below="@+id/tv_app_name"
        android:layout_toEndOf="@+id/fl_app_use"/>
</RelativeLayout>
