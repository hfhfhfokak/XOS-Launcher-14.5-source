<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.guide.Guide xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guide"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_ignoreInsets="true">
    <ImageView
        android:id="@+id/guide_bg_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ViewStub
        android:id="@+id/x_guide_page_wellcom"
        android:layout="@layout/x_guide_page_wellcom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/x_guide_page_custom_wellcom"
        android:layout="@layout/x_guide_page_custom_wellcom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/x_guide_page_privacy_policy"
        android:layout="@layout/x_guide_page_privacy_policy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/x_guide_page_wallpaper"
        android:layout="@layout/x_guide_page_theme"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/x_guide_page_loading"
        android:layout="@layout/x_guide_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.transsion.xlauncher.guide.Guide>
