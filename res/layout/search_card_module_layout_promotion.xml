<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="@string/search_card_module_key_back_ground"
    android:background="@drawable/search_card_shape_bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsion.cardlibrary.element.SquareImageElement
        android:id="@+id/list_img_icon1"
        android:tag="@string/card_module_key_logo"
        android:layout_width="@dimen/card_library_38dp"
        android:layout_height="@dimen/card_library_38dp"
        android:src="@drawable/card_img_normal"
        android:scaleType="centerCrop"
        android:layout_marginEnd="@dimen/card_library_11dp"
        app:shapeAppearance="@style/RoundedStyleSearch"
        app:strokeColor="@null"/>
    <com.transsion.cardlibrary.element.TextElement
        android:textSize="16sp"
        android:textColor="@color/search_card_content_color"
        android:ellipsize="end"
        android:tag="@string/card_module_key_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/card_library_100dp"
        android:layout_toEndOf="@+id/list_img_icon1"/>
    <com.transsion.cardlibrary.element.TextElement
        android:textSize="12sp"
        android:textColor="@color/search_card_desc_color"
        android:ellipsize="end"
        android:id="@+id/search_list_desc1_tv"
        android:tag="@string/card_module_key_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_alignBottom="@+id/list_img_icon1"
        android:layout_marginEnd="@dimen/card_library_100dp"
        android:layout_toEndOf="@+id/list_img_icon1"/>
    <com.transsion.cardlibrary.element.TextElement
        android:textColor="@color/search_card_button_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/search_promotion_button_tv"
        android:tag="@string/search_card_module_key_button_text"
        android:background="@drawable/search_card_button_shape_bg"
        android:layout_width="@dimen/card_library_56dp"
        android:layout_height="@dimen/card_library_24dp"
        android:lines="1"
        android:includeFontPadding="false"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/card_library_5dp"
        android:paddingEnd="@dimen/card_library_5dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
