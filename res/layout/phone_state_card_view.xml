<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/zs_card_view_shape_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/zs_card_padding_start_end"
    android:paddingEnd="@dimen/zs_card_padding_start_end">
    <TextView
        android:textSize="@dimen/dp_10"
        android:textColor="@color/zs_step_bt_text_color_day_night"
        android:gravity="center"
        android:id="@+id/bt_ram_clean"
        android:background="@drawable/zs_card_bt_round_selector"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="85dp"
        android:layout_height="22dp"
        android:text="@string/zs_card_ram_clean"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/bt_ram_clean"
        android:layout_alignParentStart="true">
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="22dp"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/zs_phone_state_title_percent_color_day_night"
                android:gravity="bottom"
                android:id="@+id/tv_ram_progress"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="28dp"
                android:text="10%"
                android:fontFamily="Roboto Medium"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/zs_phone_state_title_color_day_night"
                android:gravity="bottom"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/zs_card_ram"
                android:fontFamily="Roboto Regular"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <com.scene.zeroscreen.view.RamProgressView
            android:layout_gravity="center_vertical"
            android:id="@+id/progressbar_ram"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</RelativeLayout>
