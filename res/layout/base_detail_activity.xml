<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/base_title_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_back"
            android:background="@drawable/os_control_background_40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/BaseBackIconStyle"/>
        <RadioGroup
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rg_instant"
            android:background="@drawable/web_instant_bg"
            android:padding="3dp"
            android:visibility="gone"
            android:layout_width="150dp"
            android:layout_height="34dp"
            android:layout_marginBottom="1dp"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <RadioButton
                android:textSize="14sp"
                android:textColor="@drawable/web_instant_textcolor_selector"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/rb_web"
                android:background="@drawable/web_instant_bg_selector"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:checked="false"
                android:button="@null"
                android:text="@string/web"
                android:lines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <RadioButton
                android:textSize="14sp"
                android:textColor="@drawable/web_instant_textcolor_selector"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/rb_instant"
                android:background="@drawable/web_instant_bg_selector"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:checked="false"
                android:button="@null"
                android:text="@string/instant"
                android:lines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="6dp"/>
        </RadioGroup>
        <ImageView
            android:id="@+id/iv_change_font_size_img"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:src="@drawable/font_size_select_icon"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_share_top"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_share_top"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/zs_ic_share_selector"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fl_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
