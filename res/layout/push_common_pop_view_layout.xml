<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/push_common_pop_view_bg_layout"
        android:background="@drawable/push_pop_view_card_bg"
        android:layout_width="@dimen/push_common_pop_view_width"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.transsion.xlauncher.admedia.widget.CustomRoundImageView
                android:id="@+id/push_common_pop_view_image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/push_common_pop_view_Image_height"
                android:scaleType="centerCrop"
                app:civ_top_left_radius="@dimen/push_common_pop_view_radius"
                app:civ_top_right_radius="@dimen/push_common_pop_view_radius"/>
            <TextView
                android:textSize="@dimen/push_common_pop_view_content_size"
                android:textColor="@color/push_common_pop_view_content_color"
                android:ellipsize="end"
                android:id="@+id/push_common_pop_view_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:maxLines="3"
                android:layout_marginStart="@dimen/push_common_pop_view_content_margin_start_end"
                android:layout_marginEnd="@dimen/push_common_pop_view_content_margin_start_end"/>
            <TextView
                android:textSize="@dimen/push_common_pop_view_btn_text_size"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/push_common_pop_view_button"
                android:background="@drawable/bg_emoji_dialog_ok_btn"
                android:layout_width="@dimen/push_common_pop_view_btn_width"
                android:layout_height="@dimen/push_common_pop_view_btn_height"
                android:layout_marginBottom="18dp"
                android:singleLine="true"/>
        </LinearLayout>
        <View
            android:background="@drawable/push_common_pop_view_gradient_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/push_common_pop_view_gradient_height"
            android:layout_marginTop="@dimen/push_common_pop_view_gradient_margin_top"/>
        <TextView
            android:textSize="@dimen/push_common_pop_view_title_size"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/push_common_pop_view_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/push_common_pop_view_title_margin_top"
            android:singleLine="true"
            android:layout_marginStart="@dimen/push_common_pop_view_title_margin_start_end"
            android:layout_marginEnd="@dimen/push_common_pop_view_title_margin_start_end"/>
    </FrameLayout>
</FrameLayout>
