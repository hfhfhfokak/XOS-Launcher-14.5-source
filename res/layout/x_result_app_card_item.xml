<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/x_rl_search_item"
    android:background="@drawable/x_search_card_item_selector"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <com.transsion.xlauncher.search.view.SaFreezeImageView
        android:id="@+id/x_iv_search_img"
        android:layout_width="@dimen/search_img_size"
        android:layout_height="@dimen/search_img_size"
        android:layout_centerVertical="true"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="12dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/search_result_item_text_color"
        android:ellipsize="end"
        android:id="@+id/x_tv_search_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:textAlignment="viewStart"
        style="@style/TextAppearance_Roboto_Content"/>
    <ImageView
        android:id="@+id/x_iv_search_location"
        android:layout_width="52dp"
        android:layout_height="58dp"
        android:src="@drawable/ic_search_location"
        android:scaleType="center"
        android:paddingStart="3dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/search_widget_text_open"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/x_tv_search_open"
        android:background="@drawable/button_bg_stroke_20dp_radius"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/x_search_instant_app_open"
        android:maxLength="8"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dimen_16"/>
</LinearLayout>
