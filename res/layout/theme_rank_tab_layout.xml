<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fifty_six_dp"
    android:layout_marginBottom="@dimen/ten_dp"
    android:layout_marginStart="@dimen/theme_rank_tab_padding"
    android:layout_marginEnd="@dimen/theme_rank_tab_padding">
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/sixteen_dp"
        android:textStyle="normal"
        android:textColor="@color/main_tab_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/weekly_download_ranking_bt"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/weekly_download_ranking"
        android:singleLine="true"
        android:layout_weight="1"
        android:textAllCaps="false"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="@dimen/sixteen_dp"
        android:textStyle="normal"
        android:textColor="@color/main_tab_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/total_download_ranking_bt"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/total_download_ranking"
        android:singleLine="true"
        android:layout_weight="1"
        android:textAllCaps="false"/>
</LinearLayout>
