<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_bg"
        android:background="@color/mini_color_surface_01"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/mini_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_bg"/>
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mini_dp_39"
        android:src="@drawable/mini_ic_pin_for_later_bg"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/mini_dp_100"
        android:layout_height="@dimen/mini_dp_78"
        android:layout_marginBottom="2dp"
        android:src="@drawable/mini_ic_pin_for_later"
        app:layout_constraintBottom_toTopOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/mini_dp_24"
        android:layout_height="@dimen/mini_dp_24"
        android:layout_marginTop="@dimen/mini_dp_8"
        android:src="@drawable/mini_ic_pin_for_later_close"
        android:layout_marginEnd="@dimen/mini_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_bg"/>
    <TextView
        android:textSize="@dimen/mini_sp_18"
        android:textColor="@color/mini_color_191f2b"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mini_dp_8"
        android:text="@string/mini_successfully_pinned_on"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/mini_dp_32"
        android:layout_marginEnd="@dimen/mini_dp_32"
        app:layout_constraintBottom_toTopOf="@+id/tv_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/mini_sp_14"
        android:textColor="@color/mini_color_191f2b"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/mini_dp_12"
        android:text="@string/mini_pin_for_later_tip"
        android:maxLines="3"
        android:fontFamily="sans-serif"
        android:layout_marginStart="@dimen/mini_dp_16"
        android:layout_marginEnd="@dimen/mini_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/ll_show"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.cloud.tmc.miniapp.widget.RoundedCornerLayout
        android:id="@+id/ll_show"
        android:layout_width="@dimen/mini_dp_220"
        android:layout_height="@dimen/mini_dp_176"
        android:layout_marginBottom="@dimen/mini_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/tv_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/iv_show"
            android:layout_width="@dimen/mini_dp_440"
            android:layout_height="@dimen/mini_dp_177"
            android:src="@drawable/mini_ic_pin_for_later_guide"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_show_ar"
            android:visibility="gone"
            android:layout_width="@dimen/mini_dp_440"
            android:layout_height="@dimen/mini_dp_177"
            android:src="@drawable/mini_ic_pin_for_later_guide_ar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_mask"
            android:layout_width="@dimen/mini_dp_220"
            android:layout_height="@dimen/mini_dp_176"
            android:layout_marginBottom="@dimen/mini_dp_20"
            android:src="@drawable/mini_ic_pin_for_later_msk"
            android:alpha="0"
            app:layout_constraintBottom_toTopOf="@+id/tv_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </com.cloud.tmc.miniapp.widget.RoundedCornerLayout>
    <TextView
        android:textColor="@color/mini_color_divider_02"
        android:id="@+id/tv_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mini_dp_16"
        android:layout_marginRight="@dimen/mini_dp_16"
        android:layout_marginBottom="@dimen/mini_dp_20"
        android:text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/mini_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/iv_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/iv_tip"
        android:layout_width="@dimen/mini_dp_42"
        android:layout_height="@dimen/mini_dp_32"
        android:layout_marginBottom="@dimen/mini_dp_24"
        android:src="@drawable/mini_ic_pin_for_later_tip"
        android:layout_marginStart="@dimen/mini_dp_42"
        app:layout_constraintBottom_toTopOf="@+id/tv_addToHomeScreen"
        app:layout_constraintEnd_toStartOf="@+id/tv_tip"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/mini_sp_14"
        android:textColor="@color/mini_color_191f2b"
        android:ellipsize="end"
        android:id="@+id/tv_tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mini_dp_4"
        android:text="@string/mini_pin_for_later_content"
        android:maxLines="2"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/mini_dp_42"
        app:layout_constraintBottom_toBottomOf="@+id/iv_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_tip"
        app:layout_constraintTop_toTopOf="@+id/iv_tip"/>
    <TextView
        android:textSize="@dimen/mini_sp_14"
        android:textColor="@color/mini_color_191f2b"
        android:gravity="center"
        android:id="@+id/tv_addToHomeScreen"
        android:background="@drawable/mini_sel_status_btn"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mini_dp_42"
        android:layout_marginRight="@dimen/mini_dp_42"
        android:layout_marginBottom="@dimen/mini_dp_12"
        android:minHeight="@dimen/mini_dp_40"
        android:text="@string/mini_add_to_home_screen"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/mini_dp_42"
        app:layout_constraintBottom_toTopOf="@+id/tv_got_it"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/mini_sp_14"
        android:textColor="@color/mini_color_191f2b"
        android:gravity="center"
        android:id="@+id/tv_got_it"
        android:background="@drawable/mini_sel_status_btn"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/mini_dp_42"
        android:layout_marginRight="@dimen/mini_dp_42"
        android:layout_marginBottom="@dimen/mini_dp_24"
        android:minHeight="@dimen/mini_dp_40"
        android:text="@string/mini_got_it"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/mini_dp_42"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
