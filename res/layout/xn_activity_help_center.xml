<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/quickUnderstandL"
        android:background="@drawable/xn_ripple_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_58"
        android:layout_marginTop="@dimen/dimen_10">
        <ImageView
            android:id="@+id/quickUnderstandArrow"
            android:layout_width="@dimen/dimen_24"
            android:layout_height="@dimen/dimen_24"
            android:src="@drawable/xn_next"
            android:layout_marginEnd="@dimen/dimen_16"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/font_black_16"
            android:id="@+id/quickUnderstand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xn_quick_understand"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/dimen_16"
            android:layout_toStartOf="@+id/quickUnderstandArrow"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/faqL"
        android:background="@drawable/xn_ripple_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_58">
        <ImageView
            android:id="@+id/faqArrow"
            android:layout_width="@dimen/dimen_24"
            android:layout_height="@dimen/dimen_24"
            android:src="@drawable/xn_next"
            android:layout_marginEnd="@dimen/dimen_16"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/font_black_16"
            android:id="@+id/faq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xn_faq"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/dimen_16"
            android:layout_toStartOf="@+id/faqArrow"/>
    </RelativeLayout>
</LinearLayout>
