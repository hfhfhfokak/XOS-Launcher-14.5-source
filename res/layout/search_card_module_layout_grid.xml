<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/search_card_shape_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/card_title_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_library_9dp"
        android:layoutDirection="locale">
        <com.transsion.cardlibrary.element.RoundImageElement
            android:id="@+id/search_grid_logo"
            android:tag="@string/card_module_key_logo"
            android:layout_width="@dimen/card_library_18dp"
            android:layout_height="@dimen/card_library_18dp"
            android:src="@drawable/card_img_normal"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/card_library_14dp"
            app:shapeAppearance="@style/CircleStyle"
            app:strokeColor="@null"/>
        <com.transsion.cardlibrary.element.TextElement
            android:textSize="12sp"
            android:textColor="@color/search_card_title_color"
            android:ellipsize="end"
            android:id="@+id/search_card_title"
            android:tag="@string/card_module_key_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/card_library_8dp"
            android:layout_marginEnd="@dimen/card_library_40dp"
            android:layout_toEndOf="@+id/search_grid_logo"/>
        <ImageView
            android:id="@+id/search_grid_arrow"
            android:tag="@string/search_card_module_key_more_icon"
            android:padding="@dimen/card_library_2dp"
            android:layout_width="@dimen/card_library_19dp"
            android:layout_height="@dimen/card_library_19dp"
            android:src="@drawable/search_card_arrow"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/card_library_18dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.transsion.cardlibrary.view.AbilityLinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_search_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_library_12dp"
        android:layout_marginBottom="@dimen/card_library_12dp"
        android:weightSum="4"
        android:layout_below="@+id/card_title_ll"
        android:layout_marginStart="@dimen/card_library_20dp"
        android:layout_marginEnd="8dp">
        <RelativeLayout
            android:id="@+id/search_card_grid_icon1"
            android:tag="@string/search_card_module_key_back_ground1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="@dimen/card_library_12dp">
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/img_icon1"
                android:tag="@string/search_card_module_key_icon1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_library_6dp"
                android:maxLines="1"
                android:layout_below="@+id/img_icon1"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/search_card_grid_icon2"
            android:tag="@string/search_card_module_key_back_ground2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="@dimen/card_library_12dp">
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/img_icon2"
                android:tag="@string/search_card_module_key_icon2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_library_6dp"
                android:maxLines="1"
                android:layout_below="@+id/img_icon2"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/search_card_grid_icon3"
            android:tag="@string/search_card_module_key_back_ground3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="@dimen/card_library_12dp">
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/img_icon3"
                android:tag="@string/search_card_module_key_icon3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_library_6dp"
                android:maxLines="1"
                android:layout_below="@+id/img_icon3"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/search_card_grid_icon4"
            android:tag="@string/search_card_module_key_back_ground4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="@dimen/card_library_12dp">
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/img_icon4"
                android:tag="@string/search_card_module_key_icon4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_library_6dp"
                android:maxLines="1"
                android:layout_below="@+id/img_icon4"/>
        </RelativeLayout>
    </com.transsion.cardlibrary.view.AbilityLinearLayout>
    <com.transsion.cardlibrary.view.AbilityLinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_search_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4"
        android:layout_below="@+id/ll_search_top"
        android:layout_marginStart="@dimen/card_library_20dp"
        android:layout_marginEnd="@dimen/card_library_8dp">
        <RelativeLayout
            android:id="@+id/search_card_grid_icon5"
            android:tag="@string/search_card_module_key_back_ground5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_library_14dp"
            android:layout_weight="1"
            android:paddingEnd="@dimen/card_library_12dp">
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/img_icon5"
                android:tag="@string/search_card_module_key_icon5"
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_library_66dp"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_library_6dp"
                android:maxLines="1"
                android:layout_below="@+id/img_icon5"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/search_card_grid_icon6"
            android:tag="@string/search_card_module_key_back_ground6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_library_14dp"
            android:layout_weight="1"
            android:paddingEnd="@dimen/card_library_12dp">
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/img_icon6"
                android:tag="@string/search_card_module_key_icon6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_library_66dp"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_library_6dp"
                android:maxLines="1"
                android:layout_below="@+id/img_icon6"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/search_card_grid_icon7"
            android:tag="@string/search_card_module_key_back_ground7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_library_14dp"
            android:layout_weight="1"
            android:paddingEnd="@dimen/card_library_12dp">
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/img_icon7"
                android:tag="@string/search_card_module_key_icon7"
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_library_66dp"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_library_6dp"
                android:maxLines="1"
                android:layout_below="@+id/img_icon7"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/search_card_grid_icon8"
            android:tag="@string/search_card_module_key_back_ground8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_library_14dp"
            android:layout_weight="1"
            android:paddingEnd="@dimen/card_library_12dp">
            <com.transsion.cardlibrary.element.SquareImageElement
                android:id="@+id/img_icon8"
                android:tag="@string/search_card_module_key_icon8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_library_66dp"
                android:src="@drawable/card_img_normal"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RoundedStyleSearch"
                app:strokeColor="@null"/>
            <com.transsion.cardlibrary.element.TextElement
                android:textSize="12sp"
                android:textColor="@color/search_card_content_color"
                android:ellipsize="end"
                android:gravity="center"
                android:tag="@string/card_module_key_text8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_library_6dp"
                android:maxLines="1"
                android:layout_below="@+id/img_icon8"/>
        </RelativeLayout>
    </com.transsion.cardlibrary.view.AbilityLinearLayout>
</RelativeLayout>
