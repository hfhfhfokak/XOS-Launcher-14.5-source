<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_new_detail_select_instant_view"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/btn_new_detail_select_instant_view"
        android:background="@drawable/instant_bg"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/instant_view"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/instant"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#9b9b9b"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/slow_tip"/>
    <CheckBox
        android:textSize="12sp"
        android:textColor="#388e3c"
        android:layout_gravity="center"
        android:id="@+id/cb_new_detail_select_instant_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/always_enable"/>
</LinearLayout>
