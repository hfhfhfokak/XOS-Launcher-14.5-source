<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ptr="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <include layout="@layout/theme_title_lr2_layout"/>
        <View
            android:id="@+id/gap_line"
            style="@style/HorizontalLine"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.handmark.pulltorefresh.library.PullToRefreshScrollView
                android:id="@+id/theme_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                ptr:ptrAnimationStyle="flip"
                ptr:ptrDrawable="@drawable/ic_down"
                ptr:ptrScrollingWhileRefreshingEnabled="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/detail_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.transsion.theme.common.customview.ElegantTextView
                        android:textSize="@dimen/twelve_sp"
                        android:textColor="@color/theme_detail_author_tv"
                        android:id="@+id/author_tv"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/six_dp"
                        android:layout_marginBottom="@dimen/one_dp"
                        style="@style/author_tv_style"/>
                    <include layout="@layout/detail_base_info"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/detail_viewPager"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/five_dp"
                        android:layout_marginStart="@dimen/theme_common_screen_padding_with_item_padding"
                        android:layout_marginEnd="@dimen/theme_common_screen_padding_with_item_padding"/>
                    <com.transsion.theme.common.customview.ElegantTextView
                        android:textSize="@dimen/fourteen_sp"
                        android:textColor="@color/purple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/eight_dp"
                        android:text="@string/text_theme_description"
                        android:layout_marginStart="@dimen/theme_common_text_screen_padding"
                        android:layout_marginEnd="@dimen/theme_common_text_screen_padding"/>
                    <com.transsion.theme.common.customview.ElegantTextView
                        android:textSize="@dimen/twelve_sp"
                        android:textColor="@color/percentage_100_gray"
                        android:id="@+id/theme_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/three_dp"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="@dimen/theme_common_text_screen_padding"
                        android:layout_marginEnd="@dimen/theme_common_text_screen_padding"/>
                    <com.transsion.theme.common.customview.ElegantTextView
                        android:textSize="@dimen/twelve_sp"
                        android:textColor="@color/percentage_50_gray"
                        android:layout_gravity="end"
                        android:id="@+id/theme_description_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/theme_common_text_screen_padding"
                        android:layout_marginEnd="@dimen/theme_common_text_screen_padding"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/twenty_dp"/>
                    <com.transsion.theme.common.FlowLayout
                        android:id="@+id/detail_labels"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/eighteen_dp"
                        android:layout_marginStart="@dimen/theme_common_text_screen_padding"
                        android:layout_marginEnd="@dimen/theme_common_text_screen_padding"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/twelve_dp"
                        android:layout_marginStart="@dimen/theme_common_screen_padding_with_item_padding"
                        android:layout_marginEnd="@dimen/theme_common_screen_padding_with_item_padding">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/theme_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.handmark.pulltorefresh.library.PullToRefreshScrollView>
            <com.transsion.theme.common.customview.RefreshView
                android:id="@+id/refresh_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/theme_download_action"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sixty_eight_dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_six_dp"
            android:layout_marginTop="@dimen/twelve_dp"
            android:layout_marginStart="@dimen/theme_detail_download_btn_margin_total"
            android:layout_marginEnd="@dimen/theme_detail_download_btn_margin_end">
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/downing_state"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ProgressBar
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/downing_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ProgressBar_Mini"/>
                <com.transsion.theme.common.customview.ElegantTextView
                    android:textSize="@dimen/sixteen_sp"
                    android:textColor="@color/th_detail_btn_text_color"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/downing_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:lines="1"/>
            </RelativeLayout>
            <FrameLayout
                android:layout_width="@dimen/forty_eight_dp"
                android:layout_height="match_parent">
                <ImageView
                    android:gravity="center"
                    android:id="@+id/downing_stop"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_download_stop"
                    android:scaleType="center"/>
                <ImageView
                    android:gravity="center"
                    android:id="@+id/downing_going"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_download_going"
                    android:scaleType="center"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/btn_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_six_dp"
            android:layout_marginTop="@dimen/twelve_dp"
            android:layout_marginStart="@dimen/theme_detail_download_btn_margin"
            android:layout_marginEnd="@dimen/theme_detail_download_btn_margin">
            <View
                android:id="@+id/btn_start_gap"
                android:visibility="gone"
                android:layout_width="@dimen/twenty_six_dp"
                android:layout_height="match_parent"/>
            <Button
                android:textSize="@dimen/fourteen_sp"
                android:textColor="@color/purple"
                android:id="@+id/btn_trial_theme"
                android:background="@drawable/theme_trial_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/text_trial_theme"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="@dimen/twenty_four_dp"
                style="?android:attr/borderlessButtonStyle"/>
            <Button
                android:textSize="@dimen/twelve_sp"
                android:textColor="@color/th_detail_btn_text_color"
                android:id="@+id/btn_download_theme"
                android:background="@drawable/theme_download_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/text_theme_download"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium"
                style="?android:attr/borderlessButtonStyle"/>
            <View
                android:id="@+id/btn_end_gap"
                android:visibility="gone"
                android:layout_width="@dimen/twenty_six_dp"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </RelativeLayout>
    <include layout="@layout/theme_button_gap_layout"/>
</LinearLayout>
