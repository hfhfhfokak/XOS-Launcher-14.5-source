<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guide_produce_conent"
    android:background="@color/guide_product_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/guide_product_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/guide_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/guide_product_text_margin_top"
        android:drawablePadding="@dimen/guide_product_drawable_padding"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="@dimen/guide_product_title_text_size"
        android:textColor="@color/guide_product_text_color"
        android:id="@+id/guide_product_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/guide_product_title_margin_top"
        android:text="@string/guide_product_title"
        android:layout_below="@+id/guide_product"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textSize="@dimen/dialog_text_size"
        android:textStyle="bold"
        android:textColor="@color/guide_product_text_color"
        android:id="@+id/guide_product_cancel"
        android:background="@null"
        android:layout_width="@dimen/guide_product_button_width"
        android:layout_height="@dimen/guide_product_button_height"
        android:layout_marginTop="@dimen/guide_product_cancel_margin_top"
        android:layout_marginBottom="@dimen/guide_product_margin"
        android:text="@string/guide_product_cancel"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"/>
    <Button
        android:textSize="@dimen/dialog_text_size"
        android:textStyle="bold"
        android:textColor="@color/guide_product_ok_color"
        android:id="@+id/guide_product_ok"
        android:layout_width="@dimen/guide_product_button_width"
        android:layout_height="@dimen/guide_product_button_height"
        android:layout_marginTop="@dimen/guide_product_ok_margin_top"
        android:text="@string/guide_product_ok"
        android:layout_above="@+id/guide_product_cancel"
        android:layout_centerHorizontal="true"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"
        style="@style/CustomButtonTheme"/>
</RelativeLayout>
