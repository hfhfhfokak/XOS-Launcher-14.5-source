<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:paddingBottom="@dimen/ten_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/sixteen_dp"
        android:paddingEnd="@dimen/sixteen_dp">
        <com.transsion.theme.common.customview.RoundCornerImageView
            android:id="@+id/share_picture"
            android:layout_width="match_parent"
            android:layout_height="136dp"
            android:scaleType="fitXY"
            app:roundCornerRadius="@dimen/theme_preview_corner_radius"/>
        <com.transsion.theme.common.customview.ElegantTextView
            android:textSize="@dimen/ten_sp"
            android:textColor="@android:color/white"
            android:layout_gravity="bottom"
            android:id="@+id/water_mark"
            android:paddingLeft="@dimen/ten_dp"
            android:paddingBottom="@dimen/seven_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@android:color/black"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"/>
    </FrameLayout>
    <CheckedTextView
        android:textSize="@dimen/sixteen_sp"
        android:textColor="@color/theme_detail_author_tv"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/is_show_water_mark"
        android:background="@drawable/os_press_primary_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:minHeight="@dimen/fifty_dp"
        android:drawableEnd="@drawable/dialog_selector_checkbox"
        android:paddingStart="@dimen/sixteen_dp"
        android:paddingEnd="@dimen/sixteen_dp"/>
</LinearLayout>
