<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ram_card_root"
    android:background="@drawable/zs_card_view_shape_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:paddingStart="@dimen/zs_card_padding_start_end"
    android:paddingEnd="0dp">
    <FrameLayout
        android:id="@+id/ram_card_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ram_card_used_title"
        android:layout_alignParentTop="true">
        <RelativeLayout
            android:paddingTop="@dimen/dp_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="locale">
            <TextView
                android:textSize="@dimen/zs_ram_card_title_text_size"
                android:textColor="@color/zs_ram_card_title_color"
                android:ellipsize="end"
                android:id="@+id/ram_title_text"
                android:layout_width="63.67dp"
                android:layout_height="wrap_content"
                android:text="@string/zs_card_ram"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_above="@+id/ram_number_text"
                android:layout_alignParentTop="true"
                android:textDirection="locale"
                android:layout_alignParentStart="true"
                android:textFontWeight="500"/>
            <TextView
                android:textSize="@dimen/zs_ram_card_number_text_size"
                android:textColor="@color/zs_ram_card_number_text_color"
                android:id="@+id/ram_number_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22"
                android:includeFontPadding="false"
                android:layout_alignParentBottom="true"
                android:textFontWeight="400"/>
        </RelativeLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            layout="@layout/zs_ram_anim_icon_lyt"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/zs_ram_card_used_title_text_size"
        android:textColor="@color/zs_ram_card_title_color"
        android:id="@+id/ram_card_used_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_9"
        android:text="@string/zs_card_ram_used"
        android:includeFontPadding="false"
        android:layout_above="@+id/ram_card_progress"
        android:layout_marginEnd="@dimen/dp_16"
        android:textFontWeight="500"/>
    <com.scene.zeroscreen.view.RamCardProgressBar
        android:id="@+id/ram_card_progress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginBottom="19.67dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/dp_16"
        style="@style/ZsRamCardProgressBarStyle"/>
</RelativeLayout>
