<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.library.settingbase.LauRoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/preference_item_bg_selector"
    android:paddingTop="@dimen/preference_item_padding_top_bottom"
    android:paddingBottom="@dimen/preference_item_padding_top_bottom"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/preference_item_min_height"
    android:paddingStart="@dimen/preference_item_padding_start"
    android:paddingEnd="@dimen/preference_item_padding_end"
    android:layout_marginStart="@dimen/preference_item_margin_start_end"
    android:layout_marginEnd="@dimen/preference_item_margin_start_end">
    <include
        android:layout_width="@dimen/preference_item_start_icon_big_wh"
        android:layout_height="@dimen/preference_item_start_icon_big_wh"
        android:layout_marginStart="@dimen/preference_item_start_icon_margin_start"
        layout="@layout/preference_item_widget_icon"/>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/preference_item_text_margin_start">
        <com.transsion.xlauncher.library.settingbase.MarqueeText
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingEnd="@dimen/preference_item_Text_padding_end"
            style="@style/PreferenceText.Title"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:id="@+id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/preference_item_end_icon_summary_margin_start"
        android:layout_marginEnd="@dimen/preference_item_end_icon_margin_end">
        <TextView
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="25"
            android:drawableEnd="@drawable/ic_list_next"
            android:textAlignment="viewStart"
            style="@style/PreferenceText.Summary"/>
    </LinearLayout>
</com.transsion.xlauncher.library.settingbase.LauRoundLinearLayout>
