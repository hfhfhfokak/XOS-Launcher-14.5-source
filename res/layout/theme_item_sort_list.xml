<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/theme_common_item_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsion.theme.common.ThemeCoverView
        android:id="@+id/sort_cover"
        android:layout_width="match_parent"
        android:layout_height="@dimen/theme_sort_item_height"
        app:isNeedText="false"
        app:radios="@dimen/theme_preview_corner_radius"/>
    <com.transsion.theme.common.customview.ElegantTextView
        android:textSize="20sp"
        android:textColor="#ffffffff"
        android:id="@+id/sort_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="24dp"/>
</RelativeLayout>
