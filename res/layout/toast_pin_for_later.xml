<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/view_bg"
        android:background="@drawable/mini_pin_for_later_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/mini_dp_64"
        android:layout_marginLeft="@dimen/mini_dp_16"
        android:layout_marginRight="@dimen/mini_dp_16"
        android:layout_marginBottom="@dimen/mini_dp_30"
        android:layout_marginHorizontal="@dimen/mini_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/mini_dp_80"
        android:layout_height="@dimen/mini_dp_62"
        android:layout_marginBottom="@dimen/mini_dp_50"
        android:src="@drawable/mini_ic_pin_for_later"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/mini_color_element_regular"
        android:gravity="center"
        android:id="@+id/tv_view"
        android:background="@drawable/mini_pin_for_later_view_bg"
        android:layout_width="@dimen/mini_dp_64"
        android:layout_height="@dimen/mini_dp_28"
        android:text="@string/mini_view"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="@dimen/mini_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_bg"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/mini_color_191f2b"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/mini_successfully_pinned_on_recently_used"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/mini_dp_12"
        android:layout_marginEnd="@dimen/mini_dp_100"
        app:layout_constraintBottom_toBottomOf="@+id/view_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/view_bg"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
