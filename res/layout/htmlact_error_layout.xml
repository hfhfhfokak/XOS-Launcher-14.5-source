<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/htmlact_error_layout_bgcolor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/loading_error_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="60dp"
        android:src="@drawable/htmlact_loading_error"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/htmlact_error_layout_textcolor"
        android:id="@+id/loading_error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/failed_description"
        android:layout_below="@+id/loading_error_icon"
        android:layout_centerInParent="true"/>
    <Button
        android:textSize="14sp"
        android:textColor="@color/white"
        android:id="@+id/loading_error_retry"
        android:background="@drawable/htmlact_retry_button_style"
        android:layout_width="100dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:text="@string/loading_retry"
        android:layout_below="@+id/loading_error_message"
        android:layout_centerInParent="true"
        android:onClick="retryShow"/>
</RelativeLayout>
