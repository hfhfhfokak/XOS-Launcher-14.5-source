<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <TextView
        android:textSize="@dimen/zs_dialog_text_size"
        android:textColor="@color/zs_dialog_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/zs_search_dialog_message"
        style="@style/TextAppearance_Roboto_Content"/>
    <CheckBox
        android:textColor="@color/zs_dialog_text_color"
        android:id="@+id/zs_gs_dialog_checkbox"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:button="@drawable/zs_checkbox_selector_xos"
        android:text="@string/zs_search_dialog_checkbox"
        style="@style/TextAppearance_Roboto_Content"/>
</LinearLayout>
