<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guide_page_wallpaper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/guide_wallpager_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="70dp"
        android:layout_marginRight="50dp"
        android:text="@string/guide_wallpager_title"
        android:shadowColor="#33000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="2"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"/>
    <Button
        android:textSize="@dimen/guide_button_text_size"
        android:textColor="@color/white"
        android:id="@+id/guide_wallpaper_button"
        android:background="@drawable/guide_button_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/guide_button_height"
        android:layout_marginLeft="65dp"
        android:layout_marginRight="65dp"
        android:layout_marginBottom="@dimen/x_guide_bottom_button_margin_bottom"
        android:text="@string/guide_wallpaper_button"
        android:shadowColor="#33000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="2"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:contentDescription="@string/desc_content_guide_wallpaper_button"
        android:textAllCaps="false"
        style="?android:attr/borderlessButtonStyle"/>
    <com.transsion.xlauncher.guide.GuideWallpaperPickView
        android:id="@+id/guide_wallpager_pick_view"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/guide_wallpaper_preview_home_height"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:layout_above="@+id/guide_wallpaper_button"
        android:layout_below="@+id/guide_wallpager_title"
        android:layout_centerHorizontal="true">
        <com.transsion.xlauncher.guide.WallpaperViewPager
            android:layout_gravity="center"
            android:id="@+id/guide_wallpaper_view_pager"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/guide_wallpaper_preview_home"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/guide_wallpaper_preview_home_icons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </com.transsion.xlauncher.guide.GuideWallpaperPickView>
</RelativeLayout>
