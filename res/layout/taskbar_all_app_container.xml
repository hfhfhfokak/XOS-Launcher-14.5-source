<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/rl_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.quickstep.src.com.android.launcher3.taskbar.allapps.TaskbarLinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="22dp"
            android:layout_marginBottom="8dp"
            layout="@layout/taskbar_all_apps_topbar"/>
        <com.android.quickstep.src.com.android.launcher3.taskbar.allapps.TaskbarAllAppsPageHead
            android:id="@+id/taskbar_pageHead"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:layout_gravity="center"
            android:id="@+id/all_apps_container_view_stub"
            android:visibility="gone"
            android:layout="@layout/taskbar_all_apps_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.android.quickstep.src.com.android.launcher3.taskbar.allapps.TaskbarLinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/v_shadow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/ll_main"
        android:layout_alignTop="@+id/ll_main"
        android:layout_alignRight="@+id/ll_main"
        android:layout_alignBottom="@+id/ll_main"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/view_btn_background"
        android:background="@drawable/taskbar_all_apps_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_30"
        android:layout_alignLeft="@+id/ll_main"
        android:layout_alignRight="@+id/ll_main"
        android:layout_alignBottom="@+id/ll_main"/>
</RelativeLayout>
