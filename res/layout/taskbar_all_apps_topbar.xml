<?xml version="1.0" encoding="utf-8"?>
<com.android.quickstep.src.com.android.launcher3.taskbar.transsion.allapps.TaskbarTopSearchBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_layout"
    android:paddingBottom="@dimen/all_apps_topbar_bottom_padding"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <FrameLayout
        android:id="@+id/search_container"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/picture_blur_shadow_height"
        android:layout_marginBottom="-1dp"
        android:src="@drawable/picture_blur_shadow"
        android:scaleType="fitXY"
        android:layout_alignParentBottom="true"/>
</com.android.quickstep.src.com.android.launcher3.taskbar.transsion.allapps.TaskbarTopSearchBar>
