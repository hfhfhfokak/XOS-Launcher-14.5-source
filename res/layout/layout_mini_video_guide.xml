<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#66000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/swipe_line"
        android:background="@drawable/mini_shape_swipe_line"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="38dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_swipe_up"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/iv_swipe_finger"
        android:layout_width="51dp"
        android:layout_height="36dp"
        android:src="@drawable/mini_ic_video_swipe_finger"
        app:layout_constraintStart_toStartOf="@+id/swipe_line"
        app:layout_constraintTop_toTopOf="@+id/swipe_line"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_swipe_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:text="@string/mini_swipe_guide"
        android:fontFamily="sans-serif"
        android:layout_marginHorizontal="30dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.58"/>
</androidx.constraintlayout.widget.ConstraintLayout>
