<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_toolbar"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.transsion.xlauncher.library.springview.SpringScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/rl_name_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/clock_widget_islsetting_content_selected_text_color"
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/tv_c_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="150dp"
                            android:text="@string/hijri_c_name_default"
                            android:fontFamily="sans-serif"
                            android:layout_marginStart="16dp"/>
                        <TextView
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/tv_arrow_name"
                            android:background="@drawable/os7_ic_list_pulldown"
                            android:layout_width="24dp"
                            android:layout_height="24dp"/>
                        <View
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/tv_arrow_name_anchor"
                            android:layout_width="16dp"
                            android:layout_height="match_parent"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/clock_widget_islsetting_content_text_color"
                        android:id="@+id/tv_other"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hijri_c_name_other"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="16dp"
                        android:layout_toStartOf="@+id/rl_name_spinner"
                        android:layout_alignParentStart="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_num"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="58dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/rl_num_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/clock_widget_islsetting_content_selected_text_color"
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/tv_c_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hijri_c_num2"
                            android:fontFamily="sans-serif"
                            android:layout_marginStart="16dp"/>
                        <TextView
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/tv_arrow_num"
                            android:background="@drawable/os7_ic_list_pulldown"
                            android:layout_width="24dp"
                            android:layout_height="24dp"/>
                        <View
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/tv_arrow_num_anchor"
                            android:layout_width="16dp"
                            android:layout_height="match_parent"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/clock_widget_islsetting_content_text_color"
                        android:id="@+id/tv_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hijri_c_name_xjl"
                        android:layout_centerVertical="true"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="16dp"
                        android:layout_toStartOf="@+id/rl_num_spinner"
                        android:layout_alignParentStart="true"/>
                </RelativeLayout>
            </LinearLayout>
        </com.transsion.xlauncher.library.springview.SpringScrollView>
    </FrameLayout>
</LinearLayout>
