<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/step_card_root"
    android:background="@drawable/zs_card_view_shape_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:paddingStart="@dimen/zs_card_padding_start_end"
    android:paddingEnd="@dimen/zs_card_padding_start_end">
    <FrameLayout
        android:id="@+id/step_card_progressbar_container"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_centerVertical="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.scene.zeroscreen.view.HealthProgressView
            android:id="@+id/step_card_progressbar"
            android:layout_width="60dp"
            android:layout_height="60dp"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/step_card_icon_anim_lottie"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/step_card_progressbar_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/step_card_progressbar_container">
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/zs_step_goal_text_color_day_night"
            android:id="@+id/tv_goal_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zs_goal"
            android:fontFamily="Roboto Regular"
            style="@style/ZsStepCardTextStyle"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textStyle="bold"
            android:textColor="@color/zs_step_num_color_day_night"
            android:id="@+id/step_card_goal_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="Roboto Regular"
            style="@style/ZsStepCardTextStyle"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/kolun_card_bt_text_color_normal"
            android:id="@+id/bt_set_goal"
            android:focusable="true"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zs_card_step_setgoal"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            style="@style/ZsStepCardTextStyle"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_28"
        android:textColor="@color/zs_step_num_color_day_night"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/step_card_steps_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="0"
        android:maxLines="1"
        android:fontFamily="Roboto Regular"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
