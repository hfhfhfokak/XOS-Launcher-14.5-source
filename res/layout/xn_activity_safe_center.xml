<?xml version="1.0" encoding="utf-8"?>
<com.transsion.widgetslib.view.OverBoundNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/xn_full_margin_start"
    android:layout_marginEnd="@dimen/xn_full_margin_end">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textAppearance="@style/font_black_14_t40"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/xn_safe_info"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end"
            android:elegantTextHeight="true"/>
        <RelativeLayout
            android:id="@+id/phoneL"
            android:background="@drawable/xn_ripple_bg"
            android:paddingTop="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end">
            <ImageView
                android:id="@+id/phoneArrow"
                android:layout_width="@dimen/dimen_24"
                android:layout_height="@dimen/dimen_24"
                android:src="@drawable/xn_next"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textAppearance="@style/font_black_15"
                android:id="@+id/phoneLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xn_phone_num"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@+id/phoneArrow"
                android:elegantTextHeight="true"/>
            <TextView
                android:textAppearance="@style/font_black_12_t40"
                android:id="@+id/phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/phoneLabel"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/emailL"
            android:background="@drawable/xn_ripple_bg"
            android:paddingTop="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end">
            <ImageView
                android:id="@+id/emailArrow"
                android:layout_width="@dimen/dimen_24"
                android:layout_height="@dimen/dimen_24"
                android:src="@drawable/xn_next"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textAppearance="@style/font_black_15"
                android:id="@+id/emailLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xn_email"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@+id/emailArrow"
                android:elegantTextHeight="true"/>
            <TextView
                android:textAppearance="@style/font_black_12_t40"
                android:id="@+id/email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/emailLabel"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/emergencyContactL"
            android:background="@drawable/xn_ripple_bg"
            android:paddingTop="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end">
            <ImageView
                android:id="@+id/emergencyContactArrow"
                android:layout_width="@dimen/dimen_24"
                android:layout_height="@dimen/dimen_24"
                android:src="@drawable/xn_next"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textAppearance="@style/font_black_15"
                android:id="@+id/emergencyContactLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xn_emergency_contact"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@+id/emergencyContactArrow"
                android:elegantTextHeight="true"/>
            <TextView
                android:textAppearance="@style/font_black_12_t40"
                android:id="@+id/emergencyContact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_below="@+id/emergencyContactLabel"/>
        </RelativeLayout>
        <View
            android:background="@color/xn_divider_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dimen_12"
            android:layout_marginStart="@dimen/dimen_24"
            android:layout_marginEnd="@dimen/dimen_24"/>
        <TextView
            android:textAppearance="@style/font_black_14_t40"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/xn_pwd_manage"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end"
            android:elegantTextHeight="true"/>
        <RelativeLayout
            android:id="@+id/pwdL"
            android:background="@drawable/xn_ripple_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_58"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end">
            <ImageView
                android:id="@+id/pwdArrow"
                android:layout_width="@dimen/dimen_24"
                android:layout_height="@dimen/dimen_24"
                android:src="@drawable/xn_next"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textAppearance="@style/font_black_15"
                android:id="@+id/pwdLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xn_pwd_change"
                android:layout_centerVertical="true"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@+id/pwdArrow"
                android:elegantTextHeight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/loginML"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/xn_divider_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dimen_12"
                android:layout_marginStart="@dimen/dimen_24"
                android:layout_marginEnd="@dimen/dimen_24"/>
            <TextView
                android:textAppearance="@style/font_black_14_t40"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="@string/xn_login_manage"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end"
                android:elegantTextHeight="true"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/thirdL"
            android:background="@drawable/xn_ripple_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dimen_58"
            android:paddingStart="@dimen/xn_item_padding_start"
            android:paddingEnd="@dimen/xn_item_padding_end">
            <ImageView
                android:id="@+id/bindThirdArrow"
                android:layout_width="@dimen/dimen_24"
                android:layout_height="@dimen/dimen_24"
                android:src="@drawable/xn_next"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textAppearance="@style/font_black_15"
                android:id="@+id/bindThirdLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xn_bind_third"
                android:layout_centerVertical="true"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@+id/bindThirdArrow"
                android:elegantTextHeight="true"/>
        </RelativeLayout>
    </LinearLayout>
</com.transsion.widgetslib.view.OverBoundNestedScrollView>
