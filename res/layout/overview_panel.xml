<?xml version="1.0" encoding="utf-8"?>
<com.transsion.xlauncher.base.PaletteLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dock_menu_view_size"
    android:paddingStart="@dimen/overview_panel_padding_start_end"
    android:paddingEnd="@dimen/overview_panel_padding_start_end"
    launcher:layout_ignoreInsets="true">
    <com.transsion.xlauncher.base.PaletteTextView
        android:textSize="@dimen/overview_panel_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/wallpaper_button"
        android:paddingBottom="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/wallpaper_button_text"
        android:singleLine="true"
        android:drawableTop="@drawable/ic_dock_wallpaper"
        android:drawablePadding="@dimen/overview_panel_drawable_padding"
        android:layout_weight="1"
        android:contentDescription="@string/wallpaper_button_text"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"
        android:paddingStart="@dimen/overview_panel_text_padding_start_end"
        android:paddingEnd="@dimen/overview_panel_text_padding_start_end"
        android:stateListAnimator="@anim/overview_button_anim"/>
    <com.transsion.xlauncher.base.PaletteTextView
        android:textSize="@dimen/overview_panel_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/widget_button"
        android:paddingBottom="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/hotseat_widget"
        android:singleLine="true"
        android:drawableTop="@drawable/ic_dock_widgets"
        android:drawablePadding="@dimen/overview_panel_drawable_padding"
        android:layout_weight="1"
        android:contentDescription="@string/hotseat_widget"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"
        android:paddingStart="@dimen/overview_panel_text_padding_start_end"
        android:paddingEnd="@dimen/overview_panel_text_padding_start_end"
        android:stateListAnimator="@anim/overview_button_anim"/>
    <com.transsion.xlauncher.base.PaletteTextView
        android:textSize="@dimen/overview_panel_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/xtheme_button"
        android:paddingBottom="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/theme_app_name"
        android:singleLine="true"
        android:drawableTop="@drawable/ic_dock_xtheme"
        android:drawablePadding="@dimen/overview_panel_drawable_padding"
        android:layout_weight="1"
        android:contentDescription="@string/theme_app_name"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"
        android:paddingStart="@dimen/overview_panel_text_padding_start_end"
        android:paddingEnd="@dimen/overview_panel_text_padding_start_end"
        android:stateListAnimator="@anim/overview_button_anim"/>
    <com.transsion.xlauncher.base.PaletteTextView
        android:textSize="@dimen/overview_panel_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/icon_style_button"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/desktop_icon_style"
        android:singleLine="true"
        android:drawableTop="@drawable/ic_dock_icon_style"
        android:drawablePadding="@dimen/overview_panel_drawable_padding"
        android:layout_weight="1"
        android:contentDescription="@string/desktop_icon_style"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"
        android:paddingStart="@dimen/overview_panel_text_padding_start_end"
        android:paddingEnd="@dimen/overview_panel_text_padding_start_end"
        android:stateListAnimator="@anim/overview_button_anim"/>
    <com.transsion.xlauncher.base.PaletteTextView
        android:textSize="@dimen/overview_panel_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/settings_button"
        android:paddingBottom="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/settings_button_text"
        android:singleLine="true"
        android:drawableTop="@drawable/ic_dock_settings"
        android:drawablePadding="@dimen/overview_panel_drawable_padding"
        android:layout_weight="1"
        android:contentDescription="@string/settings_button_text"
        android:textAllCaps="false"
        android:fontFamily="sans-serif"
        android:paddingStart="@dimen/overview_panel_text_padding_start_end"
        android:paddingEnd="@dimen/overview_panel_text_padding_start_end"
        android:stateListAnimator="@anim/overview_button_anim"/>
</com.transsion.xlauncher.base.PaletteLinearLayout>
