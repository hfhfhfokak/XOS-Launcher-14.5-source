<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/xn_full_margin_start"
    android:layout_marginEnd="@dimen/xn_full_margin_end">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView2"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_marginBottom="@dimen/dimen_16"
        android:listSelector="#00000000"
        android:cacheColorHint="#00000000"
        android:divider="@null"/>
    <RelativeLayout
        android:id="@+id/emptyL"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/emptyLogo"
            android:layout_width="200dp"
            android:layout_height="140dp"
            android:src="@mipmap/xn_empty_country"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textAppearance="@style/font_black_16_t40"
            android:gravity="center"
            android:id="@+id/emptyNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xn_no_result"
            android:layout_below="@+id/emptyLogo"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/dimen_32"
            android:layout_marginEnd="@dimen/dimen_32"/>
    </RelativeLayout>
</RelativeLayout>
