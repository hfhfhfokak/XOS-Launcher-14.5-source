<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/xn_full_margin_start"
    android:layout_marginEnd="@dimen/xn_full_margin_end">
    <View
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <Button
        android:enabled="false"
        android:id="@+id/next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/xn_next"
        android:layout_above="@+id/placeholder"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="72dp"
        style="@style/OS.Widget.Button.Contained.Big.Single"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="12dp"
        android:layout_above="@+id/next">
        <com.transsion.widgetslib.view.OverBoundNestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end">
                <TextView
                    android:textAppearance="@style/font_black_18_medium"
                    android:id="@+id/inputEmailNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_verify_email_note"
                    android:elegantTextHeight="true"/>
                <com.transsion.xuanniao.account.comm.widget.EmailInput
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_24"
                    android:layout_below="@+id/inputEmailNote"/>
                <com.transsion.xuanniao.account.comm.widget.CaptchaCodeInput
                    android:id="@+id/captchaCodeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16"
                    android:layout_below="@+id/emailInput"/>
                <com.transsion.xuanniao.account.comm.widget.SmsCodeInput
                    android:id="@+id/smsCodeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16"
                    android:layout_below="@+id/captchaCodeInput"/>
                <com.transsion.xuanniao.account.comm.widget.ErrorView
                    android:id="@+id/errorView"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8"
                    android:layout_below="@+id/smsCodeInput"
                    android:layout_alignStart="@+id/smsCodeInput"/>
                <TextView
                    android:textAppearance="@style/font_black_10_t40"
                    android:id="@+id/notExistPrefix"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8"
                    android:text="@string/xn_not_exist_prefix"
                    android:layout_below="@+id/errorView"
                    android:layout_alignStart="@+id/smsCodeInput"
                    android:elegantTextHeight="true"/>
                <TextView
                    android:textAppearance="@style/font_primary_10"
                    android:id="@+id/notExistSuffix"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_not_exist_suffix"
                    android:layout_alignTop="@+id/notExistPrefix"
                    android:layout_toEndOf="@+id/notExistPrefix"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
        </com.transsion.widgetslib.view.OverBoundNestedScrollView>
    </RelativeLayout>
</RelativeLayout>
