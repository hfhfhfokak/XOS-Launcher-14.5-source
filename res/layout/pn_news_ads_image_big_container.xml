<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/zs_ad_bg_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.zero.mediation.ad.view.TMediaView
        android:id="@+id/ad_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pn_dimen_167dp"
        android:layout_marginTop="@dimen/pn_dimen_11dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pn_dimen_11dp"
        android:layout_marginBottom="@dimen/pn_dimen_11dp"
        android:layoutDirection="locale">
        <com.zero.mediation.ad.view.TIconView
            android:id="@+id/ad_icon"
            android:layout_width="@dimen/pn_dimen_38dp"
            android:layout_height="@dimen/pn_dimen_38dp"
            android:layout_marginEnd="@dimen/pn_dimen_11dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="locale">
            <TextView
                android:textSize="@dimen/pn_dimen_15sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/ad_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="@dimen/pn_dimen_12sp"
                android:textColor="@color/zs_new_white_50"
                android:ellipsize="end"
                android:id="@+id/ad_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pn_dimen_2dp"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:textSize="@dimen/pn_dimen_12sp"
        android:textColor="@color/pn_color1"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ad_install"
        android:background="@drawable/pn_news_ads_btn_bg"
        android:paddingLeft="@dimen/pn_dimen_8dp"
        android:paddingRight="@dimen/pn_dimen_8dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pn_dimen_28dp"
        android:layout_marginBottom="@dimen/pn_dimen_14dp"
        android:maxLines="1"/>
</LinearLayout>
