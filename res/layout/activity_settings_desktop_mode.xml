<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:id="@+id/btn_apply"
        android:layout_width="296dp"
        android:layout_height="36dp"
        android:layout_marginBottom="30dp"
        android:text="@string/setting_desktop_mode_btn_apply"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/OS.Widget.Button.Contained.Big.Single"/>
    <ImageView
        android:id="@+id/small_preview"
        android:layout_width="160dp"
        android:layout_height="234dp"
        android:src="@drawable/desktop_mode_traditional"
        android:scaleType="centerInside"
        android:layout_alignBottom="@+id/preview_divider"
        android:layout_centerHorizontal="true"
        android:layout_toStartOf="@+id/preview_divider"/>
    <ImageView
        android:id="@+id/big_preview"
        android:layout_width="160dp"
        android:layout_height="234dp"
        android:src="@drawable/desktop_mode_big_folder"
        android:scaleType="centerInside"
        android:layout_alignBottom="@+id/preview_divider"
        android:layout_centerHorizontal="true"
        android:layout_toEndOf="@+id/preview_divider"/>
    <ImageView
        android:id="@+id/small_indicator"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="4dp"
        android:layout_marginTop="50dp"
        android:src="@drawable/ic_settings_big_folder_indicator"
        android:scaleType="fitXY"
        android:layout_below="@+id/small_preview"
        android:layout_marginStart="72dp"
        android:layout_alignStart="@+id/indicate_text"/>
    <ImageView
        android:id="@+id/big_indicator"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="4dp"
        android:layout_marginTop="50dp"
        android:src="@drawable/ic_settings_big_folder_indicator"
        android:scaleType="fitXY"
        android:layout_below="@+id/big_preview"
        android:layout_marginEnd="72dp"
        android:layout_alignEnd="@+id/indicate_text"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/radio_group"
        android:paddingTop="10dp"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/preview_divider"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="152dp"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/radio_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.transsion.xlauncher.library.widget.ElegantTextView
                android:textSize="12sp"
                android:textColor="@color/lau_os_text_primary_color_day_night"
                android:gravity="start|center_vertical"
                android:id="@+id/radio_small_text"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_desktop_mode_traditional"
                android:maxLines="2"
                android:paddingStart="8dp"/>
        </LinearLayout>
        <Space
            android:layout_width="16dp"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="152dp"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/radio_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.transsion.xlauncher.library.widget.ElegantTextView
                android:textSize="12sp"
                android:textColor="@color/lau_os_text_primary_color_day_night"
                android:gravity="start|center_vertical"
                android:id="@+id/radio_big_text"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_desktop_mode_Large_folder"
                android:maxLines="2"
                android:paddingStart="8dp"/>
        </LinearLayout>
    </RadioGroup>
    <Space
        android:id="@+id/preview_divider"
        android:layout_width="8dp"
        android:layout_height="264dp"
        android:layout_below="@+id/toolbar"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/lau_os_text_secondary_color_day_night"
        android:id="@+id/indicate_text"
        android:background="@drawable/ic_settings_big_folder_text_bg"
        android:padding="16dp"
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        android:text=""
        android:minLines="3"
        android:layout_below="@+id/small_preview"
        android:layout_centerHorizontal="true"
        android:lineHeight="16sp"/>
    <include
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        layout="@layout/include_toolbar"/>
</RelativeLayout>
