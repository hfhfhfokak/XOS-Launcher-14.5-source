<?xml version="1.0" encoding="utf-8"?>
<com.android.quickstep.src.com.android.quickstep.views.TaskView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/dragBackground"
        android:background="@drawable/drag_conners"
        android:visibility="gone"
        android:layout_width="@dimen/dp_177"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_23"
        android:translationX="-5dp"
        android:translationY="@dimen/dp_5"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/flipTaskViewBackground"
        android:background="@drawable/flip_taskview_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_32"/>
    <FrameLayout
        android:id="@+id/task_top_title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="end|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/task_menu_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/recent_task_menu_layout_padding_end"
            android:paddingEnd="@dimen/recent_task_menu_layout_padding_end">
            <ImageView
                android:id="@+id/task_arrow"
                android:background="@null"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="@dimen/task_thumbnail_arrow_drawable_size_tablet"
                android:layout_height="@dimen/task_thumbnail_arrow_drawable_size_tablet"
                android:src="@drawable/recent_ic_task_menu_arrow"
                android:importantForAccessibility="no"/>
            <TextView
                android:theme="@style/recent_WidgetContainerTheme"
                android:textSize="14sp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/task_title"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/recent_task_title_max_width"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:textAlignment="viewStart"
                android:paddingStart="6dp"
                app:autoSizeTextType="uniform"/>
            <FrameLayout
                android:layout_width="@dimen/recent_task_thumbnail_icon_size"
                android:layout_height="@dimen/recent_task_thumbnail_icon_size">
                <com.android.quickstep.src.com.android.quickstep.views.IconView
                    android:id="@+id/icon"
                    android:focusable="false"
                    android:layout_width="@dimen/recent_task_thumbnail_icon_size"
                    android:layout_height="@dimen/recent_task_thumbnail_icon_size"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/task_shortcut_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/task_lock"
                android:background="@null"
                android:visibility="invisible"
                android:layout_width="@dimen/task_thumbnail_arrow_drawable_size_tablet"
                android:layout_height="@dimen/task_thumbnail_arrow_drawable_size_tablet"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/recent_task_shortcut_leading"
                android:layout_marginEnd="@dimen/recent_task_icon_margin_end"/>
            <ImageButton
                android:id="@+id/task_info"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="@dimen/recent_task_icon_padding"
                android:layout_height="@dimen/recent_task_thumbnail_icon_size"
                android:layout_marginEnd="@dimen/recent_task_icon_margin_end"/>
            <ImageButton
                android:id="@+id/task_pin"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="@dimen/recent_task_thumbnail_icon_size"
                android:layout_height="@dimen/recent_task_thumbnail_icon_size"
                android:layout_marginEnd="@dimen/recent_task_icon_margin_end"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/task_split"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="@dimen/task_thumbnail_arrow_drawable_size_tablet"
                android:layout_height="@dimen/task_thumbnail_arrow_drawable_size_tablet"
                android:src="@drawable/recent_ic_h_task_tran_split"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                android:layout_marginEnd="@dimen/recent_task_icon_margin_end"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/snapshotContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.android.quickstep.src.com.android.quickstep.views.TaskThumbnailView
            android:id="@+id/snapshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/recent_task_thumbnail_top_margin"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/dragTaskIcon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"/>
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/taskLockIconTop"
            android:visibility="gone"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:layout_margin="@dimen/recent_task_lock_icon_margin"
            android:src="@drawable/lock"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/blurTaskIcon"
            android:visibility="gone"
            android:layout_width="@dimen/recent_task_center_app_lock_icon_size"
            android:layout_height="@dimen/recent_task_center_app_lock_icon_size"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="@dimen/recent_task_blur_reason_text_size"
            android:textColor="@color/recent_task_blur_reason_text_color"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/blurTaskText"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/recent_task_blur_reason_text_height_default"/>
    </FrameLayout>
</com.android.quickstep.src.com.android.quickstep.views.TaskView>
