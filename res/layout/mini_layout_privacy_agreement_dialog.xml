<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/shape_mini_privacy_agreement_dialog_bg"
        android:paddingLeft="@dimen/mini_dp_16"
        android:paddingTop="@dimen/mini_dp_24"
        android:paddingRight="@dimen/mini_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/mini_dp_16">
        <TextView
            android:textSize="@dimen/mini_sp_14"
            android:textColor="@color/mini_color_element_03"
            android:id="@+id/tv_privacy_agreement_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mini_privacy_agreement_desc"/>
        <TextView
            android:textSize="@dimen/mini_sp_14"
            android:textColor="@color/mini_color_element_03"
            android:id="@+id/tv_privacy_agreement_please_read"
            android:paddingTop="@dimen/mini_dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mini_privacy_agreement_please_read"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="@dimen/mini_dp_16"
            android:paddingBottom="@dimen/mini_dp_40"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/mini_sp_16"
                android:textColor="@color/mini_color_191f2b"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/mini_sel_userinfo_btn_deny_bg"
                android:paddingTop="@dimen/mini_dp_10"
                android:paddingBottom="@dimen/mini_dp_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/mini_text_cancel"
                android:maxLines="1"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="@dimen/mini_dp_10"/>
            <View
                android:layout_width="@dimen/mini_dp_12"
                android:layout_height="@dimen/mini_dp_1"/>
            <TextView
                android:textSize="@dimen/mini_sp_16"
                android:textColor="@color/mini_color_bg_01"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_agree"
                android:background="@drawable/mini_sel_userinfo_btn_allow_bg"
                android:paddingTop="@dimen/mini_dp_10"
                android:paddingBottom="@dimen/mini_dp_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/mini_text_agree"
                android:maxLines="1"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="@dimen/mini_dp_10"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
