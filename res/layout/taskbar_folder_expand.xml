<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/rl_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="24sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginTop="102dp"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/fl_container"
        android:background="@drawable/taskbar_fold_pop_background"
        android:paddingLeft="6dp"
        android:paddingTop="16dp"
        android:paddingRight="6dp"
        android:paddingBottom="16dp"
        android:layout_width="@dimen/taskBar_big_folder_content_width"
        android:layout_height="@dimen/taskBar_big_folder_content_height"
        android:layout_marginTop="20dp">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarThumbVertical="@drawable/taskbar_nav_foler_expand_scrollbar"
            android:layout_gravity="center_horizontal"
            android:id="@+id/recyclerview"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
