<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/fa_recent_flashapp_item_style"
    android:layout_width="90dp"
    android:layout_height="120dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">
    <ImageView
        android:id="@+id/item_recent_iv"
        android:background="@drawable/fa_roundbg_default"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="10.67dp"
        android:layout_marginBottom="6dp"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/fa_color_000000_DEDEDE"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone"
        android:maxLines="2"
        android:lineSpacingExtra="4dp"/>
</LinearLayout>
