<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.widget.SearchWidgetView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/top_search_bar_height"
    android:contentDescription="@string/abandoned_search"
    app:swv_backgroundColor="@color/search_widget_background_color_translucent"
    app:swv_contentMarginLeft="@dimen/search_widget_translucent_content_marginLeft"
    app:swv_contentText="@string/abandoned_search"
    app:swv_contentTextColor="@color/white"
    app:swv_contentTextSize="16sp"
    app:swv_endBitmap="@drawable/ic_voice_search_not_transparent"
    app:swv_endBitmapMarginRight="@dimen/search_widget_translucent_end_bitmap_margin_right"
    app:swv_hotWordsIconPaddingStart="3dp"
    app:swv_hotWordsSearchBitmap="@drawable/ic_search_not_transparent"
    app:swv_hotWordsSearchBitmapMarginRight="@dimen/search_widget_translucent_hot_search_bitmap_margin_right"
    app:swv_hotWordsShow="true"
    app:swv_rectHeight="@dimen/search_widget_translucent_rect_height"
    app:swv_rectPaddingLeft="@dimen/search_widget_translucent_rect_padding_left"
    app:swv_rectRadius="@dimen/search_widget_translucent_rect_radius"
    app:swv_ripperColor="@color/search_widget_translucent_ripper_color"
    app:swv_shadowColor="@color/search_widget_translucent_shadow_color"
    app:swv_shadowOffset="@dimen/search_widget_translucent_shadow_offset"
    app:swv_translucent="true"/>
