<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsion.xlauncher.zeroscroll.AZUPNestedScrollView
        android:id="@+id/scoll_view_az"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_100">
            <TextView
                android:textSize="@dimen/zs_zero_16sp"
                android:textStyle="bold"
                android:textColor="@color/os_btn_text_dark"
                android:id="@+id/tv_hot_game"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:text="@string/zero_az_up_hot_games"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_hot_game"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_19"
                android:overScrollMode="never"/>
            <TextView
                android:textSize="@dimen/zs_zero_16sp"
                android:textStyle="bold"
                android:textColor="@color/os_btn_text_dark"
                android:id="@+id/tv_recommend_for_you"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/zero_az_up_recommend_for_you"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recomment_for_you"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_19"
                android:overScrollMode="never"/>
            <TextView
                android:textSize="@dimen/zs_zero_16sp"
                android:textStyle="bold"
                android:textColor="@color/os_btn_text_dark"
                android:id="@+id/tv_may_u_like_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_11"
                android:text="Recent played"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_may_you_like"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_7"
                android:overScrollMode="never"/>
        </LinearLayout>
    </com.transsion.xlauncher.zeroscroll.AZUPNestedScrollView>
    <RelativeLayout
        android:id="@+id/rl_touch"
        android:background="@drawable/discover_az_up_botton_up_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_touch_up"
            android:background="@drawable/myesc_ic_pull_up"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_marginBottom="@dimen/zs_zero_13dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
