<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/discovery_screen_padding"
    android:paddingEnd="@dimen/discovery_screen_padding">
    <FrameLayout
        android:id="@+id/vs_item"
        android:layout_width="match_parent"
        android:layout_height="@dimen/discovery_item_height"
        android:layout_marginTop="@dimen/twelve_dp"
        android:contentDescription="@string/video_show_in_discovery">
        <com.transsion.theme.common.customview.RoundCornerImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_dsy_vs_bg"
            android:scaleType="fitXY"
            app:roundCornerRadius="@dimen/theme_preview_corner_radius"/>
        <com.transsion.theme.common.customview.ElegantTextView
            android:text="@string/video_show_text"
            style="@style/VsDsyTextStyle"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sixteen_dp"
        android:layout_below="@+id/vs_item">
        <FrameLayout
            android:id="@+id/diy_item"
            android:layout_width="0dp"
            android:layout_height="@dimen/discovery_item_height"
            android:layout_weight="1"
            android:contentDescription="@string/diy_in_discovery">
            <com.transsion.theme.common.customview.RoundCornerImageView
                android:id="@+id/diy_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_dsy_diy_half_bg"
                android:scaleType="fitXY"
                app:roundCornerRadius="@dimen/theme_preview_corner_radius"/>
            <com.transsion.theme.common.customview.ElegantTextView
                android:text="@string/diy_single_text"
                style="@style/VsDsyTextStyle"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/font_item"
            android:layout_width="@dimen/discovery_font_item_width"
            android:layout_height="@dimen/discovery_item_height"
            android:contentDescription="@string/font_in_discovery"
            android:layout_marginStart="@dimen/sixteen_dp">
            <com.transsion.theme.common.customview.RoundCornerImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_dsy_font_bg"
                android:scaleType="fitXY"
                app:roundCornerRadius="@dimen/theme_preview_corner_radius"/>
            <com.transsion.theme.common.customview.ElegantTextView
                android:text="@string/text_font"
                style="@style/VsDsyTextStyle"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
