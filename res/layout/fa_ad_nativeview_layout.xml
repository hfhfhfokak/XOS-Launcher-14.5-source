<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ad_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/center_ad"
        android:layout_width="match_parent"
        android:layout_height="140dp">
        <ImageView
            android:id="@+id/big_ad_bg"
            android:layout_width="295.6641dp"
            android:layout_height="140dp"
            android:src="@drawable/fa_beauti"
            android:scaleType="fitXY"/>
    </FrameLayout>
    <FrameLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/center_ad">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/ad_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/fa_sharequit_quit"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="@dimen/ad_content_text_size"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_gravity="top"
            android:id="@+id/ad_title"
            android:clickable="false"
            android:layout_width="91dp"
            android:layout_height="19dp"
            android:layout_marginTop="9dp"
            android:layout_marginStart="49dp"/>
        <TextView
            android:textSize="@dimen/ad_description_text_size"
            android:textColor="#222222"
            android:ellipsize="end"
            android:layout_gravity="bottom"
            android:id="@+id/ad_description"
            android:clickable="false"
            android:layout_width="110dp"
            android:layout_height="11.67dp"
            android:layout_marginBottom="9dp"
            android:singleLine="true"
            android:layout_marginStart="49dp"/>
        <Button
            android:textSize="@dimen/ad_visit_text_size"
            android:textStyle="bold"
            android:textColor="@color/dialog_bg"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/visit_ad"
            android:background="@drawable/fa_button_style"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:text="@string/visit_site"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
</RelativeLayout>
