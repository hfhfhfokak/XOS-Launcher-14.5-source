<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/lau_dialog_panel_padding_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="start"
        android:id="@+id/emoji_rating_dialog_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/lau_dialog_title_margin_bottom"
        android:text="@string/emoji_rating_dialog_title"
        android:singleLine="false"
        android:layout_marginStart="@dimen/os_dialog_padding_left_right"
        android:layout_marginEnd="@dimen/os_dialog_padding_left_right"
        android:layout_alignParentStart="true"
        style="@style/os_dialog_title"/>
    <TextView
        android:gravity="start"
        android:id="@+id/emoji_rating_dialog_subtitle_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/emoji_rating_dialog_subtitle_margin_top"
        android:layout_marginBottom="@dimen/emoji_rating_dialog_subtitle_margin_bottom"
        android:text="@string/emoji_rating_dialog_subtitle"
        android:singleLine="false"
        android:layout_below="@+id/emoji_rating_dialog_title_tv"
        android:layout_marginStart="@dimen/os_dialog_padding_left_right"
        android:layout_marginEnd="@dimen/os_dialog_padding_left_right"
        android:layout_alignParentStart="true"
        style="@style/os_dialog_body"/>
    <com.transsion.xlauncher.rating.EmojiRatingLayout
        android:orientation="horizontal"
        android:id="@+id/emoji_rating_dialog_emoji_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/emoji_rating_dialog_subtitle_tv"
        android:layout_centerHorizontal="true"
        launcher:erl_emoji_gap="@dimen/emoji_rating_gap"
        launcher:erl_guide_anim_repeat_count="2"
        launcher:erl_guide_anim_type="1"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/emoji_rating_dialog_emoji_layout"
        layout="@layout/lau_prompt_dialog_buttons_horizontal"/>
</RelativeLayout>
