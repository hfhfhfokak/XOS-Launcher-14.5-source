<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recent_app_root"
    android:background="@drawable/zs_card_view_shape_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_10"
    android:layoutDirection="locale">
    <ImageView
        android:id="@+id/blur_layer"
        android:paddingTop="@dimen/zs_card_blur_margin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/zs_recent_app_card_height"
        android:scaleType="centerCrop"/>
    <GridView
        android:id="@+id/blur_target"
        android:paddingTop="5dp"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="@dimen/zs_recent_app_card_height"
        android:listSelector="@android:color/transparent"
        android:columnWidth="@dimen/zs_recent_app_card_app_name_width"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
</FrameLayout>
