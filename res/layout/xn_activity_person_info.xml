<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/xn_full_margin_start"
    android:layout_marginEnd="@dimen/xn_full_margin_end">
    <com.transsion.widgetslib.view.OverBoundNestedScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.transsion.xuanniao.account.comm.widget.RoundImageView
                android:id="@+id/portrait"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="@dimen/dimen_20"
                android:src="@drawable/xn_portrait_default"/>
            <RelativeLayout
                android:id="@+id/nicknameL"
                android:background="@drawable/xn_ripple_bg"
                android:paddingTop="@dimen/dimen_12"
                android:paddingBottom="@dimen/dimen_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_20"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end">
                <ImageView
                    android:id="@+id/nickNameArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/nickNameLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_nickname_label"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/nickNameArrow"
                    android:elegantTextHeight="true"/>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:id="@+id/nickName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_below="@+id/nickNameLabel"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/nickNameArrow"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/usernameL"
                android:background="@drawable/xn_ripple_bg"
                android:paddingTop="@dimen/dimen_12"
                android:paddingBottom="@dimen/dimen_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end">
                <ImageView
                    android:id="@+id/usernameArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/usernameLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_account_id"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/usernameArrow"
                    android:elegantTextHeight="true"/>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_below="@+id/usernameLabel"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/usernameArrow"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/fullNameL"
                android:background="@drawable/xn_ripple_bg"
                android:paddingTop="@dimen/dimen_12"
                android:paddingBottom="@dimen/dimen_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end">
                <ImageView
                    android:id="@+id/fullNameArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/fullNameLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_full_name"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/fullNameArrow"
                    android:elegantTextHeight="true"/>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:id="@+id/fullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_below="@+id/fullNameLabel"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/fullNameArrow"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/genderL"
                android:background="@drawable/xn_ripple_bg"
                android:paddingTop="@dimen/dimen_12"
                android:paddingBottom="@dimen/dimen_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end">
                <ImageView
                    android:id="@+id/genderArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/genderLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_gender"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/genderArrow"
                    android:elegantTextHeight="true"/>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:id="@+id/gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_below="@+id/genderLabel"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/genderArrow"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/birthdayL"
                android:background="@drawable/xn_ripple_bg"
                android:paddingTop="@dimen/dimen_12"
                android:paddingBottom="@dimen/dimen_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end">
                <ImageView
                    android:id="@+id/birthdayArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/birthdayLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_birthday"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/birthdayArrow"
                    android:elegantTextHeight="true"/>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:id="@+id/birthday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_below="@+id/birthdayLabel"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/birthdayArrow"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/regionL"
                android:background="@drawable/xn_ripple_bg"
                android:paddingTop="@dimen/dimen_12"
                android:paddingBottom="@dimen/dimen_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end">
                <ImageView
                    android:id="@+id/regionArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/regionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_region"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/regionArrow"
                    android:elegantTextHeight="true"/>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:id="@+id/region"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_below="@+id/regionLabel"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/regionArrow"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/addressL"
                android:background="@drawable/xn_ripple_bg"
                android:paddingTop="@dimen/dimen_12"
                android:paddingBottom="@dimen/dimen_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end">
                <ImageView
                    android:id="@+id/addressArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/addressLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_address"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/addressArrow"
                    android:elegantTextHeight="true"/>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:id="@+id/address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_below="@+id/addressLabel"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/addressArrow"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/signatureL"
                android:background="@drawable/xn_ripple_bg"
                android:paddingTop="@dimen/dimen_12"
                android:paddingBottom="@dimen/dimen_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/xn_item_padding_start"
                android:paddingEnd="@dimen/xn_item_padding_end">
                <ImageView
                    android:id="@+id/signatureArrow"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:src="@drawable/xn_next"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/signatureLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_signature"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/signatureArrow"
                    android:elegantTextHeight="true"/>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:id="@+id/signature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_below="@+id/signatureLabel"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@+id/signatureArrow"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
        </LinearLayout>
    </com.transsion.widgetslib.view.OverBoundNestedScrollView>
</RelativeLayout>
