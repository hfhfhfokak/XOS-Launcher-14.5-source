<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.LauncherRootView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <com.transsion.xlauncher.library.gaussian.GaussianWpLayer
        android:id="@+id/launcher_wp_copyed"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        launcher:layout_ignoreInsets="true"/>
    <ImageView
        android:id="@+id/launcher_gaosi_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        launcher:layout_ignoreInsets="true"/>
    <ImageView
        android:id="@+id/launcher_masking"
        android:background="@color/launcher_masking_color"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        launcher:layout_ignoreInsets="true"/>
    <com.android.launcher3.DragLayer
        android:id="@+id/drag_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/selected_cell"
            android:visibility="gone"
            launcher:layout_ignoreInsets="true"
            layout="@layout/select_cell_view"/>
        <com.android.launcher3.Workspace
            android:id="@+id/workspace"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            launcher:defaultScreen="@integer/config_workspaceDefaultScreen"
            launcher:layout_ignoreInsets="true"
            launcher:pageIndicator="@+id/page_indicator"/>
        <include
            android:id="@+id/hotseat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            launcher:layout_ignoreInsets="true"
            layout="@layout/hotseat"/>
        <include
            android:id="@+id/overview_panel"
            android:visibility="invisible"
            launcher:layout_ignoreInsets="true"
            layout="@layout/overview_panel"/>
        <include
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_menu_view_size"
            launcher:layout_ignoreInsets="true"
            layout="@layout/wallpaper_menu"/>
        <ViewStub
            android:layout_gravity="bottom"
            android:id="@+id/vs_arrange_menu"
            android:layout="@layout/arrange_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            launcher:layout_ignoreInsets="true"/>
        <com.transsion.xlauncher.pageIndicator.PageIndicatorWrapper
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:id="@+id/page_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            launcher:layout_ignoreInsets="true"/>
        <include layout="@layout/x_topbar"/>
        <com.transsion.xlauncher.library.gaussian.GaussianLayer
            android:id="@+id/apps_view_gaussian_layer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:forceHasOverlappingRendering="false"
            launcher:layout_ignoreInsets="true"/>
        <com.android.launcher3.InsettableFrameLayout
            android:id="@+id/apps_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/x_folder_view"/>
    </com.android.launcher3.DragLayer>
    <ViewStub
        android:layout_gravity="center_horizontal"
        android:id="@+id/x_top_search_view_stub"
        android:layout="@layout/layout_search_widget_translucent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_search_bar_height"/>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/nav_view_stub"
        android:layout="@layout/all_apps_nav"
        android:layout_width="match_parent"
        android:layout_height="38dp"/>
</com.android.launcher3.LauncherRootView>
