<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bootWizardL"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dimen_32"
        android:layout_marginEnd="@dimen/dimen_32">
        <Button
            android:id="@+id/bootBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xn_back"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dimen_8"
            style="@style/OS.Widget.Button.Contained.Big.Single.Gray"/>
        <Button
            android:id="@+id/bootSkip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xn_skip"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimen_8"
            style="@style/OS.Widget.Button.Contained.Big.Single"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_above="@+id/bootWizardL">
        <RelativeLayout
            android:paddingBottom="@dimen/dimen_24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/login_start_margin"
            android:layout_marginEnd="@dimen/login_end_margin">
            <RelativeLayout
                android:id="@+id/rlLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="@dimen/dimen_24"
                    android:src="@drawable/xn_launcher"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textAppearance="@style/font_black_24_medium"
                    android:gravity="center_horizontal"
                    android:id="@+id/noteTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8"
                    android:text="@string/xn_login_app"
                    android:layout_below="@+id/logo"
                    android:layout_centerHorizontal="true"
                    android:elegantTextHeight="true"/>
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/note"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8"
                    android:layout_below="@+id/noteTitle"
                    android:layout_centerHorizontal="true"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rlAuthorize"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/logoGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <ImageView
                        android:id="@+id/ivAppIcon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <TextView
                    android:textAppearance="@style/font_black_16"
                    android:textStyle="bold"
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_below="@+id/logoGroup"
                    android:layout_centerHorizontal="true"
                    android:elegantTextHeight="true"/>
            </RelativeLayout>
            <com.transsion.xuanniao.account.comm.widget.AccountInput
                android:id="@+id/accountInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24"
                android:layout_below="@+id/rlLogin"/>
            <com.transsion.xuanniao.account.comm.widget.CaptchaCodeInput
                android:id="@+id/captchaInput"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:layout_below="@+id/accountInput"/>
            <com.transsion.xuanniao.account.comm.widget.PasswordInput
                android:id="@+id/passwordInput"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:layout_below="@+id/captchaInput"/>
            <com.transsion.xuanniao.account.comm.widget.SmsCodeInput
                android:id="@+id/codeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16"
                android:layout_below="@+id/captchaInput"/>
            <com.transsion.xuanniao.account.comm.widget.ErrorView
                android:textAppearance="@style/font_error_10"
                android:id="@+id/loginByCodeError"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_below="@+id/codeInput"
                android:layout_alignStart="@+id/codeInput"/>
            <com.transsion.xuanniao.account.comm.widget.ErrorView
                android:textAppearance="@style/font_error_10"
                android:id="@+id/loginByPwdError"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_below="@+id/passwordInput"
                android:layout_alignStart="@+id/passwordInput"/>
            <TextView
                android:textAppearance="@style/font_black_10_t40"
                android:id="@+id/codeHelpTips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_6"
                android:layout_below="@+id/loginByCodeError"
                android:layout_alignStart="@+id/codeInput"
                android:elegantTextHeight="true"/>
            <TextView
                android:textAppearance="@style/font_black_10_t40"
                android:id="@+id/pwdHelpTips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_6"
                android:layout_below="@+id/loginByPwdError"
                android:layout_alignStart="@+id/passwordInput"
                android:elegantTextHeight="true"/>
            <Button
                android:enabled="false"
                android:id="@+id/loginOrRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="110dp"
                android:text="@string/xn_login_or_register"
                android:layout_below="@+id/codeInput"
                android:layout_marginStart="@dimen/xn_login_margin_start"
                android:layout_marginEnd="@dimen/xn_login_margin_end"
                style="@style/OS.Widget.Button.Contained.Big.Single"/>
            <Button
                android:id="@+id/switchLoginMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:text="@string/xn_login_by_pwd"
                android:layout_below="@+id/loginOrRegister"
                android:layout_marginStart="@dimen/xn_login_margin_start"
                android:layout_marginEnd="@dimen/xn_login_margin_end"
                style="@style/OS.Widget.Button.Contained.Big.Single.Gray"/>
            <Button
                android:textSize="12sp"
                android:id="@+id/forgotPwd"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:text="@string/xn_forget_pwd"
                android:layout_below="@+id/switchLoginMode"
                android:layout_centerHorizontal="true"
                android:elegantTextHeight="true"
                style="@style/OS.Widget.Button.Text"/>
            <RelativeLayout
                android:id="@+id/partyLoginDivision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:layout_below="@+id/forgotPwd">
                <TextView
                    android:textAppearance="@style/font_black_12_t40"
                    android:id="@+id/partyLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xn_party_login"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dimen_8"
                    android:layout_marginEnd="@dimen/dimen_8"
                    android:elegantTextHeight="true"/>
                <View
                    android:background="@color/xn_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/partyLogin"/>
                <View
                    android:background="@color/xn_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/partyLogin"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/partyLoginL"
                android:paddingTop="18dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/partyLoginDivision"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/googleLogin"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/xn_google_bg"
                    android:layout_marginStart="6dp"/>
                <View
                    android:id="@+id/googleH"
                    android:background="@drawable/xn_login_history"
                    android:visibility="invisible"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentBottom="true"/>
                <ImageView
                    android:id="@+id/facebookLogin"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/xn_facebook_bg"
                    android:layout_marginStart="@dimen/dimen_48"
                    android:layout_toEndOf="@+id/googleLogin"/>
                <View
                    android:id="@+id/facebookH"
                    android:background="@drawable/xn_login_history"
                    android:visibility="invisible"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="42dp"
                    android:layout_toEndOf="@+id/googleLogin"/>
                <ImageView
                    android:id="@+id/otherLogin"
                    android:layout_width="@dimen/dimen_24"
                    android:layout_height="@dimen/dimen_24"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="@dimen/dimen_48"
                    android:layout_toEndOf="@+id/facebookLogin"/>
                <View
                    android:id="@+id/otherH"
                    android:background="@drawable/xn_login_history"
                    android:visibility="invisible"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="42dp"
                    android:layout_toEndOf="@+id/facebookLogin"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/privacyL"
                android:background="@drawable/os_window_background"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/partyLoginL"
                android:layout_alignWithParentIfMissing="true">
                <CheckBox
                    android:id="@+id/agreementCheck"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:scaleX="0.7"
                    android:scaleY="0.7"/>
                <TextView
                    android:textAppearance="@style/font_black_10_t40"
                    android:id="@+id/agreement"
                    android:paddingTop="@dimen/dp_5"
                    android:paddingBottom="@dimen/dp_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elegantTextHeight="true"/>
            </LinearLayout>
            <TextView
                android:textAppearance="@style/font_black_10_t40"
                android:id="@+id/brand"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/privacyL"
                android:layout_centerHorizontal="true"
                android:elegantTextHeight="true"/>
        </RelativeLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/privacyL2"
        android:background="@drawable/os_window_background"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/scrollView"
        android:paddingStart="@dimen/login_start_margin"
        android:paddingEnd="@dimen/login_end_margin">
        <CheckBox
            android:id="@+id/agreementCheck2"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:scaleX="0.7"
            android:scaleY="0.7"/>
        <TextView
            android:textAppearance="@style/font_black_10_t40"
            android:id="@+id/agreement2"
            android:paddingTop="@dimen/dp_5"
            android:paddingBottom="@dimen/dp_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elegantTextHeight="true"/>
    </LinearLayout>
</RelativeLayout>
