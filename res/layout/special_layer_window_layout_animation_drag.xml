<?xml version="1.0" encoding="utf-8"?>
<com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout
        android:id="@+id/placeView"
        android:background="@color/taskbarview_drag_back_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"/>
    <com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout
        android:id="@+id/splitItemView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
    </com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout>
</com.android.quickstep.src.com.android.quickstep.views.RoundRelativeLayout>
